---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const SITE = 'https://planning-core-web.vercel.app';

const {
  title = 'Planning Core — Software de Planificación para Manufactura',
  description = 'El Gantt inteligente para manufactura industrial. Planifica producción, mide la robustez de cada plan y replanifica en segundos cuando la realidad cambia. Sin código, sin IT, en 12 semanas.',
  accent = '#1E4DB7',
  ogImage = '/images/logo-stacked.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Planning Core',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  url: SITE,
  offers: {
    '@type': 'Offer',
    description: 'Piloto de 12 semanas — ROI medible con tus propios datos antes de contratar.',
  },
  publisher: { '@type': 'Organization', name: 'Planning Core', url: SITE },
};
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0B1C3A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Planning Core" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <style define:vars={{ accent }}>
      :root { --page-accent: var(--accent); }
    </style>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Anti-flicker: apply saved theme before first paint -->
    <script is:inline>
      (function(){
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme','dark');
          }
        } catch(e){}
      })();
    </script>

    <!-- Vercel Web Analytics (no-op if not enabled on the project) -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { EN } from '../data/i18n.js';

  type Translations = Record<string, string>;

  function applyLang(lang: string) {
    const t: Translations = lang === 'en' ? EN : {};
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
      const key = el.dataset.i18n!;
      if (key in t) el.textContent = t[key];
    });
    document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach(el => {
      const key = el.dataset.i18nHtml!;
      if (key in t) el.innerHTML = t[key];
    });
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[data-i18n-placeholder]').forEach(el => {
      const key = (el as HTMLElement).dataset.i18nPlaceholder!;
      if (key in t) (el as HTMLInputElement).placeholder = t[key];
    });
    // Update <option> default text (select elements)
    document.querySelectorAll<HTMLOptionElement>('[data-i18n-opt]').forEach(el => {
      const key = el.dataset.i18nOpt!;
      if (key in t) el.textContent = t[key];
    });

    // Sync lang button label and flag SVG
    const cur  = document.getElementById('langCurrent');
    const flag = document.getElementById('langFlag');
    if (cur) cur.textContent = lang.toUpperCase();
    if (flag) flag.innerHTML = lang === 'en'
      ? `<svg class="flag-svg" viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg"><rect width="60" height="30" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/><path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/></svg>`
      : `<svg class="flag-svg" viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg"><rect width="3" height="2" fill="#c60b1e"/><rect y=".5" width="3" height="1" fill="#ffc400"/></svg>`;

    // Mark active option
    document.querySelectorAll<HTMLElement>('[data-lang-option]').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.langOption === lang);
    });

    document.documentElement.lang = lang === 'en' ? 'en' : 'es';
    localStorage.setItem('pc_lang', lang);
  }

  // Apply saved language on load
  const savedLang = localStorage.getItem('pc_lang') || 'es';
  if (savedLang === 'en') applyLang('en');

  // Sync active class on initial load
  document.querySelectorAll<HTMLElement>('[data-lang-option]').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.langOption === savedLang);
  });

  // Language dropdown toggle
  const langSelector = document.getElementById('langSelector');
  const langBtnEl    = document.getElementById('langBtnEl');
  const langMenu     = document.getElementById('langMenu');

  langBtnEl?.addEventListener('click', (e) => {
    e.stopPropagation();
    langSelector?.classList.toggle('open');
  });

  document.addEventListener('click', () => {
    langSelector?.classList.remove('open');
  });

  langMenu?.addEventListener('click', (e) => e.stopPropagation());

  document.querySelectorAll<HTMLElement>('[data-lang-option]').forEach(btn => {
    btn.addEventListener('click', () => {
      applyLang(btn.dataset.langOption!);
      langSelector?.classList.remove('open');
    });
  });
</script>
