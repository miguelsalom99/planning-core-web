---
const currentPath = Astro.url.pathname;

const industries = [
  { href: '/sectores/composites-aero',      label: 'Composites & Aeroespacial', i18n: 'nav.ind.composites' },
  { href: '/sectores/impresion-packaging',  label: 'Impresión & Packaging',     i18n: 'nav.ind.print'      },
  { href: '/sectores/fundicion-metalurgia', label: 'Fundición & Metalurgia',    i18n: 'nav.ind.metal'      },
];
---
<header class="header" id="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <img src="/images/logo-small.png" alt="" class="logo-icon" />
      <span class="logo-wordmark">Planning<strong>Core</strong></span>
    </a>

    <nav class="header__nav" id="nav">
      <a href="/" class={`nav-link ${currentPath === '/' ? 'nav-link--active' : ''}`} data-i18n="nav.inicio">Inicio</a>
      <a href="/producto" class={`nav-link ${currentPath.startsWith('/producto') ? 'nav-link--active' : ''}`} data-i18n="nav.producto">Producto</a>

      <div class="nav-dropdown">
        <button class={`nav-link nav-link--btn ${currentPath.startsWith('/sectores') ? 'nav-link--active' : ''}`}>
          <span data-i18n="nav.industrias">Industrias</span>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="dropdown-menu">
          {industries.map(({ href, label, i18n }) => (
            <a href={href} class="dropdown-item" data-i18n={i18n}>{label}</a>
          ))}
          <div class="dropdown-divider"></div>
          <a href="/sectores" class="dropdown-item dropdown-item--all" data-i18n="nav.viewAll">Ver todos los sectores →</a>
        </div>
      </div>

      <a href="/precios" class={`nav-link ${currentPath.startsWith('/precios') ? 'nav-link--active' : ''}`} data-i18n="nav.piloto">Piloto</a>
    </nav>

    <div class="header__actions">
      <!-- Language selector -->
      <div class="lang-selector" id="langSelector">
        <button class="lang-btn" id="langBtnEl" aria-label="Language">
          <span id="langFlag">
            <!-- Spain flag (default) -->
            <svg class="flag-svg" viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg">
              <rect width="3" height="2" fill="#c60b1e"/>
              <rect y=".5" width="3" height="1" fill="#ffc400"/>
            </svg>
          </span>
          <span id="langCurrent">ES</span>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="lang-menu" id="langMenu">
          <button class="lang-option" data-lang-option="es">
            <svg class="flag-svg" viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg"><rect width="3" height="2" fill="#c60b1e"/><rect y=".5" width="3" height="1" fill="#ffc400"/></svg>
            Español
          </button>
          <button class="lang-option" data-lang-option="en">
            <svg class="flag-svg" viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg"><rect width="60" height="30" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/><path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/></svg>
            English
          </button>
        </div>
      </div>

      <a href="/app" class="btn btn--ghost btn--sm" id="loginBtn" data-i18n="header.login">Iniciar sesión</a>
      <a href="/contacto" class="btn btn--primary btn--sm" data-i18n="header.demo">Solicitar demo</a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: #0B1C3A;
    border-bottom: 1px solid rgba(255,255,255,.07);
    transition: box-shadow .2s;
  }
  .header.scrolled { box-shadow: 0 4px 24px rgba(0,0,0,.3); }

  .header__inner {
    display: flex;
    align-items: center;
    height: 68px;
    gap: 2rem;
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .logo-icon {
    height: 34px;
    width: 34px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .logo-wordmark {
    font-size: 1rem;
    font-weight: 400;
    color: #fff;
    letter-spacing: -.01em;
    line-height: 1;
  }
  .logo-wordmark strong { font-weight: 700; }

  .header__nav {
    display: flex;
    align-items: center;
    gap: .25rem;
    flex: 1;
  }
  .nav-link {
    font-size: .875rem;
    font-weight: 500;
    color: rgba(255,255,255,.7);
    padding: .45rem .85rem;
    border-radius: 6px;
    transition: all .15s;
    white-space: nowrap;
  }
  .nav-link:hover { color: #fff; background: rgba(255,255,255,.07); }
  .nav-link--active { color: #fff; }

  /* Dropdown */
  .nav-dropdown { position: relative; padding-bottom: 8px; margin-bottom: -8px; }
  .nav-link--btn {
    display: flex;
    align-items: center;
    gap: .35rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .nav-link--btn svg { transition: transform .15s; opacity: .6; }
  .nav-dropdown:hover .nav-link--btn svg { transform: rotate(180deg); }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 220px;
    background: #112347;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 10px;
    padding: .4rem;
    box-shadow: 0 8px 32px rgba(0,0,0,.35);
    z-index: 300;
  }
  .nav-dropdown:hover .dropdown-menu { display: block; }
  .dropdown-item {
    display: block;
    padding: .5rem .8rem;
    font-size: .82rem;
    font-weight: 500;
    color: rgba(255,255,255,.75);
    border-radius: 6px;
    transition: all .12s;
  }
  .dropdown-item:hover { background: rgba(255,255,255,.07); color: #fff; }
  .dropdown-divider { height: 1px; background: rgba(255,255,255,.08); margin: .3rem .4rem; }
  .dropdown-item--all { color: rgba(139,194,198,.9); font-size: .78rem; }
  .dropdown-item--all:hover { color: #8BC2C6; background: rgba(139,194,198,.07); }

  .header__actions { display: flex; align-items: center; gap: .75rem; }
  .btn--sm { padding: .5rem 1.25rem; font-size: .85rem; }
  .btn--ghost {
    background: transparent;
    color: rgba(255,255,255,.8);
    border: 1.5px solid rgba(255,255,255,.2);
  }
  .btn--ghost:hover {
    background: rgba(255,255,255,.08);
    color: #fff;
    border-color: rgba(255,255,255,.4);
    transform: none;
  }

  /* Flag SVGs */
  .flag-svg {
    display: inline-block;
    width: 18px;
    height: 12px;
    border-radius: 2px;
    flex-shrink: 0;
    vertical-align: middle;
  }

  /* Language selector */
  .lang-selector {
    position: relative;
  }
  .lang-btn {
    display: flex;
    align-items: center;
    gap: .3rem;
    background: transparent;
    border: 1.5px solid rgba(255,255,255,.2);
    border-radius: 6px;
    color: rgba(255,255,255,.7);
    cursor: pointer;
    font-family: inherit;
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .04em;
    padding: .38rem .6rem;
    transition: all .15s;
  }
  .lang-btn:hover {
    background: rgba(255,255,255,.07);
    color: #fff;
    border-color: rgba(255,255,255,.35);
  }
  .lang-btn svg { opacity: .6; transition: transform .15s; }
  .lang-selector.open .lang-btn svg { transform: rotate(180deg); }
  .lang-menu {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 130px;
    background: #112347;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    padding: .3rem;
    box-shadow: 0 8px 24px rgba(0,0,0,.35);
    z-index: 300;
  }
  .lang-selector.open .lang-menu { display: block; }
  .lang-option {
    display: flex;
    align-items: center;
    gap: .5rem;
    width: 100%;
    padding: .45rem .75rem;
    background: none;
    border: none;
    border-radius: 5px;
    color: rgba(255,255,255,.75);
    cursor: pointer;
    font-family: inherit;
    font-size: .82rem;
    font-weight: 500;
    text-align: left;
    transition: all .12s;
  }
  .lang-option:hover { background: rgba(255,255,255,.07); color: #fff; }
  .lang-option.active { color: #8BC2C6; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: .25rem;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: all .2s;
  }

  @media (max-width: 900px) {
    .logo-img--full { display: none; }
    .logo-img--icon { display: block; }
  }

  @media (max-width: 768px) {
    .nav-toggle { display: flex; }
    .header__nav {
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      background: #0B1C3A;
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,.1);
      display: none;
      gap: .25rem;
    }
    .header__nav.open { display: flex; }
    .nav-link { padding: .75rem 1rem; }
  }
</style>

<script>
  const header = document.getElementById('header');
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('nav');
  const loginBtn = document.getElementById('loginBtn') as HTMLAnchorElement | null;

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  });

  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
  });

  // If already logged in, show "Mi panel" linking to /app
  if (loginBtn && localStorage.getItem('pc_token')) {
    loginBtn.textContent = 'Mi panel →';
    loginBtn.href = '/app';
    loginBtn.style.borderColor = 'rgba(139,194,198,.4)';
    loginBtn.style.color = '#8BC2C6';
  }
</script>
