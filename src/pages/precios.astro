---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Piloto 12 semanas — Planning Core"
  description="Piloto de 12 semanas para demostrar el ROI con tus propios datos. Sin permanencia. Sin riesgo."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-label">Piloto 12 semanas</p>
      <h1 class="section-title section-title--light">De cero a producción<br/>en 3 meses.</h1>
      <p class="page-hero__sub">
        Empezamos con un piloto de 12 semanas para demostrar el ROI con tus propios datos.
        Si no genera valor, no hay contrato. Así de simple.
      </p>
    </div>
  </section>

  <!-- PILOT PHASES -->
  <section class="phases">
    <div class="container">
      <p class="section-label">Cómo funciona el piloto</p>
      <h2 class="section-title">12 semanas de cero a go-live</h2>
      <div class="phases-grid">
        {[
          { phase:'Semanas 1–2', title:'Mapeo y configuración', desc:'Mapeamos tus máquinas, turnos, operarios y restricciones. Sin código, sin IT. Tú defines, nosotros configuramos.' },
          { phase:'Semanas 3–5', title:'Restricciones y validación', desc:'Configuramos la lógica de tu sector: secuencias, cuellos de botella, ventanas de mantenimiento. Plan generado vs. tu realidad.' },
          { phase:'Semanas 6–8', title:'Uso en paralelo', desc:'Corres Planning Core en paralelo con tu sistema actual. Comparas el plan generado con lo que realmente ejecutas.' },
          { phase:'Semanas 9–12', title:'Go-live y scorecard', desc:'Go-live completo. Scorecard de impacto semanal con las métricas acordadas. El ROI medido con tus propios datos.' },
        ].map(p => (
          <div class="phase-card">
            <div class="phase-badge">{p.phase}</div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT IS INCLUDED -->
  <section class="included" style="background:var(--n90)">
    <div class="container">
      <div class="included-grid">
        <div>
          <p class="section-label">Qué incluye</p>
          <h2 class="section-title">Todo lo que necesitas<br/>para empezar</h2>
          <div class="included-list">
            {[
              ['Onboarding dedicado', 'Sesiones de configuración guiadas por nuestro equipo.'],
              ['Integración con tu ERP', 'Conectamos vía API o importación CSV según tu sistema.'],
              ['Soporte durante el piloto', 'Canal directo con el equipo de CS durante las 12 semanas.'],
              ['Scorecard de impacto', 'KPIs medidos con tus datos reales, semana a semana.'],
              ['Acceso sin límite de usuarios', 'Todos los roles de tu planta pueden acceder.'],
              ['Actualizaciones incluidas', 'Sin coste adicional por nuevas funcionalidades.'],
            ].map(([title, desc]) => (
              <div class="included-item">
                <span class="inc-check">✓</span>
                <div>
                  <strong>{title}</strong>
                  <span>{desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="guarantees">
          <p class="section-label">Nuestro compromiso</p>
          <h2 style="font-size:1.4rem;font-weight:800;color:var(--navy);margin-bottom:1.5rem">Sin riesgo. Sin ataduras.</h2>
          {[
            'Sin coste de implantación',
            'Sin consultores externos',
            'Sin permanencia mínima',
            'Sin penalización por cancelar',
            'Sin reemplazar tu ERP actual',
          ].map(t => (
            <div class="guarantee-item">
              <span class="g-check">✓</span>
              <span>{t}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-bar">
    <div class="container cta-bar__inner">
      <div>
        <h2 class="section-title section-title--light">¿Hablamos de tu caso?</h2>
        <p style="color:var(--silver);margin-top:.5rem">Una llamada de 30 min para ver si Planning Core encaja con tu planta.</p>
      </div>
      <a href="/contacto" class="btn btn--primary">Solicitar llamada →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: linear-gradient(145deg, #060F20, #0B1C3A); padding: 5rem 0 4rem; }
  .page-hero__sub { color: var(--silver); max-width: 580px; line-height: 1.7; margin-top: .75rem; font-size: 1.05rem; }

  .phases { padding: 5rem 0; }
  .phases-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-top: 2.5rem; }
  .phase-card {
    background: var(--n90);
    border: 1px solid var(--n80);
    border-top: 3px solid #1E4DB7;
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem;
  }
  .phase-badge { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #1E4DB7; margin-bottom: .75rem; }
  .phase-card h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .5rem; }
  .phase-card p { font-size: .875rem; color: var(--n30); line-height: 1.65; }

  .included { padding: 5rem 0; }
  .included-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .included-list { margin-top: 1.5rem; display: flex; flex-direction: column; gap: .9rem; }
  .included-item { display: flex; gap: .85rem; align-items: flex-start; }
  .inc-check { width: 22px; height: 22px; background: rgba(30,77,183,.1); color: #1E4DB7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 700; flex-shrink: 0; margin-top: 2px; }
  .included-item strong { display: block; font-size: .95rem; color: var(--navy); margin-bottom: .15rem; }
  .included-item span { font-size: .875rem; color: var(--n30); }

  .guarantees { background: var(--navy); border-radius: var(--radius-lg); padding: 2rem; }
  .guarantees .section-label { color: rgba(255,255,255,.45); }
  .guarantees h2 { color: #fff !important; }
  .guarantee-item { display: flex; align-items: center; gap: .75rem; font-size: .9rem; color: rgba(255,255,255,.75); padding: .7rem 0; border-bottom: 1px solid rgba(255,255,255,.08); }
  .guarantee-item:last-child { border-bottom: none; }
  .g-check { width: 20px; height: 20px; background: rgba(30,77,183,.4); color: #93c5fd; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .65rem; font-weight: 700; flex-shrink: 0; }

  .cta-bar { background: linear-gradient(145deg, #060F20, #0B1C3A); padding: 4rem 0; }
  .cta-bar__inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .phases-grid { grid-template-columns: repeat(2, 1fr); }
    .included-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .phases-grid { grid-template-columns: 1fr; }
  }
</style>
