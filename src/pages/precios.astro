---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Piloto 12 semanas — Planning Core"
  description="Piloto de 12 semanas para demostrar el ROI con tus propios datos. Sin coste de implantación, sin permanencia. Si no genera valor, no hay contrato."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-label" data-i18n="precios.hero.label">Piloto 12 semanas</p>
      <h1 class="section-title section-title--light" data-i18n-html="precios.hero.title">De cero a producción<br/>en 3 meses.</h1>
      <p class="page-hero__sub" data-i18n="precios.hero.sub">
        Empezamos con un piloto de 12 semanas para demostrar el ROI con tus propios datos.
        Si no genera valor, no hay contrato. Así de simple.
      </p>
    </div>
  </section>

  <!-- PILOT PHASES -->
  <section class="phases">
    <div class="container">
      <p class="section-label" data-i18n="precios.phases.label">Cómo funciona el piloto</p>
      <h2 class="section-title" data-i18n="precios.phases.title">12 semanas de cero a go-live</h2>
      <ol class="phases-grid">
        {[
          { phase:'Semanas 1–2', title:'Mapeo y configuración', desc:'Mapeamos tus máquinas, turnos, operarios y restricciones. Sin código, sin IT. Tú defines, nosotros configuramos.', i: 0 },
          { phase:'Semanas 3–5', title:'Restricciones y validación', desc:'Configuramos la lógica de tu sector: secuencias, cuellos de botella, ventanas de mantenimiento. Plan generado vs. tu realidad.', i: 1 },
          { phase:'Semanas 6–8', title:'Uso en paralelo', desc:'Corres Planning Core en paralelo con tu sistema actual. Comparas el plan generado con lo que realmente ejecutas.', i: 2 },
          { phase:'Semanas 9–12', title:'Go-live y scorecard', desc:'Go-live completo. Scorecard de impacto semanal con las métricas acordadas. El ROI medido con tus propios datos.', i: 3 },
        ].map(p => (
          <li class="phase-card">
            <span class="phase-num">{`0${p.i + 1}`}</span>
            <div class="phase-badge" data-i18n={`precios.phase.${p.i}.badge`}>{p.phase}</div>
            <h3 data-i18n={`precios.phase.${p.i}.title`}>{p.title}</h3>
            <p data-i18n={`precios.phase.${p.i}.desc`}>{p.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHAT IS INCLUDED -->
  <section class="included">
    <div class="container">
      <div class="included-grid">
        <div>
          <p class="section-label" data-i18n="precios.inc.label">Qué incluye</p>
          <h2 class="section-title" data-i18n-html="precios.inc.title">Todo lo que necesitas<br/>para empezar</h2>
          <div class="included-list">
            {[
              ['Onboarding dedicado', 'Sesiones de configuración guiadas por nuestro equipo.', 0],
              ['Integración con tu ERP', 'Conectamos vía API o importación CSV según tu sistema.', 1],
              ['Soporte durante el piloto', 'Canal directo con el equipo de CS durante las 12 semanas.', 2],
              ['Scorecard de impacto', 'KPIs medidos con tus datos reales, semana a semana.', 3],
              ['Acceso sin límite de usuarios', 'Todos los roles de tu planta pueden acceder.', 4],
              ['Actualizaciones incluidas', 'Sin coste adicional por nuevas funcionalidades.', 5],
            ].map(([title, desc, i]) => (
              <div class="included-item">
                <span class="inc-check">✓</span>
                <div>
                  <strong data-i18n={`precios.inc.${i}.title`}>{title}</strong>
                  <span data-i18n={`precios.inc.${i}.desc`}>{desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="guarantees">
          <p class="section-label section-label--onnavy" data-i18n="precios.guarantee.label">Nuestro compromiso</p>
          <h2 class="guarantees__title" data-i18n="precios.guarantee.title">Sin riesgo. Sin ataduras.</h2>
          {[
            ['Sin coste de implantación', 0],
            ['Sin consultores externos', 1],
            ['Sin permanencia mínima', 2],
            ['Sin penalización por cancelar', 3],
            ['Sin reemplazar tu ERP actual', 4],
          ].map(([t, i]) => (
            <div class="guarantee-item">
              <span class="g-check">✓</span>
              <span data-i18n={`precios.guarantee.${i}`}>{t}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-bar">
    <div class="container cta-bar__inner">
      <div>
        <h2 class="section-title section-title--light" data-i18n="precios.cta.title">¿Hablamos de tu caso?</h2>
        <p class="cta-bar__sub" data-i18n="precios.cta.sub">Una llamada de 30 min para ver si Planning Core encaja con tu planta.</p>
      </div>
      <a href="/contacto" class="btn btn--primary" data-i18n="precios.cta.btn">Solicitar llamada →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .phases { padding: 5.5rem 0; }
  .phases-grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 2.5rem; border-top: 2px solid var(--navy); }
  .phase-card { padding: 1.5rem 1.4rem 0 0; border-right: 1px solid var(--n80); position: relative; }
  .phase-card:last-child { border-right: none; }
  .phase-card::before { content: ''; position: absolute; top: -6px; left: 0; width: 10px; height: 10px; border-radius: 50%; background: var(--navy); }
  .phase-num { font-family: var(--font-display); font-size: .72rem; font-weight: 700; letter-spacing: .12em; color: var(--brand); }
  .phase-badge { font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--n30); margin: .6rem 0 .3rem; }
  .phase-card h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: .5rem; }
  .phase-card p { font-size: .86rem; color: var(--n30); line-height: 1.6; }

  .included { padding: 5.5rem 0; background: #fff; border-top: 1px solid var(--n80); }
  .included-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4.5rem; align-items: start; }
  .included-list { margin-top: 1.5rem; display: flex; flex-direction: column; }
  .included-item { display: flex; gap: .85rem; align-items: flex-start; padding: .85rem 0; border-top: 1px solid var(--n80); }
  .included-item:first-child { border-top: none; }
  .inc-check { width: 20px; height: 20px; background: rgba(27,63,139,.1); color: var(--brand); border-radius: 50%; display: grid; place-items: center; font-size: .68rem; font-weight: 700; flex-shrink: 0; margin-top: 2px; }
  .included-item strong { display: block; font-size: .93rem; color: var(--navy); margin-bottom: .15rem; }
  .included-item span { font-size: .86rem; color: var(--n30); }

  .guarantees { background: var(--navy); border-radius: var(--radius-lg); padding: 2rem; position: sticky; top: 5rem; }
  .section-label--onnavy { color: rgba(255,255,255,.45); }
  .guarantees__title { font-family: var(--font-display); font-size: 1.3rem; font-weight: 800; color: #fff; margin-bottom: 1.4rem; letter-spacing: -.02em; }
  .guarantee-item { display: flex; align-items: center; gap: .75rem; font-size: .9rem; color: rgba(255,255,255,.78); padding: .7rem 0; border-top: 1px solid rgba(255,255,255,.09); }
  .guarantee-item:first-of-type { border-top: none; }
  .g-check { width: 18px; height: 18px; background: rgba(139,194,198,.2); color: #8BC2C6; border-radius: 50%; display: grid; place-items: center; font-size: .62rem; font-weight: 700; flex-shrink: 0; }

  .cta-bar { background: linear-gradient(160deg, #060F20, #0B1C3A); padding: 4.5rem 0; }
  .cta-bar__inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .cta-bar__sub { color: var(--silver); margin-top: .5rem; }

  @media (max-width: 980px) {
    .phases-grid { grid-template-columns: repeat(2, 1fr); }
    .phase-card { border-right: none; border-bottom: 1px solid var(--n80); padding-bottom: 1.4rem; }
    .included-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .guarantees { position: static; }
  }
  @media (max-width: 600px) {
    .phases-grid { grid-template-columns: 1fr; }
  }
</style>
