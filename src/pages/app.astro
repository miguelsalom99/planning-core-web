<script>
  const API = 'https://composite-replanning-api.vercel.app';

  async function init() {
    const token = localStorage.getItem('pc_token');
    if (!token) {
      window.location.href = 'https://composite-replanning-api.vercel.app/login?next=https://planning-core-web.vercel.app/app';
      return;
    }

    try {
      const res = await fetch(`${API}/auth/me`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Unauthorized');
      const user = await res.json();

      // Populate user info
      const initials = user.name
        ? user.name.split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase()
        : user.email.slice(0,2).toUpperCase();

      document.getElementById('user-initials').textContent = initials;
      document.getElementById('user-name').textContent = user.name || user.email;
      document.getElementById('user-role').textContent = user.is_admin ? 'Administrador' : 'Usuario';

      // Company
      const company = user.company || 'Mi empresa';
      const coInitials = company.split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase();
      document.getElementById('co-initials').textContent = coInitials;
      document.getElementById('co-name').textContent = company;

    } catch {
      localStorage.removeItem('pc_token');
      window.location.href = '/login';
      return;
    }

    // Hide overlay
    const overlay = document.getElementById('auth-overlay');
    overlay.classList.add('hidden');
    setTimeout(() => overlay.remove(), 400);
  }

  // Logout
  document.getElementById('nav-logout').addEventListener('click', (e) => {
    e.preventDefault();
    localStorage.removeItem('pc_token');
    window.location.href = '/login';
  });

  init();
</script>

