          <a class="ind-item" href="#" data-industry="muebles">
            <span class="ind-dot" style="background:#16A34A"></span>
            <span class="ind-name">Muebles & Madera</span>
          </a>
          <a class="ind-item" href="#" data-industry="medtech">
            <span class="ind-dot" style="background:#7C3AED"></span>
            <span class="ind-name">MedTech & Dispositivos</span>
          </a>
          <a class="ind-item" href="#" data-industry="ferroviario">
            <span class="ind-dot" style="background:#0891B2"></span>
            <span class="ind-name">Ferroviario MRO</span>
          </a>
          <a class="ind-item" href="#" data-industry="agroalimentario">
            <span class="ind-dot" style="background:#D97706"></span>
