<script>
  import * as XLSX from 'xlsx';
  const API = 'https://composite-replanning-api.vercel.app';

  const selectorEl  = document.getElementById('industry-selector');
  const dashboardEl = document.getElementById('dashboard-view');

  const industriesPanelEl = document.getElementById('industriesPanel');
  const backBtn           = document.getElementById('backToSelector');
  const backSep           = document.querySelector('.back-sep');
  const sidebarEl         = document.getElementById('sidebar');

  function showSelector() {
    selectorEl.classList.remove('hidden');
    dashboardEl.classList.remove('visible');
    sidebarEl.classList.add('hidden');
    industriesPanelEl.classList.add('hidden');
    backBtn.classList.add('hidden');
    backSep.classList.add('hidden');
    document.querySelectorAll('.ind-item').forEach(el => el.classList.remove('ind-item--active'));
  }

  function showDashboard(industry) {
    selectorEl.classList.add('hidden');
    dashboardEl.classList.add('visible');
    sidebarEl.classList.remove('hidden');
    industriesPanelEl.classList.remove('hidden');
    backBtn.classList.remove('hidden');
    backSep.classList.remove('hidden');
    document.querySelectorAll('.ind-item').forEach(el => {
      el.classList.toggle('ind-item--active', el.dataset.industry === industry);
    });
    initDashboard();
  }

  function showLoginForm(errMsg?: string) {
    const spinner = document.getElementById('auth-spinner');
    const card    = document.getElementById('login-card');
    if (spinner) spinner.style.display = 'none';
    if (card)    card.classList.add('visible');
    showAuthStep('login');
    if (errMsg) {
      const errEl = document.getElementById('login-err');
      if (errEl) { errEl.textContent = errMsg; errEl.style.display = 'block'; }
    }
    // Pre-warm the server in the background so login POST is fast
    fetch(`${API}/health`).catch(() => {});
  }

  function hideOverlay() {
    const overlay = document.getElementById('auth-overlay');
    if (overlay) overlay.classList.add('hidden');
  }

  function applyUser(user: any) {
    try {
      const initials = user.name
        ? user.name.split(' ').map((w: string) => w[0]).slice(0,2).join('').toUpperCase()
        : (user.email || 'U').slice(0,2).toUpperCase();
      const uiEl = document.getElementById('user-initials');
      if (uiEl) uiEl.textContent = initials;
      const unEl = document.getElementById('user-name');
      if (unEl) unEl.textContent = user.name || user.email;
      const urEl = document.getElementById('user-role');
      if (urEl) urEl.textContent = user.is_admin ? 'Administrador' : 'Usuario';
      // initAdminPanel lives inside initDashboard's scope (sidebar DOM isn't
      // mounted/relevant until the dashboard shows), so we can't call it from
      // here directly — stash the flag and let initDashboard apply it once
      // the dashboard is actually shown.
      localStorage.setItem('pc_is_admin', user.is_admin ? 'true' : 'false');
      const company    = user.company || 'Mi empresa';
      const coInitials = company.split(' ').map((w: string) => w[0]).slice(0,2).join('').toUpperCase();
      const ciEl = document.getElementById('co-initials');
      if (ciEl) ciEl.textContent = coInitials;
      const cnEl = document.getElementById('co-name');
      if (cnEl) cnEl.textContent = company;
      applyPilot(user.pilot);
    } catch (e) {
      console.error('applyUser error', e);
    }
    hideOverlay();
    showSelector();
  }

  // Pilot timeline is per-company (admin sets "Inicio del piloto" + "Semanas").
  // `user.pilot` = { start, week, total, pct } from /auth/me, computed live so it
  // advances by itself each week. Absent (company with no pilot set) → leave the
  // static demo values untouched.
  function applyPilot(pilot: any) {
    if (!pilot || !pilot.total) return;
    const chip = document.querySelector('.pilot-chip') as HTMLElement | null;
    if (chip) {
      chip.style.display = '';
      const val = chip.querySelector('.pilot-chip__val');
      if (val) val.textContent = `Sem. ${pilot.week} / ${pilot.total}`;
      const fill = chip.querySelector('.pilot-chip__fill') as HTMLElement | null;
      if (fill) fill.style.width = `${pilot.pct}%`;
    }
    const scWeek = document.querySelector('.scorecard__week');
    if (scWeek) scWeek.textContent = `Sem. ${pilot.week}`;
    const kpiSub = document.querySelector('#panel-kpis .panel-page-sub');
    if (kpiSub) kpiSub.textContent = `Semana ${pilot.week} de ${pilot.total} · Evolución acumulada desde inicio del piloto`;
  }

  async function doLogin() {
    const email    = (document.getElementById('login-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('login-password') as HTMLInputElement).value;
    const btn      = document.getElementById('login-btn') as HTMLButtonElement;
    const errEl    = document.getElementById('login-err')!;
    if (!email || !password) { errEl.textContent = 'Introduce email y contraseña'; errEl.style.display = 'block'; return; }
    btn.disabled = true;
    btn.textContent = 'Verificando…';
    errEl.style.display = 'none';
    const hint = setTimeout(() => { btn.textContent = 'Iniciando servidor… (10-15s primera vez)'; }, 3000);
    try {
      const res = await fetch(`${API}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      clearTimeout(hint);
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Credenciales incorrectas');
      localStorage.setItem('pc_token', data.access_token);
      const card = document.getElementById('login-card');
      if (card) card.classList.remove('visible');
      applyUser(data.user);
    } catch (e: any) {
      clearTimeout(hint);
      errEl.textContent = e.message || 'Error de autenticación';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Entrar →';
    }
  }

  // ── Forgot password (security question) ──────────────────────────────
  let fpEmail = '';

  function showAuthStep(step: 'login' | 'forgot1' | 'forgot2') {
    const boxes: Record<string, HTMLElement | null> = {
      login: document.getElementById('login-box'),
      forgot1: document.getElementById('forgot-step1'),
      forgot2: document.getElementById('forgot-step2'),
    };
    Object.entries(boxes).forEach(([key, el]) => { if (el) el.style.display = key === step ? '' : 'none'; });
  }

  document.getElementById('forgotPasswordLink')?.addEventListener('click', () => {
    const fpEmailInput = document.getElementById('fp-email') as HTMLInputElement;
    if (fpEmailInput) fpEmailInput.value = (document.getElementById('login-email') as HTMLInputElement)?.value || '';
    showAuthStep('forgot1');
  });
  document.getElementById('fp-back-to-login-1')?.addEventListener('click', () => showAuthStep('login'));
  document.getElementById('fp-back-to-login-2')?.addEventListener('click', () => showAuthStep('login'));

  document.getElementById('fp-continue-btn')?.addEventListener('click', async () => {
    const email = (document.getElementById('fp-email') as HTMLInputElement).value.trim();
    const errEl = document.getElementById('fp-step1-err')!;
    errEl.style.display = 'none';
    if (!email) { errEl.textContent = 'Introduce tu email'; errEl.style.display = 'block'; return; }
    try {
      const res = await fetch(`${API}/auth/forgot-password/question`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'No se pudo continuar');
      fpEmail = email;
      const qEl = document.getElementById('fp-question');
      if (qEl) qEl.textContent = data.question;
      (document.getElementById('fp-answer') as HTMLInputElement).value = '';
      (document.getElementById('fp-new-password') as HTMLInputElement).value = '';
      document.getElementById('fp-step2-err')!.style.display = 'none';
      showAuthStep('forgot2');
    } catch (e: any) {
      errEl.textContent = e.message || 'No se pudo continuar';
      errEl.style.display = 'block';
    }
  });

  document.getElementById('fp-reset-btn')?.addEventListener('click', async () => {
    const answer = (document.getElementById('fp-answer') as HTMLInputElement).value;
    const newPassword = (document.getElementById('fp-new-password') as HTMLInputElement).value;
    const errEl = document.getElementById('fp-step2-err')!;
    errEl.style.display = 'none';
    if (!answer || !newPassword) { errEl.textContent = 'Completa la respuesta y la nueva contraseña'; errEl.style.display = 'block'; return; }
    if (newPassword.length < 8) { errEl.textContent = 'La contraseña debe tener al menos 8 caracteres'; errEl.style.display = 'block'; return; }
    const btn = document.getElementById('fp-reset-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Restableciendo…';
    try {
      const res = await fetch(`${API}/auth/forgot-password/reset`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: fpEmail, answer, new_password: newPassword }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'No se pudo restablecer la contraseña');
      showToast('✓ Contraseña actualizada. Ya puedes iniciar sesión.');
      (document.getElementById('login-email') as HTMLInputElement).value = fpEmail;
      (document.getElementById('login-password') as HTMLInputElement).value = '';
      showAuthStep('login');
    } catch (e: any) {
      errEl.textContent = e.message || 'No se pudo restablecer la contraseña';
      errEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Restablecer contraseña';
    }
  });

  async function init() {
    const token = localStorage.getItem('pc_token');
    if (!token) { showLoginForm(); return; }
    // Show hint if token validation takes long (cold start)
    const hintTimer = setTimeout(() => {
      const msg = document.getElementById('auth-spinner-msg');
      if (msg) msg.textContent = 'Iniciando servidor… puede tardar unos segundos';
    }, 3000);
    try {
      const res = await fetch(`${API}/auth/me`, { headers: { Authorization: `Bearer ${token}` } });
      clearTimeout(hintTimer);
      if (!res.ok) throw new Error('expired');
      const user = await res.json();
      applyUser(user);
    } catch {
      clearTimeout(hintTimer);
      localStorage.removeItem('pc_token');
      showLoginForm('Tu sesión ha expirado. Vuelve a iniciar sesión.');
    }
  }

  // Login form wiring
  document.getElementById('login-btn')?.addEventListener('click', doLogin);
  document.getElementById('login-password')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') doLogin();
  });
  document.getElementById('login-email')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') (document.getElementById('login-password') as HTMLInputElement)?.focus();
  });

  // Industry cards in selector view
  document.querySelectorAll('#industry-selector .industry-card').forEach(card => {
    card.addEventListener('click', () => showDashboard(card.dataset.industry));
  });

  // Industry links in sidebar panel
  document.querySelectorAll('.ind-item').forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      showDashboard(link.dataset.industry);
    });
  });

  // Back to selector
  backBtn.addEventListener('click', showSelector);

  // ── Toast ──────────────────────────────────────────────
  function showToast(msg, duration = 3000) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.add('visible');
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => toast.classList.remove('visible'), duration);
  }

  // ── Dashboard interactivity (init once dashboard is shown) ──
  let dashboardReady = false;

  function initDashboard() {
    if (dashboardReady) return;
    dashboardReady = true;

    initAdminPanel(localStorage.getItem('pc_is_admin') === 'true');

    // 1. Gantt tab switching (Semana / Turno)
    const ganttSemana  = document.getElementById('gantt-semana');
    const ganttTurno   = document.getElementById('gantt-turno');
    const ganttSub     = document.querySelector('.gantt-header__sub');

    document.querySelectorAll('#ganttTabs .tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('#ganttTabs .tab').forEach(t => t.classList.remove('tab--active'));
        tab.classList.add('tab--active');
        const view = tab.dataset.view;
        if (view === 'semana') {
          ganttSemana.style.display = '';
          ganttTurno.style.display  = 'none';
          ganttSub.textContent = '5 recursos · 12 órdenes activas';
        } else {
          ganttSemana.style.display = 'none';
          ganttTurno.style.display  = '';
          const _t = new Date();
          const _dn = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'][_t.getDay()];
          const _mn = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'][_t.getMonth()];
          ganttSub.textContent = `${_dn} ${_t.getDate()} ${_mn} · Vista por horas · T.Mañana 06–14h · T.Tarde 14–22h`;
        }
      });
    });

    // ── COMPOSITES PLANNER ─────────────────────────────────────
    (function initPlannerUI() {
      const plannerBar      = document.getElementById('planner-bar');
      const plannerToggleBtn = document.getElementById('plannerToggleBtn');
      const plannerCloseBtn  = document.getElementById('plannerCloseBtn');
      const altCards         = document.getElementById('planner-alternatives');
      const manualView       = document.getElementById('gantt-manual-view');
      const plannerView      = document.getElementById('gantt-planner-view');
      const spinner          = document.getElementById('plannerSpinner');
      const runBtn           = document.getElementById('runPlannerBtn');
      const ganttSubEl       = document.querySelector('.gantt-header__sub') as HTMLElement;

      let pieceTypesList: any[] = [];
      let selectedAlt: any = null;
      let simGen = 0;  // guards against a stale simulation writing onto a newer set of cards

      // Default week start = nearest Monday
      function getMonday(d: Date): string {
        const day = d.getDay();
        const diff = day === 0 ? -6 : 1 - day;
        const mon = new Date(d);
        mon.setDate(d.getDate() + diff);
        return mon.toISOString().split('T')[0];
      }
      const weekInput = document.getElementById('plannerWeekStart') as HTMLInputElement;
      if (weekInput) weekInput.value = getMonday(new Date());

      // Populate piece type selects from API
      async function loadPieceTypes() {
        const token = localStorage.getItem('pc_token');
        try {
          const res = await fetch(`${API}/api/piece-types`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) pieceTypesList = await res.json();
        } catch (_) {}
        // Also merge any custom types from localStorage
        try {
          const stored = JSON.parse(localStorage.getItem('pc_process_times') || '[]');
          stored.forEach((pt: any) => {
            if (!pieceTypesList.find((p: any) => p.name === pt.name)) {
              pieceTypesList.push({
                name: pt.name,
                atl_hours: pt.atl_hours ?? 4,
                autoclave_hours: pt.autoclave_hours ?? 8,
                ndt_hours: pt.ndt_hours ?? 3,
                cnc_hours: pt.cnc_hours ?? 3,
                workers_atl: pt.workers_atl ?? 1,
                workers_bag: 2, workers_autoclave: 1, workers_ndt: 1, workers_cnc: 1,
                layup_type: 'Custom',
              });
            }
          });
        } catch (_) {}
        ['atl1PieceType','atl2PieceType'].forEach(id => {
          const sel = document.getElementById(id) as HTMLSelectElement;
          if (!sel) return;
          sel.innerHTML = '';
          pieceTypesList.forEach((pt: any) => {
            const opt = document.createElement('option');
            opt.value = pt.name;
            opt.textContent = `${pt.name}${pt.aircraft ? ' ('+pt.aircraft+')' : ''}`;
            sel.appendChild(opt);
          });
        });
        if ((document.getElementById('atl2PieceType') as HTMLSelectElement)?.options.length > 1) {
          (document.getElementById('atl2PieceType') as HTMLSelectElement).selectedIndex = 1;
        }
      }

      // Toggle planner bar on/off
      plannerToggleBtn?.addEventListener('click', async () => {
        const isOpen = plannerBar.style.display !== 'none';
        if (isOpen) return closePlanner();
        plannerBar.style.display = '';
        plannerToggleBtn.classList.add('btn-ui--primary');
        if (pieceTypesList.length === 0) await loadPieceTypes();
      });

      plannerCloseBtn?.addEventListener('click', closePlanner);

      function closePlanner() {
        plannerBar.style.display = 'none';
        altCards.style.display = 'none';
        spinner.classList.remove('active');
        manualView.style.display = '';
        plannerView.style.display = 'none';
        plannerToggleBtn.classList.remove('btn-ui--primary');
        if (ganttSubEl) ganttSubEl.textContent = '5 recursos · 12 órdenes activas';
      }

      // Build PlanRequest body
      function buildPlanRequest(): any {
        const weekStart = (document.getElementById('plannerWeekStart') as HTMLInputElement).value;
        const atl1Type  = (document.getElementById('atl1PieceType') as HTMLSelectElement).value;
        const atl1Qty   = parseInt((document.getElementById('atl1Qty') as HTMLInputElement).value) || 2;
        const atl2Type  = (document.getElementById('atl2PieceType') as HTMLSelectElement).value;
        const atl2Qty   = parseInt((document.getElementById('atl2Qty') as HTMLInputElement).value) || 2;

        // Piece types needed
        const needed = new Set([atl1Type, atl2Type]);
        const piece_types = pieceTypesList
          .filter((pt: any) => needed.has(pt.name))
          .map((pt: any) => ({
            name:              pt.name,
            layup_type:        pt.layup_type || 'Cuasi-isótropo',
            atl_hours:         pt.atl_hours,
            autoclave_hours:   pt.autoclave_hours,
            ndt_hours:         pt.ndt_hours,
            cnc_hours:         pt.cnc_hours,
            workers_atl:       pt.workers_atl ?? 1,
            workers_bag:       pt.workers_bag ?? 2,
            workers_autoclave: pt.workers_autoclave ?? 1,
            workers_ndt:       pt.workers_ndt ?? 1,
            workers_cnc:       pt.workers_cnc ?? 1,
          }));

        // Default specializations from localStorage or fallback 2 workers / shift
        let specializations: any[] = [];
        try {
          const shifts = JSON.parse(localStorage.getItem('pc_shift_schedule') || '[]');
          if (shifts.length >= 3) {
            specializations = [
              { operation: 'atl_layup',  shift1: 2, shift2: 2, shift3: 1 },
              { operation: 'bag_prep',   shift1: 2, shift2: 2, shift3: 1 },
              { operation: 'autoclave',  shift1: 1, shift2: 1, shift3: 1 },
              { operation: 'ndt',        shift1: 1, shift2: 1, shift3: 1 },
              { operation: 'cnc',        shift1: 1, shift2: 1, shift3: 1 },
            ];
          }
        } catch (_) {}
        if (specializations.length === 0) {
          specializations = [
            { operation: 'atl_layup',  shift1: 2, shift2: 2, shift3: 1 },
            { operation: 'bag_prep',   shift1: 2, shift2: 2, shift3: 1 },
            { operation: 'autoclave',  shift1: 1, shift2: 1, shift3: 1 },
            { operation: 'ndt',        shift1: 1, shift2: 1, shift3: 1 },
            { operation: 'cnc',        shift1: 1, shift2: 1, shift3: 1 },
          ];
        }

        return {
          week_start: weekStart,
          atl_assignments: [
            { machine: 'ATL-01', piece_type: atl1Type, quantity: atl1Qty },
            { machine: 'ATL-02', piece_type: atl2Type, quantity: atl2Qty },
          ],
          piece_types,
          specializations,
          maintenance: [],
        };
      }

      // Run planner and show alternatives
      runBtn?.addEventListener('click', async () => {
        const token = localStorage.getItem('pc_token');
        spinner.classList.add('active');
        altCards.style.display = 'none';
        manualView.style.display = 'none';
        plannerView.style.display = 'none';
        runBtn.disabled = true;

        try {
          const body = buildPlanRequest();
          const res = await fetch(`${API}/api/plan/alternatives`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            showToast(`⚠ Error al planificar: ${err.detail || res.status}`);
            manualView.style.display = '';
            return;
          }
          const data = await res.json();
          renderAlternatives(data.alternatives);
          runSimulation(body);
        } catch (e) {
          showToast('⚠ No se pudo conectar con el servidor');
          manualView.style.display = '';
        } finally {
          spinner.classList.remove('active');
          runBtn.disabled = false;
        }
      });

      // Render the 3 alternative cards
      function renderAlternatives(alternatives: any[]) {
        altCards.innerHTML = '';
        alternatives.forEach((alt: any, idx: number) => {
          const s = alt.summary;
          const compColor = s.compliance_pct >= 90 ? '#16A34A' : s.compliance_pct >= 75 ? '#D97706' : '#DC2626';
          const warnings = [...s.warnings, ...s.qualification_alerts].slice(0, 3);
          const card = document.createElement('div');
          card.className = 'alt-card';
          card.innerHTML = `
            <div class="alt-card__header">
              <span class="alt-card__badge">${s.badge}</span>
              <span class="alt-card__label">${s.label}</span>
            </div>
            <div class="alt-card__desc">${s.description}</div>
            <div class="alt-card__kpis">
              <div class="alt-kpi"><span class="alt-kpi__val" style="color:${compColor}">${s.compliance_pct}%</span><span class="alt-kpi__key">Cumplimiento OTD</span></div>
              <div class="alt-kpi"><span class="alt-kpi__val">${s.pieces_scheduled}/${s.pieces_total}</span><span class="alt-kpi__key">Piezas prog.</span></div>
              <div class="alt-kpi"><span class="alt-kpi__val">${s.atl_saturation_pct}%</span><span class="alt-kpi__key">Sat. ATL</span></div>
              <div class="alt-kpi"><span class="alt-kpi__val">${s.autoclave_saturation_pct}%</span><span class="alt-kpi__key">Sat. Autoclave</span></div>
            </div>
            ${warnings.length ? `<div class="alt-card__warnings">${warnings.map((w: string) => `<div>${w}</div>`).join('')}</div>` : ''}
          `;
          card.addEventListener('click', () => {
            document.querySelectorAll('.alt-card').forEach(c => c.classList.remove('alt-card--selected'));
            card.classList.add('alt-card--selected');
            selectedAlt = alt;
            renderPlannerGantt(alt);
          });
          // Auto-select the equilibrado one (index 1)
          if (idx === 1) {
            card.classList.add('alt-card--selected');
            selectedAlt = alt;
          }
          altCards.appendChild(card);
        });
        altCards.style.display = '';
        // Auto-render the recommended (equilibrado) alternative
        if (alternatives[1]) renderPlannerGantt(alternatives[1]);
      }

      // ── Monte Carlo robustness prediction ──────────────────────
      // Runs right after the 3 alternative cards render. Calls /api/plan/simulate
      // with the same PlanRequest body and appends a robustness block to each
      // card (matched by label). Silent no-op if the endpoint isn't reachable.
      async function runSimulation(planBody: any) {
        const gen = ++simGen;
        const token = localStorage.getItem('pc_token');
        altCards.querySelectorAll('.alt-card').forEach((c: any) => {
          if (c.querySelector('.alt-card__sim')) return;
          const el = document.createElement('div');
          el.className = 'alt-card__sim alt-card__sim--loading';
          el.textContent = 'Simulando robustez (Monte Carlo)…';
          c.appendChild(el);
        });
        try {
          const res = await fetch(`${API}/api/plan/simulate`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(planBody),
          });
          if (gen !== simGen) return;
          if (!res.ok) throw new Error('simulate ' + res.status);
          const sim = await res.json();
          renderPredictions(sim);
        } catch (e) {
          if (gen === simGen) altCards.querySelectorAll('.alt-card__sim').forEach((el: any) => el.remove());
        }
      }

      function renderPredictions(sim: any) {
        const byLabel: Record<string, any> = {};
        (sim.alternatives || []).forEach((a: any) => { byLabel[a.label] = a.prediction; });
        altCards.querySelectorAll('.alt-card').forEach((card: any) => {
          const label  = (card.querySelector('.alt-card__label')?.textContent || '').trim();
          const holder = card.querySelector('.alt-card__sim');
          const p = byLabel[label];
          if (!holder) return;
          if (!p) { holder.remove(); return; }
          const score = p.robustness_score;
          const color = score >= 80 ? '#16A34A' : score >= 55 ? '#D97706' : '#DC2626';
          const pc = p.pieces_completed || {};
          const mk = p.makespan_shifts  || {};
          holder.className = 'alt-card__sim';
          holder.innerHTML = `
            <div class="alt-sim__head">
              <span class="alt-sim__title">Robustez Monte Carlo</span>
              <span class="alt-sim__score" style="color:${color}">${score}<span>/100</span></span>
            </div>
            <div class="alt-sim__bar"><div style="width:${Math.max(2, score)}%;background:${color}"></div></div>
            <div class="alt-sim__rows">
              <div><span>Prob. dentro de plazo</span><b>${Math.round((p.within_horizon_probability || 0) * 100)}%</b></div>
              <div><span>Piezas completas · P50 / P10</span><b>${pc.p50 ?? '–'} / ${pc.p10 ?? '–'}</b></div>
              <div><span>Duración turnos · P50 / P90</span><b>${mk.p50 ?? '–'} / ${mk.p90 ?? '–'}</b></div>
              <div><span>Exceso esperado</span><b>${p.expected_overflow ?? 0}</b></div>
            </div>
            <div class="alt-sim__foot">${sim.iterations} iteraciones Monte Carlo</div>
          `;
        });
      }

      // Render the composites planner Gantt
      function renderPlannerGantt(alt: any) {
        const RESOURCES = ['ATL-01', 'ATL-02', 'AUTOCLAVE', 'NDT', 'CNC', 'WORKERS'];
        const RES_LABELS: Record<string, string> = {
          'ATL-01': 'Máquina ATL', 'ATL-02': 'Máquina ATL',
          'AUTOCLAVE': 'Curado',   'NDT': 'Ultrasonidos',
          'CNC': 'Recorte CNC',   'WORKERS': 'Operarios',
        };
        const weekDays: string[] = alt.week_days;
        const events: any[] = alt.events;

        // Build day header (uses same 21-col grid; each day cell spans 3)
        const dayHeader = document.getElementById('pg-day-header') as HTMLElement;
        dayHeader.innerHTML = `<div class="pg-corner" style="grid-column:1"><span>Recurso</span></div>`;
        weekDays.forEach((d: string, i: number) => {
          const col = 2 + i * 3;
          dayHeader.innerHTML += `<div class="pg-day-cell" style="grid-column:${col}/span 3">${d}</div>`;
        });

        // Build shift header
        const shiftHeader = document.getElementById('pg-shift-header') as HTMLElement;
        shiftHeader.innerHTML = `<div class="pg-corner" style="border-bottom:none"></div>`;
        for (let d = 0; d < 7; d++) {
          for (let s = 1; s <= 3; s++) {
            const isEod = s === 3 && d < 6;
            shiftHeader.innerHTML += `<div class="pg-shift-cell${isEod ? ' pg-shift-cell--eod' : ''}">T${s}</div>`;
          }
        }

        // Build resource rows
        const rowsContainer = document.getElementById('pg-rows') as HTMLElement;
        rowsContainer.innerHTML = '';
        RESOURCES.forEach((res: string) => {
          const resEvents = events.filter((e: any) => e.resource === res);
          const row = document.createElement('div');
          row.className = 'pg-resource-row';

          const label = document.createElement('div');
          label.className = 'pg-res-label';
          label.innerHTML = `<div><div class="pg-res-name">${res}</div><div class="pg-res-type">${RES_LABELS[res] || ''}</div></div>`;
          row.appendChild(label);

          const timeline = document.createElement('div');
          timeline.className = 'pg-timeline';

          // Background cells (21)
          for (let i = 0; i < 21; i++) {
            const cell = document.createElement('div');
            const isEod = (i + 1) % 3 === 0 && i < 20;
            cell.className = 'pg-cell' + (isEod ? ' pg-cell--eod' : '');
            cell.style.cssText = `grid-column:${i+1};grid-row:1`;
            timeline.appendChild(cell);
          }

          // Events
          resEvents.forEach((ev: any) => {
            const col = ev.day * 3 + (ev.shift - 1) + 1;
            const span = ev.duration_shifts;
            if (col < 1 || col > 21) return;
            const el = document.createElement('div');
            el.className = 'pg-event';
            el.style.cssText = `grid-column:${col}/span ${Math.min(span, 22-col)};grid-row:1;background:${ev.color}22;border-left:3px solid ${ev.color};color:${ev.color}`;
            el.innerHTML = `<span class="pg-event-title">${ev.title}</span><span class="pg-event-sub">${ev.subtitle}</span>`;
            el.title = `${ev.title} · ${ev.subtitle}\nDía ${ev.day+1} · Turno ${ev.shift} · ${ev.duration_shifts} turno(s)`;
            timeline.appendChild(el);
          });

          if (resEvents.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'pg-empty';
            empty.style.cssText = 'grid-column:1/span 21;grid-row:1';
            empty.textContent = 'Sin actividad esta semana';
            timeline.appendChild(empty);
          }

          row.appendChild(timeline);
          rowsContainer.appendChild(row);
        });

        // Update subtitle
        if (ganttSubEl) ganttSubEl.textContent = `${alt.summary.label} · ${alt.week_label} · ${alt.summary.pieces_scheduled} piezas`;
        manualView.style.display = 'none';
        plannerView.style.display = '';
      }
    })();

    // 2. Drag & drop helpers (reusable for static + dynamic blocks)
    let draggedBlock = null;

    function initGanttBlock(block) {
      // Wrap text in .gb-text span if not already done
      if (!block.querySelector('.gb-text')) {
        const text = block.textContent.trim();
        block.textContent = '';
        const span = document.createElement('span');
        span.className = 'gb-text';
        span.textContent = text;
        block.appendChild(span);
      }

      // Add resize handle if not already present
      if (!block.querySelector('.gantt-resize')) {
        const handle = document.createElement('div');
        handle.className = 'gantt-resize';
        block.appendChild(handle);

        handle.addEventListener('mousedown', e => {
          e.preventDefault();
          e.stopPropagation();
          const startX   = e.clientX;
          const startW   = block.offsetWidth;
          const cellW    = block.parentElement ? block.parentElement.offsetWidth : 200;
          const startPct = parseFloat(block.style.width) || (startW / cellW * 100);

          function onMove(ev) {
            const dx = ev.clientX - startX;
            const newPct = Math.max(10, startPct + dx / cellW * 100);
            block.style.width = newPct + '%';
          }
          function onUp() {
            document.removeEventListener('mousemove', onMove);
            document.removeEventListener('mouseup', onUp);
          }
          document.addEventListener('mousemove', onMove);
          document.addEventListener('mouseup', onUp);
        });
      }

      block.setAttribute('draggable', 'true');
      block.addEventListener('dragstart', e => {
        if (e.target.classList.contains('gantt-resize')) { e.preventDefault(); return; }
        draggedBlock = block;
        e.dataTransfer.effectAllowed = 'move';
        setTimeout(() => block.classList.add('dragging'), 0);
      });
      block.addEventListener('dragend', () => {
        block.classList.remove('dragging');
        document.querySelectorAll('.gantt-cell').forEach(c => c.classList.remove('drop-target', 'drop-target--invalid'));
        draggedBlock = null;
      });
    }

    function initTurnoBlock(block) {
      block.setAttribute('draggable', 'true');
      block.addEventListener('dragstart', e => {
        draggedBlock = block;
        e.dataTransfer.effectAllowed = 'move';
        setTimeout(() => block.classList.add('dragging'), 0);
      });
      block.addEventListener('dragend', () => {
        block.classList.remove('dragging');
        document.querySelectorAll('.turno-track').forEach(t => t.classList.remove('drop-target'));
        draggedBlock = null;
      });
    }

    document.querySelectorAll('.gantt-block').forEach(b => initGanttBlock(b));

    document.querySelectorAll('.gantt-cell').forEach(cell => {
      cell.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; cell.classList.add('drop-target'); });
      cell.addEventListener('dragleave', e => { if (!cell.contains(e.relatedTarget)) cell.classList.remove('drop-target', 'drop-target--invalid'); });
      cell.addEventListener('drop', e => {
        e.preventDefault();
        cell.classList.remove('drop-target', 'drop-target--invalid');
        if (!draggedBlock) return;
        if (draggedBlock.parentElement === cell) return;
        cell.appendChild(draggedBlock);
        // Update recurso if moved to a different row
        const newRow = cell.closest('.gantt-row[data-resource]');
        if (newRow && draggedBlock.dataset.recurso !== newRow.dataset.resource) {
          draggedBlock.dataset.recurso = newRow.dataset.resource;
        }
        showToast('Orden replanificada manualmente · Plan actualizado');
      });
    });

    document.querySelectorAll('.turno-block').forEach(b => initTurnoBlock(b));

    document.querySelectorAll('.turno-track').forEach(track => {
      track.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; track.classList.add('drop-target'); });
      track.addEventListener('dragleave', e => { if (!track.contains(e.relatedTarget)) track.classList.remove('drop-target'); });
      track.addEventListener('drop', e => {
        e.preventDefault();
        track.classList.remove('drop-target');
        if (!draggedBlock || !draggedBlock.classList.contains('turno-block')) return;
        if (draggedBlock.parentElement === track) return;
        track.appendChild(draggedBlock);
        showToast('Orden reasignada · Turno actualizado');
      });
    });

    // 8. Nav panel switching
    document.querySelectorAll('[data-panel]').forEach(item => {
      item.addEventListener('click', e => {
        e.preventDefault();
        const panel = item.dataset.panel;
        document.querySelectorAll('.nav-item[data-panel]').forEach(n => n.classList.remove('nav-item--active'));
        item.classList.add('nav-item--active');
        document.querySelectorAll('.dash-panel').forEach(p => p.style.display = 'none');
        const target = document.getElementById('panel-' + panel);
        if (target) target.style.display = '';
        closeMobileSidebar();
      });
    });

    // 8a-bis. Weekly calendar — keep the "Planificación semanal" grid on the real current week
    (function refreshWeeklyCalendar() {
      const DOW    = ['LUN', 'MAR', 'MIÉ', 'JUE', 'VIE'];
      const MONTHS = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
      const now = new Date();
      const wd  = now.getDay();                 // 0=Sun … 6=Sat
      const monday = new Date(now);
      monday.setDate(now.getDate() + (wd === 0 ? -6 : 1 - wd));
      const days = Array.from({ length: 5 }, (_, i) => {
        const d = new Date(monday);
        d.setDate(monday.getDate() + i);
        return d;
      });
      const todayIdx = (wd >= 1 && wd <= 5) ? wd - 1 : -1;

      document.querySelectorAll('#gantt-semana .gantt-days .gantt-day').forEach((cell, i) => {
        if (!days[i]) return;
        const isToday = i === todayIdx;
        cell.classList.toggle('gantt-day--today', isToday);
        cell.textContent = `${DOW[i]} ${days[i].getDate()}${isToday ? ' ●' : ''}`;
      });

      const a = days[0], b = days[4];
      const range = a.getMonth() === b.getMonth()
        ? `${a.getDate()}–${b.getDate()} ${MONTHS[b.getMonth()]} ${b.getFullYear()}`
        : `${a.getDate()} ${MONTHS[a.getMonth()]} – ${b.getDate()} ${MONTHS[b.getMonth()]} ${b.getFullYear()}`;
      const sub = document.querySelector('#panel-gantt .page-header__sub');
      if (sub) sub.textContent = `${range} · Turno mañana + tarde`;
    })();

    // 8a. Alerts panel — filters, actions, dismiss
    function updateAlertCount() {
      const rows = document.querySelectorAll('#alertList .alert-row:not(.alert-row--resolved)');
      const total = rows.length;
      const alta  = document.querySelectorAll('#alertList .alert-row:not(.alert-row--resolved) [data-sev="alta"], #alertList .alert-row[data-sev="alta"]:not(.alert-row--resolved)').length;
      const subtitleEl = document.getElementById('alertSubtitle');
      const countEl    = document.getElementById('alertCount');
      if (subtitleEl) subtitleEl.textContent = `${total} alerta${total !== 1 ? 's' : ''} · ${document.querySelectorAll('#alertList .alert-row[data-sev="alta"]:not(.alert-row--resolved)').length} de prioridad alta`;
      if (countEl)    countEl.textContent    = `${total} alerta${total !== 1 ? 's' : ''} activas`;
      // Update sidebar badge
      const sidebarBadge = document.querySelector('.nav-item[data-panel="alertas"] .nav-badge');
      if (sidebarBadge) sidebarBadge.textContent = total;
    }

    function resolveAlertRow(row) {
      if (row.classList.contains('alert-row--resolved')) return;
      // Close detail if open
      const detail = row.nextElementSibling;
      if (detail && detail.classList.contains('alert-detail')) detail.classList.remove('open');
      // Replace action with resolved chip
      const action = row.querySelector('.alert-action');
      if (action) { action.outerHTML = '<span class="alert-resolved-chip">✓ Resuelta</span>'; }
      row.querySelector('.alert-dismiss') && (row.querySelector('.alert-dismiss').style.display = 'none');
      row.classList.add('alert-row--resolved');
      updateAlertCount();
    }

    // Filter chips
    document.querySelectorAll('.alert-filter-bar .chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.alert-filter-bar .chip').forEach(c => c.classList.remove('chip--active'));
        chip.classList.add('chip--active');
        const sev = chip.dataset.sev;
        document.querySelectorAll('#alertList .alert-row').forEach(row => {
          const detail = row.nextElementSibling;
          const show = sev === 'todas' || row.dataset.sev === sev;
          row.style.display = show ? '' : 'none';
          if (detail && detail.classList.contains('alert-detail')) detail.style.display = show ? '' : 'none';
        });
      });
    });

    // Action buttons
    document.querySelectorAll('#alertList .alert-action').forEach(btn => {
      btn.addEventListener('click', e => {
        const row    = btn.closest('.alert-row');
        const action = row.dataset.action;
        const detail = row.nextElementSibling;

        if (action === 'gantt') {
          document.querySelector('.nav-item[data-panel="gantt"]').click();
          showToast('Gantt abierto · Revisa la asignación de OF-2041');
        } else if (action === 'ordenes') {
          document.querySelector('.nav-item[data-panel="ordenes"]').click();
          showToast('Abriendo Órdenes de fabricación');
        } else if (action === 'capacidad') {
          document.querySelector('.nav-item[data-panel="capacidad"]').click();
          showToast('Abriendo panel de Capacidad');
        } else if (action === 'confirmar') {
          btn.textContent = 'Confirmando…';
          btn.style.opacity = '.6';
          setTimeout(() => resolveAlertRow(row), 900);
          showToast('✓ Mantenimiento CNC-1 confirmado · Notificación enviada a M. García');
        } else if (action === 'detalles') {
          if (detail && detail.classList.contains('alert-detail')) {
            detail.classList.toggle('open');
            btn.textContent = detail.classList.contains('open') ? 'Ocultar' : 'Ver detalles';
          }
        }
      });
    });

    // Detail expand on row click (except on buttons)
    document.querySelectorAll('#alertList .alert-row').forEach(row => {
      row.style.cursor = 'pointer';
      row.addEventListener('click', e => {
        if (e.target.closest('button, .alert-action')) return;
        const detail = row.nextElementSibling;
        if (detail && detail.classList.contains('alert-detail')) {
          detail.classList.toggle('open');
        }
      });
    });

    // Dismiss buttons
    document.querySelectorAll('#alertList .alert-dismiss').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        resolveAlertRow(btn.closest('.alert-row'));
      });
    });

    // Resolve all
    const resolveAllBtn = document.getElementById('resolveAllAlerts');
    resolveAllBtn && resolveAllBtn.addEventListener('click', () => {
      document.querySelectorAll('#alertList .alert-row:not(.alert-row--resolved)').forEach(row => resolveAlertRow(row));
      showToast('✓ Todas las alertas marcadas como resueltas');
    });

    // 8b. Scenarios panel — apply / switch
    document.querySelectorAll('#panel-escenarios .scenario-card button').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (btn.disabled) return;
        const card = btn.closest('.scenario-card');
        const badge = card.querySelector('.scenario-badge');
        const scenarioName = badge.childNodes[0].textContent.trim();

        const origText = btn.textContent.trim();
        btn.disabled = true;
        btn.innerHTML = `<svg class="spin-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Aplicando…`;

        await new Promise(r => setTimeout(r, 1400));

        // Reset all cards to inactive
        document.querySelectorAll('#panel-escenarios .scenario-card').forEach(c => {
          c.classList.remove('scenario-card--active');
          const b = c.querySelector('button');
          b.className = 'btn-ui';
          b.style.cssText = 'width:100%;justify-content:center';
          b.disabled = false;
          b.textContent = 'Aplicar escenario';
          const chip = c.querySelector('.scenario-active-chip');
          if (chip) chip.remove();
