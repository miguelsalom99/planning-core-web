              <span class="cap-pct cap-pct--ok">78%</span>
            </div>
            <div class="cap-row">
              <span class="cap-name">CNC-2</span>
              <div class="cap-track"><div class="cap-fill cap-fill--over" style="width:96%"></div></div>
              <span class="cap-pct cap-pct--over">96%</span>
