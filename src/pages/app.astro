        (document.getElementById('au-email') as HTMLInputElement).value = u?.email || '';
        (document.getElementById('au-password') as HTMLInputElement).value = '';
        (document.getElementById('au-role') as HTMLSelectElement).value = u?.is_admin ? 'true' : 'false';
        (document.getElementById('au-company-id') as HTMLSelectElement).value = u?.company_id ? String(u.company_id) : '';
