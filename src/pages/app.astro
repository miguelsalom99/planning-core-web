<script>
  import * as XLSX from 'xlsx';
  const API = 'https://composite-replanning-api.vercel.app';
  const TENANT_LOGOS: Record<string, string> = {
    'Aernnova': 'data:image/png;base64,',
  };

  // ═══════════════════════════════════════════════════════════════
  //  SETTINGS + i18n  (Configuración panel)
  //  Preferences live in localStorage 'pc_settings' — per browser.
  // ═══════════════════════════════════════════════════════════════
  const GB_DEFAULTS: Record<string, string> = {
    blue: '#1B3F8B', teal: '#0891B2', green: '#16A34A',
    amber: '#D97706', purple: '#7C3AED', gray: '#64748B',
  };
  const SETTINGS_LS = 'pc_settings';

  function getSettings(): any {
    let s: any = {};
    try { s = JSON.parse(localStorage.getItem(SETTINGS_LS) || '{}') || {}; } catch (_) {}
    if (!s.theme) {
      const legacy = (() => { try { return localStorage.getItem('theme'); } catch (_) { return null; } })();
      s.theme = legacy === 'dark' ? 'dark' : legacy === 'light' ? 'light' : 'system';
    }
    if (s.lang !== 'en') s.lang = 'es';
    if (s.density !== 'compact') s.density = 'comfortable';
    if (!s.startPanel) s.startPanel = 'gantt';
    if (!s.cellColors || typeof s.cellColors !== 'object') s.cellColors = {};
    return s;
  }
  function saveSettings(patch: any) {
    const next = Object.assign(getSettings(), patch);
