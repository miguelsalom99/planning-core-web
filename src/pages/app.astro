  // ── Module access ────────────────────────────────────────────────────────
  // Mirrors the API's effective access (`user.modules` from /auth/me: the
  // company's contract, intersected with admin grants for standard users).
  // This is UX only — every gated endpoint re-checks server-side and 403s.
  // Panels not listed here are denied, so a new panel must be mapped to show.
  const PANEL_MODULE: Record<string, string | null> = {
    gantt: 'gantt', historial: 'gantt', alertas: 'gantt',
    capacidad: 'capacity', escenarios: 'scenarios', plantmap: 'plant_map',
    ordenes: 'orders', recursos: 'resources', kpis: 'kpis',
