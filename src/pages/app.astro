---
// App shell — standalone, no BaseLayout
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Planning Core · App</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Anti-flicker: apply saved theme / density / language before first paint -->
  <script>
    (function(){
      try {
        var s = {};
        try { s = JSON.parse(localStorage.getItem('pc_settings') || '{}') || {}; } catch(e){}
        // migrate legacy standalone theme key
        if (!s.theme && localStorage.getItem('theme')) s.theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        var theme = s.theme || 'system';
        var dark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.setAttribute('data-theme','dark');
        else document.documentElement.setAttribute('data-theme','light');
        if (s.density === 'compact') document.documentElement.setAttribute('data-density','compact');
        document.documentElement.lang = s.lang === 'en' ? 'en' : 'es';
        var c = s.cellColors || {};
        ['blue','teal','green','amber','purple','gray'].forEach(function(k){
          if (c[k]) document.documentElement.style.setProperty('--gb-' + k, c[k]);
        });
      } catch(e){}
    })();
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:      #0B1C3A;
      --navy-mid:  #112347;
      --navy-dark: #060F20;
      --brand:     #1B3F8B;
      --brand-lt:  #2651B2;
      --silver:    #8BC2C6;
      --n90:       #F0F4FA;
      --n80:       #D4DDE8;
      --n50:       #8898AA;
      --n30:       #4A5060;
      --n20:       #1E293B;
      --white:     #ffffff;
      --green:     #16A34A;
      --green-bg:  #DCFCE7;
      --amber:     #D97706;
      --amber-bg:  #FEF3C7;
      --red:       #DC2626;
      --red-bg:    #FEE2E2;
      /* Gantt status colours — overridable from Configuración (localStorage pc_settings.cellColors) */
      --gb-blue:   #1B3F8B;
      --gb-teal:   #0891B2;
      --gb-green:  #16A34A;
      --gb-amber:  #D97706;
      --gb-purple: #7C3AED;
      --gb-gray:   #64748B;
      --sidebar-w: 228px;
      --topbar-h:  56px;
      --radius:    8px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --shadow-sm: 0 1px 2px rgba(11,28,58,.06), 0 1px 3px rgba(11,28,58,.08);
      --shadow:    0 2px 8px rgba(11,28,58,.08), 0 1px 2px rgba(11,28,58,.05);
      --shadow-md: 0 4px 16px rgba(11,28,58,.10);
      --transition: .15s cubic-bezier(.4,0,.2,1);
    }

    /* ── DARK THEME ── */
    [data-theme="dark"] {
      --white:     #1E293B;
      --n90:       #0F172A;
      --n80:       #334155;
      --n50:       #94A3B8;
      --n30:       #CBD5E1;
      --n20:       #F1F5F9;
      /* --navy intentionally NOT overridden: used as topbar BG, stays dark */
      --green-bg:  rgba(22,163,74,.18);
      --amber-bg:  rgba(217,119,6,.18);
      --red-bg:    rgba(220,38,38,.18);
      --shadow-sm: 0 1px 2px rgba(0,0,0,.5), 0 1px 3px rgba(0,0,0,.6);
      --shadow:    0 2px 8px rgba(0,0,0,.5), 0 1px 2px rgba(0,0,0,.4);
      --shadow-md: 0 4px 16px rgba(0,0,0,.65);
    }

    /* ── Navy-as-text → must be light in dark mode ── */
    [data-theme="dark"] .page-header__left h1,
    [data-theme="dark"] .kpi-card__val,
    [data-theme="dark"] .gantt-header__title,
    [data-theme="dark"] .res-name,
    [data-theme="dark"] .pg-res-name,
    [data-theme="dark"] .modal__title,
    [data-theme="dark"] .panel-page-title,
    [data-theme="dark"] .alt-card__label,
    [data-theme="dark"] .time-section-title,
    [data-theme="dark"] .mrp-dropzone__title,
    [data-theme="dark"] .cap-card__name,
    [data-theme="dark"] .res-card__name,
    [data-theme="dark"] .scenario-card__title,
    [data-theme="dark"] .industry-card__name,
    [data-theme="dark"] .selector-header h2 { color: var(--n20); }

    /* ── Industry selector ── */
    [data-theme="dark"] .badge--available { background: rgba(255,255,255,.07); color: var(--n50); }
    [data-theme="dark"] .industry-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.4); }

    /* ── Sidebar scorecard & section labels ── */
    [data-theme="dark"] .sc-name { color: var(--n50); }
    [data-theme="dark"] .sc-row { border-color: var(--n80); }

    /* ── Hardcoded light borders in planner → dark ── */
    [data-theme="dark"] .pg-shift-cell { border-color: rgba(255,255,255,.06); }
    [data-theme="dark"] .pg-cell { border-color: rgba(255,255,255,.06); }

    /* ── Alert & history banners ── */
    [data-theme="dark"] .alert-banner { background: rgba(217,119,6,.1); border-color: rgba(217,119,6,.3); border-left-color: var(--amber); }
    [data-theme="dark"] .alert-banner__body { color: #FDE68A; }
    [data-theme="dark"] .alert-banner__body strong { color: #FDE68A; }
    [data-theme="dark"] .alert-banner__cta { background: rgba(217,119,6,.15); border-color: rgba(217,119,6,.35); color: #FDE68A; }
    [data-theme="dark"] .hist-banner { background: rgba(27,63,139,.2); border-color: rgba(27,63,139,.4); }
    [data-theme="dark"] .hist-banner__body { color: #93C5FD; }
    [data-theme="dark"] .hist-banner__icon { background: rgba(27,63,139,.4); }
    [data-theme="dark"] .hist-banner__cta { background: rgba(27,63,139,.3); border-color: rgba(27,63,139,.5); color: #93C5FD; }

    /* ── Dropdowns & popovers ── */
    [data-theme="dark"] .settings-dropdown { background: #1E293B; border-color: #334155; }
    [data-theme="dark"] .settings-dropdown__item:hover { background: rgba(255,255,255,.06); }
    [data-theme="dark"] .settings-dropdown__divider { background: #334155; }
    [data-theme="dark"] .filter-dropdown { background: #1E293B; border-color: #334155; }
    [data-theme="dark"] .filter-section__label { color: #7E96B3; }
    [data-theme="dark"] .block-popover__head { border-color: #334155; }
    [data-theme="dark"] .bp-of-input { color: #F1F5F9; }
    [data-theme="dark"] .bp-of-input:focus { background: rgba(255,255,255,.06); }
    [data-theme="dark"] .bp-input { background: #0F172A; border-color: #334155; color: #F1F5F9; }
    [data-theme="dark"] .bp-footer { border-color: #334155; }

    /* ── Modals & forms ── */
    [data-theme="dark"] .modal-backdrop { background: rgba(0,0,0,.75); }
    [data-theme="dark"] .form-input,
    [data-theme="dark"] .form-select { background: #0F172A; border-color: #334155; color: #F1F5F9; }
    [data-theme="dark"] .planner-bar input,
    [data-theme="dark"] .planner-bar select { background: #0F172A; border-color: #334155; color: #F1F5F9; }
    [data-theme="dark"] .time-input,
    [data-theme="dark"] .time-hm,
    [data-theme="dark"] .time-name-input { background: #0F172A; border-color: #334155; color: #F1F5F9; }

    /* ── Nav & sidebar ── */
    [data-theme="dark"] .nav-item--danger:hover { background: rgba(220,38,38,.15); }
    [data-theme="dark"] .scorecard { background: rgba(255,255,255,.04); border-color: #334155; }
    [data-theme="dark"] .scorecard__title { color: #7E96B3; }

    /* ── Gantt specifics ── */
    [data-theme="dark"] .gantt-cell--today { background: rgba(27,63,139,.12); }
    [data-theme="dark"] .gantt-day--today  { background: rgba(27,63,139,.2); }
    [data-theme="dark"] .gantt-grid__corner { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .gantt-days { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .planner-bar { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .alt-cards { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .pg-shift-header-row { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .pg-day-header-row { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .turno-hour-header { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .turno-hour-cell--now { background: rgba(27,63,139,.2); }
    [data-theme="dark"] .turno-empty-text { color: #475569; }

    /* ── Tables ── */
    [data-theme="dark"] .mrp-table th { background: rgba(255,255,255,.04); color: #94A3B8; }
    [data-theme="dark"] .mrp-table td { border-color: #334155; }
    [data-theme="dark"] .mrp-table tr:hover td { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .mrp-table-wrap { border-color: #334155; }
    [data-theme="dark"] .mrp-dropzone { background: rgba(255,255,255,.02); border-color: #334155; }
    [data-theme="dark"] .mrp-dropzone:hover,
    [data-theme="dark"] .mrp-dropzone.drag-over { background: rgba(27,63,139,.15); border-color: var(--brand); }

    /* ── Hardcoded light backgrounds ── */
    [data-theme="dark"] .industries-panel { background: rgba(255,255,255,.03); }
    [data-theme="dark"] .alert-detail { background: rgba(255,255,255,.03); }

    /* ── Hardcoded dark text → invisible on dark bg ── */
    [data-theme="dark"] .alert-banner__body,
    [data-theme="dark"] .alert-banner__body strong,
    [data-theme="dark"] .alert-banner__cta { color: #FDE68A; }
    [data-theme="dark"] .cap-pill--warn { color: #FDE68A; }
    [data-theme="dark"] .alert-sev--media { color: #FDE68A; background: rgba(217,119,6,.18); }
    [data-theme="dark"] .admin-badge--admin { background: rgba(217,119,6,.15); color: #FDE68A; }

    /* ── Toast — needs contrast on dark page ── */
    [data-theme="dark"] .toast { background: #334155; box-shadow: 0 4px 24px rgba(0,0,0,.5); }

    /* ── nav danger hover ── */
    [data-theme="dark"] .nav-item--danger:hover { background: rgba(220,38,38,.15); color: var(--red); }

    html, body {
      height: 100%;
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px;
      color: var(--n20);
      background: var(--n90);
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }

    /* ───── LAYOUT ───── */
    .app-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* ───── TOPBAR ───── */
    .topbar {
      height: var(--topbar-h);
      background: var(--navy);
      display: flex;
      align-items: center;
      padding: 0 1rem 0 0;
      gap: 0;
      flex-shrink: 0;
      border-bottom: 1px solid rgba(255,255,255,.06);
      position: relative;
      z-index: 100;
    }

    .topbar__brand {
      width: var(--sidebar-w);
      display: flex;
      align-items: center;
      gap: .6rem;
      padding: 0 1rem;
      flex-shrink: 0;
      border-right: 1px solid rgba(255,255,255,.07);
      height: 100%;
    }
    .topbar__brand img {
      height: 26px;
      width: 26px;
      object-fit: cover;
      border-radius: 6px;
    }
    .topbar__brand-name {
      font-size: .88rem;
      font-weight: 400;
      color: rgba(255,255,255,.75);
      letter-spacing: -.01em;
    }
    .topbar__brand-name strong {
      font-weight: 700;
      color: #fff;
    }

    .topbar__center {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0 1.25rem;
    }

    .back-btn {
      display: flex;
      align-items: center;
      gap: .35rem;
      font-size: .78rem;
      font-weight: 500;
      color: rgba(255,255,255,.55);
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: .3rem .5rem;
      border-radius: 6px;
      transition: all .15s;
      white-space: nowrap;
    }
    .back-btn:hover { color: rgba(255,255,255,.9); background: rgba(255,255,255,.07); }
    .back-btn svg { flex-shrink: 0; }
    .back-btn.hidden, .back-sep.hidden { display: none; }

    .topbar__sep {
      width: 1px;
      height: 18px;
      background: rgba(255,255,255,.1);
    }

    /* Phase 1: persistent context breadcrumb (Industry / Company / Plant / Section) */
    .ctx-bar { display: flex; align-items: center; gap: .3rem; min-width: 0; }
    .ctx-bar[hidden], .ctx-menu[hidden] { display: none !important; }
    .ctx-arrow { color: rgba(255,255,255,.28); font-size: .8rem; }
    .ctx-seg { font-size: .78rem; color: rgba(255,255,255,.72); white-space: nowrap; max-width: 15ch; overflow: hidden; text-overflow: ellipsis; }
    .ctx-seg--static { font-weight: 500; }
    .ctx-seg--pick { display: inline-flex; align-items: center; gap: .25rem; background: transparent; border: 1px solid transparent; border-radius: 6px; padding: .2rem .45rem; cursor: pointer; font-weight: 600; color: rgba(255,255,255,.88); position: relative; font-family: inherit; }
    .ctx-seg--pick:hover { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.12); }
    .ctx-seg--pick svg { opacity: .55; flex-shrink: 0; }
    .ctx-menu { position: absolute; top: calc(100% + 6px); left: 0; min-width: 190px; max-height: 320px; overflow-y: auto; background: var(--white); border: 1px solid var(--n90); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.18); z-index: 650; padding: .3rem; text-align: left; }
    .ctx-opt { padding: .5rem .6rem; font-size: .8rem; color: var(--n20); border-radius: 5px; cursor: pointer; white-space: nowrap; }
    .ctx-opt:hover { background: var(--n95); }
    .ctx-opt--active { font-weight: 600; color: var(--brand); }
    [data-theme="dark"] .ctx-menu { background: #1E293B; border-color: #334155; }
    [data-theme="dark"] .ctx-opt { color: #E2E8F0; }
    [data-theme="dark"] .ctx-opt:hover { background: rgba(255,255,255,.06); }
    @media (max-width: 860px) { .ctx-seg--static, .ctx-bar .ctx-arrow:first-of-type, .ctx-bar > .ctx-seg--static + .ctx-arrow { display: none; } }

    /* Plant Map module */
    .pm-toolbar { display: flex; gap: .4rem; align-items: center; }
    .pm-toolbar .btn-ui { padding: .35rem .6rem; }
    .pm-layout { display: flex; gap: 14px; height: 560px; margin-top: 14px; }
    .pm-canvas-wrap { flex: 1; position: relative; background: var(--n95); border: 1px solid var(--n90); border-radius: 12px; overflow: hidden; }
    #pmCanvas { width: 100%; height: 100%; display: block; cursor: grab; touch-action: none; }
    #pmCanvas.pm-grabbing { cursor: grabbing; }
    .pm-panel { width: 288px; flex: none; background: var(--white); border: 1px solid var(--n90); border-radius: 12px; padding: 16px; overflow-y: auto; }
    .pm-panel__empty { color: var(--n50); font-size: .85rem; text-align: center; margin-top: 48px; }
    .pm-field { margin-bottom: 11px; }
    .pm-field__k { font-family: ui-monospace, monospace; font-size: .62rem; text-transform: uppercase; letter-spacing: .05em; color: var(--n50); margin-bottom: 2px; }
    .pm-field__v { font-size: .9rem; color: var(--n20); }
    .pm-empty { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--n50); text-align: center; padding: 24px; gap: 8px; pointer-events: none; }
    .pm-empty[hidden] { display: none !important; }
    .pm-legend { position: absolute; left: 12px; bottom: 12px; background: color-mix(in srgb, var(--white) 90%, transparent); border: 1px solid var(--n90); border-radius: 10px; padding: 9px 11px; display: flex; flex-direction: column; gap: 5px; box-shadow: 0 4px 14px rgba(0,0,0,.08); backdrop-filter: blur(5px); max-width: 220px; pointer-events: none; }
    .pm-legend[hidden] { display: none !important; }
    .pm-legend__t { font-family: ui-monospace, monospace; font-size: .56rem; text-transform: uppercase; letter-spacing: .08em; color: var(--n50); }
    .pm-legend__row { display: flex; align-items: center; gap: 7px; font-size: .73rem; color: var(--n20); text-transform: capitalize; }
    .pm-legend__sw { width: 10px; height: 10px; border-radius: 3px; flex: none; }
    .pm-chip { display: inline-flex; align-items: center; font-family: ui-monospace, monospace; font-size: .64rem; font-weight: 600; padding: 2px 7px; border-radius: 6px; margin-left: 6px; vertical-align: middle; }
    .pm-modal-back { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .pm-modal { background: var(--white); border-radius: 14px; padding: 22px; width: 380px; max-width: 92vw; box-shadow: 0 20px 50px rgba(0,0,0,.3); }
    .pm-modal h3 { margin: 0 0 14px; font-size: 1.05rem; }
    .pm-modal label { display: block; font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; color: var(--n50); margin: 10px 0 3px; }
    .pm-modal input, .pm-modal select { width: 100%; padding: .5rem .6rem; border: 1px solid var(--n90); border-radius: 7px; background: var(--white); color: var(--n20); font-size: .9rem; font-family: inherit; box-sizing: border-box; }
    .pm-modal__actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 18px; }
    @media (max-width: 860px) { .pm-layout { flex-direction: column; height: auto; } .pm-panel { width: auto; } .pm-canvas-wrap { height: 360px; } }

    .pilot-chip {
      display: flex;
      align-items: center;
      gap: .6rem;
      background: rgba(255,255,255,.05);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 6px;
      padding: .3rem .75rem;
    }
    .pilot-chip__label {
      font-size: .67rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: rgba(255,255,255,.35);
    }
    .pilot-chip__val {
      font-size: .75rem;
      font-weight: 700;
      color: #fff;
    }
    .pilot-chip__track {
      width: 64px;
      height: 3px;
      background: rgba(255,255,255,.12);
      border-radius: 2px;
      overflow: hidden;
    }
    .pilot-chip__fill {
      height: 3px;
      background: linear-gradient(90deg, var(--silver), #6DB8BD);
      border-radius: 2px;
    }

    .topbar__right {
      display: flex;
      align-items: center;
      gap: .5rem;
      margin-left: auto;
    }

    .icon-btn {
      width: 32px;
      height: 32px;
      border-radius: 7px;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.09);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background var(--transition);
      position: relative;
    }
    .icon-btn:hover { background: rgba(255,255,255,.1); }
    .icon-btn svg { opacity: .6; }

    /* Theme toggle */
    .theme-toggle { transition: transform .3s cubic-bezier(.4,0,.2,1); }
    .icon-btn:hover .theme-toggle { transform: rotate(20deg); }
    .theme-icon-sun, .theme-icon-moon { position: absolute; transition: opacity .2s, transform .25s; }
    .theme-icon-moon { opacity: 0; transform: rotate(-30deg) scale(.7); }
    [data-theme="dark"] .theme-icon-sun  { opacity: 0; transform: rotate(30deg) scale(.7); }
    [data-theme="dark"] .theme-icon-moon { opacity: .6; transform: none; }
    .notif-badge {
      position: absolute;
      top: 5px; right: 5px;
      width: 6px; height: 6px;
      background: #F97316;
      border-radius: 50%;
      border: 1.5px solid var(--navy);
    }

    .settings-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      min-width: 200px;
      background: var(--white);
      border: 1px solid var(--n90);
      border-radius: var(--radius-md);
      box-shadow: 0 8px 24px rgba(0,0,0,.15);
      z-index: 600;
      padding: .35rem;
      text-align: left;
    }
    .settings-dropdown.open { display: block; }
    .settings-dropdown__item {
      display: flex;
      align-items: center;
      gap: .55rem;
      padding: .55rem .75rem;
      font-size: .82rem;
      font-weight: 500;
      color: var(--n20);
      border-radius: 6px;
      cursor: pointer;
      transition: background .12s;
      white-space: nowrap;
    }
    .settings-dropdown__item:hover { background: var(--n95); }
    .settings-dropdown__item svg { opacity: .6; flex-shrink: 0; }
    .settings-dropdown__divider { height: 1px; background: var(--n90); margin: .3rem .4rem; }
    .settings-dropdown__item--danger { color: var(--red); }
    .settings-dropdown__item--danger:hover { background: var(--red-bg); }
    .user-menu__head { padding: .55rem .75rem .5rem; }
    .user-menu__name { font-size: .85rem; font-weight: 600; color: var(--n20); }
    .user-menu__email { font-size: .74rem; color: var(--n50); word-break: break-all; margin-top: .1rem; }
    .user-menu__role { font-size: .68rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--brand); margin-top: .3rem; }

    .user-pill {
      position: relative;
      display: flex;
      align-items: center;
      gap: .5rem;
      padding: .25rem .5rem .25rem .25rem;
      border-radius: 8px;
      cursor: pointer;
      transition: background var(--transition);
      border: 1px solid transparent;
      margin-left: .25rem;
    }
    .user-pill:hover {
      background: rgba(255,255,255,.06);
      border-color: rgba(255,255,255,.09);
    }
    .user-avatar {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      background: linear-gradient(135deg, var(--brand), var(--brand-lt));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .65rem;
      font-weight: 800;
      color: #fff;
      letter-spacing: .02em;
    }
    .user-info { display: flex; flex-direction: column; }
    .user-name {
      font-size: .75rem;
      font-weight: 600;
      color: rgba(255,255,255,.9);
      line-height: 1.2;
    }
    .user-role {
      font-size: .62rem;
      color: rgba(255,255,255,.35);
      line-height: 1.2;
    }

    /* ───── BODY ───── */
    .app-body {
      flex: 1;
      display: flex;
      overflow: hidden;
    }

    /* ───── SIDEBAR ───── */
    .sidebar.hidden { display: none; }
    .sidebar {
      width: var(--sidebar-w);
      background: var(--white);
      border-right: 1px solid var(--n80);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .nav-section {
      padding: 1rem .75rem .5rem;
    }
    .nav-section + .nav-section {
      border-top: 1px solid var(--n80);
    }
    .nav-section__label {
      font-size: .62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: #94A3B8;
      padding: 0 .6rem;
      margin-bottom: .35rem;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: .6rem;
      padding: .5rem .6rem;
      border-radius: var(--radius);
      font-size: .8rem;
      font-weight: 500;
      color: var(--n30);
      cursor: pointer;
      transition: all var(--transition);
      position: relative;
    }
    .nav-item:hover {
      background: var(--n90);
      color: var(--n20);
    }
    .nav-item--active {
      background: rgba(27,63,139,.07);
      color: var(--brand);
      font-weight: 600;
    }
    .nav-item--active svg { opacity: 1 !important; }
    .nav-item--danger { color: #EF4444; }
    .nav-item--danger svg { opacity: .6; }
    .nav-item--danger:hover { background: #FEE2E2; color: #DC2626; }
    .nav-item--active::before {
      content: '';
      position: absolute;
      left: 0; top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 18px;
      background: var(--brand);
      border-radius: 0 2px 2px 0;
    }
    .nav-item svg { opacity: .5; flex-shrink: 0; }

    .nav-badge {
      margin-left: auto;
      font-size: .6rem;
      font-weight: 700;
      padding: .15rem .45rem;
      border-radius: 999px;
      background: var(--amber-bg);
      color: #92400E;
    }
    .nav-badge--red {
      background: var(--red-bg);
      color: var(--red);
    }
    .nav-badge--blue {
      background: rgba(27,63,139,.1);
      color: var(--brand);
    }

    .sidebar__footer {
      margin-top: auto;
      padding: .75rem;
      border-top: 1px solid var(--n80);
    }
    .scorecard {
      background: var(--n90);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      padding: .85rem;
    }
    .scorecard__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: .65rem;
    }
    .scorecard__title {
      font-size: .65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #94A3B8;
    }
    .scorecard__week {
      font-size: .62rem;
      font-weight: 600;
      color: var(--brand);
      background: rgba(27,63,139,.08);
      padding: .1rem .4rem;
      border-radius: 4px;
    }
    .sc-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: .3rem 0;
    }
    .sc-row + .sc-row { border-top: 1px solid var(--n80); }
    .sc-name { font-size: .73rem; color: var(--n30); }
    .sc-val { font-size: .73rem; font-weight: 700; }
    .sc-val--green { color: var(--green); }
    .sc-val--amber { color: var(--amber); }

    /* ───── MAIN ───── */
    .main {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      scrollbar-width: thin;
    }

    /* ───── PAGE HEADER ───── */
    .page-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }
    .page-header__left h1 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--navy);
      letter-spacing: -.02em;
    }
    .page-header__meta {
      display: flex;
      align-items: center;
      gap: .5rem;
      margin-top: .2rem;
    }
    .page-header__sub {
      font-size: .75rem;
      color: var(--n50);
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--green);
      animation: pulse-dot 2s ease infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: .4; }
    }
    .live-label {
      font-size: .65rem;
      font-weight: 700;
      color: var(--green);
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .header-actions {
      display: flex;
      gap: .5rem;
      align-items: center;
    }

    .btn-ui {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      padding: .42rem .85rem;
      border-radius: var(--radius);
      font-size: .78rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all var(--transition);
      border: 1px solid var(--n80);
      background: var(--white);
      color: var(--n20);
      box-shadow: var(--shadow-sm);
    }
    .btn-ui:hover { background: var(--n90); border-color: var(--n80); }
    .btn-ui--primary {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
      box-shadow: 0 1px 4px rgba(27,63,139,.25);
    }
    .btn-ui--primary:hover {
      background: var(--brand-lt);
      border-color: var(--brand-lt);
      box-shadow: 0 2px 8px rgba(27,63,139,.3);
      transform: translateY(-1px);
    }

    /* ───── ALERT BANNER ───── */
    .alert-banner {
      display: flex;
      align-items: center;
      gap: .85rem;
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      border-left: 3px solid var(--amber);
      border-radius: var(--radius);
      padding: .7rem 1rem;
      font-size: .78rem;
      box-shadow: var(--shadow-sm);
    }
    .alert-banner__icon {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      background: var(--amber-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .alert-banner__body strong { color: #92400E; font-weight: 700; }
    .alert-banner__body { color: #78350F; flex: 1; line-height: 1.4; }
    .alert-banner__cta {
      font-size: .73rem;
      font-weight: 700;
      color: var(--amber);
      white-space: nowrap;
      cursor: pointer;
      padding: .3rem .65rem;
      border-radius: 6px;
      background: var(--amber-bg);
      border: 1px solid #FDE68A;
      transition: all var(--transition);
    }
    .alert-banner__cta:hover { background: #FEF9C3; }

    /* ───── HISTORY BANNER ───── */
    .hist-banner {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .65rem 1rem;
      margin-bottom: .75rem;
      border-radius: var(--radius-md);
      background: #EEF2FF;
      border: 1px solid #C7D2FE;
      font-size: .82rem;
    }
    .hist-banner__icon {
      width: 28px; height: 28px;
      border-radius: 50%;
      background: #C7D2FE;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .hist-banner__body { color: #3730A3; flex: 1; line-height: 1.4; }
    .hist-banner__body strong { font-weight: 700; }
    .hist-banner__cta {
      font-size: .73rem; font-weight: 700;
      color: var(--brand); white-space: nowrap; cursor: pointer;
      padding: .3rem .65rem; border-radius: 6px;
      background: #C7D2FE; border: 1px solid #A5B4FC;
      transition: all var(--transition);
    }
    .hist-banner__cta:hover { background: #A5B4FC; }

    /* ───── MRP PANEL ───── */
    .mrp-tabs { display: flex; gap: .25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--n90); padding-bottom: .5rem; }
    .mrp-tab {
      font-size: .82rem; font-weight: 600; padding: .45rem 1rem;
      border-radius: 6px; border: none; background: none;
      color: var(--n40); cursor: pointer; transition: all .15s;
    }
    .mrp-tab:hover { background: var(--n95); color: var(--n20); }
    .mrp-tab--active { background: var(--brand); color: #fff; }

    .mrp-dropzone {
      border: 2px dashed var(--n80); border-radius: var(--radius-lg);
      padding: 2.5rem 1.5rem; text-align: center; cursor: pointer;
      transition: all .2s; background: var(--n98); margin-bottom: 1.25rem;
    }
    .mrp-dropzone:hover, .mrp-dropzone.drag-over { border-color: var(--brand); background: #EEF2FF; }
    .mrp-dropzone__icon { width: 40px; height: 40px; background: var(--n90); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin: 0 auto .75rem; }
    .mrp-dropzone__title { font-size: .9rem; font-weight: 600; color: var(--n20); margin-bottom: .3rem; }
    .mrp-dropzone__sub { font-size: .78rem; color: var(--n40); }
    .mrp-dropzone__sub a { color: var(--brand); text-decoration: underline; cursor: pointer; }

    .mrp-toolbar { display: flex; align-items: center; gap: .75rem; margin-bottom: .75rem; flex-wrap: wrap; }
    .mrp-count { font-size: .8rem; color: var(--n40); margin-left: auto; }

    .mrp-table-wrap { overflow-x: auto; border-radius: var(--radius-md); border: 1px solid var(--n90); }
    .mrp-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
    .mrp-table th { background: var(--n98); padding: .6rem .85rem; text-align: left; font-weight: 600; color: var(--n40); font-size: .74rem; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--n90); white-space: nowrap; }
    .mrp-table td { padding: .6rem .85rem; border-bottom: 1px solid var(--n95); vertical-align: middle; }
    .mrp-table tr:last-child td { border-bottom: none; }
    .mrp-table tr:hover td { background: var(--n98); }
    .mrp-urgente { color: var(--red); font-weight: 700; }
    .mrp-ok { color: var(--green); }

    /* ── Admin tabs ── */
    .admin-tab { background:none; border:none; border-bottom:2px solid transparent; padding:.6rem 1rem; font-size:.82rem; font-weight:600; color:var(--n50); cursor:pointer; font-family:inherit; transition:color .15s,border-color .15s; }
    .admin-tab:hover { color:var(--n20); }
    .admin-tab--active { color:var(--brand); border-bottom-color:var(--brand); }
    .admin-action-btn { background:none; border:1px solid var(--n80); color:var(--n50); font-size:.72rem; font-weight:600; padding:3px 8px; border-radius:4px; cursor:pointer; font-family:inherit; margin-left:.25rem; }
    .admin-action-btn:hover { color:var(--n20); border-color:var(--n50); }
    .admin-action-btn.del:hover { color:var(--red); border-color:var(--red); }
    .admin-badge { display:inline-block; font-size:.68rem; font-weight:700; padding:2px 7px; border-radius:999px; }
    .admin-badge--active { background:var(--green-bg); color:var(--green); }
    .admin-badge--inactive { background:var(--red-bg); color:var(--red); }
    .admin-badge--admin { background:#FEF3C7; color:var(--amber); }
    .admin-badge--plan { background:rgba(27,63,139,.08); color:var(--brand); border:1px solid rgba(27,63,139,.15); }

    /* ── Time editor ── */
    .time-section-title { font-size: .82rem; font-weight: 700; color: var(--n20); margin-bottom: .75rem; margin-top: 1.5rem; }
    .time-section-title:first-of-type { margin-top: 0; }
    .time-table-wrap { overflow-x: auto; border-radius: var(--radius-md); border: 1px solid var(--n90); margin-bottom: 1.25rem; }
    .time-table { width: 100%; border-collapse: collapse; font-size: .83rem; }
    .time-table th { background: var(--n98); padding: .55rem .85rem; text-align: left; font-weight: 600; color: var(--n40); font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--n90); }
    .time-table td { padding: .45rem .75rem; border-bottom: 1px solid var(--n95); vertical-align: middle; }
    .time-table tr:last-child td { border-bottom: none; }
    .time-input {
      width: 72px; padding: .3rem .5rem; border: 1px solid var(--n80);
      border-radius: 6px; font-size: .82rem; font-family: inherit;
      text-align: right; background: var(--white); color: var(--n10);
      transition: border .15s;
    }
    .time-input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 2px rgba(27,63,139,.12); }
    .time-impact { display: flex; align-items: center; gap: .4rem; }
    .time-impact-bar { height: 6px; border-radius: 3px; background: var(--n90); flex: 1; max-width: 80px; overflow: hidden; }
    .time-impact-fill { height: 100%; border-radius: 3px; background: var(--brand); transition: width .3s; }
    .time-impact-fill--warn { background: var(--amber); }
    .time-impact-fill--danger { background: var(--red); }
    .time-resource-badge { display: inline-flex; align-items: center; gap: .35rem; font-weight: 600; font-size: .82rem; }
    .time-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .time-name-input {
      width: 100%; padding: .3rem .5rem; border: 1px solid transparent;
      border-radius: 6px; font-size: .82rem; font-weight: 600;
      font-family: inherit; background: transparent; color: var(--n10);
      transition: border .15s, background .15s;
    }
    .time-name-input:hover { border-color: var(--n80); background: var(--n98); }
    .time-name-input:focus { outline: none; border-color: var(--brand); background: var(--white); box-shadow: 0 0 0 2px rgba(27,63,139,.12); }
    .time-delete-btn {
      width: 26px; height: 26px; border-radius: 6px; border: 1px solid transparent;
      background: none; color: var(--n60); cursor: pointer; display: flex;
      align-items: center; justify-content: center; transition: all .15s;
    }
    .time-delete-btn:hover { background: var(--red-bg); border-color: var(--red-bg); color: var(--red); }

    /* Shift schedule */
    .shift-name-badge { display: inline-flex; align-items: center; gap: .45rem; font-weight: 600; font-size: .82rem; }
    .shift-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .shift-days { display: flex; gap: .25rem; }
    .shift-day {
      width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--n80);
      font-size: .68rem; font-weight: 700; color: var(--n40);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all .15s; user-select: none;
    }
    .shift-day.active { background: var(--brand); border-color: var(--brand); color: #fff; }
    .shift-toggle {
      position: relative; display: inline-flex; align-items: center;
      width: 36px; height: 20px; cursor: pointer;
    }
    .shift-toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
    .shift-toggle__track {
      position: absolute; inset: 0; border-radius: 20px;
      background: var(--n80); transition: background .2s;
    }
    .shift-toggle__thumb {
      position: absolute; top: 3px; left: 3px;
      width: 14px; height: 14px; border-radius: 50%;
      background: #fff; transition: transform .2s;
      box-shadow: 0 1px 3px rgba(0,0,0,.2);
    }
    .shift-toggle input:checked ~ .shift-toggle__track { background: var(--brand); }
    .shift-toggle input:checked ~ .shift-toggle__thumb { transform: translateX(16px); }
    .shift-duration { font-size: .8rem; font-weight: 600; color: var(--n20); }
    .time-hm { width: 72px; padding: .3rem .5rem; border: 1px solid var(--n80); border-radius: 6px; font-size: .82rem; font-family: inherit; background: var(--white); color: var(--n10); transition: border .15s; }
    .time-hm:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 2px rgba(27,63,139,.12); }

    /* ───── KPI GRID ───── */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .kpi-card {
      background: var(--white);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      padding: 1rem 1.1rem 1.1rem;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
      transition: box-shadow var(--transition), transform var(--transition);
    }
    .kpi-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-1px);
    }
    .kpi-card::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
    .kpi-card--green::after { background: var(--green); }
    .kpi-card--blue::after  { background: var(--brand); }
    .kpi-card--amber::after { background: var(--amber); }
    .kpi-card--red::after   { background: var(--red); }

    .kpi-card__top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: .65rem;
    }
    .kpi-card__label {
      font-size: .68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #94A3B8;
    }
    .kpi-card__icon {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .kpi-card__icon--green { background: var(--green-bg); }
    .kpi-card__icon--blue  { background: rgba(27,63,139,.1); }
    .kpi-card__icon--amber { background: var(--amber-bg); }
    .kpi-card__icon--red   { background: var(--red-bg); }

    .kpi-card__val {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -.03em;
      line-height: 1;
      margin-bottom: .45rem;
    }
    .kpi-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .kpi-delta {
      display: inline-flex;
      align-items: center;
      gap: .2rem;
      font-size: .7rem;
      font-weight: 700;
      padding: .15rem .45rem;
      border-radius: 999px;
    }
    .kpi-delta--up   { background: var(--green-bg); color: var(--green); }
    .kpi-delta--down { background: var(--red-bg);   color: var(--red); }
    .kpi-delta--flat { background: var(--n90);      color: var(--n50); }
    .kpi-target { font-size: .67rem; color: #94A3B8; }

    /* ───── GANTT ───── */
    .gantt-card {
      background: var(--white);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .gantt-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .9rem 1.25rem;
      border-bottom: 1px solid var(--n80);
    }
    .gantt-header__title {
      font-size: .88rem;
      font-weight: 700;
      color: var(--navy);
    }
    .gantt-header__sub {
      font-size: .72rem;
      color: var(--n50);
      margin-top: .1rem;
    }
    .gantt-header__right {
      display: flex;
      align-items: center;
      gap: .75rem;
    }
    .tab-group {
      display: flex;
      background: var(--n90);
      border: 1px solid var(--n80);
      border-radius: 7px;
      padding: 2px;
      gap: 2px;
    }
    .tab {
      font-size: .72rem;
      font-weight: 600;
      padding: .28rem .65rem;
      border-radius: 5px;
      cursor: pointer;
      color: var(--n50);
      transition: all var(--transition);
    }
    .tab--active {
      background: var(--white);
      color: var(--n20);
      box-shadow: var(--shadow-sm);
    }

    /* Gantt grid */
    .gantt-grid {
      display: grid;
      grid-template-columns: 148px 1fr;
    }
    .gantt-grid__corner {
      background: var(--n90);
      border-bottom: 1px solid var(--n80);
      border-right: 1px solid var(--n80);
      padding: .45rem .9rem;
      display: flex;
      align-items: center;
    }
    .gantt-grid__corner span {
      font-size: .62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #94A3B8;
    }
    .gantt-days {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      background: var(--n90);
      border-bottom: 1px solid var(--n80);
    }
    .gantt-day {
      padding: .45rem .5rem;
      text-align: center;
      font-size: .65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: #94A3B8;
      border-right: 1px solid var(--n80);
    }
    .gantt-day:last-child { border-right: none; }
    .gantt-day--today {
      color: var(--brand);
      background: rgba(27,63,139,.04);
    }

    .gantt-row { display: contents; }

    .gantt-resource {
      display: flex;
      align-items: center;
      gap: .6rem;
      padding: .65rem .9rem;
      border-bottom: 1px solid var(--n80);
      border-right: 1px solid var(--n80);
      background: var(--white);
    }
    .gantt-row:last-child .gantt-resource,
    .gantt-row:last-child .gantt-timeline { border-bottom: none; }

    .res-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .res-indicator--green { background: var(--green); }
    .res-indicator--amber { background: var(--amber); }
    .res-indicator--blue  { background: var(--brand); }
    .res-indicator--gray  { background: #94A3B8; }

    .res-name { font-size: .77rem; font-weight: 600; color: var(--navy); }
    .res-sub  { font-size: .63rem; color: #94A3B8; margin-top: 1px; }

    .gantt-timeline {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      border-bottom: 1px solid var(--n80);
      min-height: 52px;
      position: relative;
    }
    .gantt-cell {
      border-right: 1px solid var(--n80);
      padding: .3rem .3rem;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .gantt-cell:last-child { border-right: none; }
    .gantt-cell--today { background: rgba(27,63,139,.025); }

    .gantt-block {
      height: 28px;
      border-radius: 5px;
      display: flex;
      align-items: center;
      padding: 0 .5rem 0 .5rem;
      font-size: .63rem;
      font-weight: 600;
      color: #fff;
      overflow: hidden;
      cursor: grab;
      transition: filter var(--transition), transform var(--transition), opacity var(--transition);
      user-select: none;
    }
    .gantt-block:hover { filter: brightness(1.1); transform: scaleY(1.05); }
    .gantt-block.dragging { opacity: .3; cursor: grabbing; transform: none; filter: none; }
    .gb-text { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; }
    .gantt-resize {
      flex-shrink: 0; align-self: stretch; width:5px; cursor:col-resize;
      background:rgba(255,255,255,.3); border-radius:0 4px 4px 0;
      opacity:0; transition:opacity .12s; margin-left:3px;
    }
    .gantt-block:hover .gantt-resize { opacity:1; }
    .gantt-cell.drop-target {
      background: rgba(27,63,139,.07);
      outline: 2px dashed rgba(27,63,139,.35);
      outline-offset: -3px;
      border-radius: 4px;
    }
    .gantt-cell.drop-target--invalid { outline-color: rgba(220,38,38,.35); background: rgba(220,38,38,.04); }

    /* ── FILTER DROPDOWN ── */
    .gantt-row--hidden { display: none !important; }
    .filter-wrapper { position: relative; }
    .filter-dropdown {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      background: var(--white);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      z-index: 400;
      min-width: 230px;
      padding: .85rem;
      display: none;
    }
    .filter-dropdown.open { display: block; }
    .filter-section { margin-bottom: .75rem; }
    .filter-section__label { font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #94A3B8; margin-bottom: .45rem; }
    .filter-check-row { display: flex; align-items: center; gap: .55rem; padding: .28rem 0; cursor: pointer; user-select: none; }
    .filter-check-row input[type=checkbox] { accent-color: var(--brand); width: 13px; height: 13px; cursor: pointer; flex-shrink: 0; }
    .filter-check-row span { font-size: .78rem; color: var(--n30); display: flex; align-items: center; gap: .4rem; }
    .filter-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .filter-actions { display: flex; gap: .5rem; padding-top: .65rem; border-top: 1px solid var(--n80); margin-top: .65rem; }
    .filter-badge { font-size: .58rem; font-weight: 800; background: var(--brand); color: #fff; padding: .1rem .35rem; border-radius: 999px; margin-left: .15rem; }
    .filter-btn--active { background: rgba(27,63,139,.08) !important; border-color: rgba(27,63,139,.3) !important; color: var(--brand) !important; }

    /* ── GANTT ZOOM + EXPAND ── */
    .gantt-zoom-group { display: flex; align-items: center; gap: 1px; }
    .zoom-btn { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; font-size: .85rem; font-weight: 700; border: 1px solid var(--n80); background: var(--white); color: var(--n30); border-radius: var(--radius); cursor: pointer; transition: all var(--transition); box-shadow: var(--shadow-sm); font-family: inherit; }
    .zoom-btn:hover:not(:disabled) { background: var(--n90); }
    .zoom-btn:disabled { opacity: .35; cursor: default; }
    .zoom-label { font-size: .68rem; font-weight: 700; color: var(--n50); min-width: 34px; text-align: center; }
    .expand-btn { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border: 1px solid var(--n80); background: var(--white); color: var(--n50); border-radius: var(--radius); cursor: pointer; transition: all var(--transition); box-shadow: var(--shadow-sm); }
    .expand-btn:hover { background: var(--n90); color: var(--n20); }
    #gantt-semana { overflow-x: auto; }
    #gantt-turno  { overflow-x: auto; }
    .gantt-card--expanded {
      position: fixed;
      top: var(--topbar-h);
      left: var(--sidebar-w);
      right: 0;
      bottom: 0;
      z-index: 200;
      border-radius: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .gantt-card--expanded #gantt-semana,
    .gantt-card--expanded #gantt-turno { flex: 1; overflow: auto; }
    .gantt-card--expanded .gantt-legend { flex-shrink: 0; }

    /* ── ADD ORDER MODAL ── */
    .modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(6,15,32,.55);
      z-index: 700;
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(3px);
      opacity: 0; pointer-events: none;
      transition: opacity .2s;
    }
    .modal-backdrop.open { opacity: 1; pointer-events: auto; }
    .modal {
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: 0 24px 64px rgba(11,28,58,.28);
      width: 480px; max-width: calc(100vw - 2rem);
      overflow: hidden;
      transform: translateY(8px);
      transition: transform .2s;
    }
    .modal-backdrop.open .modal { transform: translateY(0); }
    /* .modal__box: a second, newer modal-card class (savePlanModal, adminUserModal,
       companyModal, securityQuestionModal) that shares .modal__header/__body/__footer
       but never had its own container styling — it was relying on nothing, which
       only "worked" by accident wherever a default background happened to show
       through. Give it the same card treatment as .modal. */
    .modal__box {
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: 0 24px 64px rgba(11,28,58,.28);
      width: 100%; max-width: calc(100vw - 2rem);
      overflow: hidden;
      transform: translateY(8px);
      transition: transform .2s;
    }
    .modal-backdrop.open .modal__box { transform: translateY(0); }
    .modal__header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--n80);
    }
    .modal__title { font-size: .92rem; font-weight: 700; color: var(--navy); }
    .modal__close { background: none; border: none; cursor: pointer; color: #94A3B8; font-size: 1.3rem; line-height: 1; padding: .1rem .3rem; transition: color .15s; }
    .modal__close:hover { color: var(--n20); }
    .modal__body { padding: 1.25rem; display: flex; flex-direction: column; gap: .85rem; }
    .modal__footer { padding: .85rem 1.25rem; border-top: 1px solid var(--n80); display: flex; gap: .5rem; justify-content: flex-end; }
    .form-field { display: flex; flex-direction: column; gap: .3rem; }
    .form-label { font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; color: #94A3B8; }
    .form-input, .form-select {
      padding: .52rem .75rem;
      border: 1px solid var(--n80); border-radius: var(--radius);
      font-size: .82rem; font-family: inherit;
      color: var(--n20); background: var(--white); outline: none;
      transition: border-color var(--transition), box-shadow var(--transition);
    }
    .form-input:focus, .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(27,63,139,.08);
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
    .au-sectors-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; padding: .5rem 0; }
    .color-picker { display: flex; gap: .5rem; flex-wrap: wrap; }
    .color-opt {
      width: 26px; height: 26px; border-radius: 7px;
      cursor: pointer; border: 2.5px solid transparent;
      transition: all .12s; flex-shrink: 0;
    }
    .color-opt:hover { transform: scale(1.15); }
    .color-opt.selected { border-color: var(--n20); box-shadow: 0 0 0 1.5px white inset; }
    .modal-view-section { display: flex; flex-direction: column; gap: .85rem; }
    .modal-view-section[hidden] { display: none; }

    /* ── BLOCK DETAIL POPOVER (editable) ── */
    .block-popover {
      position: fixed; background: var(--white); border: 1px solid var(--n80);
      border-radius: var(--radius-md); box-shadow: var(--shadow-md);
      z-index: 500; width: 240px; padding: 0; display: none; overflow: hidden;
    }
    .block-popover.open { display: block; }
    .block-popover__head { display:flex; align-items:center; gap:.4rem; padding:.7rem .9rem .5rem; border-bottom:1px solid var(--n80); }
    .bp-of-input { flex:1; border:none; outline:none; font-size:.82rem; font-weight:700; color:var(--navy); background:transparent; min-width:0; }
    .bp-of-input:focus { background:var(--n90); border-radius:3px; padding:1px 3px; }
    .block-popover__close { background:none; border:none; cursor:pointer; color:#94A3B8; font-size:1.1rem; line-height:1; padding:0 .1rem; flex-shrink:0; }
    .bp-fields { padding:.5rem .9rem; display:flex; flex-direction:column; gap:.3rem; }
    .bp-field { display:flex; align-items:center; justify-content:space-between; font-size:.71rem; }
    .bp-lbl { color:var(--n50); flex-shrink:0; }
    .bp-input { border:1px solid var(--n80); border-radius:3px; padding:.18rem .4rem; font-size:.71rem; color:var(--n20); background:var(--white); outline:none; width:120px; }
    .bp-input:focus { border-color:var(--brand); }
    .bp-range-wrap { display:flex; align-items:center; gap:.4rem; width:120px; }
    .bp-range { flex:1; accent-color:var(--brand); cursor:pointer; }
    .bp-pct-val { font-size:.68rem; font-weight:600; color:var(--n20); min-width:26px; text-align:right; }
    .bp-footer { display:flex; gap:.4rem; padding:.5rem .9rem .7rem; border-top:1px solid var(--n80); }
    .bp-btn { flex:1; padding:.28rem 0; font-size:.68rem; font-weight:600; border-radius:4px; cursor:pointer; border:1px solid; letter-spacing:.02em; }
    .bp-btn--del { background:transparent; border-color:rgba(220,38,38,.35); color:var(--red); }
    .bp-btn--del:hover { background:var(--red-bg); }
    .bp-btn--save { background:var(--brand); border-color:var(--brand); color:#fff; }
    .bp-btn--save:hover { filter:brightness(1.1); }

    /* Replan loading */
    @keyframes spin-btn { to { transform: rotate(360deg); } }
    .spin-icon { animation: spin-btn .7s linear infinite; }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 1.75rem;
      left: 50%;
      transform: translateX(-50%) translateY(12px);
      background: #1E293B;
      color: #fff;
      font-size: .8rem;
      font-weight: 500;
      padding: .65rem 1.25rem;
      border-radius: 8px;
      box-shadow: 0 4px 24px rgba(0,0,0,.3);
      z-index: 9999;
      opacity: 0;
      transition: opacity .2s, transform .2s;
      white-space: nowrap;
      pointer-events: none;
    }
    .toast.visible { opacity: 1; transform: translateX(-50%) translateY(0); }

    .gb--blue   { background: var(--gb-blue); }
    .gb--teal   { background: var(--gb-teal); }
    .gb--green  { background: var(--gb-green); }
    .gb--purple { background: var(--gb-purple); }
    .gb--amber  { background: var(--gb-amber); }
    .gb--gray   { background: var(--gb-gray); }

    /* Turno view — now line (kept for reference; actual styles applied inline by JS) */
    .turno-now-line { pointer-events: none; }

    .gantt-legend {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: .6rem 1.25rem;
      border-top: 1px solid var(--n80);
      background: var(--n90);
      flex-wrap: wrap;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: .35rem;
      font-size: .65rem;
      color: var(--n50);
    }
    .legend-dot {
      width: 8px;
      height: 8px;
      border-radius: 2px;
    }
    .gantt-legend__updated {
      margin-left: auto;
      font-size: .65rem;
      color: #94A3B8;
    }

    /* ───── PLANNER BAR & ALTERNATIVES ───── */
    .planner-bar {
      padding: .75rem 1.25rem;
      background: rgba(27,63,139,.03);
      border-bottom: 1px solid var(--n80);
      display: flex;
      align-items: center;
      gap: .75rem;
      flex-wrap: wrap;
    }
    .planner-bar__label { font-size: .72rem; font-weight: 600; color: var(--n50); }
    .planner-bar__field { display: flex; align-items: center; gap: .4rem; }
    .planner-bar input[type=date],
    .planner-bar select,
    .planner-bar input[type=number] {
      height: 28px; border: 1px solid var(--n80); border-radius: var(--radius);
      padding: 0 .5rem; font-size: .72rem; font-family: inherit; color: var(--n20);
      background: var(--white);
    }
    .planner-bar input[type=number] { width: 54px; }
    .planner-bar__sep { width: 1px; height: 20px; background: var(--n80); }

    .alt-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: .75rem;
      padding: .75rem 1.25rem;
      background: var(--n90);
      border-bottom: 1px solid var(--n80);
    }
    .alt-card {
      background: var(--white);
      border: 2px solid var(--n80);
      border-radius: var(--radius-md);
      padding: .85rem 1rem;
      cursor: pointer;
      transition: border-color .15s, box-shadow .15s;
    }
    .alt-card:hover { border-color: #94A3B8; box-shadow: var(--shadow-sm); }
    .alt-card--selected { border-color: var(--brand) !important; box-shadow: 0 0 0 3px rgba(27,63,139,.12); }
    .alt-card__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: .5rem; }
    .alt-card__badge { font-size: .95rem; }
    .alt-card__label { font-size: .82rem; font-weight: 700; color: var(--navy); }
    .alt-card__desc  { font-size: .68rem; color: var(--n50); margin-bottom: .6rem; }
    .alt-card__kpis  { display: grid; grid-template-columns: 1fr 1fr; gap: .3rem .75rem; }
    .alt-kpi         { display: flex; flex-direction: column; }
    .alt-kpi__val    { font-size: .88rem; font-weight: 700; }
    .alt-kpi__key    { font-size: .62rem; color: var(--n50); }
    .alt-card__warnings { font-size: .65rem; color: var(--amber); margin-top: .5rem; }
    .alt-cards__note { grid-column: 1 / -1; font-size: .68rem; color: var(--n50); line-height: 1.45; margin: -.15rem 0 .1rem; }
    .alt-cards__note b { color: var(--navy); font-weight: 600; }

    /* Monte Carlo robustness block appended to each alternative card */
    .alt-card__sim { margin-top: .7rem; padding-top: .7rem; border-top: 1px dashed var(--n80); font-size: .68rem; }
    .alt-card__sim--loading { color: var(--n50); font-style: italic; }
    .alt-sim__head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: .35rem; }
    .alt-sim__title { font-weight: 700; color: var(--navy); font-size: .62rem; text-transform: uppercase; letter-spacing: .03em; }
    .alt-sim__score { font-size: 1rem; font-weight: 800; }
    .alt-sim__score span { font-size: .58rem; font-weight: 600; color: var(--n50); }
    .alt-sim__bar { height: 5px; background: var(--n80); border-radius: 3px; overflow: hidden; margin-bottom: .5rem; }
    .alt-sim__bar div { height: 5px; border-radius: 3px; transition: width .3s; }
    .alt-sim__rows { display: flex; flex-direction: column; gap: .25rem; }
    .alt-sim__rows > div { display: flex; justify-content: space-between; gap: .5rem; }
    .alt-sim__rows span { color: var(--n50); }
    .alt-sim__rows b { color: var(--navy); font-weight: 700; }
    .alt-sim__foot { margin-top: .45rem; font-size: .58rem; color: var(--n50); }

    /* ───── COMPOSITES PLANNER GANTT ───── */
    .pg-wrapper { overflow-x: auto; }
    .pg-day-header-row {
      display: grid;
      grid-template-columns: 148px repeat(21, minmax(44px, 1fr));
      background: var(--n90);
      border-bottom: 1px solid var(--n80);
    }
    .pg-day-cell {
      grid-column: span 3;
      padding: .35rem .5rem;
      text-align: center;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
      color: #94A3B8;
      border-right: 2px solid var(--n80);
    }
    .pg-day-cell:last-child { border-right: none; }
    .pg-corner { background: var(--n90); border-right: 1px solid var(--n80); border-bottom: 1px solid var(--n80); display: flex; align-items: center; padding: 0 .9rem; }
    .pg-corner span { font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #94A3B8; }
    .pg-shift-header-row {
      display: grid;
      grid-template-columns: 148px repeat(21, minmax(44px, 1fr));
      background: rgba(27,63,139,.03);
      border-bottom: 2px solid var(--n80);
    }
    .pg-shift-cell {
      padding: .25rem 0;
      text-align: center;
      font-size: .6rem;
      font-weight: 600;
      color: #94A3B8;
      border-right: 1px solid var(--n80);
    }
    .pg-shift-cell--eod { border-right: 2px solid var(--n80); }
    .pg-resource-row {
      display: grid;
      grid-template-columns: 148px 1fr;
      border-bottom: 1px solid var(--n80);
      min-height: 52px;
    }
    .pg-resource-row:last-child { border-bottom: none; }
    .pg-res-label {
      display: flex; align-items: center; gap: .6rem;
      padding: .5rem .9rem;
      border-right: 1px solid var(--n80);
      background: var(--white);
    }
    .pg-res-name { font-size: .77rem; font-weight: 600; color: var(--navy); }
    .pg-res-type { font-size: .63rem; color: #94A3B8; }
    .pg-timeline {
      display: grid;
      grid-template-columns: repeat(21, minmax(44px, 1fr));
      position: relative;
      background: var(--white);
    }
    .pg-cell {
      min-height: 52px;
      border-right: 1px solid var(--n80);
      grid-row: 1;
    }
    .pg-cell--eod { border-right: 2px solid var(--n80); }
    .pg-event {
      grid-row: 1;
      margin: 7px 2px;
      border-radius: 4px;
      padding: 3px 6px;
      font-size: .65rem;
      font-weight: 600;
      overflow: hidden;
      white-space: nowrap;
      cursor: default;
      z-index: 2;
      position: relative;
    }
    .pg-event-title { display: block; overflow: hidden; text-overflow: ellipsis; }
    .pg-event-sub   { display: block; font-size: .58rem; font-weight: 400; opacity: .75; }
    .pg-empty { display: flex; align-items: center; justify-content: center; height: 100%; color: var(--n50); font-size: .72rem; font-style: italic; }

    /* loading spinner for planner */
    .planner-spinner {
      display: none; align-items: center; gap: .5rem;
      padding: .5rem 1.25rem; font-size: .75rem; color: var(--n50);
    }
    .planner-spinner.active { display: flex; }

    /* ───── GANTT TURNO VIEW (hour-based timeline) ───── */
    .turno-track { position: relative; height: 52px; border-bottom: 1px solid var(--n80); background: var(--white); }
    .turno-track:last-child { border-bottom: none; }
    .turno-band-m { position: absolute; left: 0; width: 50%; height: 100%; background: rgba(27,63,139,.025); }
    .turno-band-t { position: absolute; left: 50%; width: 50%; height: 100%; background: rgba(217,119,6,.02); }
    .turno-divider { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: rgba(27,63,139,.15); }
    .turno-now { position: absolute; left: 18.75%; top: 0; bottom: 0; width: 2px; background: var(--brand); z-index: 5; }
    .turno-now::before { content: '09:00'; position: absolute; top: 4px; left: 4px; font-size: .55rem; font-weight: 800; color: var(--brand); }
    .turno-block { position: absolute; height: 26px; top: 13px; border-radius: 5px; display: flex; align-items: center; padding: 0 .5rem; font-size: .62rem; font-weight: 600; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: grab; transition: filter .15s, opacity .15s; }
    .turno-block:hover { filter: brightness(1.1); }
    .turno-block.dragging { opacity: .3; cursor: grabbing; }
    .turno-hour-header { display: flex; border-bottom: 1px solid var(--n80); background: var(--n90); }
    .turno-hour-cell { flex: 1; text-align: center; font-size: .6rem; font-weight: 700; color: #94A3B8; padding: .4rem 0; border-right: 1px solid var(--n80); letter-spacing: .04em; }
    .turno-hour-cell:last-child { border-right: none; }
    .turno-hour-cell--now { color: var(--brand); background: rgba(27,63,139,.04); }
    .turno-row { display: grid; grid-template-columns: 148px 1fr; border-bottom: 1px solid var(--n80); }
    .turno-row:last-child { border-bottom: none; }
    .turno-resource { display: flex; align-items: center; gap: .6rem; padding: .65rem .9rem; border-right: 1px solid var(--n80); background: var(--white); }
    .turno-shift-labels { position: relative; height: 20px; margin-left: 148px; }
    .turno-shift-label { position: absolute; font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; }
    .turno-shift-label--m { left: 1%; color: rgba(27,63,139,.5); }
    .turno-shift-label--t { left: 51%; color: rgba(217,119,6,.6); }
    .turno-empty-track { display: flex; align-items: center; justify-content: center; height: 52px; border-bottom: 1px solid var(--n80); }
    .turno-empty-text { font-size: .72rem; color: #CBD5E1; font-style: italic; }
    .turno-track.drop-target { background: rgba(27,63,139,.07); outline: 2px dashed rgba(27,63,139,.35); outline-offset: -3px; }

    /* ───── DASH PANELS ───── */
    .dash-panel { flex: 1; overflow-y: auto; display: flex; flex-direction: column; }
    .panel-page { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
    .panel-page-header { display: flex; align-items: center; justify-content: space-between; }
    .panel-page-title { font-size: 1.05rem; font-weight: 700; color: var(--navy); letter-spacing: -.02em; }
    .panel-page-sub { font-size: .75rem; color: var(--n50); margin-top: .2rem; }

    /* Capacity panel */
    .cap-cards-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
    .cap-card { background: var(--white); border: 1px solid var(--n80); border-radius: var(--radius-md); padding: 1.1rem 1.25rem; box-shadow: var(--shadow-sm); }
    .cap-card__name { font-size: .82rem; font-weight: 700; color: var(--navy); margin-bottom: .15rem; }
    .cap-card__type { font-size: .68rem; color: #94A3B8; margin-bottom: .75rem; }
    .cap-card__bar-wrap { position: relative; height: 10px; background: var(--n80); border-radius: 5px; overflow: hidden; margin-bottom: .5rem; }
    .cap-card__bar { height: 10px; border-radius: 5px; }
    .cap-card__bar--ok   { background: var(--green); }
    .cap-card__bar--warn { background: var(--amber); }
    .cap-card__bar--over { background: var(--red); }
    .cap-card__meta { display: flex; justify-content: space-between; align-items: center; }
    .cap-card__pct { font-size: .88rem; font-weight: 800; }
    .cap-card__pct--ok   { color: var(--green); }
    .cap-card__pct--warn { color: var(--amber); }
    .cap-card__pct--over { color: var(--red); }
    .cap-pill { font-size: .6rem; font-weight: 700; padding: .15rem .45rem; border-radius: 999px; }
    .cap-pill--ok   { background: var(--green-bg); color: var(--green); }
    .cap-pill--warn { background: var(--amber-bg); color: #92400E; }
    .cap-pill--over { background: var(--red-bg); color: var(--red); }
    .cap-card__orders { font-size: .65rem; color: #94A3B8; margin-top: .45rem; }
    .cap-table { background: var(--white); border: 1px solid var(--n80); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
    .cap-table table { width: 100%; border-collapse: collapse; font-size: .75rem; }
    .cap-table th { background: var(--n90); padding: .5rem .85rem; text-align: left; font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #94A3B8; border-bottom: 1px solid var(--n80); }
    .cap-table td { padding: .55rem .85rem; border-bottom: 1px solid var(--n80); color: var(--n30); }
    .cap-table tr:last-child td { border-bottom: none; }
    .cap-table td:first-child { font-weight: 600; color: var(--navy); }

    /* Scenarios panel */
    .scenario-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .scenario-card { background: var(--white); border: 1.5px solid var(--n80); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm); position: relative; overflow: hidden; }
    .scenario-card--active { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(27,63,139,.08), var(--shadow); }
    .scenario-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
    .scenario-card--green::before { background: var(--green); }
    .scenario-card--blue::before  { background: var(--brand); }
    .scenario-card--gray::before  { background: #94A3B8; }
    .scenario-badge { display: inline-flex; align-items: center; gap: .3rem; font-size: .7rem; font-weight: 700; padding: .25rem .65rem; border-radius: 999px; margin-bottom: 1rem; }
    .scenario-badge--green { background: var(--green-bg); color: var(--green); }
    .scenario-badge--blue  { background: rgba(27,63,139,.1); color: var(--brand); }
    .scenario-badge--gray  { background: var(--n90); color: var(--n50); }
    .scenario-active-chip { font-size: .6rem; font-weight: 700; background: var(--brand); color: #fff; padding: .1rem .45rem; border-radius: 999px; margin-left: .4rem; vertical-align: middle; }
    .scenario-kpis { display: flex; flex-direction: column; gap: .55rem; margin-bottom: 1.25rem; }
    .scenario-kpi { display: flex; justify-content: space-between; align-items: center; font-size: .78rem; }
    .scenario-kpi__label { color: var(--n50); }
    .scenario-kpi__val { font-weight: 700; color: var(--navy); }
    .scenario-bar { height: 6px; background: var(--n80); border-radius: 3px; margin-bottom: 1.25rem; overflow: hidden; }
    .scenario-bar__fill { height: 6px; border-radius: 3px; }

    /* Alerts panel */
    .alert-list { display: flex; flex-direction: column; gap: 0; }
    .alert-row { display: flex; align-items: center; gap: 1rem; padding: .9rem 1.25rem; border-bottom: 1px solid var(--n80); background: var(--white); }
    .alert-row:last-child { border-bottom: none; }
    .alert-sev { font-size: .62rem; font-weight: 800; padding: .2rem .55rem; border-radius: 999px; white-space: nowrap; flex-shrink: 0; }
    .alert-sev--alta  { background: var(--red-bg); color: var(--red); }
    .alert-sev--media { background: var(--amber-bg); color: #92400E; }
    .alert-sev--baja  { background: rgba(27,63,139,.08); color: var(--brand); }
    .alert-desc { flex: 1; font-size: .78rem; color: var(--n30); line-height: 1.4; }
    .alert-action { font-size: .7rem; font-weight: 600; color: var(--brand); white-space: nowrap; padding: .3rem .65rem; border-radius: 6px; background: rgba(27,63,139,.07); border: 1px solid rgba(27,63,139,.15); cursor: pointer; transition: all .15s; flex-shrink: 0; }
    .alert-action:hover { background: rgba(27,63,139,.12); }
    .alert-dismiss { background: none; border: none; cursor: pointer; color: #CBD5E1; font-size: 1.05rem; line-height: 1; padding: .1rem .2rem; transition: color .12s; flex-shrink: 0; }
    .alert-dismiss:hover { color: var(--n50); }
    .alert-row { transition: opacity .3s, max-height .35s; overflow: hidden; }
    .alert-row--resolved { opacity: .45; background: var(--n90) !important; pointer-events: none; }
    .alert-resolved-chip { font-size: .62rem; font-weight: 700; background: var(--green-bg); color: var(--green); padding: .18rem .5rem; border-radius: 999px; flex-shrink: 0; }
    .alert-detail { max-height: 0; overflow: hidden; transition: max-height .3s ease, padding .3s; padding: 0 1.25rem; background: var(--n90); border-top: 0px solid var(--n80); font-size: .75rem; color: var(--n50); line-height: 1.7; }
    .alert-detail.open { max-height: 120px; padding: .75rem 1.25rem; border-top: 1px solid var(--n80); }
    .alert-filter-bar { display: flex; align-items: center; gap: .4rem; padding: .6rem 1.25rem; border-bottom: 1px solid var(--n80); background: var(--n90); }
    .alert-count-badge { margin-left: auto; font-size: .68rem; font-weight: 700; color: var(--n50); }

    /* Orders panel */
    .orders-toolbar { display: flex; align-items: center; gap: .75rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--n80); }
    .orders-search { flex: 1; padding: .42rem .85rem; border: 1px solid var(--n80); border-radius: var(--radius); font-size: .78rem; font-family: inherit; background: var(--n90); color: var(--n20); outline: none; }
    .orders-search:focus { border-color: var(--brand); background: var(--white); }
    .filter-chips { display: flex; gap: .4rem; }
    .chip { font-size: .68rem; font-weight: 600; padding: .25rem .6rem; border-radius: 999px; cursor: pointer; border: 1px solid var(--n80); background: var(--n90); color: var(--n50); transition: all .15s; }
    .chip--active { background: rgba(27,63,139,.1); color: var(--brand); border-color: rgba(27,63,139,.25); }
    .orders-table { width: 100%; border-collapse: collapse; font-size: .75rem; }
    .orders-table th { background: var(--n90); padding: .5rem .9rem; text-align: left; font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #94A3B8; border-bottom: 1px solid var(--n80); }
    .orders-table td { padding: .6rem .9rem; border-bottom: 1px solid var(--n80); color: var(--n30); vertical-align: middle; }
    .orders-table tr:last-child td { border-bottom: none; }
    .orders-table td:first-child { font-weight: 700; color: var(--navy); font-variant-numeric: tabular-nums; }

    /* Resources panel */
    .res-cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .res-card { background: var(--white); border: 1px solid var(--n80); border-radius: var(--radius-md); padding: 1.1rem 1.25rem; box-shadow: var(--shadow-sm); }
    .res-card__header { display: flex; align-items: center; gap: .7rem; margin-bottom: .9rem; }
    .res-card__icon { width: 36px; height: 36px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .res-card__name { font-size: .85rem; font-weight: 700; color: var(--navy); }
    .res-card__type { font-size: .68rem; color: #94A3B8; }
    .res-card__order { font-size: .72rem; color: var(--n30); margin-bottom: .65rem; padding: .35rem .6rem; background: var(--n90); border-radius: 5px; }
    .res-card__util-label { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #94A3B8; margin-bottom: .3rem; }
    .res-card__bar-wrap { height: 7px; background: var(--n80); border-radius: 4px; overflow: hidden; margin-bottom: .35rem; }
    .res-card__bar { height: 7px; border-radius: 4px; }
    .res-card__footer { display: flex; justify-content: space-between; align-items: center; font-size: .68rem; }
    .res-card__maint { color: #94A3B8; }

    /* KPIs panel */
    .kpis-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .kpi-full-card { background: var(--white); border: 1px solid var(--n80); border-radius: var(--radius-md); padding: 1.1rem 1.25rem; box-shadow: var(--shadow-sm); }
    .kpi-full-card__label { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #94A3B8; margin-bottom: .3rem; }
    .kpi-full-card__val { font-size: 1.5rem; font-weight: 800; color: var(--navy); letter-spacing: -.03em; line-height: 1; margin-bottom: .2rem; }
    .kpi-full-card__target { font-size: .65rem; color: #94A3B8; margin-bottom: .75rem; }
    .kpi-trend { display: flex; align-items: flex-end; gap: 3px; height: 28px; }
    .kpi-trend__bar { flex: 1; border-radius: 2px 2px 0 0; min-height: 4px; }

    /* Disruptions panel */
    .disrupt-list { display: flex; flex-direction: column; }
    .disrupt-row { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--n80); background: var(--white); }
    .disrupt-row:last-child { border-bottom: none; }
    .disrupt-time { font-size: .65rem; font-weight: 700; color: #94A3B8; white-space: nowrap; min-width: 72px; padding-top: 2px; }
    .disrupt-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; }
    .disrupt-body { flex: 1; }
    .disrupt-title { font-size: .8rem; font-weight: 700; color: var(--navy); margin-bottom: .2rem; }
    .disrupt-detail { font-size: .72rem; color: var(--n50); line-height: 1.4; }
    .disrupt-status { font-size: .62rem; font-weight: 700; padding: .2rem .55rem; border-radius: 999px; white-space: nowrap; flex-shrink: 0; }
    .disrupt-status--resuelta  { background: var(--green-bg); color: var(--green); }
    .disrupt-status--cerrada   { background: var(--n90); color: var(--n50); }
    .disrupt-status--integrada { background: rgba(27,63,139,.1); color: var(--brand); }
    .disrupt-status--activa    { background: var(--red-bg); color: var(--red); }
    .disrupt-actions { display: flex; gap: .35rem; flex-shrink: 0; align-items: center; }

    /* ───── BOTTOM ROW ───── */
    .bottom-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 1rem;
    }

    .panel {
      background: var(--white);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .panel__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .8rem 1.1rem;
      border-bottom: 1px solid var(--n80);
    }
    .panel__title {
      font-size: .83rem;
      font-weight: 700;
      color: var(--navy);
    }
    .panel__count {
      font-size: .72rem;
      color: var(--n50);
      background: var(--n90);
      padding: .15rem .5rem;
      border-radius: 999px;
    }

    /* Orders */
    .order-list { padding: 0 1.1rem; }
    .order-row {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .55rem 0;
      border-bottom: 1px solid var(--n80);
    }
    .order-row:last-child { border-bottom: none; }
    .order-id {
      font-size: .75rem;
      font-weight: 700;
      color: var(--navy);
      min-width: 60px;
      font-variant-numeric: tabular-nums;
    }
    .order-name {
      font-size: .75rem;
      color: var(--n30);
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .order-progress {
      display: flex;
      align-items: center;
      gap: .5rem;
    }
    .progress-track {
      width: 56px;
      height: 4px;
      background: var(--n80);
      border-radius: 2px;
      overflow: hidden;
    }
    .progress-fill {
      height: 4px;
      background: var(--brand);
      border-radius: 2px;
    }
    .progress-pct {
      font-size: .68rem;
      font-weight: 700;
      color: var(--n50);
      min-width: 28px;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .status-pill {
      font-size: .63rem;
      font-weight: 700;
      padding: .2rem .55rem;
      border-radius: 999px;
      white-space: nowrap;
    }
    .sp--ok     { background: var(--green-bg); color: var(--green); }
    .sp--risk   { background: var(--amber-bg); color: var(--amber); }
    .sp--late   { background: var(--red-bg);   color: var(--red); }

    /* Order checkpoints */
    .checkpoints-btn {
      font-size: .7rem;
      font-weight: 600;
      padding: .25rem .6rem;
      border-radius: 999px;
      border: 1px solid var(--n80);
      background: var(--n90);
      color: var(--n30);
      cursor: pointer;
      white-space: nowrap;
      font-family: inherit;
    }
    .checkpoints-btn:hover { background: var(--n80); }
    .checkpoints-btn--done { background: var(--green-bg); color: var(--green); border-color: transparent; }
    .checkpoint-item { display: flex; align-items: center; gap: .65rem; padding: .55rem 0; border-bottom: 1px solid var(--n80); }
    .checkpoint-item:last-child { border-bottom: none; }
    .checkpoint-item__check { flex-shrink: 0; width: 16px; height: 16px; cursor: pointer; }
    .checkpoint-item__title { flex: 1; font-size: .85rem; color: var(--navy); word-break: break-word; }
    .checkpoint-item__title--done { text-decoration: line-through; color: var(--n40); }
    .checkpoint-item__del { background: none; border: none; color: var(--red); cursor: pointer; font-size: 1rem; line-height: 1; padding: .2rem .35rem; flex-shrink: 0; }

    /* Capacity */
    .cap-list { padding: .9rem 1.1rem; display: flex; flex-direction: column; gap: .75rem; }
    .cap-row { display: flex; align-items: center; gap: .75rem; }
    .cap-name {
      font-size: .75rem;
      font-weight: 600;
      color: var(--navy);
      min-width: 80px;
    }
    .cap-track {
      flex: 1;
      height: 7px;
      background: var(--n80);
      border-radius: 4px;
      overflow: hidden;
    }
    .cap-fill { height: 7px; border-radius: 4px; }
    .cap-fill--ok   { background: var(--green); }
    .cap-fill--warn { background: var(--amber); }
    .cap-fill--over { background: var(--red); }
    .cap-pct {
      font-size: .72rem;
      font-weight: 700;
      min-width: 34px;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .cap-pct--ok   { color: var(--green); }
    .cap-pct--warn { color: var(--amber); }
    .cap-pct--over { color: var(--red); }

    /* ───── INDUSTRIES PANEL (sidebar) ───── */
    .industries-panel {
      border-top: 1px solid var(--n80);
      border-bottom: 1px solid var(--n80);
      background: var(--n90);
    }
    .industries-panel.hidden { display: none; }
    .industries-panel__toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .6rem .75rem;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: background var(--transition);
    }
    .industries-panel__toggle:hover { background: var(--n90); }
    .industries-panel__left {
      display: flex;
      align-items: center;
      gap: .45rem;
      font-size: .62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: #94A3B8;
    }
    .industries-panel__left svg { opacity: .6; }
    .industries-panel__right { display: flex; align-items: center; gap: .3rem; }
    .industries-panel__count {
      font-size: .6rem;
      font-weight: 700;
      background: rgba(27,63,139,.1);
      color: var(--brand);
      padding: .1rem .4rem;
      border-radius: 999px;
    }
    .industries-panel__chevron {
      color: #94A3B8;
      transition: transform .2s;
    }
    .industries-panel.collapsed .industries-panel__chevron { transform: rotate(-90deg); }

    .industries-panel__list {
      padding: .25rem .5rem .5rem;
      overflow: hidden;
    }
    .industries-panel.collapsed .industries-panel__list { display: none; }

    .ind-item {
      display: flex;
      align-items: center;
      gap: .55rem;
      padding: .38rem .5rem;
      border-radius: 6px;
      cursor: pointer;
      transition: background var(--transition);
      text-decoration: none;
    }
    .ind-item:hover { background: var(--n90); }
    .ind-item--active { background: rgba(27,63,139,.07); }
    .ind-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .ind-name {
      font-size: .77rem;
      font-weight: 500;
      color: var(--n30);
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ind-item--active .ind-name { color: var(--brand); font-weight: 600; }
    .ind-badge {
      font-size: .45rem;
      color: var(--brand);
      opacity: .7;
    }

    /* ───── INDUSTRY SELECTOR ───── */
    #industry-selector {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 2rem;
      background: var(--n90);
      overflow-y: auto;
    }
    #industry-selector.hidden { display: none; }

    /* Enterprise selector — between the industry menu and the planning dashboard */
    #enterprise-selector {
      flex: 1; display: none; flex-direction: column; align-items: center; justify-content: center;
      padding: 2.5rem 2rem; background: var(--n90); overflow-y: auto;
    }
    #enterprise-selector.show { display: flex; }
    .ent-back {
      background: none; border: none; color: var(--brand); font: inherit; font-size: .82rem; font-weight: 600;
      cursor: pointer; margin-bottom: 1.4rem; display: inline-flex; align-items: center; gap: .35rem;
    }
    .ent-back:hover { text-decoration: underline; }
    .enterprise-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 240px)); gap: 1rem;
      width: 100%; max-width: 780px; justify-content: center;
    }
    .enterprise-card {
      background: var(--white); border: 1.5px solid var(--n80); border-radius: var(--radius-md);
      padding: 1.75rem 1.25rem; cursor: pointer; min-height: 150px;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.1rem;
      text-align: center;
      transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
    }
    .enterprise-card:hover { border-color: var(--brand); box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .enterprise-card__logo { max-width: 210px; max-height: 58px; width: auto; height: auto; }
    .enterprise-card__name { font-size: 1.05rem; font-weight: 700; color: var(--navy); }
    .enterprise-card__cta { font-size: .78rem; font-weight: 600; color: var(--brand); }
    .enterprise-card:hover .enterprise-card__cta::after { content: ' \2192'; }
    .enterprise-empty { text-align: center; max-width: 400px; }
    .enterprise-empty p { font-size: .9rem; color: var(--n50); line-height: 1.5; margin: 0 0 1.2rem; }

    #dashboard-view { display: none; flex: 1; overflow: hidden; }
    #dashboard-view.visible { display: flex; flex-direction: column; flex: 1; overflow: hidden; }

    .selector-header { text-align: center; margin-bottom: 2.5rem; }
    .selector-header h2 {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -.025em;
      margin-bottom: .4rem;
    }
    .selector-header p {
      font-size: .85rem;
      color: var(--n50);
      max-width: 380px;
      margin: 0 auto;
      line-height: 1.5;
    }

    .industry-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      width: 100%;
      max-width: 900px;
    }

    .industry-card {
      background: var(--white);
      border: 1.5px solid var(--n80);
      border-radius: var(--radius-lg);
      padding: 1.75rem 1.5rem 1.5rem;
      cursor: pointer;
      transition: all .18s cubic-bezier(.4,0,.2,1);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: .85rem;
      text-align: left;
    }
    .industry-card:hover {
      border-color: var(--brand);
      box-shadow: 0 4px 20px rgba(27,63,139,.12);
      transform: translateY(-2px);
    }
    .industry-card--active {
      border-color: rgba(27,63,139,.35);
      box-shadow: var(--shadow-sm);
    }
    .industry-card--active::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--brand);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .industry-card__badge {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      font-size: .6rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .1em;
      padding: .2rem .55rem;
      border-radius: 999px;
      width: fit-content;
    }
    .badge--pilot {
      background: rgba(27,63,139,.1);
      color: var(--brand);
    }
    .badge--available {
      background: var(--n90);
      color: var(--n50);
    }

    .industry-card__icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .icon--blue   { background: rgba(27,63,139,.1); }
    .icon--teal   { background: rgba(8,145,178,.1); }
    .icon--orange { background: rgba(220,104,3,.1); }

    .industry-card__name {
      font-size: .95rem;
      font-weight: 700;
      color: var(--navy);
      letter-spacing: -.01em;
      line-height: 1.25;
    }
    .industry-card__desc {
      font-size: .77rem;
      color: var(--n50);
      line-height: 1.5;
      flex: 1;
    }
    .industry-card__cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: .25rem;
    }
    .industry-card__link {
      font-size: .75rem;
      font-weight: 600;
      color: var(--brand);
    }
    .industry-card:hover .industry-card__link::after { content: ' →'; }
    .industry-card__kpis {
      font-size: .68rem;
      color: #94A3B8;
    }

    /* ───── LOADING / AUTH OVERLAY ───── */
    #auth-overlay {
      position: fixed;
      inset: 0;
      background: #060B11;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      transition: opacity .3s;
    }
    #auth-overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }
    .spinner {
      width: 36px; height: 36px;
      border: 3px solid rgba(255,255,255,.1);
      border-top-color: var(--silver);
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    /* Login card inside overlay */
    .login-card {
      display: none;
      flex-direction: column;
      width: 100%;
      max-width: 380px;
      padding: 0 1.5rem;
    }
    .login-card.visible { display: flex; }
    .login-logo { display:flex; align-items:center; gap:.6rem; margin-bottom:2.5rem; justify-content:center; }
    .login-logo__box { width:36px;height:36px;background:var(--brand);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff;border-radius:4px; }
    .login-logo__name { font-size:15px;font-weight:800;color:#fff; }
    .login-box { background:#0D1829;border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:2rem; }
    .login-box h2 { font-size:1.1rem;font-weight:700;color:#fff;margin-bottom:.25rem; }
    .login-box p { font-size:.8rem;color:rgba(255,255,255,.35);margin-bottom:1.5rem; }
    .login-field { margin-bottom:1rem; }
    .login-field label { display:block;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.35);margin-bottom:.35rem; }
    .login-field input { width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:5px;padding:.65rem .85rem;font-size:.88rem;color:#fff;font-family:inherit;outline:none;transition:border-color .15s; }
    .login-field input:focus { border-color:var(--brand-lt); }
    .login-field input::placeholder { color:rgba(255,255,255,.2); }
    .login-btn { width:100%;background:var(--brand);border:none;border-radius:5px;color:#fff;font-size:.88rem;font-weight:700;padding:.75rem;cursor:pointer;margin-top:.25rem;transition:background .15s;font-family:inherit; }
    .login-btn:hover { background:var(--brand-lt); }
    .login-btn:disabled { opacity:.5;cursor:not-allowed; }
    .login-err { background:rgba(220,38,38,.1);border:1px solid rgba(220,38,38,.25);border-radius:5px;color:#fca5a5;font-size:.78rem;padding:.55rem .85rem;margin-top:.85rem;display:none; }
    .login-link { display:block;width:100%;background:none;border:none;color:rgba(255,255,255,.4);font-size:.78rem;font-family:inherit;text-align:center;margin-top:1rem;cursor:pointer;transition:color .15s; }
    .login-link:hover { color:var(--brand-lt); }
    .login-box p.fp-question { font-size:.85rem;color:#fff;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:5px;padding:.65rem .85rem;margin-bottom:1.25rem;line-height:1.5; }

    /* ───── GLOBAL SEARCH ───── */
    .search-overlay {
      position: fixed; inset: 0;
      background: rgba(6,15,32,.5);
      z-index: 800;
      display: flex; justify-content: center;
      padding-top: 12vh;
      opacity: 0; pointer-events: none;
      transition: opacity .15s;
      backdrop-filter: blur(2px);
    }
    .search-overlay.open { opacity: 1; pointer-events: auto; }
    .search-palette {
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: 0 24px 64px rgba(11,28,58,.32);
      width: 100%; max-width: 560px;
      height: fit-content;
      max-height: 60vh;
      display: flex; flex-direction: column;
      overflow: hidden;
      transform: translateY(-8px);
      transition: transform .15s;
      margin: 0 1rem;
    }
    .search-overlay.open .search-palette { transform: translateY(0); }
    .search-input-row {
      display: flex; align-items: center; gap: .7rem;
      padding: .9rem 1.1rem;
      border-bottom: 1px solid var(--n80);
      color: #94A3B8;
      flex-shrink: 0;
    }
    .search-input-row input {
      flex: 1; border: none; outline: none; background: none;
      font-size: .92rem; font-family: inherit; color: var(--n10);
    }
    .search-input-row input::placeholder { color: #94A3B8; }
    .search-esc {
      font-size: .65rem; font-weight: 700; color: var(--n50);
      background: var(--n90); border: 1px solid var(--n80);
      border-radius: 4px; padding: .15rem .4rem; font-family: inherit;
      flex-shrink: 0;
    }
    .search-results { overflow-y: auto; padding: .5rem; }
    .search-empty {
      padding: 2rem 1rem; text-align: center; font-size: .82rem; color: var(--n50);
    }
    .search-group-label {
      font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
      color: #94A3B8; padding: .6rem .6rem .3rem;
    }
    .search-result-item {
      display: flex; align-items: center; gap: .7rem;
      padding: .55rem .6rem;
      border-radius: var(--radius);
      cursor: pointer;
      transition: background .1s;
    }
    .search-result-item:hover, .search-result-item--active { background: var(--n90); }
    .search-result-icon {
      width: 28px; height: 28px; border-radius: 7px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      background: rgba(27,63,139,.08); color: var(--brand);
    }
    .search-result-body { flex: 1; min-width: 0; }
    .search-result-title { font-size: .82rem; font-weight: 600; color: var(--navy); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .search-result-title mark { background: rgba(217,119,6,.25); color: inherit; border-radius: 2px; }
    .search-result-sub { font-size: .72rem; color: var(--n50); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .search-result-type { font-size: .62rem; font-weight: 700; color: #94A3B8; flex-shrink: 0; text-transform: uppercase; letter-spacing: .05em; }

    @keyframes search-flash {
      0%, 100% { background: transparent; }
      25%, 75% { background: rgba(217,119,6,.18); }
    }
    .search-highlight-flash { animation: search-flash 1.6s ease; }

    /* ───── MOBILE: sidebar drawer chrome (base rules, activated in media queries) ───── */
    .sidebar-toggle {
      display: none;
      width: 32px; height: 32px;
      align-items: center; justify-content: center;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.09);
      border-radius: 7px;
      color: rgba(255,255,255,.75);
      cursor: pointer;
      margin: 0 .5rem 0 .75rem;
      flex-shrink: 0;
    }
    .sidebar-toggle:hover { background: rgba(255,255,255,.1); }
    .sidebar-backdrop {
      display: none;
      position: fixed; inset: var(--topbar-h) 0 0 0;
      background: rgba(6,15,32,.5);
      z-index: 499;
      opacity: 0;
      transition: opacity .2s;
    }

    /* ═════════════════════════════════════════════════════════════════
       MOBILE / TABLET RESPONSIVE OVERRIDES
       ═════════════════════════════════════════════════════════════════ */
    @media (max-width: 900px) {
      /* When the (up to 9) industry cards stack into fewer columns they can
         exceed the viewport height. justify-content:center on an overflowing
         flex container clips the *top* of the content out of scroll reach
         (no negative scrollTop) — switch to flex-start so everything stays
         reachable by scrolling. */
      #industry-selector { justify-content: flex-start; padding-top: 2rem; }
    }

    @media (max-width: 860px) {
      /* Topbar: compress, show hamburger, drop non-essential chrome */
      .sidebar-toggle { display: flex; }
      .topbar { padding-right: .5rem; }
      .topbar__brand { width: auto; padding: 0 .5rem 0 0; border-right: none; }
      .topbar__brand-name { display: none; }
      .topbar__center { padding: 0 .5rem; gap: .5rem; min-width: 0; }
      .pilot-chip { display: none; }
      .topbar__sep { display: none; }
      .user-info { display: none; }
      .user-pill { padding: .25rem; margin-left: 0; }

      /* Sidebar becomes an off-canvas drawer over the content */
      .app-body { position: relative; }
      .sidebar {
        position: fixed;
        top: var(--topbar-h);
        bottom: 0;
        left: 0;
        width: min(82vw, 300px);
        z-index: 500;
        transform: translateX(-100%);
        transition: transform .25s ease;
        box-shadow: 8px 0 24px rgba(0,0,0,.15);
      }
      .sidebar.mobile-open { transform: translateX(0); }
      .sidebar-backdrop.open { display: block; opacity: 1; }

      .gantt-card--expanded { left: 0; }

      /* Grids: 4/5/3-column dashboard grids collapse to 2 columns */
      .kpi-grid,
      .cap-cards-grid,
      .kpis-grid,
      .res-cards-grid,
      .scenario-grid,
      .industry-grid { grid-template-columns: repeat(2, 1fr); }

      .bottom-grid { grid-template-columns: 1fr; }

      .main, .panel-page { padding: 1rem; gap: 1rem; }
    }

    @media (max-width: 560px) {
      /* Everything down to a single column on phone widths */
      .kpi-grid,
      .cap-cards-grid,
      .kpis-grid,
      .res-cards-grid,
      .scenario-grid,
      .industry-grid,
      .form-row,
      .au-sectors-grid { grid-template-columns: 1fr; }

      .main, .panel-page { padding: .75rem; gap: .75rem; }
      .page-header { flex-direction: column; align-items: stretch; }
      .header-actions { flex-wrap: wrap; }
      .header-actions .btn-ui { flex: 1 1 auto; justify-content: center; }

      /* Tables: allow horizontal scroll instead of illegible squishing.
         .time-table-wrap already has overflow-x:auto; .gantt-card (which
         wraps .orders-table directly, no dedicated wrapper) needs it added. */
      .cap-table { overflow-x: auto; }
      .gantt-card { overflow-x: auto; }
      .orders-table, .time-table { min-width: 640px; }

      /* Manual (5-day) Gantt: force a minimum column width so it scrolls
         instead of shrinking to unreadable slivers (the shift/turno Gantt
         already does this via minmax(44px,...) + #gantt-turno overflow-x). */
      .gantt-grid { min-width: 620px; }
      .gantt-timeline { grid-template-columns: repeat(5, minmax(90px, 1fr)); }
      #gantt-semana { overflow-x: auto; }

      .search-overlay { padding-top: 4vh; }
      .search-palette { max-height: 85vh; }

      .modal { width: 100%; max-width: calc(100vw - 1.5rem); }
      /* !important: several .modal__box instances set a narrower max-width
         inline (e.g. style="max-width:440px"), which would otherwise beat
         this class rule and let the card overflow past the screen edge. */
      .modal__box { max-width: calc(100vw - 1.5rem) !important; }
      .modal__body { max-height: calc(100vh - 160px); overflow-y: auto; }

      .orders-toolbar { flex-wrap: wrap; }
      .filter-chips { flex-wrap: wrap; }

      /* Auth / login card padding tighter on very small phones */
      .login-card { padding: 0 1rem; }
      .login-box { padding: 1.5rem; }
    }

    /* ═══ First Build — onboarding shell ═══ */
    #ob-welcome {
      position: fixed; inset: 0; z-index: 1200;
      display: none; align-items: center; justify-content: center;
      background: rgba(11,28,58,.5); backdrop-filter: blur(3px);
      padding: 1.5rem;
    }
    #ob-welcome.show { display: flex; }
    .ob-w-card {
      background: var(--white); border: 1px solid var(--n80);
      border-radius: var(--radius-lg); box-shadow: var(--shadow-md);
      max-width: 30rem; width: 100%; padding: 1.8rem 1.9rem;
    }
    .ob-eyebrow { font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); font-weight: 700; }
    .ob-w-card h2 { font-size: 1.35rem; line-height: 1.2; margin: .55rem 0 .55rem; color: var(--n20); }
    .ob-w-card p { font-size: .9rem; color: var(--n50); line-height: 1.55; margin: 0 0 1.2rem; }
    .ob-w-progress { font-size: .72rem; color: var(--n50); font-weight: 600; }
    .ob-w-bar { height: 5px; background: var(--n80); border-radius: 3px; overflow: hidden; margin: .35rem 0 1.3rem; }
    .ob-w-bar > i { display: block; height: 100%; background: var(--brand); border-radius: 3px; transition: width .4s cubic-bezier(.4,0,.2,1); }
    .ob-btns { display: flex; flex-wrap: wrap; gap: .6rem; }
    .ob-btn {
      font: inherit; font-size: .88rem; font-weight: 600; cursor: pointer; line-height: 1;
      padding: .6rem 1.05rem; border-radius: var(--radius);
      border: 1px solid var(--brand); background: var(--brand); color: #fff;
    }
    .ob-btn.ghost { background: transparent; color: var(--brand); }
    .ob-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

    #ob-checklist {
      position: fixed; right: 1rem; bottom: 1rem; z-index: 650;
      width: 19rem; max-width: calc(100vw - 2rem);
      background: var(--white); border: 1px solid var(--n80);
      border-radius: var(--radius-md); box-shadow: var(--shadow-md);
      overflow: hidden; font-size: .85rem; display: none;
    }
    #ob-checklist.show { display: block; }
    #ob-checklist.collapsed { width: auto; }
    #ob-checklist.collapsed .ob-cl-body, #ob-checklist.collapsed .ob-cl-foot { display: none; }
    #ob-checklist.collapsed .ob-cl-head { border-bottom: none; }
    .ob-cl-head {
      display: flex; align-items: center; justify-content: space-between; gap: .5rem;
      padding: .65rem .85rem; border-bottom: 1px solid var(--n80);
      font-weight: 700; color: var(--n20); font-size: .88rem; cursor: pointer;
    }
    .ob-cl-count { font-size: .72rem; color: var(--n50); font-weight: 600; white-space: nowrap; }
    .ob-cl-body { list-style: none; margin: 0; padding: .3rem 0; }
    .ob-cl-body li {
      display: grid; grid-template-columns: 1.15rem 1fr; gap: .55rem; align-items: center;
      padding: .5rem .85rem; cursor: pointer; color: var(--n30);
    }
    .ob-cl-body li:hover { background: var(--n90); }
    .ob-box {
      width: 1.15rem; height: 1.15rem; border-radius: 4px; border: 1.5px solid var(--n80);
      display: grid; place-items: center; color: #fff; font-size: .7rem; line-height: 1;
    }
    .ob-cl-body li.done { color: var(--n50); }
    .ob-cl-body li.done .ob-box { background: var(--green); border-color: var(--green); }
    .ob-cl-body li.now .ob-box { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(27,63,139,.14); }
    .ob-cl-foot {
      padding: .55rem .85rem; border-top: 1px solid var(--n80);
      display: flex; justify-content: space-between; align-items: center;
      font-size: .72rem; color: var(--n50);
    }
    .ob-cl-foot button { font: inherit; font-size: .72rem; background: none; border: none; color: var(--brand); cursor: pointer; font-weight: 600; padding: 0; }
    #ob-checklist.ob-cl-done .ob-cl-head { color: var(--green); }

    #ob-reopen {
      position: fixed; right: 1rem; bottom: 1rem; z-index: 649;
      display: none; align-items: center; gap: .4rem;
      background: var(--white); border: 1px solid var(--n80); border-radius: 999px;
      box-shadow: var(--shadow); padding: .48rem .85rem; cursor: pointer;
      font: inherit; font-size: .78rem; font-weight: 600; color: var(--brand);
    }
    #ob-reopen.show { display: inline-flex; }
    @media (prefers-reduced-motion: reduce) { .ob-w-bar > i { transition: none; } }

    /* ═══ Compact density (Configuración → Apariencia) ═══ */
    [data-density="compact"] .panel-page { padding: 1rem; gap: .85rem; }
    [data-density="compact"] .nav-item { padding: .38rem .7rem; font-size: .78rem; }
    [data-density="compact"] .nav-section { margin-bottom: .5rem; }
    [data-density="compact"] .kpi-card { padding: .85rem 1rem; }
    [data-density="compact"] .main { padding: 1rem; gap: 1rem; }
    [data-density="compact"] .gantt-grid__corner,
    [data-density="compact"] .gantt-res,
    [data-density="compact"] .pg-res-label { padding-top: .35rem; padding-bottom: .35rem; }
    [data-density="compact"] table td,
    [data-density="compact"] table th { padding-top: .4rem; padding-bottom: .4rem; }
    [data-density="compact"] .dash-panel .panel { padding: .85rem; }

    /* ═══ Configuración panel ═══ */
    .cfg-wrap { display: flex; flex-direction: column; gap: 1rem; max-width: 720px; }
    .cfg-card {
      background: var(--white); border: 1px solid var(--n80); border-radius: var(--radius-md);
      padding: 1.1rem 1.25rem;
    }
    .cfg-card__title { font-size: .9rem; font-weight: 700; color: var(--navy); margin-bottom: .25rem; }
    .cfg-card__sub { font-size: .72rem; color: var(--n50); margin-bottom: .9rem; line-height: 1.45; }
    .cfg-row {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding: .55rem 0; border-top: 1px solid var(--n90);
    }
    .cfg-row:first-of-type { border-top: none; }
    .cfg-row__label { font-size: .8rem; color: var(--n30); font-weight: 500; }
    .cfg-row__hint  { font-size: .68rem; color: var(--n50); margin-top: .1rem; }
    .cfg-seg { display: inline-flex; border: 1px solid var(--n80); border-radius: var(--radius); overflow: hidden; }
    .cfg-seg button {
      font: inherit; font-size: .74rem; font-weight: 600; padding: .35rem .8rem;
      background: var(--white); color: var(--n50); border: none; cursor: pointer;
      border-left: 1px solid var(--n80); transition: background var(--transition), color var(--transition);
    }
    .cfg-seg button:first-child { border-left: none; }
    .cfg-seg button.active { background: var(--brand); color: #fff; }
    .cfg-select {
      font: inherit; font-size: .78rem; padding: .35rem .6rem; border-radius: var(--radius);
      border: 1px solid var(--n80); background: var(--white); color: var(--n20); min-width: 160px;
    }
    .cfg-colors { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: .7rem; }
    .cfg-color {
      display: flex; align-items: center; gap: .6rem; padding: .5rem .6rem;
      border: 1px solid var(--n80); border-radius: var(--radius); background: var(--white);
    }
    .cfg-color input[type="color"] {
      width: 30px; height: 30px; border: none; border-radius: 6px; padding: 0;
      background: none; cursor: pointer; flex-shrink: 0;
    }
    .cfg-color input[type="color"]::-webkit-color-swatch { border: 1px solid var(--n80); border-radius: 6px; }
    .cfg-color input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
    .cfg-color__name { font-size: .74rem; color: var(--n30); }
    .cfg-color__hex  { font-size: .64rem; color: var(--n50); font-variant-numeric: tabular-nums; }
    .cfg-btn {
      font: inherit; font-size: .76rem; font-weight: 600; padding: .4rem .9rem;
      border-radius: var(--radius); border: 1px solid var(--n80); background: var(--white);
      color: var(--n30); cursor: pointer; transition: background var(--transition);
    }
    .cfg-btn:hover { background: var(--n90); }
    .cfg-btn--danger { color: var(--red); border-color: var(--red-bg); }
    .cfg-btn--danger:hover { background: var(--red-bg); }
    .cfg-card__foot { margin-top: .9rem; display: flex; gap: .6rem; flex-wrap: wrap; }
    [data-theme="dark"] .cfg-select { color: var(--n20); }
    [data-theme="dark"] .cfg-seg button { background: var(--white); }
    [data-theme="dark"] .cfg-card__title { color: var(--n20); }
    [data-theme="dark"] .cfg-btn { color: var(--n20); }
    [data-theme="dark"] .cfg-color input[type="color"]::-webkit-color-swatch { border-color: var(--n80); }

    /* ═══ Ayuda & soporte panel (reuses .cfg-* card styles) ═══ */
    .help-steps { list-style: none; display: flex; flex-direction: column; gap: .55rem; }
    .help-step { display: flex; gap: .7rem; align-items: flex-start; font-size: .8rem; color: var(--n30); line-height: 1.5; }
    .help-step__n {
      flex-shrink: 0; width: 1.4rem; height: 1.4rem; border-radius: 50%;
      background: var(--brand); color: #fff; font-size: .72rem; font-weight: 700;
      display: grid; place-items: center;
    }
    .help-links { display: flex; flex-wrap: wrap; gap: .5rem; }
    .help-link {
      font: inherit; font-size: .74rem; font-weight: 600; padding: .38rem .8rem;
      border-radius: var(--radius); border: 1px solid var(--n80); background: var(--white);
      color: var(--brand); cursor: pointer; transition: background var(--transition);
    }
    .help-link:hover { background: var(--n90); }
    .help-faq { display: flex; flex-direction: column; }
    .help-faq details {
      border-top: 1px solid var(--n90); padding: .55rem 0;
    }
    .help-faq details:first-child { border-top: none; }
    .help-faq summary {
      cursor: pointer; font-size: .8rem; font-weight: 600; color: var(--n20);
      list-style: none; display: flex; align-items: center; gap: .5rem;
    }
    .help-faq summary::-webkit-details-marker { display: none; }
    .help-faq summary::before {
      content: '+'; color: var(--brand); font-weight: 700; width: .8rem; flex-shrink: 0;
    }
    .help-faq details[open] summary::before { content: '\2212'; }
    .help-faq p { font-size: .76rem; color: var(--n30); line-height: 1.55; margin: .5rem 0 .1rem 1.3rem; }
    .help-gloss { display: grid; grid-template-columns: max-content 1fr; gap: .35rem .9rem; font-size: .76rem; }
    .help-gloss dt { font-weight: 700; color: var(--n20); }
    .help-gloss dd { color: var(--n30); line-height: 1.5; }
    .help-kbd { display: flex; flex-direction: column; gap: .5rem; }
    .help-kbd__row { display: flex; align-items: center; gap: .7rem; font-size: .78rem; color: var(--n30); }
    .help-kbd kbd {
      font: inherit; font-size: .7rem; font-weight: 600; padding: .12rem .45rem;
      border: 1px solid var(--n80); border-bottom-width: 2px; border-radius: 5px;
      background: var(--n90); color: var(--n20); white-space: nowrap;
    }
    .help-status-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .5rem 0; border-top: 1px solid var(--n90); font-size: .78rem; }
    .help-status-row:first-of-type { border-top: none; }
    .help-status-row span:first-child { color: var(--n30); }
    .help-status-row b { color: var(--n20); font-variant-numeric: tabular-nums; }
    .help-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: .4rem; vertical-align: middle; }
    .help-dot--ok { background: var(--green); }
    .help-dot--bad { background: var(--red); }
    .help-dot--wait { background: var(--amber); }
    .help-form { display: flex; flex-direction: column; gap: .7rem; }
    .help-form label { font-size: .74rem; font-weight: 600; color: var(--n30); margin-bottom: .25rem; display: block; }
    .help-input, .help-textarea, .help-form select {
      width: 100%; font: inherit; font-size: .8rem; padding: .5rem .65rem;
      border-radius: var(--radius); border: 1px solid var(--n80); background: var(--white); color: var(--n20);
    }
    .help-textarea { min-height: 110px; resize: vertical; }
    .help-form__ctx { font-size: .68rem; color: var(--n50); line-height: 1.5; }
    .help-form__msg { font-size: .75rem; min-height: 1.1em; }
    .help-form__msg--ok  { color: var(--green); }
    .help-form__msg--err { color: var(--red); }
    [data-theme="dark"] .help-link { background: var(--white); }
    [data-theme="dark"] .help-faq summary { color: var(--n20); }
    [data-theme="dark"] .help-kbd kbd { background: var(--n90); color: var(--n20); }
  </style>
</head>
<body>

<!-- Auth overlay — shows spinner while validating, login form if no token -->
<div id="auth-overlay">
  <div style="display:flex;flex-direction:column;align-items:center;gap:1rem" id="auth-spinner">
    <div class="spinner"></div>
    <p id="auth-spinner-msg" style="color:rgba(255,255,255,.35);font-size:.8rem;font-family:'Inter',sans-serif"></p>
  </div>
  <div class="login-card" id="login-card">
    <div class="login-logo">
      <div class="login-logo__box">PC</div>
      <span class="login-logo__name">Planning Core</span>
    </div>
    <div class="login-box" id="login-box">
      <h2>Accede a tu cuenta</h2>
      <p>Introduce tus credenciales para continuar</p>
      <div class="login-field">
        <label>Email</label>
        <input type="email" id="login-email" placeholder="tu@empresa.com" autocomplete="email"/>
      </div>
      <div class="login-field">
        <label>Contraseña</label>
        <input type="password" id="login-password" placeholder="••••••••" autocomplete="current-password"/>
      </div>
      <button class="login-btn" id="login-btn">Entrar →</button>
      <div class="login-err" id="login-err"></div>
      <button class="login-link" id="forgotPasswordLink" type="button">¿Olvidaste tu contraseña?</button>
    </div>

    <!-- Forgot password — step 1: enter email -->
    <div class="login-box" id="forgot-step1" style="display:none">
      <h2>Recuperar acceso</h2>
      <p>Introduce tu email para ver tu pregunta de seguridad</p>
      <div class="login-field">
        <label>Email</label>
        <input type="email" id="fp-email" placeholder="tu@empresa.com" autocomplete="email"/>
      </div>
      <button class="login-btn" id="fp-continue-btn">Continuar →</button>
      <div class="login-err" id="fp-step1-err"></div>
      <button class="login-link" id="fp-back-to-login-1" type="button">Volver a inicio de sesión</button>
    </div>

    <!-- Forgot password — step 2: answer security question + set new password -->
    <div class="login-box" id="forgot-step2" style="display:none">
      <h2>Recuperar acceso</h2>
      <p class="fp-question" id="fp-question"></p>
      <div class="login-field">
        <label>Respuesta</label>
        <input type="text" id="fp-answer" placeholder="Tu respuesta" autocomplete="off"/>
      </div>
      <div class="login-field">
        <label>Nueva contraseña</label>
        <input type="password" id="fp-new-password" placeholder="Mínimo 8 caracteres" autocomplete="new-password"/>
      </div>
      <button class="login-btn" id="fp-reset-btn">Restablecer contraseña</button>
      <div class="login-err" id="fp-step2-err"></div>
      <button class="login-link" id="fp-back-to-login-2" type="button">Volver a inicio de sesión</button>
    </div>
  </div>
</div>

