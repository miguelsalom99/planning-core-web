              <option value="averia">Avería de máquina</option>
              <option value="material">Material / proveedor</option>
              <option value="urgente">Pedido urgente</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Título <span style="color:var(--red)">*</span></label>
            <input class="form-input" id="disruptTitle" type="text" placeholder="Ej. Avería CNC-2" maxlength="200" />
          </div>
          <div class="form-group">
            <label class="form-label">Detalle (opcional)</label>
