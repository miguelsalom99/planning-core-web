            <div class="order-row">
              <span class="order-id">OF-2039</span>
              <span class="order-name">Placa base — Prototipo X</span>
              <div class="order-progress">
                <div class="progress-track"><div class="progress-fill" style="width:61%"></div></div>
                <span class="progress-pct">61%</span>
              </div>
              <span class="status-pill sp--ok">En plazo</span>
            </div>
            <div class="order-row">
              <span class="order-id">OF-2041</span>
              <span class="order-name">Soporte B — Serie 200</span>
              <div class="order-progress">
                <div class="progress-track"><div class="progress-fill" style="width:45%;background:#D97706"></div></div>
                <span class="progress-pct">45%</span>
              </div>
              <span class="status-pill sp--risk">Riesgo</span>
