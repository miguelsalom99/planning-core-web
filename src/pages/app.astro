            <td style="font-size:.78rem;color:var(--n50)">${c.user_count} usuario${c.user_count !== 1 ? 's' : ''}</td>
            <td style="font-size:.78rem;color:var(--n50)">${new Date(c.created_at).toLocaleDateString('es-ES')}</td>
