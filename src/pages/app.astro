  Configuración guiada
</button>

<style is:global>
  /* ── Planificación semanal fed by the OF engine ── */
  .home-plan-bar { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; font-size:.78rem; color:var(--n30); }
  .home-stale { color:var(--amber); font-weight:600; }
  .home-empty { padding:1rem 0; font-size:.8rem; color:var(--n50); }
  .home-order-dates { font-size:.72rem; color:var(--n50); white-space:nowrap; }
  .home-more { display:block; width:100%; margin:.5rem 0 .2rem; background:none; border:none; color:var(--brand);
               font:inherit; font-size:.76rem; font-weight:600; cursor:pointer; text-align:left; padding:.3rem 0; }
  #panel-gantt .alert-banner.home-alert--ok { background:var(--green-bg); border-color:rgba(22,163,74,.3); border-left-color:var(--green); }
  #panel-gantt .alert-banner.home-alert--info { background:rgba(27,63,139,.06); border-color:rgba(27,63,139,.2); border-left-color:var(--brand); }
  #panel-gantt .alert-banner.home-alert--bad { background:var(--red-bg); border-color:rgba(220,38,38,.3); border-left-color:var(--red); }
  #panel-gantt .alert-banner.home-alert--ok .alert-banner__body, #panel-gantt .alert-banner.home-alert--info .alert-banner__body,
  #panel-gantt .alert-banner.home-alert--bad .alert-banner__body { color:var(--n20); }
  .alert-banner .alert-banner__cta { border:none; font:inherit; }
  /* ── User-arranged layout (Personalizar vista) ─────────────────────────
     Global on purpose: the per-block bars are built in JS, and Astro only
     scopes elements it sees at build time. */
  .lw-region { display:grid; grid-template-columns:repeat(12, minmax(0, 1fr)); gap:1.25rem; }
  .lw { grid-column:span var(--lw-span, 12); min-width:0; position:relative; display:flex; flex-direction:column; gap:.75rem; }
  .lw[hidden] { display:none; }
  .lw > .demo-data-note { margin-bottom:0 !important; }
  .lw-region .lw .panel { height:100%; }
  /* The KPI block adapts its own columns to the width the user gave it. */
  .lw[data-widget="kpis"] { container-type:inline-size; }
  @container (max-width: 720px) { .lw-region .lw .kpi-grid { grid-template-columns:repeat(2, 1fr); } }
  @container (max-width: 380px) { .lw-region .lw .kpi-grid { grid-template-columns:1fr; } }
  @media (max-width: 860px) { .lw { grid-column:span 12; } }

  .lw-bar { display:none; align-items:center; gap:.4rem; flex-wrap:wrap; padding:.35rem .5rem; border:1px solid var(--n80);
            border-radius:8px; background:var(--white); font-size:.74rem; color:var(--n30); }
  .lw-bar__title { font-weight:700; color:var(--n20); flex:1 1 auto; min-width:8rem; }
  .lw-bar button, .lw-bar select { font:inherit; font-size:.72rem; border:1px solid var(--n80); background:var(--white);
            color:var(--n20); border-radius:6px; padding:.2rem .45rem; cursor:pointer; }
  .lw-bar button:hover, .lw-bar select:hover { border-color:var(--brand); }
  .lw-bar button:focus-visible, .lw-bar select:focus-visible { outline:2px solid var(--brand); outline-offset:1px; }
  .lw-bar__grip { cursor:grab !important; letter-spacing:-.1em; }
  .lw-bar__grip:active { cursor:grabbing !important; }
  .lw-bar button:disabled { opacity:.4; cursor:not-allowed; }
  .lw--collapsed > .lw-bar { display:flex; }
  .lw--collapsed > :not(.lw-bar) { display:none !important; }
  .lw-region.lw-editing .lw > .lw-bar { display:flex; border-style:dashed; border-color:var(--brand); }
  .lw-region.lw-editing .lw { outline:1px dashed rgba(27,63,139,.25); outline-offset:6px; border-radius:10px; }
  .lw-region.lw-editing .lw.lw--dragging { opacity:.45; }
  .lw-region.lw-editing .lw.lw--drop-before { box-shadow:-4px 0 0 0 var(--brand); }
  .lw-region.lw-editing .lw.lw--drop-after { box-shadow:4px 0 0 0 var(--brand); }

  .lw-tools { grid-column:1 / -1; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; padding:.6rem .8rem; border:1px solid var(--brand);
              border-radius:10px; background:rgba(27,63,139,.05); font-size:.78rem; color:var(--n20); }
  .lw-tools[hidden] { display:none; }
  .lw-tools__hint { flex:1 1 18rem; }
  .lw-tools button { font:inherit; font-size:.75rem; border:1px solid var(--n80); background:var(--white); color:var(--n20);
              border-radius:6px; padding:.3rem .6rem; cursor:pointer; }
  .lw-tools .lw-tools__done { background:var(--brand); border-color:var(--brand); color:#fff; font-weight:700; }
  .lw-tools__hidden { display:flex; gap:.35rem; flex-wrap:wrap; align-items:center; }
  #layoutEditBtn[aria-pressed="true"] { border-color:var(--brand); color:var(--brand); }

  /* Folded sidebar (desktop): more room for the Gantt. The menu button stays
     in the top bar to bring it back. */
  @media (min-width: 861px) {
    body.pc-sidebar-hidden .sidebar { display:none !important; }
    html body .topbar .sidebar-toggle { display:flex; }
  }
  /* Docked copilot: opens beside the screen instead of over it, below the
     top bar, so every control stays reachable. Wide screens only. */
  @media (min-width: 1100px) {
    body.pc-copilot-docked .pcx-drawer { top:var(--topbar-h); height:calc(100vh - var(--topbar-h)); box-shadow:none;
                                         width:min(430px, 34vw); }
    body.pc-copilot-docked:has(#copilotDrawer.pcx-open) .app-body { margin-right:min(430px, 34vw); }
    body.pc-copilot-docked:has(#copilotDrawer.pcx-open) #copilotFab { display:none !important; }
  }
  @media (max-width: 1099px) { #copilotDock { display:none; } }
  #copilotDock[aria-pressed="true"] { border-color:var(--brand); color:var(--brand); }
  /* ── KPI Intelligence + Planning Copilot (runtime-built nodes, so global + pcx- prefix) ── */
  .pcx-kpi-head { display:flex; justify-content:space-between; align-items:flex-end; gap:1rem; flex-wrap:wrap; margin-bottom:1rem; }
  .pcx-kpi-controls { display:flex; gap:.5rem; flex-wrap:wrap; }
  .pcx-select { width:auto; min-width:150px; font-size:.8rem; padding:.4rem .6rem; }
  .pcx-summary { background:var(--white); border:1px solid var(--n80); border-left:4px solid var(--brand); border-radius:10px; padding:1rem 1.1rem; margin-bottom:1rem; }
  .pcx-summary h3 { margin:0 0 .35rem; font-size:.78rem; text-transform:uppercase; letter-spacing:.05em; color:var(--n50); }
  .pcx-summary p { margin:0; font-size:.92rem; line-height:1.55; color:var(--n20); }
  .pcx-actions { margin:.75rem 0 0; padding:0; list-style:none; display:grid; gap:.5rem; }
  .pcx-action { background:var(--n90); border-radius:8px; padding:.6rem .75rem; font-size:.82rem; color:var(--n30); line-height:1.45; }
  .pcx-action b { color:var(--n20); display:block; margin-bottom:.15rem; }
  .pcx-action .pcx-impact { color:var(--green); font-weight:600; }
  .pcx-kpi-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(250px, 1fr)); gap:.85rem; }
  .pcx-kpi { background:var(--white); border:1px solid var(--n80); border-radius:12px; padding:1rem; display:flex; flex-direction:column; gap:.45rem; cursor:pointer; text-align:left; font:inherit; color:inherit; transition:box-shadow .15s, border-color .15s; }
  .pcx-kpi:hover, .pcx-kpi:focus-visible { border-color:var(--brand); box-shadow:0 4px 16px rgba(27,63,139,.12); outline:none; }
  .pcx-kpi__top { display:flex; justify-content:space-between; gap:.5rem; align-items:flex-start; }
  .pcx-kpi__name { font-size:.8rem; font-weight:600; color:var(--n30); line-height:1.3; }
  .pcx-kpi__val { font-size:1.75rem; font-weight:800; color:var(--n20); line-height:1.1; }
  .pcx-kpi__meta { font-size:.75rem; color:var(--n50); }
  .pcx-kpi__insight { font-size:.78rem; color:var(--n30); line-height:1.4; border-top:1px dashed var(--n80); padding-top:.45rem; }
  .pcx-st { font-size:.66rem; font-weight:700; padding:.2rem .5rem; border-radius:99px; white-space:nowrap; }
  .pcx-st--ok { background:var(--green-bg); color:var(--green); }
  .pcx-st--warn { background:var(--amber-bg); color:var(--amber); }
  .pcx-st--bad { background:var(--red-bg); color:var(--red); }
  .pcx-st--none { background:var(--n90); color:var(--n50); }
  .pcx-kpi__impact { font-size:.76rem; color:var(--n20); line-height:1.4; }
  .pcx-conf { font-size:.7rem; color:var(--n50); }
  .pcx-conf b { font-weight:600; }
  .pcx-conf--low b { color:var(--red); }
  .pcx-trend--good { color:var(--green); font-weight:700; } .pcx-trend--bad { color:var(--red); font-weight:700; } .pcx-trend--flat { color:var(--n50); }
