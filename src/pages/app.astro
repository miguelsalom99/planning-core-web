      function closeCompanyModal() { document.getElementById('companyModal')!.style.display = 'none'; }

      async function saveCompany() {
        const token = localStorage.getItem('pc_token');
        const name = (document.getElementById('cmp-name') as HTMLInputElement).value.trim();
        const industry = (document.getElementById('cmp-industry') as HTMLSelectElement).value || null;
        const plan = (document.getElementById('cmp-plan') as HTMLSelectElement).value || null;
        const pilot_start = (document.getElementById('cmp-pilot-start') as HTMLInputElement).value || null;
        const pwRaw = (document.getElementById('cmp-pilot-weeks') as HTMLInputElement).value.trim();
