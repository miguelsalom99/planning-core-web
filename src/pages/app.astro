              <div class="gantt-block gb--amber" style="width:100%">OF-2042 · Brida C</div>
            </div>
            <div class="gantt-cell">
              <div class="gantt-block gb--amber" style="width:100%">OF-2042</div>
            </div>
            <div class="gantt-cell">
              <div class="gantt-block gb--blue" style="width:60%">OF-2047</div>
            </div>
          </div>

          <!-- Soldadura -->
          <div class="gantt-resource">
            <div class="res-indicator res-indicator--blue"></div>
            <div>
              <div class="res-name">Soldadura</div>
              <div class="res-sub">Robot MIG · 85%</div>
            </div>
          </div>
          <div class="gantt-timeline">
            <div class="gantt-cell"></div>
            <div class="gantt-cell">
              <div class="gantt-block gb--green" style="width:100%">OF-2040 · Marco</div>
            </div>
            <div class="gantt-cell gantt-cell--today">
              <div class="gantt-block gb--green" style="width:100%">OF-2040</div>
            </div>
            <div class="gantt-cell">
              <div class="gantt-block gb--teal" style="width:100%">OF-2043 · Depósito</div>
            </div>
            <div class="gantt-cell">
              <div class="gantt-block gb--teal" style="width:80%">OF-2043</div>
            </div>
          </div>

          <!-- Acabados -->
