---
// App shell — standalone, no BaseLayout
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Planning Core — App</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:      #0B1C3A;
      --navy-mid:  #112347;
      --navy-dark: #060F20;
      --brand:     #1B3F8B;
      --brand-lt:  #2651B2;
      --silver:    #8BC2C6;
      --n90:       #F0F4FA;
      --n80:       #D4DDE8;
      --n50:       #8898AA;
      --n30:       #4A5060;
      --n20:       #1E293B;
      --white:     #ffffff;
      --green:     #16A34A;
      --green-bg:  #DCFCE7;
      --amber:     #D97706;
      --amber-bg:  #FEF3C7;
      --red:       #DC2626;
      --red-bg:    #FEE2E2;
      --sidebar-w: 228px;
      --topbar-h:  56px;
      --radius:    8px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --shadow-sm: 0 1px 2px rgba(11,28,58,.06), 0 1px 3px rgba(11,28,58,.08);
      --shadow:    0 2px 8px rgba(11,28,58,.08), 0 1px 2px rgba(11,28,58,.05);
      --shadow-md: 0 4px 16px rgba(11,28,58,.10);
      --transition: .15s cubic-bezier(.4,0,.2,1);
    }

    html, body {
      height: 100%;
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px;
      color: var(--n20);
      background: var(--n90);
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }

    /* ───── LAYOUT ───── */
    .app-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* ───── TOPBAR ───── */
    .topbar {
      height: var(--topbar-h);
      background: var(--navy);
      display: flex;
      align-items: center;
      padding: 0 1rem 0 0;
      gap: 0;
      flex-shrink: 0;
      border-bottom: 1px solid rgba(255,255,255,.06);
      position: relative;
      z-index: 100;
    }

    .topbar__brand {
      width: var(--sidebar-w);
      display: flex;
      align-items: center;
      gap: .6rem;
      padding: 0 1rem;
      flex-shrink: 0;
      border-right: 1px solid rgba(255,255,255,.07);
      height: 100%;
    }
    .topbar__brand img {
      height: 26px;
      width: 26px;
      object-fit: cover;
      border-radius: 6px;
    }
    .topbar__brand-name {
      font-size: .88rem;
      font-weight: 400;
      color: rgba(255,255,255,.75);
      letter-spacing: -.01em;
    }
    .topbar__brand-name strong {
      font-weight: 700;
      color: #fff;
    }

    .topbar__center {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0 1.25rem;
    }

    .back-btn {
      display: flex;
      align-items: center;
      gap: .35rem;
      font-size: .78rem;
      font-weight: 500;
      color: rgba(255,255,255,.55);
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: .3rem .5rem;
      border-radius: 6px;
      transition: all .15s;
      white-space: nowrap;
    }
    .back-btn:hover { color: rgba(255,255,255,.9); background: rgba(255,255,255,.07); }
    .back-btn svg { flex-shrink: 0; }
    .back-btn.hidden, .back-sep.hidden { display: none; }

    .topbar__company {
      display: flex;
      align-items: center;
      gap: .5rem;
    }
    .company-avatar {
      width: 26px;
      height: 26px;
      border-radius: 6px;
      background: linear-gradient(135deg, rgba(139,194,198,.3), rgba(139,194,198,.15));
      border: 1px solid rgba(139,194,198,.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .6rem;
      font-weight: 800;
      color: var(--silver);
      letter-spacing: .03em;
    }
    .company-name {
      font-size: .8rem;
      color: rgba(255,255,255,.75);
      font-weight: 500;
    }

    .topbar__sep {
      width: 1px;
      height: 18px;
      background: rgba(255,255,255,.1);
    }

    .pilot-chip {
      display: flex;
      align-items: center;
      gap: .6rem;
      background: rgba(255,255,255,.05);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 6px;
      padding: .3rem .75rem;
    }
    .pilot-chip__label {
      font-size: .67rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: rgba(255,255,255,.35);
    }
    .pilot-chip__val {
      font-size: .75rem;
      font-weight: 700;
      color: #fff;
    }
    .pilot-chip__track {
      width: 64px;
      height: 3px;
      background: rgba(255,255,255,.12);
      border-radius: 2px;
      overflow: hidden;
    }
    .pilot-chip__fill {
      height: 3px;
      background: linear-gradient(90deg, var(--silver), #6DB8BD);
      border-radius: 2px;
    }

    .topbar__right {
      display: flex;
      align-items: center;
      gap: .5rem;
      margin-left: auto;
    }

    .icon-btn {
      width: 32px;
      height: 32px;
      border-radius: 7px;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.09);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background var(--transition);
      position: relative;
    }
    .icon-btn:hover { background: rgba(255,255,255,.1); }
    .icon-btn svg { opacity: .6; }
    .notif-badge {
      position: absolute;
      top: 5px; right: 5px;
      width: 6px; height: 6px;
      background: #F97316;
      border-radius: 50%;
      border: 1.5px solid var(--navy);
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: .5rem;
      padding: .25rem .5rem .25rem .25rem;
      border-radius: 8px;
      cursor: pointer;
      transition: background var(--transition);
      border: 1px solid transparent;
      margin-left: .25rem;
    }
    .user-pill:hover {
      background: rgba(255,255,255,.06);
      border-color: rgba(255,255,255,.09);
    }
    .user-avatar {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      background: linear-gradient(135deg, var(--brand), var(--brand-lt));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .65rem;
      font-weight: 800;
      color: #fff;
      letter-spacing: .02em;
    }
    .user-info { display: flex; flex-direction: column; }
    .user-name {
      font-size: .75rem;
      font-weight: 600;
      color: rgba(255,255,255,.9);
      line-height: 1.2;
    }
    .user-role {
      font-size: .62rem;
      color: rgba(255,255,255,.35);
      line-height: 1.2;
    }

    /* ───── BODY ───── */
    .app-body {
      flex: 1;
      display: flex;
      overflow: hidden;
    }

    /* ───── SIDEBAR ───── */
    .sidebar.hidden { display: none; }
    .sidebar {
      width: var(--sidebar-w);
      background: var(--white);
      border-right: 1px solid var(--n80);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .nav-section {
      padding: 1rem .75rem .5rem;
    }
    .nav-section + .nav-section {
      border-top: 1px solid var(--n80);
    }
    .nav-section__label {
      font-size: .62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: #94A3B8;
      padding: 0 .6rem;
      margin-bottom: .35rem;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: .6rem;
      padding: .5rem .6rem;
      border-radius: var(--radius);
      font-size: .8rem;
      font-weight: 500;
      color: var(--n30);
      cursor: pointer;
      transition: all var(--transition);
      position: relative;
    }
    .nav-item:hover {
      background: var(--n90);
      color: var(--n20);
    }
    .nav-item--active {
      background: rgba(27,63,139,.07);
      color: var(--brand);
      font-weight: 600;
    }
    .nav-item--active svg { opacity: 1 !important; }
    .nav-item--danger { color: #EF4444; }
    .nav-item--danger svg { opacity: .6; }
    .nav-item--danger:hover { background: #FEE2E2; color: #DC2626; }
    .nav-item--active::before {
      content: '';
      position: absolute;
      left: 0; top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 18px;
      background: var(--brand);
      border-radius: 0 2px 2px 0;
    }
    .nav-item svg { opacity: .5; flex-shrink: 0; }

    .nav-badge {
      margin-left: auto;
      font-size: .6rem;
      font-weight: 700;
      padding: .15rem .45rem;
      border-radius: 999px;
      background: var(--amber-bg);
      color: #92400E;
    }
    .nav-badge--red {
      background: var(--red-bg);
      color: var(--red);
    }
    .nav-badge--blue {
      background: rgba(27,63,139,.1);
      color: var(--brand);
    }

    .sidebar__footer {
      margin-top: auto;
      padding: .75rem;
      border-top: 1px solid var(--n80);
    }
    .scorecard {
      background: var(--n90);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      padding: .85rem;
    }
    .scorecard__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: .65rem;
    }
    .scorecard__title {
      font-size: .65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #94A3B8;
    }
    .scorecard__week {
      font-size: .62rem;
      font-weight: 600;
      color: var(--brand);
      background: rgba(27,63,139,.08);
      padding: .1rem .4rem;
      border-radius: 4px;
    }
    .sc-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: .3rem 0;
    }
    .sc-row + .sc-row { border-top: 1px solid var(--n80); }
    .sc-name { font-size: .73rem; color: var(--n30); }
    .sc-val { font-size: .73rem; font-weight: 700; }
    .sc-val--green { color: var(--green); }
    .sc-val--amber { color: var(--amber); }

    /* ───── MAIN ───── */
    .main {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      scrollbar-width: thin;
    }

    /* ───── PAGE HEADER ───── */
    .page-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }
    .page-header__left h1 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--navy);
      letter-spacing: -.02em;
    }
    .page-header__meta {
      display: flex;
      align-items: center;
      gap: .5rem;
      margin-top: .2rem;
    }
    .page-header__sub {
      font-size: .75rem;
      color: var(--n50);
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--green);
      animation: pulse-dot 2s ease infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: .4; }
    }
    .live-label {
      font-size: .65rem;
      font-weight: 700;
      color: var(--green);
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .header-actions {
      display: flex;
      gap: .5rem;
      align-items: center;
    }

    .btn-ui {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      padding: .42rem .85rem;
      border-radius: var(--radius);
      font-size: .78rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all var(--transition);
      border: 1px solid var(--n80);
      background: var(--white);
      color: var(--n20);
      box-shadow: var(--shadow-sm);
    }
    .btn-ui:hover { background: var(--n90); border-color: var(--n80); }
    .btn-ui--primary {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
      box-shadow: 0 1px 4px rgba(27,63,139,.25);
    }
    .btn-ui--primary:hover {
      background: var(--brand-lt);
      border-color: var(--brand-lt);
      box-shadow: 0 2px 8px rgba(27,63,139,.3);
      transform: translateY(-1px);
    }

    /* ───── ALERT BANNER ───── */
    .alert-banner {
      display: flex;
      align-items: center;
      gap: .85rem;
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      border-left: 3px solid var(--amber);
      border-radius: var(--radius);
      padding: .7rem 1rem;
      font-size: .78rem;
      box-shadow: var(--shadow-sm);
    }
    .alert-banner__icon {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      background: var(--amber-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .alert-banner__body strong { color: #92400E; font-weight: 700; }
    .alert-banner__body { color: #78350F; flex: 1; line-height: 1.4; }
    .alert-banner__cta {
      font-size: .73rem;
      font-weight: 700;
      color: var(--amber);
      white-space: nowrap;
      cursor: pointer;
      padding: .3rem .65rem;
      border-radius: 6px;
      background: var(--amber-bg);
      border: 1px solid #FDE68A;
      transition: all var(--transition);
    }
    .alert-banner__cta:hover { background: #FEF9C3; }

    /* ───── KPI GRID ───── */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .kpi-card {
      background: var(--white);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      padding: 1rem 1.1rem 1.1rem;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
      transition: box-shadow var(--transition), transform var(--transition);
    }
    .kpi-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-1px);
    }
    .kpi-card::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
    .kpi-card--green::after { background: var(--green); }
    .kpi-card--blue::after  { background: var(--brand); }
    .kpi-card--amber::after { background: var(--amber); }
    .kpi-card--red::after   { background: var(--red); }

    .kpi-card__top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: .65rem;
    }
    .kpi-card__label {
      font-size: .68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #94A3B8;
    }
    .kpi-card__icon {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .kpi-card__icon--green { background: var(--green-bg); }
    .kpi-card__icon--blue  { background: rgba(27,63,139,.1); }
    .kpi-card__icon--amber { background: var(--amber-bg); }
    .kpi-card__icon--red   { background: var(--red-bg); }

    .kpi-card__val {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -.03em;
      line-height: 1;
      margin-bottom: .45rem;
    }
    .kpi-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .kpi-delta {
      display: inline-flex;
      align-items: center;
      gap: .2rem;
      font-size: .7rem;
      font-weight: 700;
      padding: .15rem .45rem;
      border-radius: 999px;
    }
    .kpi-delta--up   { background: var(--green-bg); color: var(--green); }
    .kpi-delta--down { background: var(--red-bg);   color: var(--red); }
    .kpi-delta--flat { background: var(--n90);      color: var(--n50); }
    .kpi-target { font-size: .67rem; color: #94A3B8; }

    /* ───── GANTT ───── */
    .gantt-card {
      background: var(--white);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .gantt-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .9rem 1.25rem;
      border-bottom: 1px solid var(--n80);
    }
    .gantt-header__title {
      font-size: .88rem;
      font-weight: 700;
      color: var(--navy);
    }
    .gantt-header__sub {
      font-size: .72rem;
      color: var(--n50);
      margin-top: .1rem;
    }
    .gantt-header__right {
      display: flex;
      align-items: center;
      gap: .75rem;
    }
    .tab-group {
      display: flex;
      background: var(--n90);
      border: 1px solid var(--n80);
      border-radius: 7px;
      padding: 2px;
      gap: 2px;
    }
    .tab {
      font-size: .72rem;
      font-weight: 600;
      padding: .28rem .65rem;
      border-radius: 5px;
      cursor: pointer;
      color: var(--n50);
      transition: all var(--transition);
    }
    .tab--active {
      background: var(--white);
      color: var(--n20);
      box-shadow: var(--shadow-sm);
    }

    /* Gantt grid */
    .gantt-grid {
      display: grid;
      grid-template-columns: 148px 1fr;
    }
    .gantt-grid__corner {
      background: var(--n90);
      border-bottom: 1px solid var(--n80);
      border-right: 1px solid var(--n80);
      padding: .45rem .9rem;
      display: flex;
      align-items: center;
    }
    .gantt-grid__corner span {
      font-size: .62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #94A3B8;
    }
    .gantt-days {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      background: var(--n90);
      border-bottom: 1px solid var(--n80);
    }
    .gantt-day {
      padding: .45rem .5rem;
      text-align: center;
      font-size: .65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: #94A3B8;
      border-right: 1px solid var(--n80);
    }
    .gantt-day:last-child { border-right: none; }
    .gantt-day--today {
      color: var(--brand);
      background: rgba(27,63,139,.04);
    }

    .gantt-row { display: contents; }

    .gantt-resource {
      display: flex;
      align-items: center;
      gap: .6rem;
      padding: .65rem .9rem;
      border-bottom: 1px solid var(--n80);
      border-right: 1px solid var(--n80);
      background: var(--white);
    }
    .gantt-row:last-child .gantt-resource,
    .gantt-row:last-child .gantt-timeline { border-bottom: none; }

    .res-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .res-indicator--green { background: var(--green); }
    .res-indicator--amber { background: var(--amber); }
    .res-indicator--blue  { background: var(--brand); }
    .res-indicator--gray  { background: #94A3B8; }

    .res-name { font-size: .77rem; font-weight: 600; color: var(--navy); }
    .res-sub  { font-size: .63rem; color: #94A3B8; margin-top: 1px; }

    .gantt-timeline {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      border-bottom: 1px solid var(--n80);
      min-height: 52px;
      position: relative;
    }
    .gantt-cell {
      border-right: 1px solid var(--n80);
      padding: .3rem .3rem;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .gantt-cell:last-child { border-right: none; }
    .gantt-cell--today { background: rgba(27,63,139,.025); }

    .gantt-block {
      height: 28px;
      border-radius: 5px;
      display: flex;
      align-items: center;
      padding: 0 .5rem;
      font-size: .63rem;
      font-weight: 600;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      cursor: grab;
      transition: filter var(--transition), transform var(--transition), opacity var(--transition);
      user-select: none;
    }
    .gantt-block:hover { filter: brightness(1.1); transform: scaleY(1.05); }
    .gantt-block.dragging { opacity: .3; cursor: grabbing; transform: none; filter: none; }
    .gantt-cell.drop-target {
      background: rgba(27,63,139,.07);
      outline: 2px dashed rgba(27,63,139,.35);
      outline-offset: -3px;
      border-radius: 4px;
    }
    .gantt-cell.drop-target--invalid { outline-color: rgba(220,38,38,.35); background: rgba(220,38,38,.04); }

    /* Replan loading */
    @keyframes spin-btn { to { transform: rotate(360deg); } }
    .spin-icon { animation: spin-btn .7s linear infinite; }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 1.75rem;
      left: 50%;
      transform: translateX(-50%) translateY(12px);
      background: #1E293B;
      color: #fff;
      font-size: .8rem;
      font-weight: 500;
      padding: .65rem 1.25rem;
      border-radius: 8px;
      box-shadow: 0 4px 24px rgba(0,0,0,.3);
      z-index: 9999;
      opacity: 0;
      transition: opacity .2s, transform .2s;
      white-space: nowrap;
      pointer-events: none;
    }
    .toast.visible { opacity: 1; transform: translateX(-50%) translateY(0); }

    .gb--blue   { background: var(--brand); }
    .gb--teal   { background: #0891B2; }
    .gb--green  { background: var(--green); }
    .gb--purple { background: #7C3AED; }
    .gb--amber  { background: var(--amber); }
    .gb--gray   { background: #64748B; }

    .today-line {
      position: absolute;
      top: 0; bottom: 0;
      width: 2px;
      background: var(--brand);
      left: 38%;
      z-index: 5;
      pointer-events: none;
    }
    .today-line::before {
      content: 'HOY';
      position: absolute;
      top: 4px;
      left: 50%;
      transform: translateX(-50%);
      font-size: .55rem;
      font-weight: 800;
      color: var(--brand);
      letter-spacing: .06em;
      background: rgba(27,63,139,.08);
      padding: .1rem .3rem;
      border-radius: 3px;
      white-space: nowrap;
    }

    .gantt-legend {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: .6rem 1.25rem;
      border-top: 1px solid var(--n80);
      background: var(--n90);
      flex-wrap: wrap;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: .35rem;
      font-size: .65rem;
      color: var(--n50);
    }
    .legend-dot {
      width: 8px;
      height: 8px;
      border-radius: 2px;
    }
    .gantt-legend__updated {
      margin-left: auto;
      font-size: .65rem;
      color: #94A3B8;
    }

    /* ───── BOTTOM ROW ───── */
    .bottom-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 1rem;
    }

    .panel {
      background: var(--white);
      border: 1px solid var(--n80);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .panel__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .8rem 1.1rem;
      border-bottom: 1px solid var(--n80);
    }
    .panel__title {
      font-size: .83rem;
      font-weight: 700;
      color: var(--navy);
    }
    .panel__count {
      font-size: .72rem;
      color: var(--n50);
      background: var(--n90);
      padding: .15rem .5rem;
      border-radius: 999px;
    }

    /* Orders */
    .order-list { padding: 0 1.1rem; }
    .order-row {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .55rem 0;
      border-bottom: 1px solid var(--n80);
    }
    .order-row:last-child { border-bottom: none; }
    .order-id {
      font-size: .75rem;
      font-weight: 700;
      color: var(--navy);
      min-width: 60px;
      font-variant-numeric: tabular-nums;
    }
    .order-name {
      font-size: .75rem;
      color: var(--n30);
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .order-progress {
      display: flex;
      align-items: center;
      gap: .5rem;
    }
    .progress-track {
      width: 56px;
      height: 4px;
      background: var(--n80);
      border-radius: 2px;
      overflow: hidden;
    }
    .progress-fill {
      height: 4px;
      background: var(--brand);
      border-radius: 2px;
    }
    .progress-pct {
      font-size: .68rem;
      font-weight: 700;
      color: var(--n50);
      min-width: 28px;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .status-pill {
      font-size: .63rem;
      font-weight: 700;
      padding: .2rem .55rem;
      border-radius: 999px;
      white-space: nowrap;
    }
    .sp--ok     { background: var(--green-bg); color: var(--green); }
    .sp--risk   { background: var(--amber-bg); color: var(--amber); }
    .sp--late   { background: var(--red-bg);   color: var(--red); }

    /* Capacity */
    .cap-list { padding: .9rem 1.1rem; display: flex; flex-direction: column; gap: .75rem; }
    .cap-row { display: flex; align-items: center; gap: .75rem; }
    .cap-name {
      font-size: .75rem;
      font-weight: 600;
      color: var(--navy);
      min-width: 80px;
    }
    .cap-track {
      flex: 1;
      height: 7px;
      background: var(--n80);
      border-radius: 4px;
      overflow: hidden;
    }
    .cap-fill { height: 7px; border-radius: 4px; }
    .cap-fill--ok   { background: var(--green); }
    .cap-fill--warn { background: var(--amber); }
    .cap-fill--over { background: var(--red); }
    .cap-pct {
      font-size: .72rem;
      font-weight: 700;
      min-width: 34px;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .cap-pct--ok   { color: var(--green); }
    .cap-pct--warn { color: var(--amber); }
    .cap-pct--over { color: var(--red); }

    /* ───── INDUSTRIES PANEL (sidebar) ───── */
    .industries-panel {
      border-top: 1px solid var(--n80);
      border-bottom: 1px solid var(--n80);
      background: #F8FAFC;
    }
    .industries-panel.hidden { display: none; }
    .industries-panel__toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .6rem .75rem;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: background var(--transition);
    }
    .industries-panel__toggle:hover { background: var(--n90); }
    .industries-panel__left {
      display: flex;
      align-items: center;
      gap: .45rem;
      font-size: .62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: #94A3B8;
    }
    .industries-panel__left svg { opacity: .6; }
    .industries-panel__right { display: flex; align-items: center; gap: .3rem; }
    .industries-panel__count {
      font-size: .6rem;
      font-weight: 700;
      background: rgba(27,63,139,.1);
      color: var(--brand);
      padding: .1rem .4rem;
      border-radius: 999px;
    }
    .industries-panel__chevron {
      color: #94A3B8;
      transition: transform .2s;
    }
    .industries-panel.collapsed .industries-panel__chevron { transform: rotate(-90deg); }

    .industries-panel__list {
      padding: .25rem .5rem .5rem;
      overflow: hidden;
    }
    .industries-panel.collapsed .industries-panel__list { display: none; }

    .ind-item {
      display: flex;
      align-items: center;
      gap: .55rem;
      padding: .38rem .5rem;
      border-radius: 6px;
      cursor: pointer;
      transition: background var(--transition);
      text-decoration: none;
    }
    .ind-item:hover { background: var(--n90); }
    .ind-item--active { background: rgba(27,63,139,.07); }
    .ind-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .ind-name {
      font-size: .77rem;
      font-weight: 500;
      color: var(--n30);
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ind-item--active .ind-name { color: var(--brand); font-weight: 600; }
    .ind-badge {
      font-size: .45rem;
      color: var(--brand);
      opacity: .7;
    }

    /* ───── INDUSTRY SELECTOR ───── */
    #industry-selector {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 2rem;
      background: var(--n90);
      overflow-y: auto;
    }
    #industry-selector.hidden { display: none; }
    #dashboard-view { display: none; flex: 1; overflow: hidden; }
    #dashboard-view.visible { display: flex; flex-direction: column; flex: 1; overflow: hidden; }

    .selector-header { text-align: center; margin-bottom: 2.5rem; }
    .selector-header h2 {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -.025em;
      margin-bottom: .4rem;
    }
    .selector-header p {
      font-size: .85rem;
      color: var(--n50);
      max-width: 380px;
      margin: 0 auto;
      line-height: 1.5;
    }

    .industry-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      width: 100%;
      max-width: 900px;
    }

    .industry-card {
      background: var(--white);
      border: 1.5px solid var(--n80);
      border-radius: var(--radius-lg);
      padding: 1.75rem 1.5rem 1.5rem;
      cursor: pointer;
      transition: all .18s cubic-bezier(.4,0,.2,1);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: .85rem;
      text-align: left;
    }
    .industry-card:hover {
      border-color: var(--brand);
      box-shadow: 0 4px 20px rgba(27,63,139,.12);
      transform: translateY(-2px);
    }
    .industry-card--active {
      border-color: rgba(27,63,139,.35);
      box-shadow: var(--shadow-sm);
    }
    .industry-card--active::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--brand);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .industry-card__badge {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      font-size: .6rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .1em;
      padding: .2rem .55rem;
      border-radius: 999px;
      width: fit-content;
    }
    .badge--pilot {
      background: rgba(27,63,139,.1);
      color: var(--brand);
    }
    .badge--available {
      background: var(--n90);
      color: var(--n50);
    }

    .industry-card__icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .icon--blue   { background: rgba(27,63,139,.1); }
    .icon--teal   { background: rgba(8,145,178,.1); }
    .icon--orange { background: rgba(220,104,3,.1); }

    .industry-card__name {
      font-size: .95rem;
      font-weight: 700;
      color: var(--navy);
      letter-spacing: -.01em;
      line-height: 1.25;
    }
    .industry-card__desc {
      font-size: .77rem;
      color: var(--n50);
      line-height: 1.5;
      flex: 1;
    }
    .industry-card__cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: .25rem;
    }
    .industry-card__link {
      font-size: .75rem;
      font-weight: 600;
      color: var(--brand);
    }
    .industry-card:hover .industry-card__link::after { content: ' →'; }
    .industry-card__kpis {
      font-size: .68rem;
      color: #94A3B8;
    }

    /* ───── LOADING / AUTH OVERLAY ───── */
    #auth-overlay {
      position: fixed;
      inset: 0;
      background: var(--navy-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      transition: opacity .3s;
    }
    #auth-overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }
    .spinner {
      width: 36px; height: 36px;
      border: 3px solid rgba(255,255,255,.1);
      border-top-color: var(--silver);
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>

<!-- Auth overlay — hidden once token validated -->
<div id="auth-overlay">
  <div class="spinner"></div>
</div>

<div class="app-shell">

  <!-- ── TOPBAR ── -->
  <header class="topbar">
    <a href="/" class="topbar__brand">
      <img src="/images/logo-small.png" alt="Planning Core" />
