      <!-- Industries panel — separate collapsible menu -->
      <div class="industries-panel hidden" id="industriesPanel">
        <button class="industries-panel__toggle" id="industriesToggle" aria-expanded="true">
          <div class="industries-panel__left">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>Industrias</span>
          </div>
          <div class="industries-panel__right">
            <span class="industries-panel__count">9</span>
            <svg class="industries-panel__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </button>
        <div class="industries-panel__list" id="industriesList">
          <a class="ind-item" href="#" data-industry="composites">
