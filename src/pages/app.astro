            <div class="gantt-cell"></div>
            <div class="gantt-cell">
              <div class="gantt-block gb--blue" style="width:100%">OF-2038 · Envío</div>
            </div>
          </div>
        </div>

        <div class="gantt-legend">
          <div class="legend-item"><div class="legend-dot" style="background:#1B3F8B"></div>En curso</div>
          <div class="legend-item"><div class="legend-dot" style="background:#0891B2"></div>Programado</div>
          <div class="legend-item"><div class="legend-dot" style="background:#16A34A"></div>Completado</div>
          <div class="legend-item"><div class="legend-dot" style="background:#D97706"></div>En riesgo</div>
          <div class="legend-item"><div class="legend-dot" style="background:#7C3AED"></div>Pendiente QC</div>
