      async function saveAdminUser() {
        const token = localStorage.getItem('pc_token');
        const errEl = document.getElementById('adminUserModalErr')!;
        const name = (document.getElementById('au-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('au-email') as HTMLInputElement).value.trim();
        const password = (document.getElementById('au-password') as HTMLInputElement).value;
        const companyIdRaw = (document.getElementById('au-company-id') as HTMLSelectElement).value;
        const sectors = [...document.querySelectorAll('#au-sectors input:checked')].map(i => (i as HTMLInputElement).value).join(',') || null;
        const is_admin = (document.getElementById('au-role') as HTMLSelectElement).value === 'true';

        if (!name || !email) { errEl.textContent = 'Nombre y email son obligatorios'; return; }
        if (!editingUserId && !password) { errEl.textContent = 'La contraseña es obligatoria para un usuario nuevo'; return; }
        if (password && password.length < 8) { errEl.textContent = 'La contraseña debe tener al menos 8 caracteres'; return; }
        errEl.textContent = '';

        let url = `${API_BASE}/admin/users`;
        let method = 'POST';
        let body: any = { name, email, password, company_id: companyIdRaw ? parseInt(companyIdRaw) : null, sector: sectors, is_admin };
        if (editingUserId) {
          url = `${API_BASE}/admin/users/${editingUserId}`;
          method = 'PATCH';
          const is_active = (document.getElementById('au-active') as HTMLSelectElement).value === 'true';
          body = { name, email, company_id: companyIdRaw ? parseInt(companyIdRaw) : null, sector: sectors, is_admin, is_active };
          if (password) body.new_password = password;
        }

        const res = await fetch(url, { method, headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (!res.ok) { const d = await res.json(); errEl.textContent = d.detail || 'Error al guardar'; return; }
        document.getElementById('adminUserModal')!.classList.remove('open');
        loadAdminUsers();
        showToast(editingUserId ? '✓ Usuario actualizado' : '✓ Usuario creado');
      }

      document.getElementById('newUserBtn')?.addEventListener('click', () => openUserModal());
      document.getElementById('adminUserModalClose')?.addEventListener('click', () => { document.getElementById('adminUserModal')!.classList.remove('open'); });
      document.getElementById('adminUserModalCancel')?.addEventListener('click', () => { document.getElementById('adminUserModal')!.classList.remove('open'); });
      document.getElementById('adminUserModalSave')?.addEventListener('click', saveAdminUser);
      document.getElementById('adminUserModal')?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === document.getElementById('adminUserModal')) document.getElementById('adminUserModal')!.classList.remove('open');
      });

