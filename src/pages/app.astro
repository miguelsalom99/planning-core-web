        closeCompanyModal();
        loadAdminCompanies();
        showToast(editingCompanyId ? '✓ Empresa actualizada' : '✓ Empresa creada');
      }

      async function deleteCompany(id: number, name: string) {
        if (!confirm(`¿Eliminar "${name}"?\nLos usuarios vinculados quedarán sin empresa.`)) return;
        const token = localStorage.getItem('pc_token');
        await fetch(`${API_BASE}/admin/companies/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
        loadAdminCompanies();
        showToast('Empresa eliminada');
