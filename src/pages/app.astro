  };

  // HTML-escape any server/user-supplied value before it goes into an HTML
  // template string. Top-level so every builder in this file can reach it
  // (the older escapeHtml lives inside initDashboard's scope).
  function escHtml(v: unknown): string {
    return String(v ?? '').replace(/[&<>"']/g, c => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
  }

  // Server-side logout (audit S6): revokes every session of this account, so a
  // token copied out of localStorage stops working too. Best-effort and
  // non-blocking (keepalive survives the reload that follows); the local token
  // is always dropped by the caller.
  function revokeServerSession(): void {
    const token = localStorage.getItem('pc_token');
    if (!token) return;
    try {
      fetch(`${API}/auth/logout`, { method: 'POST', headers: { Authorization: `Bearer ${token}` }, keepalive: true })
        .catch(() => {});
    } catch { /* offline: the token still expires on its own */ }
  }

  // ── Safe DOM builder for the KPI dashboard + copilot: every value goes in via
  // textContent / setAttribute, never innerHTML, so server or AI text cannot
  // inject markup.
  function el(tag: string, props: Record<string, any> = {}, ...kids: any[]): HTMLElement {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(props)) {
      if (v == null || v === false) continue;
      if (k === 'class') n.className = String(v);
      else if (k === 'text') n.textContent = String(v);
      else if (k.startsWith('on') && typeof v === 'function') n.addEventListener(k.slice(2), v);
      else n.setAttribute(k, String(v));
    }
    for (const c of kids.flat()) {
      if (c == null || c === false) continue;
      n.appendChild(typeof c === 'string' || typeof c === 'number' ? document.createTextNode(String(c)) : c);
    }
    return n;
  }
  function svgEl(tag: string, attrs: Record<string, any>): SVGElement {
    const n = document.createElementNS('http://www.w3.org/2000/svg', tag);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
    return n;
  }
  async function apiJson(path: string, init: RequestInit = {}) {
    const res = await fetch(`${API}${path}`, {
      ...init,
      headers: { Authorization: `Bearer ${localStorage.getItem('pc_token')}`, 'Content-Type': 'application/json',
                 ...(init.headers || {}) },
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      // `detail` is a string, an object with a message (routing release) or FastAPI's list of field errors.
      const d = body.detail;
      const msg = typeof d === 'string' ? d : d?.message || (Array.isArray(d) && d[0]?.msg) || `HTTP ${res.status}`;
      throw Object.assign(new Error(msg), { status: res.status, body });
    }
    return body;
  }

  // The plan currently open in the planner (last "Planificar" request) — the
  // copilot's context for "¿cómo va mi plan?" and what-if simulations.
  let lastPlanRequest: any = null;

  // ── KPI Intelligence dashboard ────────────────────────────────────────────
  const KPI_STATUS: Record<string, [string, string]> = {
    healthy: ['En objetivo', 'pcx-st pcx-st--ok'], attention: ['Requiere atención', 'pcx-st pcx-st--warn'],
    critical: ['Crítico', 'pcx-st pcx-st--bad'], no_data: ['Sin datos', 'pcx-st pcx-st--none'],
  };
  const KPI_CONF: Record<string, string> = { high: 'alta', medium: 'media', low: 'baja' };
  function confLine(c: any): HTMLElement | null {
    if (!c || !KPI_CONF[c.level]) return null;
    return el('div', { class: `pcx-conf${c.level === 'low' ? ' pcx-conf--low' : ''}`, title: c.reason },
      'Confianza ', el('b', { text: KPI_CONF[c.level] }), ` · ${c.reason}`);
  }
  const kpiState = { period: 28, plant: '', detailKey: null as string | null, gran: 'week', detailPeriod: 90, resource: '' };

  function fmtKpi(v: any, unit: string): string {
    if (v == null) return '—';
    const n = Math.round(Number(v) * 10) / 10;
    return unit === '%' ? `${n}%` : `${n} ${unit}`;
  }
  function trendClass(k: any): string {
    const d = k.trend?.direction;
    if (!d || d === 'flat' || k.previous == null) return 'pcx-trend--flat';
    const better = k.direction === 'higher' ? d === 'up' : k.direction === 'lower' ? d === 'down'
      : Math.abs(k.value - k.target) < Math.abs(k.previous - k.target);
    return better ? 'pcx-trend--good' : 'pcx-trend--bad';
  }
  function trendText(k: any): string {
    if (k.pct_change == null) return '';
    const arrow = k.trend?.direction === 'up' ? '↑' : k.trend?.direction === 'down' ? '↓' : '→';
    const streak = k.trend?.worsening_periods >= 2 ? ` · empeora ${k.trend.worsening_periods} periodos` : '';
    return `${arrow} ${k.pct_change > 0 ? '+' : ''}${k.pct_change}% vs. periodo anterior${streak}`;
  }
  function sparkBars(values: any[]): HTMLElement {
    const nums = values.filter(v => v != null) as number[];
    const max = Math.max(1, ...nums.map(Math.abs));
    const wrap = el('div', { class: 'pcx-spark', 'aria-hidden': 'true' });
    values.forEach((v, i) => {
      const h = v == null ? 0 : Math.max(6, Math.round((Math.abs(v) / max) * 100));
      wrap.appendChild(el('span', { style: `height:${h}%;${v == null ? 'opacity:.25' : ''}`,
                                    class: i === values.length - 1 ? 'pcx-last' : '' }));
    });
    return wrap;
  }

  async function loadKpiOverview() {
    const grid = document.getElementById('kpiGrid');
    const concl = document.getElementById('kpiConclusion');
    const unav = document.getElementById('kpiUnavailable');
    if (!grid || !concl || !unav) return;
    document.getElementById('kpiOverview')!.style.display = '';
    document.getElementById('kpiDetail')!.style.display = 'none';
    kpiState.detailKey = null;
    grid.replaceChildren(el('div', { class: 'pcx-empty', text: 'Calculando indicadores…' }));
    let data: any;
    try {
      const q = `?period_days=${kpiState.period}${kpiState.plant ? `&plant_id=${encodeURIComponent(kpiState.plant)}` : ''}`;
      data = await apiJson(`/api/kpis${q}`);
    } catch (e: any) {
      grid.replaceChildren(el('div', { class: 'pcx-empty', text: e.status === 403
        ? 'Tu usuario no tiene acceso al módulo de KPIs.' : 'No se pudieron cargar los KPIs. Inténtalo de nuevo.' }));
      return;
    }
    const cov = data.data_coverage || {};
    document.getElementById('kpiSub')!.textContent =
      `Basado en ${cov.simulations ?? 0} simulaciones, ${cov.disruptions ?? 0} disrupciones y ${cov.milestones ?? 0} hitos del periodo.`;
    concl.replaceChildren(
      el('h3', { text: 'Conclusión ejecutiva' }),
      el('p', { text: data.conclusion }),
      (data.recommendations || []).length ? el('ul', { class: 'pcx-actions' },
        (data.recommendations || []).slice(0, 3).map((r: any) => el('li', { class: 'pcx-action' },
          el('b', { text: r.title }), r.why, ' ', el('span', { class: 'pcx-impact', text: `Impacto esperado: ${r.expected_impact}` })))) : null,
    );
    grid.replaceChildren(...(data.kpis || []).map((k: any) => {
      const [stTxt, stCls] = KPI_STATUS[k.status] || KPI_STATUS.no_data;
      return el('button', { class: 'pcx-kpi', type: 'button', onclick: () => openKpiDetail(k.key), title: k.description || '',
                            'aria-label': `${k.name}: ${fmtKpi(k.value, k.unit)}, ${stTxt}. Ver análisis` },
        el('div', { class: 'pcx-kpi__top' }, el('div', { class: 'pcx-kpi__name', text: k.name }), el('span', { class: stCls, text: stTxt })),
        el('div', { class: 'pcx-kpi__val', text: fmtKpi(k.value, k.unit) }),
        el('div', { class: 'pcx-kpi__meta' },
          `Objetivo ${fmtKpi(k.target, k.unit)}`,
          k.gap != null ? ` · brecha ${k.gap > 0 ? '+' : ''}${Math.round(k.gap * 10) / 10}` : ''),
        k.pct_change != null ? el('div', { class: `pcx-kpi__meta ${trendClass(k)}`, text: trendText(k) }) : null,
        sparkBars(k.spark || []),
        k.impact ? el('div', { class: 'pcx-kpi__impact', text: `Impacto: ${k.impact}` }) : null,
        k.insight ? el('div', { class: 'pcx-kpi__insight', text: k.insight })
          : k.empty_hint ? el('div', { class: 'pcx-kpi__insight', text: k.empty_hint }) : null,
        confLine(k.confidence),
      );
    }));
    unav.replaceChildren(
      el('h4', { text: 'Indicadores de negocio pendientes de conectar' }),
      el('div', { class: 'pcx-unav-grid' }, (data.unavailable || []).map((u: any) =>
        el('div', { class: 'pcx-unav' }, el('b', { text: u.name }), `Requiere: ${u.requires}`))),
    );
  }

  function kpiChart(series: any[], target: number, unit: string): SVGElement {
    const W = 640, H = 190, P = { l: 38, r: 10, t: 12, b: 26 };
    const vals = series.map(p => p.value).filter((v: any) => v != null) as number[];
    const max = Math.max(target || 0, ...vals, 1) * 1.1;
    const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, class: 'pcx-chart', role: 'img',
                               'aria-label': 'Serie histórica del indicador con línea de objetivo' });
    const y = (v: number) => P.t + (H - P.t - P.b) * (1 - v / max);
    const bw = (W - P.l - P.r) / Math.max(1, series.length);
    [0, 0.5, 1].forEach(f => {
      const v = max * f;
      svg.appendChild(svgEl('line', { x1: P.l, x2: W - P.r, y1: y(v), y2: y(v), stroke: 'var(--n90)' }));
      const t = svgEl('text', { x: 2, y: y(v) + 4, 'font-size': 10, fill: 'var(--n50)' }); t.textContent = fmtKpi(Math.round(v), unit === '%' ? '%' : ''); svg.appendChild(t);
    });
    series.forEach((p, i) => {
      if (p.value == null) return;
      const x = P.l + i * bw + bw * 0.15;
      const r = svgEl('rect', { x, y: y(p.value), width: Math.max(2, bw * 0.7), height: Math.max(1, y(0) - y(p.value)),
                                rx: 2, fill: 'var(--brand)', opacity: i === series.length - 1 ? 1 : 0.55 });
      const tt = svgEl('title', {}); tt.textContent = `${p.period}: ${fmtKpi(p.value, unit)}`; r.appendChild(tt);
      svg.appendChild(r);
    });
    const step = Math.max(1, Math.ceil(series.length / 6));
    series.forEach((p, i) => {
      if (i % step) return;
      const t = svgEl('text', { x: P.l + i * bw, y: H - 8, 'font-size': 10, fill: 'var(--n50)' });
      t.textContent = String(p.period).slice(5); svg.appendChild(t);
    });
    if (target != null) {
      svg.appendChild(svgEl('line', { x1: P.l, x2: W - P.r, y1: y(target), y2: y(target), stroke: 'var(--red)',
                                      'stroke-dasharray': '5 4', 'stroke-width': 1.5 }));
      const t = svgEl('text', { x: W - P.r - 90, y: y(target) - 4, 'font-size': 10, fill: 'var(--red)' });
      t.textContent = `Objetivo ${fmtKpi(target, unit)}`; svg.appendChild(t);
    }
    return svg;
  }

  async function openKpiDetail(key: string) {
    const box = document.getElementById('kpiDetail');
    if (!box) return;
    kpiState.detailKey = key;
    document.getElementById('kpiOverview')!.style.display = 'none';
    box.style.display = '';
    box.replaceChildren(el('div', { class: 'pcx-empty', text: 'Analizando el indicador…' }));
    let d: any;
    try {
      const q = new URLSearchParams({ period_days: String(kpiState.detailPeriod), granularity: kpiState.gran });
      if (kpiState.plant) q.set('plant_id', kpiState.plant);
      if (kpiState.resource) q.set('resource', kpiState.resource);
      d = await apiJson(`/api/kpis/${encodeURIComponent(key)}?${q}`);
    } catch (e: any) {
      box.replaceChildren(el('button', { class: 'pcx-back', type: 'button', text: '← Todos los KPIs', onclick: loadKpiOverview }),
                          el('div', { class: 'pcx-empty', text: 'No se pudo cargar el análisis.' }));
      return;
    }
    const s = d.summary;
    const [stTxt, stCls] = KPI_STATUS[s.status] || KPI_STATUS.no_data;
    const seg = (opts: [string, string][], cur: string, on: (v: string) => void) =>
      el('div', { class: 'pcx-seg', role: 'group' }, opts.map(([v, label]) =>
        el('button', { type: 'button', class: v === cur ? 'pcx-on' : '', text: label, 'aria-pressed': String(v === cur),
                       onclick: () => { on(v); openKpiDetail(key); } })));
    const canEditTarget = !!currentUser?.is_admin;
    const targetInput = el('input', { class: 'form-input', type: 'number', step: 'any', min: '0', value: String(s.target) }) as HTMLInputElement;
    const drivers = d.root_causes?.drivers || [];
    box.replaceChildren(
      el('div', { class: 'pcx-detail-head' },
        el('button', { class: 'pcx-back', type: 'button', text: '← Todos los KPIs', onclick: loadKpiOverview }),
        el('div', { class: 'panel-page-title', text: d.name }), el('span', { class: stCls, text: stTxt })),
      el('div', { class: 'pcx-sections' },
        el('section', { class: 'pcx-sec pcx-sec--wide' },
          el('h3', { text: 'Conclusión ejecutiva' }), el('div', { class: 'pcx-conclusion', text: d.conclusion }),
          el('div', { class: 'pcx-chips', style: 'padding:.7rem 0 0' },
            ['¿Por qué está cambiando este KPI?', '¿Qué debería mejorar primero?', 'Resume los mayores riesgos'].map(q =>
              hasAccess('copilot') ? el('button', { class: 'pcx-chip', type: 'button', text: q, onclick: () => openCopilot(q) }) : null))),
        el('section', { class: 'pcx-sec' },
          el('h3', { text: '1 · Definición' }),
          el('dl', { class: 'pcx-dl' },
            el('dt', { text: 'Qué mide' }), el('dd', { text: d.definition.what }),
            el('dt', { text: 'Por qué importa' }), el('dd', { text: d.definition.why }),
            el('dt', { text: 'Cálculo' }), el('dd', { text: d.definition.formula }),
            el('dt', { text: 'Fuentes' }), el('dd', { text: (d.definition.sources || []).join(' · ') }),
            d.definition.reference ? el('dt', { text: 'Referencia' }) : null,
            d.definition.reference ? el('dd', { text: d.definition.reference }) : null),
          el('div', { class: 'pcx-muted', style: 'margin-top:.6rem' },
            `Actual ${fmtKpi(s.value, d.unit)} · objetivo ${fmtKpi(s.target, d.unit)}`,
            s.gap != null ? ` · brecha ${s.gap > 0 ? '+' : ''}${Math.round(s.gap * 10) / 10}` : '',
            s.pct_change != null ? ` · ${s.pct_change > 0 ? '+' : ''}${s.pct_change}% vs. periodo anterior` : ''),
          s.impact ? el('div', { class: 'pcx-kpi__impact', style: 'margin-top:.4rem', text: `Impacto: ${s.impact}` }) : null,
          confLine(s.confidence),
          canEditTarget ? el('div', { class: 'pcx-target' }, el('label', { class: 'pcx-muted', text: 'Objetivo de la empresa' }), targetInput,
            el('button', { class: 'btn-ui', type: 'button', text: 'Guardar', onclick: async () => {
              try {
                await apiJson(`/api/kpis/${encodeURIComponent(key)}/target`, { method: 'PUT', body: JSON.stringify({ target: Number(targetInput.value) }) });
                showToast('✓ Objetivo actualizado'); openKpiDetail(key);
              } catch (e: any) { showToast(`⚠ ${e.message}`); }
            } })) : null),
        el('section', { class: 'pcx-sec' },
          el('h3', { text: '2 · Evolución histórica' }),
          el('div', { style: 'display:flex;gap:.5rem;flex-wrap:wrap' },
            seg([['day', 'Día'], ['week', 'Semana'], ['month', 'Mes']], kpiState.gran, v => { kpiState.gran = v; }),
            seg([['30', '30 d'], ['90', '90 d'], ['365', '1 año']], String(kpiState.detailPeriod), v => { kpiState.detailPeriod = Number(v); })),
          kpiChart(d.series || [], s.target, d.unit),
          el('div', { class: 'pcx-muted' },
            `Mismo periodo del año anterior: ${fmtKpi(d.year_over_year?.last_year, d.unit)} (actual ${fmtKpi(d.year_over_year?.current, d.unit)})`),
          (d.filters?.unsupported || []).length ? el('div', { class: 'pcx-muted', text: `Filtros no aplicables: ${d.filters.unsupported.join('; ')}.` }) : null,
          el('div', { class: 'pcx-muted', text: `Filtros por ${(d.filters?.not_available || []).join(' y ')} disponibles cuando se conecten esos datos.` })),
        el('section', { class: 'pcx-sec' },
          el('h3', { text: '3 · Causas asociadas' }),
          drivers.length ? el('div', {}, drivers.map((x: any) => el('div', { class: 'pcx-driver' },
            el('div', { class: 'pcx-driver__row' }, el('span', { text: x.factor }), el('span', { text: x.share_pct != null ? `${x.share_pct}%` : '' })),
            x.share_pct != null ? el('div', { class: 'pcx-bar' }, el('i', { style: `width:${Math.min(100, x.share_pct)}%` })) : null,
            el('div', { class: 'pcx-muted', text: x.evidence }))))
            : el('p', { text: 'Sin causas registradas en el periodo. Registra disrupciones para poder explicar los cambios.' }),
          d.root_causes?.method ? el('div', { class: 'pcx-muted', text: d.root_causes.method }) : null),
        el('section', { class: 'pcx-sec' },
          el('h3', { text: '4 · Impacto' }),
          (d.impact?.items || []).length ? el('ul', {}, d.impact.items.map((i: string) => el('li', { text: i })))
            : el('p', { text: 'No hay datos suficientes para estimar el impacto operativo.' }),
          el('div', { class: 'pcx-muted', text: d.impact?.economic })),
        el('section', { class: 'pcx-sec pcx-sec--wide' },
          el('h3', { text: '5 · Acciones recomendadas' }),
          (d.recommendations || []).length ? el('ul', { class: 'pcx-actions' }, d.recommendations.map((r: any) =>
            el('li', { class: 'pcx-action' }, el('b', { text: r.title }), `Por qué: ${r.why} `,
              el('span', { class: 'pcx-impact', text: `Impacto esperado: ${r.expected_impact}` }),
              el('div', { class: 'pcx-muted', text: `Base: ${r.basis}` }))))
            : el('p', { text: s.status === 'healthy' ? 'El indicador está en objetivo: no hay acciones urgentes.'
                                                     : 'No hay datos suficientes para recomendar una acción concreta.' })),
      ),
    );
  }

  function initKpiDashboard() {
    const per = document.getElementById('kpiPeriod') as HTMLSelectElement | null;
    const plant = document.getElementById('kpiPlant') as HTMLSelectElement | null;
    per?.addEventListener('change', () => { kpiState.period = Number(per.value); loadKpiOverview(); });
    plant?.addEventListener('change', () => {
      kpiState.plant = plant.value;
      kpiState.detailKey ? openKpiDetail(kpiState.detailKey) : loadKpiOverview();
    });
    apiJson('/api/plants').then((plants: any[]) => {
      if (!plant) return;
      plants.forEach(p => plant.appendChild(el('option', { value: String(p.id), text: p.name })));
      if (plants.length < 2) plant.style.display = 'none';
    }).catch(() => { if (plant) plant.style.display = 'none'; });
    const ask = document.getElementById('kpiAskCopilot');
    if (ask && hasAccess('copilot')) {
      ask.style.display = '';
      ask.addEventListener('click', () => openCopilot());
    }
  }

  // ── Planning Copilot ──────────────────────────────────────────────────────
  const copilotState = { history: [] as { role: 'user' | 'assistant'; content: string }[], busy: false };
  // What the user is looking at in MRP & Tiempos → Rutas y OF. Only ids and a
  // label travel to the server, which resolves ownership against the user's
  // company before any of it reaches the model (app/copilot_context.py).
  let copilotFocus: { order_id?: number; operation_id?: number; part_id?: number; resource_id?: number; label?: string } | null = null;
  function setCopilotFocus(f: typeof copilotFocus) {
    copilotFocus = f;
    const ctx = document.getElementById('copilotCtx');
    if (ctx && document.getElementById('copilotDrawer')?.classList.contains('pcx-open')) copilotChips();
  }

  function copilotPage(): { page: string; kpi_key: string | null; label: string } {
    const visible = (id: string) => { const p = document.getElementById(id) as HTMLElement | null; return !!p && p.style.display !== 'none'; };
    if (visible('panel-kpis')) return { page: 'kpis', kpi_key: kpiState.detailKey, label: kpiState.detailKey ? 'KPIs · análisis del indicador' : 'KPIs · visión general' };
    if (visible('panel-mrp')) return { page: 'mrp', kpi_key: null, label: `MRP & Tiempos${copilotFocus?.label ? ' · ' + copilotFocus.label : ' · rutas y OF'}` };
    return { page: 'planner', kpi_key: null, label: lastPlanRequest ? `Planificador · semana del ${lastPlanRequest.week_start}` : 'Planificador · sin plan generado' };
  }

  function copilotChips() {
    const box = document.getElementById('copilotChips');
    if (!box) return;
    const ctx = copilotPage();
    // [question, request_type] — the context (plan, OF, operation…) is sent automatically.
    const f = copilotFocus;
    const qs: [string, string][] = ctx.page === 'kpis'
      ? [['¿Por qué está bajando este KPI?', 'free'], ['¿Qué debería mejorar primero?', 'find_risks'], ['Resume los mayores riesgos', 'find_risks']]
      : ctx.page === 'mrp'
      ? [
          ...(f?.operation_id ? [['¿Qué pasa con esta operación y cómo lo soluciono?', 'whats_wrong'] as [string, string]] : []),
          ...(f?.order_id ? [['¿Qué le pasa a esta OF?', 'whats_wrong'], ['¿Por qué se retrasa esta OF?', 'why_delayed'],
                             ['¿Qué operación consume más capacidad en esta OF?', 'check_capacity'],
                             ['¿Cómo puedo evitar el retraso de esta OF?', 'suggest_alternatives']] as [string, string][] : []),
          ...(f?.part_id ? [['¿Por qué esta pieza tiene estas operaciones?', 'explain_plan'], ['¿Por qué tarda tanto esta pieza?', 'explain_plan']] as [string, string][] : []),
          ['¿Qué está mal en mi plan?', 'whats_wrong'], ['Resume mi plan', 'summarize_plan'], ['Encuentra riesgos', 'find_risks'],
          ['¿Qué recursos están sobrecargados?', 'check_capacity'], ['¿Qué OF tienen operaciones sin capacidad?', 'check_capacity'],
          ['Comprueba la disponibilidad de material', 'check_material'],
          ['¿Qué pasa si el recurso más cargado pierde 8 horas?', 'simulate_change'],
        ]
      : [['Estado actual del plan', 'summarize_plan'], ['¿Cabe este plan con la capacidad actual?', 'check_capacity'],
         ['¿Podemos añadir 20 piezas más esta semana?', 'check_capacity'], ['¿Qué órdenes debo priorizar?', 'suggest_alternatives'],
         ['¿Por qué es arriesgado este plan?', 'find_risks'], ['¿Qué pasa si la demanda sube un 15%?', 'simulate_change'],
         ['¿Qué pasa si el autoclave pierde un 20% de capacidad?', 'simulate_change'],
         ['¿Y si un proveedor se retrasa 2 días?', 'simulate_change'], ['Crea una estrategia de producción para esta semana', 'free']];
    box.replaceChildren(...qs.map(([q, rt]) => el('button', { class: 'pcx-chip', type: 'button', text: q,
      onclick: () => sendCopilot(q, q === 'Estado actual del plan' ? 'status' : undefined, rt) })));
    document.getElementById('copilotCtx')!.textContent = ctx.label;
  }

  function copilotCard(a: any): HTMLElement | null {
    if (a.type === 'scenario') {
      const rows = Object.keys(a.scenario || {}).map(lab => {
        const b = a.baseline?.[lab] || {}, s2 = a.scenario[lab];
        const dc = s2.confianza_cumplimiento_pct - (b.confianza_cumplimiento_pct ?? 0);
        return el('tr', {}, el('td', { text: lab }),
          el('td', {}, `${b.confianza_cumplimiento_pct ?? '—'}% → ${s2.confianza_cumplimiento_pct}% `,
            el('span', { class: dc < 0 ? 'pcx-delta--bad' : dc > 0 ? 'pcx-delta--good' : '', text: `(${dc > 0 ? '+' : ''}${dc} pp)` })),
          el('td', { text: `${s2.piezas_p50}/${s2.piezas_total}` }),
          el('td', { text: `${b.operaciones_fuera_de_plan ?? '—'} → ${s2.operaciones_fuera_de_plan}` }));
      });
      return el('div', { class: 'pcx-card' }, el('h4', { text: `Escenario simulado: ${a.label}` }),
        el('table', {}, el('thead', {}, el('tr', {}, ['Alternativa', 'Confianza', 'Piezas p50', 'Ops. fuera'].map(h => el('th', { text: h })))),
          el('tbody', {}, rows)),
        el('ul', { style: 'margin:.4rem 0 0;padding-left:1rem' }, (a.assumptions || []).map((x: string) => el('li', { class: 'pcx-muted', text: x }))));
    }
    if (a.type === 'plan_status') {
      return el('div', { class: 'pcx-card' }, el('h4', { text: `Estado del plan: ${a.estado}` }),
        el('table', {}, el('thead', {}, el('tr', {}, ['Alternativa', 'Confianza', 'Piezas', 'Autoclave'].map(h => el('th', { text: h })))),
          el('tbody', {}, (a.alternativas || []).map((x: any) => el('tr', {}, el('td', { text: x.alternativa }),
            el('td', { text: `${x.confianza_cumplimiento_pct ?? '—'}%` }), el('td', { text: `${x.piezas_programadas}/${x.piezas_total}` }),
            el('td', { text: `${x.saturacion_autoclave_pct}%` }))))),
        el('div', { class: 'pcx-muted', text: `Fuente: ${a.fuente}${a.mejor ? ` · alternativa más robusta: ${a.mejor}` : ''}` }));
    }
    if (a.type === 'capacity') {
      // Verdict + confidence come from the capacity engine, not from the AI text.
      const cls: Record<string, string> = { viable: 'pcx-st pcx-st--ok', riesgo: 'pcx-st pcx-st--warn', imposible: 'pcx-st pcx-st--bad' };
      const top = (a.resources || []).slice(0, 5);
      return el('div', { class: 'pcx-card' },
        el('div', { class: 'pcx-kpi__top' }, el('h4', { text: `Capacidad: ${a.label || 'plan'}` }),
          el('span', { class: cls[a.verdict] || 'pcx-st pcx-st--none', text: a.verdict_label || a.verdict })),
        el('div', { text: a.summary }),
        el('ul', { style: 'margin:.3rem 0;padding-left:1rem' }, (a.reasons || []).map((r: string) => el('li', { text: r }))),
        el('table', {}, el('thead', {}, el('tr', {}, ['Recurso', 'Carga', 'Turnos (nec./disp.)', 'Exceso'].map(h => el('th', { text: h })))),
          el('tbody', {}, top.map((r: any) => el('tr', {}, el('td', { text: r.resource }),
            el('td', { class: r.load_pct == null || r.load_pct > 100 ? 'pcx-delta--bad' : r.load_pct >= 85 ? '' : 'pcx-delta--good',
                       text: r.load_pct == null ? 'sin capacidad' : `${r.load_pct}%` }),
            el('td', { text: `${r.demand_shifts} / ${r.available_shifts}` }),
            el('td', { text: r.excess_hours ? `${r.excess_hours} h` : '—' }))))),
        (a.alternatives || []).length ? el('div', {}, el('h4', { style: 'margin-top:.5rem', text: 'Alternativas validadas' }),
          el('ul', { style: 'margin:.2rem 0;padding-left:1rem' }, a.alternatives.map((x: any) => el('li', {},
            el('b', { text: `${x.action}: ` }), x.detail, ' ',
            el('span', { class: cls[x.result_verdict] || 'pcx-st', text: `→ ${x.result_label}` }))))) : null,
        el('div', { class: 'pcx-muted', text: `Confianza ${a.confidence?.level || '—'}: ${(a.confidence?.reasons || []).join(' ')}` }),
        el('div', { class: 'pcx-muted', text: `${a.horizon}. ${a.overtime} ${a.demand_scope}` }));
    }
    if (a.type === 'routing_scenario') {
      const keys: [string, string][] = [['on_time', 'OF en plazo'], ['late', 'Retrasadas'], ['at_risk', 'En riesgo'], ['unplanned', 'Sin planificar']];
      return el('div', { class: 'pcx-card' },
        el('div', { class: 'pcx-kpi__top' }, el('h4', { text: 'Simulación de rutas' }), el('span', { class: 'pcx-st pcx-st--warn', text: 'SIMULACIÓN — no es el plan real' })),
        el('ul', { style: 'margin:.3rem 0;padding-left:1rem' }, (a.assumptions || []).map((x: string) => el('li', { class: 'pcx-muted', text: x }))),
        el('table', {}, el('thead', {}, el('tr', {}, ['', 'Plan actual', 'Simulado'].map(h => el('th', { text: h })))),
          el('tbody', {}, keys.map(([k, l]) => el('tr', {}, el('td', { text: l }), el('td', { text: String(a.baseline?.[k] ?? '—') }), el('td', { text: String(a.scenario?.[k] ?? '—') }))))),
        (a.changed || []).length ? el('div', { class: 'pcx-muted', text: 'OF que cambian: ' + a.changed.map((c: any) => `${c.of} (${c.antes?.riesgo || '—'} → ${c.despues?.riesgo || '—'})`).join(', ') }) : null,
        el('div', { class: 'pcx-muted', text: 'Nada se ha guardado: el plan real no ha cambiado.' }));
    }
    if (a.type === 'routing_workload') {
      const cls = a.verdict === 'sobrecapacidad' ? 'pcx-st pcx-st--bad' : a.verdict === 'cabe' ? 'pcx-st pcx-st--ok' : 'pcx-st pcx-st--none';
      return el('div', { class: 'pcx-card' },
        el('div', { class: 'pcx-kpi__top' }, el('h4', { text: 'Carga frente a capacidad' }), el('span', { class: cls, text: a.verdict === 'sobrecapacidad' ? 'Sobrecapacidad' : a.verdict === 'cabe' ? 'Cabe' : 'Datos incompletos' })),
        el('table', {}, el('thead', {}, el('tr', {}, ['Recurso', 'Comprometida', 'Nueva', 'Disponible', 'Resultado'].map(h => el('th', { text: h })))),
          el('tbody', {}, (a.rows || []).map((r: any) => el('tr', {}, el('td', { text: r.recurso }), el('td', { text: `${r.comprometido_h} h` }),
            el('td', { text: `${r.nuevo_h} h` }), el('td', { text: r.disponible_h == null ? 'DATO FALTANTE' : `${r.disponible_h} h` }),
            el('td', { class: r.exceso_h ? 'pcx-delta--bad' : 'pcx-delta--good', text: r.exceso_h ? `+${r.exceso_h} h` : r.holgura_h != null ? `${r.holgura_h} h libres` : '—' }))))),
        el('div', { class: 'pcx-muted', text: `Periodo hasta ${String(a.until || '').slice(0, 10)}. Comprobación simulada: no se ha añadido ninguna carga al plan.` }));
    }
    if (a.type === 'kpi' && a.key) {
      return el('button', { class: 'pcx-chip', type: 'button', text: 'Abrir el análisis del KPI', onclick: () => {
        (document.querySelector('.nav-item[data-panel="kpis"]') as HTMLElement | null)?.click();
        openKpiDetail(a.key);
      } });
    }
    return null;
  }

  function copilotLogAppend(node: HTMLElement) {
    const log = document.getElementById('copilotLog')!;
    log.appendChild(node);
    log.scrollTop = log.scrollHeight;
  }

  async function sendCopilot(text: string, pageOverride?: string, requestType = 'free') {
    const q = (text || '').trim();
    if (!q || copilotState.busy) return;
    openCopilot();
    copilotState.busy = true;
    (document.getElementById('copilotSend') as HTMLButtonElement).disabled = true;
    copilotState.history.push({ role: 'user', content: q });
    copilotLogAppend(el('div', { class: 'pcx-msg pcx-msg--user', text: q }));
    const thinking = el('div', { class: 'pcx-thinking', text: 'Analizando tus datos… (puede tardar hasta un minuto si simulo escenarios)' });
    copilotLogAppend(thinking);
    let hist = copilotState.history.slice(-12);
    while (hist.length && hist[0].role !== 'user') hist = hist.slice(1);
    const ctx = copilotPage();
    const inMrp = ctx.page === 'mrp';
    // Minimum context: the weekly plan only for the planner/KPI pages; ids of what is on screen in MRP.
    const focus = inMrp && copilotFocus ? Object.fromEntries(Object.entries(copilotFocus)
      .filter(([k, v]) => k !== 'label' && typeof v === 'number')) : null;
    try {
      const res = await apiJson('/api/copilot', { method: 'POST', body: JSON.stringify({
        messages: hist, page: pageOverride || ctx.page, kpi_key: ctx.kpi_key, plan: inMrp ? null : lastPlanRequest,
        focus, request_type: requestType,
      }) });
      thinking.remove();
      if (res.outcome === 'error' || res.outcome === 'busy') {
        // Service problem: show it, but keep it out of the conversation sent back to the model.
        copilotState.history.pop();
        copilotLogAppend(el('div', { class: 'pcx-msg pcx-msg--err', text: res.reply }));
        return;
      }
      copilotState.history.push({ role: 'assistant', content: res.reply });
      copilotLogAppend(el('div', { class: 'pcx-msg pcx-msg--bot', text: res.reply }));
      (res.artifacts || []).forEach((a: any) => { const c = copilotCard(a); if (c) copilotLogAppend(c); });
    } catch (e: any) {
      thinking.remove();
      copilotState.history.pop();
      // Never show server details: a fixed, reassuring message per case.
      copilotLogAppend(el('div', { class: 'pcx-msg pcx-msg--err', text: e.status === 429
        ? 'Has alcanzado el límite de consultas del copiloto. Inténtalo más tarde. Tu plan no se ha modificado.'
        : e.status === 403 ? 'Tu usuario no tiene acceso al copiloto.'
        : e.status === 422 ? 'La pregunta es demasiado larga o la conversación demasiado extensa: empieza una nueva conversación.'
        : 'El asistente de planificación no está disponible temporalmente. Tu plan no se ha modificado.' }));
    } finally {
      copilotState.busy = false;
      (document.getElementById('copilotSend') as HTMLButtonElement).disabled = false;
    }
  }

  function openCopilot(prefill?: string) {
    const d = document.getElementById('copilotDrawer');
    if (!d || !hasAccess('copilot')) return;
    d.classList.add('pcx-open');
    d.setAttribute('aria-hidden', 'false');
    copilotChips();
    const log = document.getElementById('copilotLog')!;
    if (!log.childElementCount) {
      copilotLogAppend(el('div', { class: 'pcx-msg pcx-msg--bot', text:
        'Hola. Veo lo que tienes en pantalla (tu plan, tus KPI o la OF/operación que estés revisando) y puedo simular ' +
        'escenarios. Pregúntame qué está mal, por qué, cómo solucionarlo o qué pasa si cambias algo: te diré en qué ' +
        'datos me baso. Solo consulto y simulo: nunca modifico tu plan.' }));
    }
    const input = document.getElementById('copilotInput') as HTMLTextAreaElement;
    if (prefill) { input.value = prefill; }
    input.focus();
  }

  function setCopilotAvailable(on: boolean) {
    const fab = document.getElementById('copilotFab');
    if (fab) fab.style.display = on && hasAccess('copilot') ? '' : 'none';
    if (!on) document.getElementById('copilotDrawer')?.classList.remove('pcx-open');
  }

  // ── User-arranged layout («Personalizar vista») ──────────────────────
  // Each `.lw` block of a `.lw-region` can be reordered (drag or ← →),
  // resized on a 12-column grid, minimised or hidden. Blocks marked
  // data-essential (the Gantt + planner) can only be minimised, so no tool is
  // ever lost. Blocks are *moved*, never re-rendered, so their event listeners
  // and ids keep working. The layout is per user: cached locally for an
  // instant first paint and stored on the server (PUT /config {layouts}).
  const LW_SPANS: [number, string][] = [[12, 'Ancho completo'], [8, '2/3'], [6, 'Mitad'], [4, '1/3']];
  const LW_ID = /^[a-z0-9_-]{1,40}$/;
  let lwState: any = { version: 1, panels: {}, shell: { sidebar_hidden: false, copilot_docked: false } };
  const lwDefaults: Record<string, { order: string[]; spans: Record<string, number> }> = {};
  let lwSaveTimer: any = null;
  let lwReady = false;

  function lwCacheKey() { return `pc_layouts:${currentUser?.id ?? 'anon'}`; }

  function lwClean(raw: any) {
    // Mirror of the server schema (schemas.LayoutsIn): anything unknown is dropped.
    const out: any = { version: 1, panels: {}, shell: { sidebar_hidden: false, copilot_docked: false } };
    if (!raw || typeof raw !== 'object') return out;
    out.shell.sidebar_hidden = !!raw.shell?.sidebar_hidden;
    out.shell.copilot_docked = !!raw.shell?.copilot_docked;
    for (const [pid, p] of Object.entries<any>(raw.panels || {})) {
      if (!LW_ID.test(pid) || !p || typeof p !== 'object') continue;
      const order = [...new Set((Array.isArray(p.order) ? p.order : [])
        .filter((x: any) => typeof x === 'string' && LW_ID.test(x)))].slice(0, 30);
      const widgets: any = {};
      for (const [wid, w] of Object.entries<any>(p.widgets || {})) {
        if (!LW_ID.test(wid) || !w || typeof w !== 'object') continue;
        widgets[wid] = { span: LW_SPANS.some(([s]) => s === w.span) ? w.span : 12,
                         collapsed: !!w.collapsed, hidden: !!w.hidden };
      }
      out.panels[pid] = { order, widgets };
    }
    return out;
  }

  function lwBlocks(region: HTMLElement): HTMLElement[] {
    return Array.from(region.children).filter(c => (c as HTMLElement).classList?.contains('lw')) as HTMLElement[];
  }

  function lwPanel(pid: string) {
    if (!lwState.panels[pid]) lwState.panels[pid] = { order: [], widgets: {} };
    return lwState.panels[pid];
  }

  function lwWidget(pid: string, wid: string) {
    const p = lwPanel(pid);
    if (!p.widgets[wid]) p.widgets[wid] = { span: lwDefaults[pid]?.spans[wid] ?? 12, collapsed: false, hidden: false };
    return p.widgets[wid];
  }

  function lwApplyRegion(region: HTMLElement) {
    const pid = region.dataset.layout!;
    const def = lwDefaults[pid];
    if (!def) return;
    const p = lwState.panels[pid] || { order: [], widgets: {} };
    const byId: Record<string, HTMLElement> = {};
    lwBlocks(region).forEach(b => { byId[b.dataset.widget!] = b; });
    // Saved order first (only blocks that still exist), then any new block in its default place.
    const order = [...p.order.filter((x: string) => byId[x]), ...def.order.filter(x => !p.order.includes(x))];
    order.forEach(wid => region.appendChild(byId[wid]));
    const tools = region.querySelector(':scope > .lw-tools');
    if (tools) region.prepend(tools);
    for (const wid of order) {
      const b = byId[wid];
      const w = p.widgets[wid] || {};
      const essential = b.dataset.essential === '1';
      const span = LW_SPANS.some(([s]) => s === w.span) ? w.span : def.spans[wid];
      b.style.setProperty('--lw-span', String(span));
      b.hidden = !essential && !!w.hidden;
      b.classList.toggle('lw--collapsed', !!w.collapsed);
    }
    for (const wid of order) {
      const w = p.widgets[wid] || {};
      lwSyncBar(region, byId[wid], LW_SPANS.some(([s]) => s === w.span) ? w.span : def.spans[wid], !!w.collapsed);
    }
    lwRenderTools(region);
  }

  function lwSyncBar(region: HTMLElement, b: HTMLElement, span: number, collapsed: boolean) {
    const bar = b.querySelector(':scope > .lw-bar') as HTMLElement | null;
    if (!bar) return;
    (bar.querySelector('select') as HTMLSelectElement).value = String(span);
    const col = bar.querySelector('[data-lw="collapse"]') as HTMLButtonElement;
    col.textContent = collapsed ? 'Mostrar' : 'Minimizar';
    col.setAttribute('aria-expanded', String(!collapsed));
    const visible = lwBlocks(region).filter(x => !x.hidden);
    const i = visible.indexOf(b);
    (bar.querySelector('[data-lw="prev"]') as HTMLButtonElement).disabled = i <= 0;
    (bar.querySelector('[data-lw="next"]') as HTMLButtonElement).disabled = i < 0 || i >= visible.length - 1;
  }

  function lwBuildBar(region: HTMLElement, b: HTMLElement) {
    const pid = region.dataset.layout!, wid = b.dataset.widget!, title = b.dataset.title || wid;
    const essential = b.dataset.essential === '1';
    const sel = el('select', { 'aria-label': `Ancho de «${title}»`, onchange: (e: Event) => {
      lwWidget(pid, wid).span = Number((e.target as HTMLSelectElement).value); lwCommit(region);
    } }, LW_SPANS.map(([s, label]) => el('option', { value: String(s), text: label })));
    const grip = el('button', { type: 'button', class: 'lw-bar__grip', draggable: 'true', title: 'Arrastra para mover',
                                'aria-label': `Mover «${title}» (arrastrar)`, text: '⋮⋮' });
    grip.addEventListener('dragstart', (e: DragEvent) => {
      region.dataset.dragging = wid; b.classList.add('lw--dragging');
      e.dataTransfer?.setData('text/plain', wid);
      if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
    });
    grip.addEventListener('dragend', () => {
      delete region.dataset.dragging; b.classList.remove('lw--dragging'); lwClearDrop(region);
    });
    const bar = el('div', { class: 'lw-bar', role: 'toolbar', 'aria-label': `Bloque «${title}»` },
      grip,
      el('span', { class: 'lw-bar__title', text: title }),
      el('button', { type: 'button', 'data-lw': 'prev', title: 'Mover antes', 'aria-label': `Mover «${title}» antes`,
                     text: '←', onclick: () => lwMove(region, wid, -1) }),
      el('button', { type: 'button', 'data-lw': 'next', title: 'Mover después', 'aria-label': `Mover «${title}» después`,
                     text: '→', onclick: () => lwMove(region, wid, 1) }),
      sel,
      el('button', { type: 'button', 'data-lw': 'collapse', onclick: () => {
        const w = lwWidget(pid, wid); w.collapsed = !w.collapsed; lwCommit(region);
      } }),
      essential
        ? el('span', { style: 'font-size:.7rem;color:var(--n50)', title: 'Contiene el planificador: se puede minimizar, no ocultar',
                       text: 'Imprescindible' })
        : el('button', { type: 'button', 'data-lw': 'hide', title: 'Ocultar (se recupera desde «Bloques ocultos»)',
                         text: 'Ocultar', onclick: () => { lwWidget(pid, wid).hidden = true; lwCommit(region); } }),
    );
    b.prepend(bar);
  }

  function lwClearDrop(region: HTMLElement) {
    lwBlocks(region).forEach(x => x.classList.remove('lw--drop-before', 'lw--drop-after'));
  }

  function lwCurrentOrder(region: HTMLElement) { return lwBlocks(region).map(x => x.dataset.widget!); }

  function lwMove(region: HTMLElement, wid: string, dir: number) {
    const all = lwBlocks(region);
    const visible = all.filter(x => !x.hidden);
    const b = all.find(x => x.dataset.widget === wid)!;
    const i = visible.indexOf(b), j = i + dir;
    if (i < 0 || j < 0 || j >= visible.length) return;
    const ref = visible[j];
    if (dir < 0) region.insertBefore(b, ref); else region.insertBefore(b, ref.nextSibling);
    lwPanel(region.dataset.layout!).order = lwCurrentOrder(region);
    lwCommit(region);
    (b.querySelector(`[data-lw="${dir < 0 ? 'prev' : 'next'}"]`) as HTMLButtonElement | null)?.focus();
  }

  function lwRenderTools(region: HTMLElement) {
    let tools = region.querySelector(':scope > .lw-tools') as HTMLElement | null;
    if (!tools) {
      tools = el('div', { class: 'lw-tools', role: 'region', 'aria-label': 'Personalizar vista' });
      region.prepend(tools);
    }
    const pid = region.dataset.layout!;
    const hidden = lwBlocks(region).filter(b => b.hidden);
    tools.replaceChildren(
      el('span', { class: 'lw-tools__hint', text: 'Arrastra ⋮⋮ (o usa ← →) para reordenar, elige el ancho de cada bloque, '
                   + 'minimízalo u ocúltalo. Se guarda para tu usuario.' }),
      el('span', { class: 'lw-tools__hidden' },
        hidden.length ? el('span', { text: 'Bloques ocultos:' }) : null,
        hidden.map(b => el('button', { type: 'button', title: 'Volver a mostrar', text: `+ ${b.dataset.title}`, onclick: () => {
          lwWidget(pid, b.dataset.widget!).hidden = false; lwCommit(region);
        } }))),
      el('button', { type: 'button', text: 'Restablecer', title: 'Vuelve al diseño original de esta pantalla', onclick: () => {
        delete lwState.panels[pid]; lwCommit(region); showToast('Diseño restablecido');
      } }),
      el('button', { type: 'button', class: 'lw-tools__done', text: 'Listo', onclick: () => lwSetEditing(region, false) }),
    );
    tools.hidden = !region.classList.contains('lw-editing');
  }

  function lwSetEditing(region: HTMLElement, on: boolean) {
    region.classList.toggle('lw-editing', on);
    const btn = document.getElementById('layoutEditBtn');
    btn?.setAttribute('aria-pressed', String(on));
    lwRenderTools(region);
    if (on) (region.querySelector('.lw-tools button') as HTMLElement | null)?.focus();
    else btn?.focus();
  }

  function lwApplyShell() {
    document.body.classList.toggle('pc-sidebar-hidden', !!lwState.shell.sidebar_hidden);
    document.body.classList.toggle('pc-copilot-docked', !!lwState.shell.copilot_docked);
    document.getElementById('copilotDock')?.setAttribute('aria-pressed', String(!!lwState.shell.copilot_docked));
    const tgl = document.getElementById('sidebarToggle');
    if (tgl && window.innerWidth > 860) {
      tgl.setAttribute('aria-label', lwState.shell.sidebar_hidden ? 'Mostrar menú lateral' : 'Ocultar menú lateral');
      tgl.setAttribute('aria-expanded', String(!lwState.shell.sidebar_hidden));
    }
  }

  function lwApplyAll() {
    document.querySelectorAll<HTMLElement>('.lw-region').forEach(lwApplyRegion);
    lwApplyShell();
  }

  function lwCommit(region?: HTMLElement) {
    lwState = lwClean(lwState);
    if (region) lwApplyRegion(region); else lwApplyAll();
    lwApplyShell();
    try { localStorage.setItem(lwCacheKey(), JSON.stringify(lwState)); } catch {}
    clearTimeout(lwSaveTimer);
    lwSaveTimer = setTimeout(async () => {
      try { await apiJson('/config', { method: 'PUT', body: JSON.stringify({ layouts: lwState }) }); }
      catch { showToast('No se pudo guardar tu diseño en el servidor; se mantiene en este navegador.'); }
      finally { lwSaveTimer = null; }
    }, 700);
  }

  function lwToggleSidebar() { lwState.shell.sidebar_hidden = !lwState.shell.sidebar_hidden; lwCommit(); }
  function lwToggleDock() { lwState.shell.copilot_docked = !lwState.shell.copilot_docked; lwCommit(); }

  async function layoutLoadForUser(_user: any) {
    // Instant: the copy cached for this user; then the server copy wins.
    try {
      const c = localStorage.getItem(lwCacheKey());
      if (c) { lwState = lwClean(JSON.parse(c)); lwApplyAll(); }
    } catch {}
    try {
      const cfg = await apiJson('/config');
      if (cfg && cfg.layouts) {
        lwState = lwClean(cfg.layouts);
        try { localStorage.setItem(lwCacheKey(), JSON.stringify(lwState)); } catch {}
        lwApplyAll();
      }
    } catch { /* offline or an older API: the cached copy or the default layout stays */ }
  }

  function initLayout() {
    if (lwReady) return;
    lwReady = true;
    document.querySelectorAll<HTMLElement>('.lw-region').forEach(region => {
      const pid = region.dataset.layout!;
      const blocks = lwBlocks(region);
      lwDefaults[pid] = { order: blocks.map(b => b.dataset.widget!),
                          spans: Object.fromEntries(blocks.map(b => [b.dataset.widget!, Number(b.dataset.span) || 12])) };
      blocks.forEach(b => lwBuildBar(region, b));
      region.addEventListener('dragover', (e: DragEvent) => {
        const dragging = region.dataset.dragging;
        const target = (e.target as HTMLElement).closest?.('.lw') as HTMLElement | null;
        if (!dragging || !target || target.parentElement !== region) return;
        e.preventDefault();
        lwClearDrop(region);
        if (target.dataset.widget === dragging) return;
        const r = target.getBoundingClientRect();
        // Wide block: drop above/below. Narrow block: drop left/right.
        const before = r.width > r.height * 2 ? e.clientY < r.top + r.height / 2 : e.clientX < r.left + r.width / 2;
        target.classList.add(before ? 'lw--drop-before' : 'lw--drop-after');
      });
      region.addEventListener('drop', (e: DragEvent) => {
        const dragging = region.dataset.dragging;
        const target = (e.target as HTMLElement).closest?.('.lw') as HTMLElement | null;
        if (!dragging || !target || target.parentElement !== region) return;
        e.preventDefault();
        const b = lwBlocks(region).find(x => x.dataset.widget === dragging);
        const before = target.classList.contains('lw--drop-before');
        lwClearDrop(region);
        if (!b || b === target) return;
        region.insertBefore(b, before ? target : target.nextSibling);
        lwPanel(pid).order = lwCurrentOrder(region);
        lwCommit(region);
      });
    });
    document.getElementById('layoutEditBtn')?.addEventListener('click', () => {
      const region = document.querySelector<HTMLElement>('#panel-gantt .lw-region');
      if (region) lwSetEditing(region, !region.classList.contains('lw-editing'));
    });
    document.getElementById('copilotDock')?.addEventListener('click', lwToggleDock);
    // Several tabs / devices: the last save would silently overwrite the
    // others. Another tab of this browser saving → apply its copy at once;
    // coming back to this tab → reload the server copy (unless editing here).
    window.addEventListener('storage', (e) => {
      if (e.key !== lwCacheKey() || !e.newValue || document.querySelector('.lw-region.lw-editing')) return;
      try { lwState = lwClean(JSON.parse(e.newValue)); lwApplyAll(); } catch {}
    });
    let lwLastPull = 0;
    const lwPull = () => {
      if (!currentUser || document.visibilityState !== 'visible' || document.querySelector('.lw-region.lw-editing')) return;
      if (Date.now() - lwLastPull < 5000 || lwSaveTimer) return;
      lwLastPull = Date.now();
      layoutLoadForUser(currentUser);
    };
    window.addEventListener('focus', lwPull);
    document.addEventListener('visibilitychange', lwPull);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const region = document.querySelector<HTMLElement>('.lw-region.lw-editing');
      if (region) lwSetEditing(region, false);
    });
    lwApplyAll();
  }

  // ── Planificación semanal: real data from the routing (OF) engine ───────
  // The four blocks used to be static demo HTML. They now show the company's
  // own OFs, the last finite-capacity plan and its capacity check
  // (GET /api/routing/overview + /orders). No number is invented: without
  // data each block says what is missing and how to get it.
  let homeLoading = false;

  function homeDt(s?: string | null): string {
    if (!s) return '—';
    const d = new Date(s);
    return isNaN(+d) ? '—' : d.toLocaleString('es-ES', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
  }
  function homeDate(s?: string | null): string {
    if (!s) return '—';
    const d = new Date(`${String(s).slice(0, 10)}T00:00:00`);
    return isNaN(+d) ? '—' : d.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit' });
  }
  function homeGoToOrders() { (document.querySelector('.nav-item[data-panel="mrp"]') as HTMLElement | null)?.click(); }

  function homeStamp() {
    document.querySelectorAll('#panel-gantt .lw[data-widget="alert"], #panel-gantt .lw[data-widget="kpis"], '
      + '#panel-gantt .lw[data-widget="orders"], #panel-gantt .lw[data-widget="capacity"]').forEach(s => stampAstroScope(s));
  }

  function homeMessage(kind: 'info' | 'warn' | 'bad' | 'ok', text: string, actions: HTMLElement[] = []) {
    const a = document.getElementById('homeAlert');
    if (!a) return;
    a.className = `alert-banner home-alert--${kind}`;
    a.replaceChildren(el('div', { class: 'alert-banner__body' }, text), ...actions);
  }

  function homeCta(label: string, onclick: () => void) {
    return el('button', { class: 'alert-banner__cta', type: 'button', text: label, onclick });
  }

  function homeEmpty(text: string) {
    const kp = document.getElementById('homeKpis'); kp?.replaceChildren();
    const bar = document.getElementById('homePlanBar'); bar?.replaceChildren();
    const ol = document.getElementById('homeOrdersList');
    ol?.replaceChildren(el('p', { class: 'home-empty', text }));
    const cl = document.getElementById('homeCapList');
    cl?.replaceChildren(el('p', { class: 'home-empty', text }));
    const oc = document.getElementById('homeOrdersCount'); if (oc) oc.textContent = '—';
    const cp = document.getElementById('homeCapPeriod'); if (cp) cp.textContent = '—';
  }

  async function homeReplan(btn: HTMLButtonElement) {
    btn.disabled = true; btn.textContent = 'Calculando…';
    try {
      await apiJson('/api/routing/plan', { method: 'POST', body: JSON.stringify({ start: null }) });
      showToast('✓ Plan de OF recalculado');
    } catch (e: any) { showToast(e?.message || 'No se pudo recalcular el plan', 4000); }
    await loadHomeWidgets();
  }

  async function loadHomeWidgets() {
    if (!document.getElementById('homeAlert') || homeLoading) return;
    homeLoading = true;
    try {
      if (!hasAccess('mrp')) {
        homeMessage('info', 'Estos bloques muestran tus órdenes de fabricación y su plan. Tu usuario no tiene acceso al módulo «MRP & Tiempos»: pide acceso a tu administrador.');
        homeEmpty('Sin acceso al módulo MRP & Tiempos.');
        return;
      }
      const [ov, orders] = await Promise.all([apiJson('/api/routing/overview'), apiJson('/api/routing/orders')]);
      homeRender(ov, orders);
    } catch (e: any) {
      homeMessage('info', e?.status === 403 ? (e.message || 'Sin acceso a las órdenes de fabricación.')
        : 'No se pudo cargar el estado de tus OF. Vuelve a intentarlo en unos segundos.',
        [homeCta('Reintentar', () => loadHomeWidgets())]);
      homeEmpty('Sin datos.');
    } finally {
      homeLoading = false;
      homeStamp();
    }
  }

  function homeRender(ov: any, orders: any[]) {
    const lp = ov?.last_plan;
    const s = lp?.summary || null;
    const open = ov?.orders?.open ?? orders.length;
    const routeErrors = ov?.orders?.routing_errors ?? 0;

    // Plan bar: when the plan was computed, and recompute.
    const bar = document.getElementById('homePlanBar');
    const replan = el('button', { class: 'btn-ui', type: 'button', text: s ? 'Recalcular plan de OF' : 'Calcular plan de OF',
      onclick: (e: Event) => homeReplan(e.currentTarget as HTMLButtonElement) }) as HTMLButtonElement;
    const stale = s && s.orders !== open;
    bar?.replaceChildren(
      el('span', { text: s ? `Plan de OF calculado el ${homeDt(lp.at)}` : 'Todavía no hay un plan de OF.' }),
      // replaceChildren() would print a null as the text «null»: spread instead.
      ...(stale ? [el('span', { class: 'home-stale', text: ' · Las OF han cambiado desde entonces: recalcula para verlo al día.' })] : []),
      el('span', { style: 'flex:1' }), replan,
      el('button', { class: 'btn-ui', type: 'button', text: 'Ver OF y rutas', onclick: homeGoToOrders }));

    // KPIs (only what the OF engine actually measures).
    const card = (tone: string, label: string, val: string, foot: string, footTone = 'flat') =>
      el('div', { class: `kpi-card kpi-card--${tone}` },
        el('div', { class: 'kpi-card__top' }, el('div', { class: 'kpi-card__label', text: label })),
        el('div', { class: 'kpi-card__val', text: val }),
        el('div', { class: 'kpi-card__footer' }, el('span', { class: `kpi-delta kpi-delta--${footTone}`, text: foot })));
    const over = s?.overloaded_resources || [];
    const pct = s?.on_time_pct;
    const behind = s ? (s.late || 0) + (s.unplanned || 0) : null;
    document.getElementById('homeKpis')?.replaceChildren(
      card('blue', 'OF abiertas', String(open), routeErrors ? `${routeErrors} con error de ruta` : 'Rutas sin errores',
           routeErrors ? 'down' : 'up'),
      card(pct == null ? 'blue' : pct >= 95 ? 'green' : pct >= 80 ? 'amber' : 'red', 'OF en plazo',
           pct == null ? '—' : `${pct}%`, s ? `${s.on_time} de ${s.orders_with_due_date} con fecha de necesidad` : 'Calcula el plan',
           pct == null ? 'flat' : pct >= 95 ? 'up' : 'down'),
      card(behind ? 'red' : 'green', 'Retrasadas o sin planificar', behind == null ? '—' : String(behind),
           s ? `${s.at_risk || 0} más en riesgo (< 24 h de margen)` : 'Calcula el plan', behind ? 'down' : 'flat'),
      card(over.length ? 'red' : 'green', 'Recursos sobrecargados', s ? String(over.length) : '—',
           over.length ? over.slice(0, 3).map((c: any) => c.resource).join(', ') : s ? 'Capacidad suficiente' : 'Calcula el plan',
           over.length ? 'down' : 'flat'));

    // Alert: the single most important thing to act on.
    if (!open) {
      homeMessage('info', 'No hay órdenes de fabricación abiertas. Créalas o impórtalas desde tu MRP en «MRP & Tiempos».',
        [homeCta('Ir a MRP & Tiempos', homeGoToOrders)]);
    } else if (!s) {
      homeMessage('info', `Tienes ${open} OF abiertas sin plan. Calcula el plan para ver qué llega a tiempo y qué recurso limita.`,
        [homeCta('Calcular plan', () => homeReplan(replan))]);
    } else if (over.length) {
      const c = over[0];
      const n = (s.orders_with_capacity_problems || []).length;
      homeMessage('bad', `Sobrecarga en ${c.resource}: necesita ${c.required_h} h y dispone de ${c.available_h} h en el periodo `
        + `(+${c.overload_h} h).${n ? ` Afecta a ${n} OF.` : ''}${over.length > 1 ? ` Y ${over.length - 1} recurso(s) más.` : ''}`,
        [homeCta('Ver detalle', homeGoToOrders),
         ...(hasAccess('copilot') ? [homeCta('Preguntar al copiloto', () => openCopilot(`¿Por qué está sobrecargado ${c.resource}, qué OF afecta y cómo lo soluciono?`))] : [])]);
    } else if (behind) {
      const late = orders.filter((o: any) => o.risk === 'late' || o.risk === 'unplanned').map((o: any) => o.order_number);
      homeMessage('bad', `${behind} OF no llegan a su fecha de necesidad o no se pueden planificar: ${late.slice(0, 5).join(', ')}`
        + `${late.length > 5 ? '…' : ''}. Cada una explica su causa en «Ver detalle».`, [homeCta('Ver detalle', homeGoToOrders)]);
    } else if (s.at_risk) {
      homeMessage('warn', `${s.at_risk} OF terminan con menos de 24 h de margen sobre su fecha de necesidad.`,
        [homeCta('Ver detalle', homeGoToOrders)]);
    } else {
      homeMessage('ok', `Todas las OF planificadas llegan a tiempo${s.on_time_pct != null ? ` (${s.on_time} de ${s.orders_with_due_date})` : ''}. Sin sobrecargas en el periodo.`);
    }

    // Orders: the ones that need attention first.
    const rank: Record<string, number> = { late: 0, unplanned: 1, at_risk: 2, on_time: 3 };
    const pill: Record<string, [string, string]> = { late: ['sp--late', 'Retraso'], unplanned: ['sp--late', 'Sin planificar'],
                                                    at_risk: ['sp--risk', 'En riesgo'], on_time: ['sp--ok', 'En plazo'] };
    const top = [...orders].sort((a: any, b: any) => (rank[a.risk] ?? 4) - (rank[b.risk] ?? 4)
      || String(a.due_date || '9999').localeCompare(String(b.due_date || '9999'))).slice(0, 8);
    const oc = document.getElementById('homeOrdersCount');
    if (oc) oc.textContent = `${open} abiertas`;
    document.getElementById('homeOrdersList')?.replaceChildren(...(top.length ? top.map((o: any) => {
      const [cls, txt] = pill[o.risk] || ['', 'Sin plan'];
      return el('div', { class: 'order-row', title: o.risk_reason || '' },
        el('span', { class: 'order-id', text: o.order_number }),
        el('span', { class: 'order-name', text: `${o.part_number || 'Sin pieza'} · ${o.quantity}${o.unit ? ' ' + o.unit : ''}` }),
        el('span', { class: 'home-order-dates', text: `Fin ${homeDt(o.planned_end)} · Nec. ${homeDate(o.due_date)}` }),
        el('span', { class: `status-pill ${cls}`, text: txt }));
    }) : [el('p', { class: 'home-empty', text: 'No hay OF abiertas.' })]),
      ...(orders.length > top.length ? [el('button', { class: 'home-more', type: 'button',
        text: `Ver las ${orders.length} OF en «MRP & Tiempos»`, onclick: homeGoToOrders })] : []));

    // Capacity: load per resource in the plan's period, busiest first.
    const cap = (s?.capacity || []).filter((c: any) => c.required_h || c.status === 'NO_CALENDAR')
      .sort((a: any, b: any) => (b.load_pct ?? 999) - (a.load_pct ?? 999)).slice(0, 8);
    const cp = document.getElementById('homeCapPeriod');
    if (cp) cp.textContent = s?.period ? `${homeDate(s.period.start)} – ${homeDate(s.period.end)}` : '—';
    document.getElementById('homeCapList')?.replaceChildren(...(cap.length ? cap.map((c: any) => {
      const tone = c.status === 'OVERLOAD' ? 'over' : c.status === 'HIGH' ? 'warn' : c.status === 'NO_CALENDAR' ? 'warn' : 'ok';
      return el('div', { class: 'cap-row', title: c.message || '' },
        el('span', { class: 'cap-name', text: c.resource }),
        el('div', { class: 'cap-track' }, el('div', { class: `cap-fill cap-fill--${tone}`, style: `width:${Math.min(100, c.load_pct ?? 100)}%` })),
        el('span', { class: `cap-pct cap-pct--${tone}`, text: c.status === 'NO_CALENDAR' ? 'Sin cal.' : `${c.load_pct}%` }));
    }) : [el('p', { class: 'home-empty', text: s ? 'Sin carga en el periodo del plan.' : 'Calcula el plan para ver la carga.' })]));
  }

  // ── Exportar: the plan on screen as an Excel workbook ───────────────────
  // Sheets: Resumen · OF · Operaciones · Carga por recurso (from the OF engine,
  // when the user has the module) and «Planificador» (the alternative chosen in
  // «Generar alternativas», when there is one). Built in the browser from data
  // the user can already see; nothing is sent anywhere.
  let plannerSelectedAlt: any = null;
  const RISK_TXT: Record<string, string> = { late: 'Retraso', unplanned: 'Sin planificar', at_risk: 'En riesgo', on_time: 'En plazo' };
  const PLAN_DAY_START_HOUR = 6;   // backend PLAN_DAY_START_HOUR default: shifts 06-14-22

  function xDate(s?: string | null): Date | string {
    if (!s) return '';
    const d = new Date(s);
    return isNaN(+d) ? '' : d;
  }

  function xSheet(rows: any[][], widths: number[]) {
    const ws = XLSX.utils.aoa_to_sheet(rows, { cellDates: true, dateNF: 'dd/mm/yyyy hh:mm' } as any);
    (ws as any)['!cols'] = widths.map(w => ({ wch: w }));
    if (rows.length > 1) (ws as any)['!autofilter'] = { ref: XLSX.utils.encode_range({ s: { r: 0, c: 0 }, e: { r: rows.length - 1, c: rows[0].length - 1 } }) };
    return ws;
  }

  async function exportPlan(btn?: HTMLButtonElement | null) {
    if (btn) { btn.disabled = true; }
    try {
      const wb = XLSX.utils.book_new();
      const company = selectedEnterprise || currentUser?.company || '';
      const summary: any[][] = [['Planning Core · exportación del plan'], ['Generado', new Date()], ['Empresa', company], ['Usuario', currentUser?.email || '']];
      let sheets = 0;

      if (hasAccess('mrp')) {
        try {
          const [ov, orders] = await Promise.all([apiJson('/api/routing/overview'), apiJson('/api/routing/orders')]);
          const s = ov?.last_plan?.summary;
          summary.push([], ['Plan de OF calculado', xDate(ov?.last_plan?.at)],
            ['OF abiertas', ov?.orders?.open ?? orders.length],
            ['OF en plazo (%)', s?.on_time_pct ?? ''], ['Retrasadas', s?.late ?? ''], ['En riesgo', s?.at_risk ?? ''],
            ['Sin planificar', s?.unplanned ?? ''],
            ['Recursos sobrecargados', (s?.overloaded_resources || []).map((c: any) => c.resource).join(', ')]);
          if (orders.length) {
            XLSX.utils.book_append_sheet(wb, xSheet([
              ['OF', 'Pieza', 'Cantidad', 'Unidad', 'Prioridad', 'Fecha de necesidad', 'Inicio previsto', 'Fin previsto', 'Riesgo', 'Motivo', 'Ruta'],
              ...orders.map((o: any) => [o.order_number, o.part_number || '', o.quantity, o.unit || '', o.priority,
                xDate(o.due_date), xDate(o.planned_start), xDate(o.planned_end), RISK_TXT[o.risk] || 'Sin plan',
                o.risk_reason || '', (o.route || []).join(' → ')]),
            ], [12, 16, 9, 7, 9, 16, 17, 17, 13, 60, 30]), 'OF');
            XLSX.utils.book_append_sheet(wb, xSheet([
              ['OF', 'Operación', 'Nombre', 'Recurso', 'Inicio previsto', 'Fin previsto', 'Horas', 'Estado', 'Motivo'],
              ...orders.flatMap((o: any) => (o.operations || []).map((op: any) => [o.order_number, op.code, op.name,
                op.subcontracted ? 'Externo' : (op.planned_resource_code || op.resource_code || ''),
                xDate(op.planned_start), xDate(op.planned_end), op.required_h ?? '', op.status, op.risk_reason || ''])),
            ], [12, 10, 24, 14, 17, 17, 8, 13, 60]), 'Operaciones');
            sheets += 2;
          }
          const cap = (s?.capacity || []).filter((c: any) => c.required_h || c.status === 'NO_CALENDAR');
          if (cap.length) {
            XLSX.utils.book_append_sheet(wb, xSheet([
              ['Recurso', 'Horas necesarias', 'Horas disponibles', 'Carga (%)', 'Estado', 'Exceso (h)'],
              ...cap.map((c: any) => [c.resource, c.required_h, c.available_h ?? '', c.load_pct ?? '',
                { OVERLOAD: 'Sobrecarga', HIGH: 'Carga alta', OK: 'OK', NO_CALENDAR: 'Sin calendario' }[c.status as string] || c.status,
                c.overload_h || 0]),
            ], [16, 16, 17, 10, 14, 10]), 'Carga por recurso');
            sheets += 1;
          }
        } catch { summary.push([], ['OF', 'No se pudieron cargar las órdenes de fabricación']); }
      }

      const alt = plannerSelectedAlt;
      if (alt?.events?.length) {
        const week = (document.getElementById('plannerWeekStart') as HTMLInputElement | null)?.value;
        const origin = week ? new Date(`${week}T${String(PLAN_DAY_START_HOUR).padStart(2, '0')}:00:00`) : null;
        const at = (day: number, shift: number, plus = 0) => origin
          ? new Date(+origin + ((day * 3 + (shift - 1)) + plus) * 8 * 3600000) : '';
        summary.push([], ['Alternativa del planificador', alt.summary?.label || ''], ['Semana', week || '']);
        XLSX.utils.book_append_sheet(wb, xSheet([
          ['Recurso', 'Pieza', 'Operación', 'Día', 'Turno', 'Inicio', 'Fin', 'Turnos'],
          ...alt.events.filter((e: any) => e.resource !== 'WORKERS').map((e: any) => [e.resource, e.title, e.subtitle,
            (alt.week_days || [])[e.day] || e.day + 1, e.shift, at(e.day, e.shift), at(e.day, e.shift, e.duration_shifts || 1),
            e.duration_shifts]),
        ], [12, 16, 20, 10, 7, 17, 17, 8]), 'Planificador');
        sheets += 1;
      }

      if (!sheets) {
        showToast('Todavía no hay nada que exportar: calcula el plan de OF o genera alternativas en el planificador.', 4500);
        return;
      }
      XLSX.utils.book_append_sheet(wb, xSheet(summary, [28, 40]), 'Resumen');
      // «Resumen» first.
      wb.SheetNames.unshift(wb.SheetNames.pop()!);
      const slug = String(company || 'plan').toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'plan';
      XLSX.writeFile(wb, `planning-core-${slug}-${new Date().toISOString().slice(0, 10)}.xlsx`, { cellDates: true } as any);
      showToast('✓ Plan exportado a Excel');
    } catch (e: any) {
      showToast('No se pudo generar el Excel: ' + (e?.message || 'error desconocido'), 4500);
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  function initCopilot() {
    document.getElementById('copilotFab')?.addEventListener('click', () => openCopilot());
    document.getElementById('copilotClose')?.addEventListener('click', () => {
      const d = document.getElementById('copilotDrawer')!;
      d.classList.remove('pcx-open'); d.setAttribute('aria-hidden', 'true');
    });
    document.getElementById('copilotReset')?.addEventListener('click', () => {
      copilotState.history = [];
      document.getElementById('copilotLog')!.replaceChildren();
      openCopilot();
    });
    const input = document.getElementById('copilotInput') as HTMLTextAreaElement | null;
    document.getElementById('copilotForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = input?.value || '';
      if (input) input.value = '';
      sendCopilot(v);
    });
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); document.getElementById('copilotForm')?.dispatchEvent(new Event('submit')); }
    });
    setCopilotAvailable(true);
  }

  function hasAccess(moduleKey: string): boolean {
    return !!currentUser && Array.isArray(currentUser.modules) && currentUser.modules.includes(moduleKey);
  }

  function canOpenPanel(panel: string): boolean {
    if (!(panel in PANEL_MODULE)) return false;
    const key = PANEL_MODULE[panel];
    if (key === null) return true;
    if (key === '@admin') return !!currentUser?.is_admin;
    return hasAccess(key);
  }

  function firstAllowedPanel(): string {
    const order = ['gantt', 'plantmap', 'escenarios', 'capacidad', 'ordenes', 'recursos', 'disrupciones', 'mrp', 'kpis'];
    return order.find(canOpenPanel) || 'noaccess';
  }

  // Hide every nav entry and panel the user can't open, and any nav section
  // left empty by that. Re-run whenever currentUser changes.
  function applyModuleVisibility() {
    document.querySelectorAll('.nav-item[data-panel]').forEach(el => {
      const panel = (el as HTMLElement).dataset.panel!;
      if (panel === 'admin') return;  // governed by initAdminPanel
      (el as HTMLElement).style.display = canOpenPanel(panel) ? '' : 'none';
    });
    document.querySelectorAll('.dash-panel').forEach(el => {
      const panel = el.id.replace(/^panel-/, '');
      if (!canOpenPanel(panel)) (el as HTMLElement).style.display = 'none';
    });
    document.querySelectorAll('#sidebar .nav-section').forEach(sec => {
      if (sec.id === 'nav-admin-section') return;
      const items = [...sec.querySelectorAll('.nav-item')] as HTMLElement[];
      if (!items.length) return;
      (sec as HTMLElement).style.display = items.some(i => i.style.display !== 'none') ? '' : 'none';
    });
  }

  function openNoAccessPanel() {
    document.querySelectorAll('.nav-item[data-panel]').forEach(n => n.classList.remove('nav-item--active'));
    document.querySelectorAll('.dash-panel').forEach(p => (p as HTMLElement).style.display = 'none');
    const status = currentUser?.permission_status;
    const msg = document.getElementById('noaccess-msg');
    if (msg) msg.textContent = status === 'pending'
      ? 'Tu cuenta está pendiente de permisos. Un administrador de tu empresa debe asignarte los módulos con los que vas a trabajar.'
      : 'No tienes acceso a este módulo. Pide a un administrador de tu empresa que te lo asigne.';
    const p = document.getElementById('panel-noaccess');
    if (p) p.style.display = '';
  }

  // Single choke point for every way into a panel: sidebar clicks, the many
  // programmatic `.nav-item.click()` shortcuts (search, alerts, onboarding,
  // quick actions) and the saved start panel all dispatch a click, and this
  // capture-phase listener runs before any of their handlers.
  document.addEventListener('click', (e: MouseEvent) => {
    const el = (e.target as HTMLElement | null)?.closest?.('[data-panel]') as HTMLElement | null;
    if (!el || !el.dataset.panel) return;
    if (canOpenPanel(el.dataset.panel)) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    openNoAccessPanel();
  }, true);

  // industry-card slug -> the `industry` value stored on Company rows
  const IND_SLUG: Record<string, string> = {
    composites: 'composites-aeronautica', impresion: 'impresion-packaging', fundicion: 'fundicion-metalurgia',
    muebles: 'fabricacion-muebles', medtech: 'medtech-dispositivos', ferroviario: 'ferroviario-mro',
    agroalimentario: 'agroalimentario', naval: 'naval-astilleros', construccion: 'construccion-industrial',
  };
  const IND_NAME: Record<string, string> = {
    composites: 'Composites & Aeroespacial', impresion: 'Impresión & Packaging', fundicion: 'Fundición & Metalurgia',
    muebles: 'Fabricación de Muebles', medtech: 'MedTech & Dispositivos', ferroviario: 'Ferroviario MRO',
    agroalimentario: 'Agroalimentaria', naval: 'Naval & Astilleros', construccion: 'Construcción Industrial',
  };

  const industriesPanelEl = document.getElementById('industriesPanel');
  const backBtn           = document.getElementById('backToSelector');
  const backSep           = document.querySelector('.back-sep');
  const sidebarEl         = document.getElementById('sidebar');

  // F-02: a non-admin may only navigate to the industry their company/sector
  // is assigned to. This is a UI gate for usability + least-surprise; the real
  // boundary is enforced server-side. Admins (or users whose industry we cannot
  // determine) see every industry.
  function applySectorGate() {
    const cards = document.querySelectorAll('.industry-card, .ind-item');
    const allowed = new Set<string>();
    if (currentUser && currentUser.company_industry) allowed.add(currentUser.company_industry);
    if (currentUser && currentUser.sector) String(currentUser.sector).split(',').map((s: string) => s.trim()).filter(Boolean).forEach((s: string) => allowed.add(s));
    const showAll = (!currentUser || currentUser.is_admin || allowed.size === 0);
    cards.forEach(el => {
      const key = (el as HTMLElement).getAttribute('data-industry') || '';
      const full = IND_SLUG[key] || key;
      (el as HTMLElement).style.display = (showAll || allowed.has(full) || allowed.has(key)) ? '' : 'none';
    });
  }

  function showSelector() {
    setCopilotAvailable(false);
    selectorEl.classList.remove('hidden');
    entSelectorEl?.classList.remove('show');
    dashboardEl.classList.remove('visible');
    sidebarEl.classList.add('hidden');
    industriesPanelEl.classList.add('hidden');
    backBtn.classList.add('hidden');
    backSep.classList.add('hidden');
    document.querySelectorAll('.ind-item').forEach(el => el.classList.remove('ind-item--active'));
    applySectorGate();
  }

  // Step between the industry menu and the planning: pick which client enterprise
  // you're planning for. Admins see every company in that sector; a regular user
  // sees only their own.
  function showEnterpriseSelector(industry: string) {
    selectorEl.classList.add('hidden');
    dashboardEl.classList.remove('visible');
    sidebarEl.classList.add('hidden');
    industriesPanelEl.classList.add('hidden');
    backBtn.classList.add('hidden');
    backSep.classList.add('hidden');
    entSelectorEl?.classList.add('show');
    renderEnterprises(industry);
  }

  async function renderEnterprises(industry: string) {
    const grid = document.getElementById('enterprise-grid');
    const sub  = document.getElementById('entSub');
    if (!grid) return;
    const indSlug = IND_SLUG[industry] || industry;
    if (sub) sub.textContent = 'Elige la empresa cuya planificación quieres abrir · ' + (IND_NAME[industry] || industry);
    grid.innerHTML = '<div class="enterprise-empty"><p>Cargando empresas…</p></div>';

    let companies: any[] = [];
    try {
      if (currentUser && currentUser.is_admin) {
        const token = localStorage.getItem('pc_token');
        const res = await fetch(`${API}/admin/companies`, { headers: { Authorization: `Bearer ${token}` } });
        if (res.ok) companies = (await res.json()).filter((c: any) => (c.industry || '') === indSlug);
      } else if (currentUser && currentUser.company) {
        companies = [{ name: currentUser.company, industry: indSlug }];
      }
    } catch (_) {}

    if (!companies.length) {
      grid.innerHTML = `<div class="enterprise-empty">
        <p>Aún no hay empresas registradas en ${IND_NAME[industry] || 'este sector'}.${currentUser && currentUser.is_admin ? ' Añádelas en Administración → Empresas.' : ''}</p>
        <button class="btn-ui btn-ui--primary" id="entSkip" type="button">Continuar sin empresa</button>
      </div>`;
      stampAstroScope(grid);
      document.getElementById('entSkip')?.addEventListener('click', () => pickEnterprise(null, industry));
      return;
    }

    grid.innerHTML = companies.map((c: any) => {
      const logo = TENANT_LOGOS[c.name];
      const nm = escHtml(c.name);  // audit S3: company names are tenant-controlled
      return `<div class="enterprise-card" data-name="${nm}">
        ${logo ? `<img class="enterprise-card__logo" src="${logo}" alt="${nm}"/>` : `<div class="enterprise-card__name">${nm}</div>`}
        <div class="enterprise-card__cta">Abrir planificación</div>
      </div>`;
    }).join('');
    stampAstroScope(grid);
    grid.querySelectorAll('.enterprise-card').forEach(card => {
      card.addEventListener('click', () => pickEnterprise(card.getAttribute('data-name'), industry));
    });
  }

  function pickEnterprise(name: string | null, industry: string) {
    selectedEnterprise = name;
    entSelectorEl?.classList.remove('show');
    showDashboard(industry);
  }

  // Astro scopes <style> to build-time elements; JS-built nodes need the cid
  // attribute copied from a static ancestor or scoped rules won't match them.
  function stampAstroScope(root: Element) {
    const attr = Array.prototype.slice.call(root.attributes).find((a: Attr) => a.name.indexOf('data-astro-cid') === 0);
    if (attr) root.querySelectorAll('*').forEach(el => el.setAttribute(attr.name, attr.value));
  }

  // ── Phase 1: persistent context selector (Industry / Company / Plant / Section) ──
  // Wired to the tenant-scoped /api/plants + /api/plants/{id}/sections endpoints.
  // Keeps the working context visible + persistent (localStorage) and exposes it
  // as window.pcContext for later section-workspace / AI-context features.
  let ctxPlants: any[] = [];
  let ctxSections: any[] = [];
  let ctxPlant: any = null;
  let ctxSection: any = null;
  let _ctxWired = false;

  function _ctxToken() { return localStorage.getItem('pc_token'); }
  function _ctxClose(id: string) { const m = document.getElementById(id); if (m) m.hidden = true; }
  function _ctxToggle(openId: string, closeId: string) {
    _ctxClose(closeId);
    const o = document.getElementById(openId); if (o) o.hidden = !o.hidden;
  }
  function _ctxWire() {
    if (_ctxWired) return;
    _ctxWired = true;
    document.getElementById('ctxPlantBtn')?.addEventListener('click', (e) => { e.stopPropagation(); _ctxToggle('ctxPlantMenu', 'ctxSectionMenu'); });
    document.getElementById('ctxSectionBtn')?.addEventListener('click', (e) => { e.stopPropagation(); _ctxToggle('ctxSectionMenu', 'ctxPlantMenu'); });
    document.addEventListener('click', () => { _ctxClose('ctxPlantMenu'); _ctxClose('ctxSectionMenu'); });
  }

  function _ctxBuildMenu(menuId: string, items: any[], labelFn: (x: any) => string, onPick: (x: any) => void, activeId: any) {
    const menu = document.getElementById(menuId); if (!menu) return;
    menu.innerHTML = '';
    if (!items.length) {
      const empty = document.createElement('div');
      empty.className = 'ctx-opt'; empty.style.opacity = '.6'; empty.textContent = 'Sin elementos';
      menu.appendChild(empty);
    } else {
      items.forEach((it) => {
        const opt = document.createElement('div');
        opt.className = 'ctx-opt' + (it.id === activeId ? ' ctx-opt--active' : '');
        opt.textContent = labelFn(it);
        opt.addEventListener('click', (e) => { e.stopPropagation(); onPick(it); });
        menu.appendChild(opt);
      });
    }
    stampAstroScope(menu);
  }

  async function initContextBar(industry: string, companyName: string | null) {
    const bar = document.getElementById('ctxBar'); if (!bar) return;
    _ctxWire();
    const indLabel = (typeof IND_NAME !== 'undefined' && IND_NAME[industry]) ? IND_NAME[industry] : (industry || '—');
    const company = companyName || (currentUser && currentUser.company) || '—';
    const iEl = document.getElementById('ctxIndustry'); if (iEl) iEl.textContent = indLabel;
    const cEl = document.getElementById('ctxCompany'); if (cEl) cEl.textContent = company;
    (window as any).pcContext = { industry, industryLabel: indLabel, company, plantId: null, plant: null, sectionId: null, section: null };
    await _ctxLoadPlants();
  }

  async function _ctxLoadPlants() {
    const bar = document.getElementById('ctxBar'); const token = _ctxToken();
    if (!bar || !token) return;
    try {
      const res = await fetch(`${API}/api/plants`, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) { bar.hidden = true; return; }
      ctxPlants = await res.json();
    } catch (_) { bar.hidden = true; return; }
    if (!Array.isArray(ctxPlants) || !ctxPlants.length) { bar.hidden = true; return; }
    bar.hidden = false;
    const savedId = parseInt(localStorage.getItem('pc_plant') || '', 10);
    const plant = ctxPlants.find(p => p.id === savedId) || ctxPlants.find(p => p.is_default) || ctxPlants[0];
    await _ctxSetPlant(plant, true);
  }

  async function _ctxSetPlant(plant: any, restoreSection: boolean) {
    ctxPlant = plant;
    localStorage.setItem('pc_plant', String(plant.id));
    const el = document.getElementById('ctxPlantName'); if (el) el.textContent = plant.name;
    (window as any).pcContext.plantId = plant.id; (window as any).pcContext.plant = plant.name;
    _ctxBuildMenu('ctxPlantMenu', ctxPlants, (p) => p.name, (p) => _ctxPickPlant(p), ctxPlant && ctxPlant.id);
    await _ctxLoadSections(plant.id, restoreSection);
  }
  async function _ctxPickPlant(plant: any) {
    _ctxClose('ctxPlantMenu');
    if (ctxPlant && ctxPlant.id === plant.id) return;
    localStorage.removeItem('pc_section');
    await _ctxSetPlant(plant, false);
  }

  async function _ctxLoadSections(plantId: number, restore: boolean) {
    const token = _ctxToken(); ctxSections = [];
    try {
      const res = await fetch(`${API}/api/plants/${plantId}/sections`, { headers: { Authorization: `Bearer ${token}` } });
      if (res.ok) ctxSections = await res.json();
    } catch (_) {}
    if (!Array.isArray(ctxSections)) ctxSections = [];
    const savedId = restore ? parseInt(localStorage.getItem('pc_section') || '', 10) : NaN;
    const sec = ctxSections.find(s => s.id === savedId) || ctxSections[0] || null;
    _ctxSetSection(sec);
  }
  function _ctxSetSection(sec: any) {
    ctxSection = sec;
    const el = document.getElementById('ctxSectionName'); if (el) el.textContent = sec ? sec.name : '—';
    if (sec) localStorage.setItem('pc_section', String(sec.id));
    (window as any).pcContext.sectionId = sec ? sec.id : null; (window as any).pcContext.section = sec ? sec.name : null;
    _ctxBuildMenu('ctxSectionMenu', ctxSections, (s) => s.name, (s) => _ctxPickSection(s), ctxSection && ctxSection.id);
  }
  function _ctxPickSection(sec: any) { _ctxClose('ctxSectionMenu'); _ctxSetSection(sec); }

  // ── Plant Map module (MVP) ──────────────────────────────────────────────
  // Interactive SVG floor plan of the current plant's departments (sections),
  // wired to /api/plants/{id}/map + geometry PATCH. Pan/zoom, click→panel,
  // admin drag-to-move + create. Tenant scoping is enforced server-side.
  let pmData: any = null;
  let pmView = { x: 0, y: 0, w: 800, h: 600 };
  let pmSelId: number | null = null;
  let pmIsAdmin = false;
  let pmWired = false;
  let pmPanMoved = false;
  const PM_NS = 'http://www.w3.org/2000/svg';

  function pmEl(tag: string, attrs: Record<string, any>) {
    const e = document.createElementNS(PM_NS, tag);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  // Module-scope HTML escape — `escapeHtml` lives inside initDashboard() and is
  // not reachable from here, so define our own for the info panel.
  function pmEsc(s: any): string {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>
    )[c]);
  }
  function pmApplyView() {
    const svg = document.getElementById('pmCanvas');
    if (svg) svg.setAttribute('viewBox', `${pmView.x} ${pmView.y} ${pmView.w} ${pmView.h}`);
  }
  function pmShowEmpty(show: boolean) {
    const e = document.getElementById('pmEmpty'); if (e) e.hidden = !show;
  }
  function pmScale() {
    const svg = document.getElementById('pmCanvas'); if (!svg) return 1;
    const r = svg.getBoundingClientRect();
    return r.width ? pmView.w / r.width : 1;
  }

  async function initPlantMap() {
    const svg = document.getElementById('pmCanvas'); if (!svg) return;
    // Pilot decision: any authenticated company user may edit their own plant
    // (the server enforces tenant scoping). Full Viewer/Planner/Admin roles are
    // the next milestone; until then editing is enabled for all logged-in users.
    pmIsAdmin = true;
    const addBtn = document.getElementById('pmAddDept'); if (addBtn) addBtn.style.display = '';
    pmWireOnce();
    const plantId = (window as any).pcContext ? (window as any).pcContext.plantId : null;
    await pmLoad(plantId);
  }

  async function pmLoad(plantId: number | null) {
    const token = localStorage.getItem('pc_token');
    try {
      let pid = plantId;
      if (!pid) {
        const pr = await fetch(`${API}/api/plants`, { headers: { Authorization: `Bearer ${token}` } });
        const plants = pr.ok ? await pr.json() : [];
        pid = (plants && plants.length) ? plants[0].id : null;
      }
      if (!pid) { pmShowEmpty(true); return; }
      const res = await fetch(`${API}/api/plants/${pid}/map`, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) { pmShowEmpty(true); return; }
      pmData = await res.json();
      pmData.plant_id = pid;
      if ((window as any).pcContext) (window as any).pcContext.plantId = pid;
      const sub = document.getElementById('pmSub');
      if (sub) sub.textContent = `${pmData.plant.name} · ${(pmData.departments || []).length} departamentos`;
      pmFit(); pmRender();
    } catch (_) { pmShowEmpty(true); }
  }

  function pmFit() {
    const d = (pmData && pmData.departments) || [];
    if (!d.length) { pmView = { x: 0, y: 0, w: 800, h: 600 }; pmApplyView(); pmShowEmpty(true); return; }
    pmShowEmpty(false);
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    d.forEach((s: any) => { minX = Math.min(minX, s.pos_x); minY = Math.min(minY, s.pos_y); maxX = Math.max(maxX, s.pos_x + s.width); maxY = Math.max(maxY, s.pos_y + s.height); });
    const pad = 48;
    pmView = { x: minX - pad, y: minY - pad, w: (maxX - minX) + pad * 2, h: (maxY - minY) + pad * 2 };
    pmApplyView();
  }

  function pmRender() {
    const svg = document.getElementById('pmCanvas'); if (!svg) return;
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    (pmData && pmData.departments || []).forEach((s: any) => {
      const g = pmEl('g', { 'data-id': s.id }); (g as any).style.cursor = 'pointer';
      const sel = s.id === pmSelId;
      g.appendChild(pmEl('rect', { x: s.pos_x, y: s.pos_y, width: s.width, height: s.height, rx: 9, fill: 'var(--white)', stroke: sel ? 'var(--brand)' : s.color, 'stroke-width': sel ? 3 : 1.5 }));
      g.appendChild(pmEl('rect', { x: s.pos_x, y: s.pos_y, width: 6, height: s.height, rx: 3, fill: s.color }));
      const name = pmEl('text', { x: s.pos_x + 16, y: s.pos_y + 26, 'font-size': 13, 'font-weight': 700, fill: 'var(--n20)' }); name.textContent = s.name; g.appendChild(name);
      const kind = pmEl('text', { x: s.pos_x + 16, y: s.pos_y + 42, 'font-size': 10, fill: 'var(--n50)', 'font-family': 'ui-monospace,monospace' }); kind.textContent = s.kind || ''; g.appendChild(kind);
      if (s.capacity != null) {
        const inner = s.width - 32;
        const bw = Math.max(0, Math.min(1, s.capacity / 100)) * inner;
        const cy = s.pos_y + s.height - 16;
        const capColor = s.capacity >= 90 ? 'var(--red)' : s.capacity >= 70 ? 'var(--amber)' : 'var(--green)';
        g.appendChild(pmEl('rect', { x: s.pos_x + 16, y: cy, width: inner, height: 6, rx: 3, fill: 'var(--n90)' }));
        g.appendChild(pmEl('rect', { x: s.pos_x + 16, y: cy, width: bw, height: 6, rx: 3, fill: capColor }));
        const ct = pmEl('text', { x: s.pos_x + 16, y: cy - 4, 'font-size': 9, fill: 'var(--n50)', 'font-family': 'ui-monospace,monospace' }); ct.textContent = Math.round(s.capacity) + '% cap.'; g.appendChild(ct);
      }
      g.addEventListener('click', (e) => { e.stopPropagation(); pmSelId = s.id; pmRender(); pmShowPanel(s); });
      if (pmIsAdmin) pmMakeDraggable(g, s);
      svg.appendChild(g);
    });
    pmRenderLegend();
  }

  // Capacity → operational state (the map's decision cue: which department is a
  // bottleneck). Null when capacity isn't set yet, so the UI can prompt for it.
  function pmCapState(c: any) {
    if (c == null) return null;
    if (c >= 90) return { label: 'En riesgo', color: 'var(--red)' };
    if (c >= 70) return { label: 'Ajustado', color: 'var(--amber)' };
    return { label: 'Holgado', color: 'var(--green)' };
  }

  // Legend so the map is self-explanatory ("what am I looking at?"): the
  // department types present + what the capacity colours mean, only when relevant.
  function pmRenderLegend() {
    const el = document.getElementById('pmLegend'); if (!el) return;
    const deps = (pmData && pmData.departments) || [];
    if (!deps.length) { el.hidden = true; return; }
    const seen = new Map();
    deps.forEach((d: any) => { const k = d.kind || 'otro'; if (!seen.has(k)) seen.set(k, d.color); });
    let html = '<div class="pm-legend__t">Departamentos</div>';
    seen.forEach((color: string, k: string) => {
      html += `<div class="pm-legend__row"><span class="pm-legend__sw" style="background:${pmEsc(color)}"></span>${pmEsc(k)}</div>`;
    });
    if (deps.some((d: any) => d.capacity != null)) {
      html += '<div class="pm-legend__t" style="margin-top:4px">Capacidad</div>'
        + '<div class="pm-legend__row"><span class="pm-legend__sw" style="background:var(--red)"></span>En riesgo · ≥ 90%</div>'
        + '<div class="pm-legend__row"><span class="pm-legend__sw" style="background:var(--amber)"></span>Ajustado · 70–89%</div>'
        + '<div class="pm-legend__row"><span class="pm-legend__sw" style="background:var(--green)"></span>Holgado · &lt; 70%</div>';
    }
    el.innerHTML = html;
    stampAstroScope(el);   // JS-built rows/swatches need the Astro cid or scoped CSS won't match
    el.hidden = false;
  }

  function pmMakeDraggable(g: Element, s: any) {
    let drag = false, sx = 0, sy = 0, moved = false;
    const DRAG_THRESH = 4; // screen px; a press that moves less than this is a click-to-select, not a drag
    g.addEventListener('pointerdown', (e: any) => { e.stopPropagation(); drag = true; moved = false; sx = e.clientX; sy = e.clientY; g.setPointerCapture(e.pointerId); });
    g.addEventListener('pointermove', (e: any) => {
      if (!drag) return;
      // Ignore sub-threshold jitter: applying a transform here would move the node out
      // from under the pointer and suppress the native click, breaking click-to-select.
      if (!moved && Math.abs(e.clientX - sx) < DRAG_THRESH && Math.abs(e.clientY - sy) < DRAG_THRESH) return;
      moved = true;
      const sc = pmScale(); const dx = (e.clientX - sx) * sc, dy = (e.clientY - sy) * sc; g.setAttribute('transform', `translate(${dx} ${dy})`);
    });
    g.addEventListener('pointerup', async (e: any) => {
      if (!drag) return; drag = false;
      // Select on tap. We can't rely on the native click event: once a drag applies a
      // transform the element moves and the browser fires no click, so selection is done here.
      if (!moved) { pmSelId = s.id; pmRender(); pmShowPanel(s); return; }
      const sc = pmScale(); const dx = (e.clientX - sx) * sc, dy = (e.clientY - sy) * sc; s.pos_x = Math.max(0, Math.round(s.pos_x + dx)); s.pos_y = Math.max(0, Math.round(s.pos_y + dy)); g.removeAttribute('transform'); pmRender(); await pmSaveGeom(s);
    });
  }
  async function pmSaveGeom(s: any) {
    const token = localStorage.getItem('pc_token');
    try {
      await fetch(`${API}/api/sections/${s.id}/geometry`, { method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ pos_x: Math.round(s.pos_x), pos_y: Math.round(s.pos_y), width: Math.round(s.width), height: Math.round(s.height) }) });
    } catch (_) {}
  }

  function pmShowPanel(s: any) {
    const empty = document.getElementById('pmPanelEmpty'); if (empty) empty.hidden = true;
    const body = document.getElementById('pmPanelBody'); if (!body) return; body.hidden = false;
    const cs = pmCapState(s.capacity);
    const cap = s.capacity != null
      ? `<div class="pm-field"><div class="pm-field__k">Capacidad</div><div class="pm-field__v">${Math.round(s.capacity)}%<span class="pm-chip" style="background:color-mix(in srgb, ${cs.color} 15%, transparent);color:${cs.color}">${cs.label}</span></div></div>`
      : `<div class="pm-field"><div class="pm-field__k">Capacidad</div><div class="pm-field__v" style="color:var(--n50)">Sin definir · añádela para ver la carga</div></div>`;
    const hint = pmIsAdmin ? `<div style="margin-top:14px;font-size:.72rem;color:var(--n50);border-top:1px solid var(--n90);padding-top:10px">Arrastra el departamento en el mapa para reubicarlo.</div>` : '';
    body.innerHTML = `
      <div style="font-size:1.05rem;font-weight:700;margin-bottom:12px;color:var(--n20)">${pmEsc(s.name)}</div>
      <div class="pm-field"><div class="pm-field__k">Tipo</div><div class="pm-field__v" style="text-transform:capitalize">${pmEsc(s.kind || '—')}</div></div>
      ${s.owner ? `<div class="pm-field"><div class="pm-field__k">Responsable</div><div class="pm-field__v">${pmEsc(s.owner)}</div></div>` : ''}
      ${cap}
      <div class="pm-field"><div class="pm-field__k">Posición</div><div class="pm-field__v">${Math.round(s.pos_x)}, ${Math.round(s.pos_y)} · ${Math.round(s.width)}×${Math.round(s.height)}</div></div>
      ${hint}`;
    stampAstroScope(body);   // JS-built fields/chip need the Astro cid or scoped CSS won't match
  }
  function pmClearPanel() {
    const empty = document.getElementById('pmPanelEmpty'); if (empty) empty.hidden = false;
    const body = document.getElementById('pmPanelBody'); if (body) body.hidden = true;
  }

  function pmWireOnce() {
    if (pmWired) return; pmWired = true;
    const svg = document.getElementById('pmCanvas'); if (!svg) return;
    svg.addEventListener('pointerdown', (e: any) => {
      if ((e.target as Element).closest && (e.target as Element).closest('g[data-id]')) return;
      pmPanMoved = false;
      const sx = e.clientX, sy = e.clientY, ox = pmView.x, oy = pmView.y;
      svg.classList.add('pm-grabbing');
      const move = (ev: any) => { const sc = pmScale(); pmView.x = ox - (ev.clientX - sx) * sc; pmView.y = oy - (ev.clientY - sy) * sc; pmPanMoved = true; pmApplyView(); };
      const up = () => { svg.classList.remove('pm-grabbing'); window.removeEventListener('pointermove', move); window.removeEventListener('pointerup', up); };
      window.addEventListener('pointermove', move); window.addEventListener('pointerup', up);
    });
    svg.addEventListener('wheel', (e: any) => { e.preventDefault(); pmZoomAt(e.deltaY < 0 ? 0.9 : 1.1, e); }, { passive: false });
    svg.addEventListener('click', () => { if (pmPanMoved) { pmPanMoved = false; return; } pmSelId = null; pmRender(); pmClearPanel(); });
    document.getElementById('pmZoomIn')?.addEventListener('click', () => pmZoom(0.85));
    document.getElementById('pmZoomOut')?.addEventListener('click', () => pmZoom(1.18));
    document.getElementById('pmZoomReset')?.addEventListener('click', () => pmFit());
    document.getElementById('pmAddDept')?.addEventListener('click', pmOpenCreate);
  }
  function pmZoom(f: number) { const cx = pmView.x + pmView.w / 2, cy = pmView.y + pmView.h / 2; pmView.w *= f; pmView.h *= f; pmView.x = cx - pmView.w / 2; pmView.y = cy - pmView.h / 2; pmApplyView(); }
  function pmZoomAt(f: number, e: any) {
    const svg = document.getElementById('pmCanvas'); if (!svg) return; const r = svg.getBoundingClientRect();
    const rx = (e.clientX - r.left) / r.width, ry = (e.clientY - r.top) / r.height;
    const px = pmView.x + rx * pmView.w, py = pmView.y + ry * pmView.h;
    pmView.w *= f; pmView.h *= f; pmView.x = px - rx * pmView.w; pmView.y = py - ry * pmView.h; pmApplyView();
  }

  function pmOpenCreate() {
    if (!pmIsAdmin || !pmData) return;
    const back = document.createElement('div'); back.className = 'pm-modal-back';
    back.innerHTML = `<div class="pm-modal">
      <h3>Nuevo departamento</h3>
      <label>Tipo</label>
      <select id="pmcType"><option value="production">Producción</option><option value="warehouse">Almacén</option><option value="quality">Calidad</option><option value="maintenance">Mantenimiento</option><option value="tooling">Utillaje</option><option value="logistics">Logística</option><option value="office">Oficina</option><option value="custom">Otro</option></select>
      <label>Nombre</label><input id="pmcName" maxlength="120" placeholder="p. ej. Línea de montaje 2"/>
      <label>Responsable (opcional)</label><input id="pmcOwner" maxlength="120"/>
      <label>Capacidad % (opcional)</label><input id="pmcCap" type="number" min="0" max="100"/>
      <div id="pmcErr" style="color:var(--red);font-size:.8rem;margin-top:8px;display:none"></div>
      <div class="pm-modal__actions"><button class="btn-ui" id="pmcCancel" type="button">Cancelar</button><button class="btn-ui btn-ui--primary" id="pmcSave" type="button">Crear</button></div>
    </div>`;
    // Stamp Astro scope so .pm-modal / .btn-ui scoped CSS applies to this body-appended node.
    const cidEl = document.getElementById('panel-plantmap');
    const cidAttr = cidEl && Array.prototype.slice.call(cidEl.attributes).find((a: Attr) => a.name.indexOf('data-astro-cid') === 0);
    if (cidAttr) { back.setAttribute(cidAttr.name, cidAttr.value); stampAstroScope(back); }
    document.body.appendChild(back);
    const close = () => back.remove();
    back.addEventListener('click', (e) => { if (e.target === back) close(); });
    (back.querySelector('#pmcCancel') as HTMLElement)?.addEventListener('click', close);
    (back.querySelector('#pmcSave') as HTMLElement)?.addEventListener('click', async () => {
      const name = (back.querySelector('#pmcName') as HTMLInputElement).value.trim();
      const err = back.querySelector('#pmcErr') as HTMLElement;
      if (!name) { err.textContent = 'El nombre es obligatorio.'; err.style.display = 'block'; return; }
      const kind = (back.querySelector('#pmcType') as HTMLSelectElement).value;
      const owner = (back.querySelector('#pmcOwner') as HTMLInputElement).value.trim() || null;
      const capV = (back.querySelector('#pmcCap') as HTMLInputElement).value;
      const capacity = capV === '' ? null : parseFloat(capV);
      let py = 40; (pmData.departments || []).forEach((s: any) => { py = Math.max(py, s.pos_y + s.height + 30); });
      const token = localStorage.getItem('pc_token');
      try {
        const res = await fetch(`${API}/api/sections`, { method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ plant_id: pmData.plant_id, name, kind, owner, capacity, pos_x: 40, pos_y: py, width: 150, height: 96 }) });
        if (res.ok) { close(); await pmLoad(pmData.plant_id); }
        else { err.textContent = 'No se pudo crear el departamento.'; err.style.display = 'block'; }
      } catch (_) { err.textContent = 'Error de red.'; err.style.display = 'block'; }
    });
  }

  function showDashboard(industry) {
    selectorEl.classList.add('hidden');
    entSelectorEl?.classList.remove('show');
    dashboardEl.classList.add('visible');
    sidebarEl.classList.remove('hidden');
    industriesPanelEl.classList.remove('hidden');
    backBtn.classList.remove('hidden');
    backSep.classList.remove('hidden');
    document.querySelectorAll('.ind-item').forEach(el => {
      el.classList.toggle('ind-item--active', el.dataset.industry === industry);
    });
    initDashboard();
    loadHomeWidgets();
    setCopilotAvailable(true);
    initContextBar(industry, selectedEnterprise);
    // honour the "start panel" preference (Configuración) — only if the user
    // may open it; otherwise land on their first permitted module, or on the
    // "pending permissions" screen when they have none.
    applyModuleVisibility();
    const saved = getSettings().startPanel;
    const startPanel = saved && canOpenPanel(saved) ? saved : firstAllowedPanel();
    if (startPanel === 'noaccess') {
      openNoAccessPanel();
    } else if (startPanel !== 'gantt') {
      (document.querySelector(`.nav-item[data-panel="${startPanel}"]`) as HTMLElement | null)?.click();
    }
  }

  function showLoginForm(errMsg?: string) {
    const spinner = document.getElementById('auth-spinner');
    const card    = document.getElementById('login-card');
    if (spinner) spinner.style.display = 'none';
    if (card)    card.classList.add('visible');
    showAuthStep('login');
    if (errMsg) {
      const errEl = document.getElementById('login-err');
      if (errEl) { errEl.textContent = errMsg; errEl.style.display = 'block'; }
    }
    // Pre-warm the server in the background so login POST is fast
    fetch(`${API}/health`).catch(() => {});
  }

  function hideOverlay() {
    const overlay = document.getElementById('auth-overlay');
    if (overlay) overlay.classList.add('hidden');
  }

  function applyUser(user: any) {
    currentUser = user;
    layoutLoadForUser(user);
    try {
      const initials = user.name
        ? user.name.split(' ').map((w: string) => w[0]).slice(0,2).join('').toUpperCase()
        : (user.email || 'U').slice(0,2).toUpperCase();
      const uiEl = document.getElementById('user-initials');
      if (uiEl) uiEl.textContent = initials;
      const unEl = document.getElementById('user-name');
      if (unEl) unEl.textContent = user.name || user.email;
      const urEl = document.getElementById('user-role');
      if (urEl) urEl.textContent = user.role === 'platform_admin' ? 'Admin. plataforma'
        : user.is_admin ? 'Administrador' : 'Usuario';
      // initAdminPanel lives inside initDashboard's scope (sidebar DOM isn't
      // mounted/relevant until the dashboard shows); it reads currentUser when
      // the dashboard is shown. The localStorage flag is kept only for older
      // cached bundles — nothing in this file trusts it for access decisions.
      localStorage.setItem('pc_is_admin', user.is_admin ? 'true' : 'false');
      applyModuleVisibility();
      applyPilot(user.pilot);
    } catch (e) {
      console.error('applyUser error', e);
    }
    hideOverlay();
    showSelector();
  }

  // Pilot timeline is per-company (admin sets "Inicio del piloto" + "Semanas").
  // `user.pilot` = { start, week, total, pct } from /auth/me, computed live so it
  // advances by itself each week. Absent (company with no pilot set) → leave the
  // static demo values untouched.
  function applyPilot(pilot: any) {
    if (!pilot || !pilot.total) return;
    const chip = document.querySelector('.pilot-chip') as HTMLElement | null;
    if (chip) {
      chip.style.display = '';
      const val = chip.querySelector('.pilot-chip__val');
      if (val) val.textContent = `Sem. ${pilot.week} / ${pilot.total}`;
      const fill = chip.querySelector('.pilot-chip__fill') as HTMLElement | null;
      if (fill) fill.style.width = `${pilot.pct}%`;
    }
    const scWeek = document.querySelector('.scorecard__week');
    if (scWeek) scWeek.textContent = `Sem. ${pilot.week}`;
    const kpiSub = document.querySelector('#panel-kpis .panel-page-sub');
    if (kpiSub) kpiSub.textContent = `Semana ${pilot.week} de ${pilot.total} · Evolución acumulada desde inicio del piloto`;
  }

  async function doLogin() {
    const email    = (document.getElementById('login-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('login-password') as HTMLInputElement).value;
    const btn      = document.getElementById('login-btn') as HTMLButtonElement;
    const errEl    = document.getElementById('login-err')!;
    if (!email || !password) { errEl.textContent = 'Introduce email y contraseña'; errEl.style.display = 'block'; return; }
    btn.disabled = true;
    btn.textContent = 'Verificando…';
    errEl.style.display = 'none';
    const hint = setTimeout(() => { btn.textContent = 'Iniciando servidor… (10-15s primera vez)'; }, 3000);
    try {
      const res = await fetch(`${API}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      clearTimeout(hint);
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Credenciales incorrectas');
      localStorage.setItem('pc_token', data.access_token);
      const card = document.getElementById('login-card');
      if (card) card.classList.remove('visible');
      applyUser(data.user);
    } catch (e: any) {
      clearTimeout(hint);
      errEl.textContent = e.message || 'Error de autenticación';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Entrar →';
    }
  }

  // ── Forgot password (security question) ──────────────────────────────
  let fpEmail = '';

  function showAuthStep(step: 'login' | 'forgot1' | 'forgot2') {
    const boxes: Record<string, HTMLElement | null> = {
      login: document.getElementById('login-box'),
      forgot1: document.getElementById('forgot-step1'),
      forgot2: document.getElementById('forgot-step2'),
    };
    Object.entries(boxes).forEach(([key, el]) => { if (el) el.style.display = key === step ? '' : 'none'; });
  }

  document.getElementById('forgotPasswordLink')?.addEventListener('click', () => {
    const fpEmailInput = document.getElementById('fp-email') as HTMLInputElement;
    if (fpEmailInput) fpEmailInput.value = (document.getElementById('login-email') as HTMLInputElement)?.value || '';
    showAuthStep('forgot1');
  });
  document.getElementById('fp-back-to-login-1')?.addEventListener('click', () => showAuthStep('login'));
  document.getElementById('fp-back-to-login-2')?.addEventListener('click', () => showAuthStep('login'));

  document.getElementById('fp-continue-btn')?.addEventListener('click', async () => {
    const email = (document.getElementById('fp-email') as HTMLInputElement).value.trim();
    const errEl = document.getElementById('fp-step1-err')!;
    errEl.style.display = 'none';
    if (!email) { errEl.textContent = 'Introduce tu email'; errEl.style.display = 'block'; return; }
    try {
      const res = await fetch(`${API}/auth/forgot-password/question`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'No se pudo continuar');
      fpEmail = email;
      const qEl = document.getElementById('fp-question');
      if (qEl) qEl.textContent = data.question;
      (document.getElementById('fp-answer') as HTMLInputElement).value = '';
      (document.getElementById('fp-new-password') as HTMLInputElement).value = '';
      document.getElementById('fp-step2-err')!.style.display = 'none';
      showAuthStep('forgot2');
    } catch (e: any) {
      errEl.textContent = e.message || 'No se pudo continuar';
      errEl.style.display = 'block';
    }
  });

  document.getElementById('fp-reset-btn')?.addEventListener('click', async () => {
    const answer = (document.getElementById('fp-answer') as HTMLInputElement).value;
    const newPassword = (document.getElementById('fp-new-password') as HTMLInputElement).value;
    const errEl = document.getElementById('fp-step2-err')!;
    errEl.style.display = 'none';
    if (!answer || !newPassword) { errEl.textContent = 'Completa la respuesta y la nueva contraseña'; errEl.style.display = 'block'; return; }
    if (newPassword.length < 8) { errEl.textContent = 'La contraseña debe tener al menos 8 caracteres'; errEl.style.display = 'block'; return; }
    const btn = document.getElementById('fp-reset-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Restableciendo…';
    try {
      const res = await fetch(`${API}/auth/forgot-password/reset`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: fpEmail, answer, new_password: newPassword }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'No se pudo restablecer la contraseña');
      showToast('✓ Contraseña actualizada. Ya puedes iniciar sesión.');
      (document.getElementById('login-email') as HTMLInputElement).value = fpEmail;
      (document.getElementById('login-password') as HTMLInputElement).value = '';
      showAuthStep('login');
    } catch (e: any) {
      errEl.textContent = e.message || 'No se pudo restablecer la contraseña';
      errEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Restablecer contraseña';
    }
  });

  async function init() {
    const token = localStorage.getItem('pc_token');
    if (!token) { showLoginForm(); return; }
    // Show hint if token validation takes long (cold start)
    const hintTimer = setTimeout(() => {
      const msg = document.getElementById('auth-spinner-msg');
      if (msg) msg.textContent = 'Iniciando servidor… puede tardar unos segundos';
    }, 3000);
    try {
      const res = await fetch(`${API}/auth/me`, { headers: { Authorization: `Bearer ${token}` } });
      clearTimeout(hintTimer);
      if (!res.ok) throw new Error('expired');
      const user = await res.json();
      applyUser(user);
    } catch {
      clearTimeout(hintTimer);
      localStorage.removeItem('pc_token');
      showLoginForm('Tu sesión ha expirado. Vuelve a iniciar sesión.');
    }
  }

  // Login form wiring
  document.getElementById('login-btn')?.addEventListener('click', doLogin);
  document.getElementById('login-password')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') doLogin();
  });
  document.getElementById('login-email')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') (document.getElementById('login-password') as HTMLInputElement)?.focus();
  });

  // Industry cards in selector view → go to the enterprise picker first
  document.querySelectorAll('#industry-selector .industry-card').forEach(card => {
    card.addEventListener('click', () => showEnterpriseSelector((card as HTMLElement).dataset.industry as string));
  });

  // Industry links in sidebar panel → enterprise picker for that sector
  document.querySelectorAll('.ind-item').forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      showEnterpriseSelector((link as HTMLElement).dataset.industry as string);
    });
  });

  // Back to selector
  backBtn.addEventListener('click', showSelector);
  document.getElementById('entBack')?.addEventListener('click', showSelector);

  // ── Toast ──────────────────────────────────────────────
  function showToast(msg, duration = 3000) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.add('visible');
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => toast.classList.remove('visible'), duration);
  }

  // ── Dashboard interactivity (init once dashboard is shown) ──
  let dashboardReady = false;

  function initDashboard() {
    if (dashboardReady) return;
    dashboardReady = true;

    initAdminPanel(!!currentUser?.is_admin);
    initKpiDashboard();
    initCopilot();
    initLayout();

    // 1. Gantt tab switching (Semana / Turno)
    const ganttSemana  = document.getElementById('gantt-semana');
    const ganttTurno   = document.getElementById('gantt-turno');
    const ganttSub     = document.querySelector('.gantt-header__sub');

    document.querySelectorAll('#ganttTabs .tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('#ganttTabs .tab').forEach(t => t.classList.remove('tab--active'));
        tab.classList.add('tab--active');
        const view = tab.dataset.view;
        if (view === 'semana') {
          ganttSemana.style.display = '';
          ganttTurno.style.display  = 'none';
          ganttSub.textContent = '5 recursos · 12 órdenes activas';
        } else {
          ganttSemana.style.display = 'none';
          ganttTurno.style.display  = '';
          const _t = new Date();
          const _dn = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'][_t.getDay()];
          const _mn = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'][_t.getMonth()];
          ganttSub.textContent = `${_dn} ${_t.getDate()} ${_mn} · Vista por horas · T.Mañana 06–14h · T.Tarde 14–22h`;
        }
      });
    });

    // ── COMPOSITES PLANNER ─────────────────────────────────────
    (function initPlannerUI() {
      const plannerBar      = document.getElementById('planner-bar');
      const plannerToggleBtn = document.getElementById('plannerToggleBtn');
      const plannerCloseBtn  = document.getElementById('plannerCloseBtn');
      const altCards         = document.getElementById('planner-alternatives');
      const manualView       = document.getElementById('gantt-manual-view');
      const plannerView      = document.getElementById('gantt-planner-view');
      const spinner          = document.getElementById('plannerSpinner');
      const runBtn           = document.getElementById('runPlannerBtn');
      const ganttSubEl       = document.querySelector('.gantt-header__sub') as HTMLElement;

      let pieceTypesList: any[] = [];
      let selectedAlt: any = null;
      let simGen = 0;  // guards against a stale simulation writing onto a newer set of cards

      // Default week start = nearest Monday
      function getMonday(d: Date): string {
        const day = d.getDay();
        const diff = day === 0 ? -6 : 1 - day;
        const mon = new Date(d);
        mon.setDate(d.getDate() + diff);
        return mon.toISOString().split('T')[0];
      }
      const weekInput = document.getElementById('plannerWeekStart') as HTMLInputElement;
      if (weekInput) weekInput.value = getMonday(new Date());

      // Populate piece type selects from API
      async function loadPieceTypes() {
        const token = localStorage.getItem('pc_token');
        try {
          const res = await fetch(`${API}/api/piece-types`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) pieceTypesList = await res.json();
        } catch (_) {}
        // Also merge any custom types from localStorage
        try {
          const stored = JSON.parse(localStorage.getItem('pc_process_times') || '[]');
          stored.forEach((pt: any) => {
            if (!pieceTypesList.find((p: any) => p.name === pt.name)) {
              pieceTypesList.push({
                name: pt.name,
                atl_hours: pt.atl_hours ?? 4,
                autoclave_hours: pt.autoclave_hours ?? 8,
                ndt_hours: pt.ndt_hours ?? 3,
                cnc_hours: pt.cnc_hours ?? 3,
                workers_atl: pt.workers_atl ?? 1,
                workers_bag: 2, workers_autoclave: 1, workers_ndt: 1, workers_cnc: 1,
                layup_type: 'Custom',
              });
            }
          });
        } catch (_) {}
        ['atl1PieceType','atl2PieceType'].forEach(id => {
          const sel = document.getElementById(id) as HTMLSelectElement;
          if (!sel) return;
          sel.innerHTML = '';
          pieceTypesList.forEach((pt: any) => {
            const opt = document.createElement('option');
            opt.value = pt.name;
            opt.textContent = `${pt.name}${pt.aircraft ? ' ('+pt.aircraft+')' : ''}`;
            sel.appendChild(opt);
          });
        });
        if ((document.getElementById('atl2PieceType') as HTMLSelectElement)?.options.length > 1) {
          (document.getElementById('atl2PieceType') as HTMLSelectElement).selectedIndex = 1;
        }
      }

      // Toggle planner bar on/off
      plannerToggleBtn?.addEventListener('click', async () => {
        const isOpen = plannerBar.style.display !== 'none';
        if (isOpen) return closePlanner();
        plannerBar.style.display = '';
        plannerToggleBtn.classList.add('btn-ui--primary');
        if (pieceTypesList.length === 0) await loadPieceTypes();
      });

      plannerCloseBtn?.addEventListener('click', closePlanner);

      function closePlanner() {
        plannerBar.style.display = 'none';
        altCards.style.display = 'none';
        spinner.classList.remove('active');
        manualView.style.display = '';
        plannerView.style.display = 'none';
        plannerToggleBtn.classList.remove('btn-ui--primary');
        if (ganttSubEl) ganttSubEl.textContent = '5 recursos · 12 órdenes activas';
      }

      // Build PlanRequest body
      function buildPlanRequest(): any {
        const weekStart = (document.getElementById('plannerWeekStart') as HTMLInputElement).value;
        const atl1Type  = (document.getElementById('atl1PieceType') as HTMLSelectElement).value;
        const atl1Qty   = parseInt((document.getElementById('atl1Qty') as HTMLInputElement).value) || 2;
        const atl2Type  = (document.getElementById('atl2PieceType') as HTMLSelectElement).value;
        const atl2Qty   = parseInt((document.getElementById('atl2Qty') as HTMLInputElement).value) || 2;

        // Piece types needed
        const needed = new Set([atl1Type, atl2Type]);
        const piece_types = pieceTypesList
          .filter((pt: any) => needed.has(pt.name))
          .map((pt: any) => ({
            name:              pt.name,
            layup_type:        pt.layup_type || 'Cuasi-isótropo',
            atl_hours:         pt.atl_hours,
            autoclave_hours:   pt.autoclave_hours,
            ndt_hours:         pt.ndt_hours,
            cnc_hours:         pt.cnc_hours,
            workers_atl:       pt.workers_atl ?? 1,
            workers_bag:       pt.workers_bag ?? 2,
            workers_autoclave: pt.workers_autoclave ?? 1,
            workers_ndt:       pt.workers_ndt ?? 1,
            workers_cnc:       pt.workers_cnc ?? 1,
          }));

        // Default specializations from localStorage or fallback 2 workers / shift
        let specializations: any[] = [];
        try {
          const shifts = JSON.parse(localStorage.getItem('pc_shift_schedule') || '[]');
          if (shifts.length >= 3) {
            specializations = [
              { operation: 'atl_layup',  shift1: 2, shift2: 2, shift3: 1 },
              { operation: 'bag_prep',   shift1: 2, shift2: 2, shift3: 1 },
              { operation: 'autoclave',  shift1: 1, shift2: 1, shift3: 1 },
              { operation: 'ndt',        shift1: 1, shift2: 1, shift3: 1 },
              { operation: 'cnc',        shift1: 1, shift2: 1, shift3: 1 },
            ];
          }
        } catch (_) {}
        if (specializations.length === 0) {
          specializations = [
            { operation: 'atl_layup',  shift1: 2, shift2: 2, shift3: 1 },
            { operation: 'bag_prep',   shift1: 2, shift2: 2, shift3: 1 },
            { operation: 'autoclave',  shift1: 1, shift2: 1, shift3: 1 },
            { operation: 'ndt',        shift1: 1, shift2: 1, shift3: 1 },
            { operation: 'cnc',        shift1: 1, shift2: 1, shift3: 1 },
          ];
        }

        return {
          week_start: weekStart,
          atl_assignments: [
            { machine: 'ATL-01', piece_type: atl1Type, quantity: atl1Qty },
            { machine: 'ATL-02', piece_type: atl2Type, quantity: atl2Qty },
          ],
          piece_types,
          specializations,
          maintenance: [],
        };
      }

      // Run planner and show alternatives
      runBtn?.addEventListener('click', async () => {
        const token = localStorage.getItem('pc_token');
        spinner.classList.add('active');
        altCards.style.display = 'none';
        manualView.style.display = 'none';
        plannerView.style.display = 'none';
        runBtn.disabled = true;

        try {
          const body = buildPlanRequest();
          lastPlanRequest = body;  // copilot context: the plan on screen
          const res = await fetch(`${API}/api/plan/alternatives`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            showToast(`⚠ Error al planificar: ${err.detail || res.status}`);
            manualView.style.display = '';
            return;
          }
          const data = await res.json();
          renderAlternatives(data.alternatives);
          runSimulation(body);
        } catch (e) {
          showToast('⚠ No se pudo conectar con el servidor');
          manualView.style.display = '';
        } finally {
          spinner.classList.remove('active');
          runBtn.disabled = false;
        }
      });

      // Derive the schedule shape from the 21-shift events grid (7 días × 3 turnos).
      // On small inputs the deployed summary KPIs (cumplimiento, saturación) come
      // back identical across the 3 buffers — the real difference is *cuándo*
      // termina el plan y *cuánto margen* deja entre operaciones ante imprevistos.
      function altMetrics(alt: any) {
        const evs = alt.events || [];
        if (!evs.length) return null;
        const endIdx = Math.max(...evs.map((e: any) => e.day * 3 + (e.shift - 1) + (e.duration_shifts || 1))); // 1..21, fin exclusivo
        const lastConsumed = endIdx - 1;
        const finDay   = Math.floor(lastConsumed / 3);
        const finShift = (lastConsumed % 3) + 1;
        const dayLabel = (alt.week_days && alt.week_days[finDay]) || ('Día ' + (finDay + 1));
        // Margen entre operaciones: turnos que espera una pieza entre acabar ATL y entrar en autoclave.
        let buffer: number | null = null;
        evs.filter((e: any) => /^ATL/.test(e.resource)).forEach((a: any) => {
          const c = evs.find((x: any) => x.resource === 'AUTOCLAVE' && x.title === a.title);
          if (!c) return;
          const gap = (c.day * 3 + (c.shift - 1)) - (a.day * 3 + (a.shift - 1) + (a.duration_shifts || 1));
          if (buffer === null || gap < buffer) buffer = gap;
        });
        return { endIdx, finishLabel: `${dayLabel} · T${finShift}`, buffer };
      }

      // Render the 3 alternative cards
      function renderAlternatives(alternatives: any[]) {
        altCards.innerHTML = '';

        const metrics   = alternatives.map(altMetrics);
        const haveAll   = metrics.every((m: any) => m);
        const minEnd    = haveAll ? Math.min(...metrics.map((m: any) => m.endIdx)) : 0;
        const maxEnd    = haveAll ? Math.max(...metrics.map((m: any) => m.endIdx)) : 0;
        const buffers   = metrics.map((m: any) => (m && m.buffer !== null ? m.buffer : null));
        const haveBuf   = buffers.every((b: any) => b !== null);
        const maxBuf    = haveBuf ? Math.max(...buffers as number[]) : 0;
        const comps     = alternatives.map((a: any) => a.summary.compliance_pct);
        const sameComp  = comps.every((c: number) => c === comps[0]);

        // When the summary KPIs don't separate the options, spell out the trade-off once.
        if (haveAll && sameComp && (minEnd !== maxEnd || (haveBuf && Math.min(...buffers as number[]) !== maxBuf))) {
          const note = document.createElement('div');
          note.className = 'alt-cards__note';
          note.innerHTML = `Las 3 opciones cumplen el plan al <b>${comps[0]}%</b>. El compromiso es <b>velocidad de entrega</b> frente a <b>margen ante imprevistos</b>: compara «Fin del plan» y «Margen entre operaciones».`;
          altCards.appendChild(note);
        }

        alternatives.forEach((alt: any, idx: number) => {
          const s = alt.summary;
          const m = metrics[idx];
          const compColor = s.compliance_pct >= 90 ? '#16A34A' : s.compliance_pct >= 75 ? '#D97706' : '#DC2626';
          const warnings = [...s.warnings, ...s.qualification_alerts].slice(0, 3);

          let kpi3: string, kpi4: string;
          if (m) {
            const fast = haveAll && m.endIdx === minEnd && minEnd !== maxEnd;
            kpi3 = `<div class="alt-kpi"><span class="alt-kpi__val"${fast ? ' style="color:#16A34A"' : ''}>${m.finishLabel}</span><span class="alt-kpi__key">Fin del plan${fast ? ' · el más rápido' : ''}</span></div>`;
          } else {
            kpi3 = `<div class="alt-kpi"><span class="alt-kpi__val">${s.atl_saturation_pct}%</span><span class="alt-kpi__key">Sat. ATL</span></div>`;
          }
          if (m && m.buffer !== null) {
            const b = m.buffer;
            const roomy = haveBuf && b === maxBuf && b > 0;
            const bColor = b === 0 ? '#DC2626' : roomy ? '#16A34A' : '';
            kpi4 = `<div class="alt-kpi"><span class="alt-kpi__val"${bColor ? ` style="color:${bColor}"` : ''}>${b} turno${b === 1 ? '' : 's'}</span><span class="alt-kpi__key">Margen entre ops.${roomy ? ' · el mayor' : b === 0 ? ' · sin colchón' : ''}</span></div>`;
          } else {
            kpi4 = `<div class="alt-kpi"><span class="alt-kpi__val">${s.autoclave_saturation_pct}%</span><span class="alt-kpi__key">Sat. Autoclave</span></div>`;
          }

          const card = document.createElement('div');
          card.className = 'alt-card';
          card.innerHTML = `
            <div class="alt-card__header">
              <span class="alt-card__badge">${s.badge}</span>
              <span class="alt-card__label" hidden>${s.label}</span>
            </div>
            <div class="alt-card__desc">${s.description}</div>
            <div class="alt-card__kpis">
              <div class="alt-kpi"><span class="alt-kpi__val" style="color:${compColor}">${s.compliance_pct}%</span><span class="alt-kpi__key">Cumplimiento OTD</span></div>
              <div class="alt-kpi"><span class="alt-kpi__val">${s.pieces_scheduled}/${s.pieces_total}</span><span class="alt-kpi__key">Piezas prog.</span></div>
              ${kpi3}
              ${kpi4}
            </div>
            ${warnings.length ? `<div class="alt-card__warnings">${warnings.map((w: string) => `<div>${escHtml(w)}</div>`).join('')}</div>` : ''}
          `;
          card.addEventListener('click', () => {
            document.querySelectorAll('.alt-card').forEach(c => c.classList.remove('alt-card--selected'));
            card.classList.add('alt-card--selected');
            selectedAlt = alt;
            renderPlannerGantt(alt);
          });
          // Auto-select the equilibrado one (index 1)
          if (idx === 1) {
            card.classList.add('alt-card--selected');
            selectedAlt = alt;
          }
          altCards.appendChild(card);
        });
        stampAstroScope(altCards);   // JS-built cards need the Astro cid or scoped CSS won't match
        altCards.style.display = '';
        // Auto-render the recommended (equilibrado) alternative
        if (alternatives[1]) renderPlannerGantt(alternatives[1]);
      }

      // ── Monte Carlo robustness prediction ──────────────────────
      // Runs right after the 3 alternative cards render. Calls /api/plan/simulate
      // with the same PlanRequest body and appends a robustness block to each
      // card (matched by label). Silent no-op if the endpoint isn't reachable.
      async function runSimulation(planBody: any) {
        const gen = ++simGen;
        const token = localStorage.getItem('pc_token');
        altCards.querySelectorAll('.alt-card').forEach((c: any) => {
          if (c.querySelector('.alt-card__sim')) return;
          const el = document.createElement('div');
          el.className = 'alt-card__sim alt-card__sim--loading';
          el.textContent = 'Simulando robustez (Monte Carlo)…';
          c.appendChild(el);
        });
        stampAstroScope(altCards);
        try {
          const res = await fetch(`${API}/api/plan/simulate`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(planBody),
          });
          if (gen !== simGen) return;
          if (!res.ok) throw new Error('simulate ' + res.status);
          const sim = await res.json();
          renderPredictions(sim);
        } catch (e) {
          if (gen === simGen) altCards.querySelectorAll('.alt-card__sim').forEach((el: any) => el.remove());
        }
      }

      function renderPredictions(sim: any) {
        const byLabel: Record<string, any> = {};
        (sim.alternatives || []).forEach((a: any) => { byLabel[a.label] = a.prediction; });
        altCards.querySelectorAll('.alt-card').forEach((card: any) => {
          const label  = (card.querySelector('.alt-card__label')?.textContent || '').trim();
          const holder = card.querySelector('.alt-card__sim');
          const p = byLabel[label];
          if (!holder) return;
          if (!p) { holder.remove(); return; }
          const score = p.robustness_score;
          const color = score >= 80 ? '#16A34A' : score >= 55 ? '#D97706' : '#DC2626';
          const pc = p.pieces_completed || {};
          const mk = p.makespan_shifts  || {};
          // A-08: show the 95% confidence interval, not a false-precision point.
          const sci = Array.isArray(p.robustness_score_ci) ? p.robustness_score_ci : null;
          const sciTxt = sci ? `<span style="font-size:.6rem;font-weight:500;color:var(--n50);margin-left:.35rem">IC95 ${sci[0]}–${sci[1]}</span>` : '';
          const whci = Array.isArray(p.within_horizon_ci) ? p.within_horizon_ci : null;
          const whTxt = whci ? ` <span style="font-size:.62rem;color:var(--n50)">(${Math.round(whci[0]*100)}–${Math.round(whci[1]*100)}%)</span>` : '';
          // A-02: label results honestly until the model is calibrated with real data.
          const calibrated = !!(sim.model && sim.model.calibrated);
          const badge = calibrated ? '' :
            `<div style="font-size:.64rem;font-weight:600;color:#B7791F;background:rgba(183,121,31,.10);border:1px solid rgba(183,121,31,.30);border-radius:6px;padding:2px 7px;margin-bottom:.45rem;display:inline-block">Modelo ilustrativo · parámetros sin calibrar</div>`;
          const trunc = sim.truncated ? ' · ⚠ interrumpido por límite de tiempo' : '';
          holder.className = 'alt-card__sim';
          holder.innerHTML = `
            ${badge}
            <div class="alt-sim__head">
              <span class="alt-sim__title">Robustez Monte Carlo</span>
              <span class="alt-sim__score" style="color:${color}">${score}<span>/100</span></span>
            </div>
            ${sciTxt ? `<div style="text-align:right;margin:-.2rem 0 .3rem">${sciTxt}</div>` : ''}
            <div class="alt-sim__bar"><div style="width:${Math.max(2, score)}%;background:${color}"></div></div>
            <div class="alt-sim__rows">
              <div><span>Prob. dentro de plazo</span><b>${Math.round((p.within_horizon_probability || 0) * 100)}%${whTxt}</b></div>
              <div><span>Piezas completas · P50 / P10</span><b>${pc.p50 ?? '–'} / ${pc.p10 ?? '–'}</b></div>
              <div><span>Duración turnos · P50 / P90</span><b>${mk.p50 ?? '–'} / ${mk.p90 ?? '–'}</b></div>
              <div><span>Exceso esperado</span><b>${p.expected_overflow ?? 0}</b></div>
              ${p.plan_adherence_pct != null ? `<div><span>Operaciones a su hora</span><b>${p.plan_adherence_pct}%</b></div>` : ''}
            </div>
            <div class="alt-sim__foot">${sim.iterations} iteraciones Monte Carlo${trunc}</div>
          `;
          // The recommendation comes from the simulation (engine ≥ 2.0), never
          // from a fixed label: «Equilibrado» used to be marked RECOMENDADO
          // even when it scored below «Óptimo».
          card.querySelector('.alt-card__rec')?.remove();
          if (sim.recommended && label === sim.recommended) {
            const rec = document.createElement('div');
            rec.className = 'alt-card__rec';
            rec.style.cssText = 'font-size:.66rem;font-weight:700;color:#16A34A;background:rgba(22,163,74,.10);border:1px solid rgba(22,163,74,.30);border-radius:6px;padding:3px 8px;margin:.35rem 0;';
            rec.textContent = `Recomendado por la simulación · ${sim.recommendation_reason || ''}`;
            card.querySelector('.alt-card__header')?.after(rec);
          }
        });
        stampAstroScope(altCards);
      }

      // Render the composites planner Gantt
      function renderPlannerGantt(alt: any) {
        plannerSelectedAlt = alt;   // what «Exportar» writes to the «Planificador» sheet
        const RESOURCES = ['ATL-01', 'ATL-02', 'AUTOCLAVE', 'NDT', 'CNC', 'WORKERS'];
        const RES_LABELS: Record<string, string> = {
          'ATL-01': 'Máquina ATL', 'ATL-02': 'Máquina ATL',
          'AUTOCLAVE': 'Curado',   'NDT': 'Ultrasonidos',
          'CNC': 'Recorte CNC',   'WORKERS': 'Operarios',
        };
        const weekDays: string[] = alt.week_days;
        const events: any[] = alt.events;

        // Build day header (uses same 21-col grid; each day cell spans 3)
        const dayHeader = document.getElementById('pg-day-header') as HTMLElement;
        dayHeader.innerHTML = `<div class="pg-corner" style="grid-column:1"><span>Recurso</span></div>`;
        weekDays.forEach((d: string, i: number) => {
          const col = 2 + i * 3;
          dayHeader.innerHTML += `<div class="pg-day-cell" style="grid-column:${col}/span 3">${d}</div>`;
        });

        // Build shift header
        const shiftHeader = document.getElementById('pg-shift-header') as HTMLElement;
        shiftHeader.innerHTML = `<div class="pg-corner" style="border-bottom:none"></div>`;
        for (let d = 0; d < 7; d++) {
          for (let s = 1; s <= 3; s++) {
            const isEod = s === 3 && d < 6;
            shiftHeader.innerHTML += `<div class="pg-shift-cell${isEod ? ' pg-shift-cell--eod' : ''}">T${s}</div>`;
          }
        }

        // Build resource rows
        const rowsContainer = document.getElementById('pg-rows') as HTMLElement;
        rowsContainer.innerHTML = '';
        RESOURCES.forEach((res: string) => {
          const resEvents = events.filter((e: any) => e.resource === res);
          const row = document.createElement('div');
          row.className = 'pg-resource-row';

          const label = document.createElement('div');
          label.className = 'pg-res-label';
          label.innerHTML = `<div><div class="pg-res-name">${escHtml(res)}</div><div class="pg-res-type">${escHtml(RES_LABELS[res] || '')}</div></div>`;
          row.appendChild(label);

          const timeline = document.createElement('div');
          timeline.className = 'pg-timeline';

          // Background cells (21)
          for (let i = 0; i < 21; i++) {
            const cell = document.createElement('div');
            const isEod = (i + 1) % 3 === 0 && i < 20;
            cell.className = 'pg-cell' + (isEod ? ' pg-cell--eod' : '');
            cell.style.cssText = `grid-column:${i+1};grid-row:1`;
            timeline.appendChild(cell);
          }

          // Events
          resEvents.forEach((ev: any) => {
            const col = ev.day * 3 + (ev.shift - 1) + 1;
            const span = ev.duration_shifts;
            if (col < 1 || col > 21) return;
            const el = document.createElement('div');
            el.className = 'pg-event';
            el.style.cssText = `grid-column:${col}/span ${Math.min(span, 22-col)};grid-row:1;background:${ev.color}22;border-left:3px solid ${ev.color};color:${ev.color}`;
            el.innerHTML = `<span class="pg-event-title">${escHtml(ev.title)}</span><span class="pg-event-sub">${escHtml(ev.subtitle)}</span>`;
            el.title = `${ev.title} · ${ev.subtitle}\nDía ${ev.day+1} · Turno ${ev.shift} · ${ev.duration_shifts} turno(s)`;
            timeline.appendChild(el);
          });

          if (resEvents.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'pg-empty';
            empty.style.cssText = 'grid-column:1/span 21;grid-row:1';
            empty.textContent = 'Sin actividad esta semana';
            timeline.appendChild(empty);
          }

          row.appendChild(timeline);
          rowsContainer.appendChild(row);
        });

        // Update subtitle
        if (ganttSubEl) ganttSubEl.textContent = `${alt.summary.label} · ${alt.week_label} · ${alt.summary.pieces_scheduled} piezas`;
        stampAstroScope(plannerView);   // grid rows/cells/events are JS-built — stamp so scoped CSS applies
        manualView.style.display = 'none';
        plannerView.style.display = '';
      }
    })();

    // 2. Drag & drop helpers (reusable for static + dynamic blocks)
    let draggedBlock = null;

    function initGanttBlock(block) {
      // Wrap text in .gb-text span if not already done
      if (!block.querySelector('.gb-text')) {
        const text = block.textContent.trim();
        block.textContent = '';
        const span = document.createElement('span');
        span.className = 'gb-text';
        span.textContent = text;
        block.appendChild(span);
      }

      // Add resize handle if not already present
      if (!block.querySelector('.gantt-resize')) {
        const handle = document.createElement('div');
        handle.className = 'gantt-resize';
        block.appendChild(handle);

        handle.addEventListener('mousedown', e => {
          e.preventDefault();
          e.stopPropagation();
          const startX   = e.clientX;
          const startW   = block.offsetWidth;
          const cellW    = block.parentElement ? block.parentElement.offsetWidth : 200;
          const startPct = parseFloat(block.style.width) || (startW / cellW * 100);

          function onMove(ev) {
            const dx = ev.clientX - startX;
            const newPct = Math.max(10, startPct + dx / cellW * 100);
            block.style.width = newPct + '%';
          }
          function onUp() {
            document.removeEventListener('mousemove', onMove);
            document.removeEventListener('mouseup', onUp);
          }
          document.addEventListener('mousemove', onMove);
          document.addEventListener('mouseup', onUp);
        });
      }

      block.setAttribute('draggable', 'true');
      block.addEventListener('dragstart', e => {
        if (e.target.classList.contains('gantt-resize')) { e.preventDefault(); return; }
        draggedBlock = block;
        e.dataTransfer.effectAllowed = 'move';
        setTimeout(() => block.classList.add('dragging'), 0);
      });
      block.addEventListener('dragend', () => {
        block.classList.remove('dragging');
        document.querySelectorAll('.gantt-cell').forEach(c => c.classList.remove('drop-target', 'drop-target--invalid'));
        draggedBlock = null;
      });
    }

    function initTurnoBlock(block) {
      block.setAttribute('draggable', 'true');
      block.addEventListener('dragstart', e => {
        draggedBlock = block;
        e.dataTransfer.effectAllowed = 'move';
        setTimeout(() => block.classList.add('dragging'), 0);
      });
      block.addEventListener('dragend', () => {
        block.classList.remove('dragging');
        document.querySelectorAll('.turno-track').forEach(t => t.classList.remove('drop-target'));
        draggedBlock = null;
      });
    }

    document.querySelectorAll('.gantt-block').forEach(b => initGanttBlock(b));

    document.querySelectorAll('.gantt-cell').forEach(cell => {
      cell.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; cell.classList.add('drop-target'); });
      cell.addEventListener('dragleave', e => { if (!cell.contains(e.relatedTarget)) cell.classList.remove('drop-target', 'drop-target--invalid'); });
      cell.addEventListener('drop', e => {
        e.preventDefault();
        cell.classList.remove('drop-target', 'drop-target--invalid');
        if (!draggedBlock) return;
        if (draggedBlock.parentElement === cell) return;
        cell.appendChild(draggedBlock);
        // Update recurso if moved to a different row
        const newRow = cell.closest('.gantt-row[data-resource]');
        if (newRow && draggedBlock.dataset.recurso !== newRow.dataset.resource) {
          draggedBlock.dataset.recurso = newRow.dataset.resource;
        }
        showToast('Orden replanificada manualmente · Plan actualizado');
      });
    });

    document.querySelectorAll('.turno-block').forEach(b => initTurnoBlock(b));

    document.querySelectorAll('.turno-track').forEach(track => {
      track.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; track.classList.add('drop-target'); });
      track.addEventListener('dragleave', e => { if (!track.contains(e.relatedTarget)) track.classList.remove('drop-target'); });
      track.addEventListener('drop', e => {
        e.preventDefault();
        track.classList.remove('drop-target');
        if (!draggedBlock || !draggedBlock.classList.contains('turno-block')) return;
        if (draggedBlock.parentElement === track) return;
        track.appendChild(draggedBlock);
        showToast('Orden reasignada · Turno actualizado');
      });
    });

    // 8. Nav panel switching
    document.querySelectorAll('[data-panel]').forEach(item => {
      item.addEventListener('click', e => {
        e.preventDefault();
        const panel = item.dataset.panel;
        document.querySelectorAll('.nav-item[data-panel]').forEach(n => n.classList.remove('nav-item--active'));
        item.classList.add('nav-item--active');
        document.querySelectorAll('.dash-panel').forEach(p => p.style.display = 'none');
        const target = document.getElementById('panel-' + panel);
        if (target) target.style.display = '';
        closeMobileSidebar();
      });
    });

    // 8a-bis. Weekly calendar — keep the "Planificación semanal" grid on the real current week
    (function refreshWeeklyCalendar() {
      const DOW    = ['LUN', 'MAR', 'MIÉ', 'JUE', 'VIE'];
      const MONTHS = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
      const now = new Date();
      const wd  = now.getDay();                 // 0=Sun … 6=Sat
      const monday = new Date(now);
      monday.setDate(now.getDate() + (wd === 0 ? -6 : 1 - wd));
      const days = Array.from({ length: 5 }, (_, i) => {
        const d = new Date(monday);
        d.setDate(monday.getDate() + i);
        return d;
      });
      const todayIdx = (wd >= 1 && wd <= 5) ? wd - 1 : -1;

      document.querySelectorAll('#gantt-semana .gantt-days .gantt-day').forEach((cell, i) => {
        if (!days[i]) return;
        const isToday = i === todayIdx;
        cell.classList.toggle('gantt-day--today', isToday);
        cell.textContent = `${DOW[i]} ${days[i].getDate()}${isToday ? ' ●' : ''}`;
      });

      const a = days[0], b = days[4];
      const range = a.getMonth() === b.getMonth()
        ? `${a.getDate()}–${b.getDate()} ${MONTHS[b.getMonth()]} ${b.getFullYear()}`
        : `${a.getDate()} ${MONTHS[a.getMonth()]} – ${b.getDate()} ${MONTHS[b.getMonth()]} ${b.getFullYear()}`;
      const sub = document.querySelector('#panel-gantt .page-header__sub');
      if (sub) sub.textContent = `${range} · Turno mañana + tarde`;
    })();

    // 8a. Alerts panel — filters, actions, dismiss
    function updateAlertCount() {
      const rows = document.querySelectorAll('#alertList .alert-row:not(.alert-row--resolved)');
      const total = rows.length;
      const alta  = document.querySelectorAll('#alertList .alert-row:not(.alert-row--resolved) [data-sev="alta"], #alertList .alert-row[data-sev="alta"]:not(.alert-row--resolved)').length;
      const subtitleEl = document.getElementById('alertSubtitle');
      const countEl    = document.getElementById('alertCount');
      if (subtitleEl) subtitleEl.textContent = `${total} alerta${total !== 1 ? 's' : ''} · ${document.querySelectorAll('#alertList .alert-row[data-sev="alta"]:not(.alert-row--resolved)').length} de prioridad alta`;
      if (countEl)    countEl.textContent    = `${total} alerta${total !== 1 ? 's' : ''} activas`;
      // Update sidebar badge
      const sidebarBadge = document.querySelector('.nav-item[data-panel="alertas"] .nav-badge');
      if (sidebarBadge) sidebarBadge.textContent = total;
    }

    function resolveAlertRow(row) {
      if (row.classList.contains('alert-row--resolved')) return;
      // Close detail if open
      const detail = row.nextElementSibling;
      if (detail && detail.classList.contains('alert-detail')) detail.classList.remove('open');
      // Replace action with resolved chip
      const action = row.querySelector('.alert-action');
      if (action) { action.outerHTML = '<span class="alert-resolved-chip">✓ Resuelta</span>'; }
      row.querySelector('.alert-dismiss') && (row.querySelector('.alert-dismiss').style.display = 'none');
      row.classList.add('alert-row--resolved');
      updateAlertCount();
    }

    // Filter chips
    document.querySelectorAll('.alert-filter-bar .chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.alert-filter-bar .chip').forEach(c => c.classList.remove('chip--active'));
        chip.classList.add('chip--active');
        const sev = chip.dataset.sev;
        document.querySelectorAll('#alertList .alert-row').forEach(row => {
          const detail = row.nextElementSibling;
          const show = sev === 'todas' || row.dataset.sev === sev;
          row.style.display = show ? '' : 'none';
          if (detail && detail.classList.contains('alert-detail')) detail.style.display = show ? '' : 'none';
        });
      });
    });

    // Action buttons
    document.querySelectorAll('#alertList .alert-action').forEach(btn => {
      btn.addEventListener('click', e => {
        const row    = btn.closest('.alert-row');
        const action = row.dataset.action;
        const detail = row.nextElementSibling;

        if (action === 'gantt') {
          document.querySelector('.nav-item[data-panel="gantt"]').click();
          showToast('Gantt abierto · Revisa la asignación de OF-2041');
        } else if (action === 'ordenes') {
          document.querySelector('.nav-item[data-panel="ordenes"]').click();
          showToast('Abriendo Órdenes de fabricación');
        } else if (action === 'capacidad') {
          document.querySelector('.nav-item[data-panel="capacidad"]').click();
          showToast('Abriendo panel de Capacidad');
        } else if (action === 'confirmar') {
          btn.textContent = 'Confirmando…';
          btn.style.opacity = '.6';
          setTimeout(() => resolveAlertRow(row), 900);
          showToast('✓ Mantenimiento CNC-1 confirmado · Notificación enviada a M. García');
        } else if (action === 'detalles') {
          if (detail && detail.classList.contains('alert-detail')) {
            detail.classList.toggle('open');
            btn.textContent = detail.classList.contains('open') ? 'Ocultar' : 'Ver detalles';
          }
        }
      });
    });

    // Detail expand on row click (except on buttons)
    document.querySelectorAll('#alertList .alert-row').forEach(row => {
      row.style.cursor = 'pointer';
      row.addEventListener('click', e => {
        if (e.target.closest('button, .alert-action')) return;
        const detail = row.nextElementSibling;
        if (detail && detail.classList.contains('alert-detail')) {
          detail.classList.toggle('open');
        }
      });
    });

    // Dismiss buttons
    document.querySelectorAll('#alertList .alert-dismiss').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        resolveAlertRow(btn.closest('.alert-row'));
      });
    });

    // Resolve all
    const resolveAllBtn = document.getElementById('resolveAllAlerts');
    resolveAllBtn && resolveAllBtn.addEventListener('click', () => {
      document.querySelectorAll('#alertList .alert-row:not(.alert-row--resolved)').forEach(row => resolveAlertRow(row));
      showToast('✓ Todas las alertas marcadas como resueltas');
    });

    // 8b. Scenarios panel — apply / switch
    document.querySelectorAll('#panel-escenarios .scenario-card button').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (btn.disabled) return;
        const card = btn.closest('.scenario-card');
        const badge = card.querySelector('.scenario-badge');
        const scenarioName = badge.childNodes[0].textContent.trim();

        const origText = btn.textContent.trim();
        btn.disabled = true;
        btn.innerHTML = `<svg class="spin-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Aplicando…`;

        await new Promise(r => setTimeout(r, 1400));

        // Reset all cards to inactive
        document.querySelectorAll('#panel-escenarios .scenario-card').forEach(c => {
          c.classList.remove('scenario-card--active');
          const b = c.querySelector('button');
          b.className = 'btn-ui';
          b.style.cssText = 'width:100%;justify-content:center';
          b.disabled = false;
          b.textContent = 'Aplicar escenario';
          const chip = c.querySelector('.scenario-active-chip');
          if (chip) chip.remove();
        });

        // Activate selected card
        card.classList.add('scenario-card--active');
        btn.className = 'btn-ui btn-ui--primary';
        btn.style.cssText = 'width:100%;justify-content:center';
        btn.disabled = true;
        btn.textContent = 'Escenario activo';
        if (!badge.querySelector('.scenario-active-chip')) {
          const chip = document.createElement('span');
          chip.className = 'scenario-active-chip';
          chip.textContent = 'Activo';
          badge.appendChild(chip);
        }

        showToast(`✓ ${scenarioName} activado · Gantt actualizado con nuevos parámetros`, 4500);
      });
    });

    // Card body click → visual preview (highlight without applying)
    document.querySelectorAll('#panel-escenarios .scenario-card').forEach(card => {
      card.style.cursor = 'pointer';
      card.addEventListener('click', e => {
        if (e.target.closest('button')) return;
        card.querySelector('button:not([disabled])').click();
      });
    });

    // 8c. Orders panel — filter chips + search
    const ordersSearch = document.getElementById('ordersSearch');

    function filterOrders() {
      const activeChip = document.querySelector('#ordersChips .chip--active');
      const estado = activeChip ? activeChip.dataset.estado : 'todas';
      const query  = ordersSearch ? ordersSearch.value.toLowerCase().trim() : '';
      let visible = 0;
      document.querySelectorAll('#ordersBody tr').forEach(row => {
        const matchEstado = estado === 'todas' || row.dataset.estado === estado;
        const matchSearch = !query || row.textContent.toLowerCase().includes(query);
        const show = matchEstado && matchSearch;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      // Empty state
      let emptyRow = document.getElementById('ordersEmptyRow');
      if (visible === 0) {
        if (!emptyRow) {
          emptyRow = document.createElement('tr');
          emptyRow.id = 'ordersEmptyRow';
          emptyRow.innerHTML = `<td colspan="8" style="text-align:center;padding:2rem;color:var(--n40);font-size:.85rem">Sin órdenes que coincidan</td>`;
          document.getElementById('ordersBody')?.appendChild(emptyRow);
        }
        emptyRow.style.display = '';
      } else if (emptyRow) {
        emptyRow.style.display = 'none';
      }
    }

    document.querySelectorAll('#ordersChips .chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('#ordersChips .chip').forEach(c => c.classList.remove('chip--active'));
        chip.classList.add('chip--active');
        filterOrders();
      });
    });

    ordersSearch && ordersSearch.addEventListener('input', filterOrders);

    // 8d. Historial de planificaciones — guardar + listar + eliminar
    const API_BASE = 'https://composite-replanning-api.vercel.app';
    const LS_KEY   = 'pc_historial';

    function getLocalHistory(): any[] {
      try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { return []; }
    }
    function saveLocalHistory(list: any[]) {
      localStorage.setItem(LS_KEY, JSON.stringify(list));
    }

    function captureSnapshot() {
      const escenario = document.querySelector('#panel-escenarios .scenario-card--active .scenario-badge')
        ?.childNodes[0]?.textContent?.trim() ?? '—';
      const ordenes: any[] = [];
      document.querySelectorAll('#ordersBody tr[data-estado]').forEach(tr => {
        const cells = tr.querySelectorAll('td');
        if (cells.length >= 6) {
          ordenes.push({
            id:      cells[0].textContent?.trim(),
            desc:    cells[1].textContent?.trim(),
            recurso: cells[2].textContent?.trim(),
            inicio:  cells[3].textContent?.trim(),
            fin:     cells[4].textContent?.trim(),
            estado:  (tr as HTMLElement).dataset.estado,
          });
        }
      });
      return { escenario, ordenes, timestamp: new Date().toISOString() };
    }

    async function savePlanToBackend(entry: any) {
      const token = localStorage.getItem('pc_token');
      if (!token) return null;
      try {
        const res = await fetch(`${API_BASE}/planificaciones`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ nombre: entry.nombre, descripcion: entry.descripcion, datos: entry.datos }),
        });
        if (!res.ok) return null;
        return await res.json();
      } catch { return null; }
    }

    async function fetchHistorialFromBackend(): Promise<any[]> {
      const token = localStorage.getItem('pc_token');
      if (!token) return [];
      try {
        const res = await fetch(`${API_BASE}/planificaciones`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) return [];
        return await res.json();
      } catch { return []; }
    }

    async function deleteFromBackend(id: number) {
      const token = localStorage.getItem('pc_token');
      if (!token) return;
      try {
        await fetch(`${API_BASE}/planificaciones/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` },
        });
      } catch {}
    }

    function renderHistorial(entries: any[]) {
      const tbody = document.getElementById('historialBody')!;
      const emptyRow = document.getElementById('historialEmpty');
      // remove all non-empty rows
      tbody.querySelectorAll('tr:not(#historialEmpty)').forEach(r => r.remove());

      const sub = document.getElementById('historialSub');
      if (entries.length === 0) {
        if (emptyRow) emptyRow.style.display = '';
        if (sub) sub.textContent = 'Sin registros guardados';
        return;
      }
      if (emptyRow) emptyRow.style.display = 'none';
      if (sub) sub.textContent = `${entries.length} registro${entries.length !== 1 ? 's' : ''} · ordenados por fecha desc.`;

      entries.forEach(e => {
        const datos = e.datos || {};
        const fecha = new Date(e.creado_en).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' });
        const tr = document.createElement('tr');
        tr.dataset.entryId = String(e.id ?? e.localId ?? '');
        tr.dataset.localId = String(e.localId ?? '');
        tr.innerHTML = `
          <td style="font-weight:600;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(e.nombre)}">${escHtml(e.nombre)}</td>
          <td style="color:var(--n40);font-size:.8rem;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(e.descripcion || '—')}</td>
          <td><span class="chip" style="font-size:.72rem;padding:.2rem .55rem">${escHtml(datos.escenario || '—')}</span></td>
          <td style="font-size:.82rem">${(datos.ordenes || []).length} órdenes</td>
          <td style="font-size:.78rem;color:var(--n40)">${escHtml(e.usuario_email || localStorage.getItem('pc_email') || '—')}</td>
          <td style="font-size:.78rem;white-space:nowrap">${fecha}</td>
          <td style="display:flex;gap:.35rem;padding:.5rem .75rem">
            <button class="btn-ui btn-ui--primary" style="font-size:.72rem;padding:.3rem .6rem" data-action="load">Cargar</button>
            <button class="btn-ui" style="font-size:.72rem;padding:.3rem .6rem" data-action="export">JSON</button>
            <button class="btn-ui" style="font-size:.72rem;padding:.3rem .6rem;color:var(--red);border-color:var(--red-bg)" data-action="delete">×</button>
          </td>`;

        tr.querySelector('[data-action="load"]')?.addEventListener('click', () => {
          restoreSnapshot(e);
        });

        tr.querySelector('[data-action="export"]')?.addEventListener('click', () => {
          const blob = new Blob([JSON.stringify(e, null, 2)], { type: 'application/json' });
          const url  = URL.createObjectURL(blob);
          const a    = Object.assign(document.createElement('a'), { href: url, download: `planificacion-${e.nombre.replace(/\s+/g,'-')}.json` });
          a.click();
          URL.revokeObjectURL(url);
        });

        tr.querySelector('[data-action="delete"]')?.addEventListener('click', async () => {
          if (!confirm(`¿Eliminar "${e.nombre}"?`)) return;
          // remove from localStorage
          const local = getLocalHistory().filter((x: any) => x.localId !== e.localId);
          saveLocalHistory(local);
          // remove from backend if has server id
          if (e.id) await deleteFromBackend(e.id);
          tr.remove();
          const remaining = tbody.querySelectorAll('tr:not(#historialEmpty)').length;
          if (remaining === 0 && emptyRow) emptyRow.style.display = '';
          if (sub) sub.textContent = remaining === 0 ? 'Sin registros guardados' : `${remaining} registro${remaining !== 1 ? 's' : ''}`;
        });

        copyAstroScope(tr);
        tbody.appendChild(tr);
      });
    }

    // Snapshot of "live" order rows so we can restore them when dismissing history mode
    let _liveOrdersSnapshot: string | null = null;

    function restoreSnapshot(entry: any) {
      const datos = entry.datos || {};
      const ordenes: any[] = datos.ordenes || [];

      // 1. Save live state if not already in history mode
      const histBanner = document.getElementById('histBanner');
      if (histBanner && histBanner.style.display === 'none') {
        _liveOrdersSnapshot = document.getElementById('ordersBody')?.innerHTML ?? null;
      }

      // 2. Update orders table rows
      const tbody = document.getElementById('ordersBody');
      if (tbody && ordenes.length > 0) {
        const rows = tbody.querySelectorAll('tr[data-estado]');
        rows.forEach(row => {
          const idCell = row.querySelector('td:first-child');
          if (!idCell) return;
          const ofId = idCell.textContent?.trim();
          const saved = ordenes.find((o: any) => o.id === ofId);
          if (!saved) return;

          // Update cells
          const cells = row.querySelectorAll('td');
          if (cells[2]) cells[2].textContent = saved.recurso || cells[2].textContent;
          if (cells[3]) cells[3].textContent = saved.inicio  || cells[3].textContent;
          if (cells[4]) cells[4].textContent = saved.fin     || cells[4].textContent;

          // Update estado
          const estado = saved.estado || 'ok';
          (row as HTMLElement).dataset.estado = estado;

          const pill = row.querySelector('.status-pill');
          if (pill) {
            pill.className = 'status-pill ' + (estado === 'riesgo' ? 'sp--risk' : 'sp--ok');
            pill.textContent = estado === 'riesgo' ? 'Riesgo' : estado === 'completada' ? 'Completada' : 'En plazo';
          }
        });
      }

      // 3. Activate matching scenario
      if (datos.escenario) {
        document.querySelectorAll('#panel-escenarios .scenario-card').forEach(card => {
          const badge = card.querySelector('.scenario-badge');
          const name  = badge?.childNodes[0]?.textContent?.trim();
          const btn   = card.querySelector('button');
          if (!btn) return;
          if (name === datos.escenario) {
            card.classList.add('scenario-card--active');
            btn.className = 'btn-ui btn-ui--primary';
            (btn as HTMLButtonElement).disabled = true;
            btn.style.cssText = 'width:100%;justify-content:center';
            const existing = badge?.querySelector('.scenario-active-chip');
            if (!existing) {
              const chip = document.createElement('span');
              chip.className = 'scenario-active-chip';
              chip.textContent = 'Activo';
              badge?.appendChild(chip);
            }
          } else {
            card.classList.remove('scenario-card--active');
            btn.className = 'btn-ui';
            (btn as HTMLButtonElement).disabled = false;
            btn.style.cssText = 'width:100%;justify-content:center';
            btn.textContent = 'Aplicar este escenario';
            badge?.querySelector('.scenario-active-chip')?.remove();
          }
        });
      }

      // 4. Show history mode banner
      const banner = document.getElementById('histBanner');
      const bannerNombre = document.getElementById('histBannerNombre');
      const bannerFecha  = document.getElementById('histBannerFecha');
      if (banner) {
        banner.style.display = 'flex';
        if (bannerNombre) bannerNombre.textContent = entry.nombre;
        if (bannerFecha)  bannerFecha.textContent  = new Date(entry.creado_en).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' });
      }

      // 5. Navigate to Gantt panel
      document.querySelectorAll('.nav-item[data-panel]').forEach(n => n.classList.remove('nav-item--active'));
      document.querySelector('.nav-item[data-panel="gantt"]')?.classList.add('nav-item--active');
      document.querySelectorAll('.dash-panel').forEach(p => (p as HTMLElement).style.display = 'none');
      const ganttPanel = document.getElementById('panel-gantt');
      if (ganttPanel) ganttPanel.style.display = '';

      showToast(`✓ Planificación "${entry.nombre}" cargada en modo historial`);
    }

    function dismissHistoryMode() {
      // Restore live orders
      const tbody = document.getElementById('ordersBody');
      if (tbody && _liveOrdersSnapshot) {
        tbody.innerHTML = _liveOrdersSnapshot;
        _liveOrdersSnapshot = null;
        // Re-attach chip/search filters
        filterOrders();
        enhanceOrderRows();
      }
      // Hide banner
      const banner = document.getElementById('histBanner');
      if (banner) banner.style.display = 'none';
      showToast('Plan actual restaurado');
    }

    document.getElementById('histBannerDismiss')?.addEventListener('click', dismissHistoryMode);

    async function loadHistorial() {
      const sub = document.getElementById('historialSub');
      if (sub) sub.textContent = 'Sincronizando…';
      const [remoteEntries, localEntries] = await Promise.all([fetchHistorialFromBackend(), Promise.resolve(getLocalHistory())]);

      // Merge: remote entries take precedence; local-only entries (no id) fill the rest
      const remoteIds = new Set(remoteEntries.map((e: any) => e.localId).filter(Boolean));
      const localOnly = localEntries.filter((e: any) => !e.id && !remoteIds.has(e.localId));
      const merged = [...remoteEntries, ...localOnly].sort((a: any, b: any) =>
        new Date(b.creado_en).getTime() - new Date(a.creado_en).getTime()
      );
      renderHistorial(merged);
    }

    // Save plan modal wiring
    const savePlanModal  = document.getElementById('savePlanModal');
    const savePlanBtn    = document.getElementById('savePlanBtn');
    const savePlanClose  = document.getElementById('savePlanClose');
    const savePlanCancel = document.getElementById('savePlanCancel');
    const savePlanSubmit = document.getElementById('savePlanSubmit');
    const savePlanNombre = document.getElementById('savePlanNombre') as HTMLInputElement | null;
    const savePlanDesc   = document.getElementById('savePlanDesc') as HTMLTextAreaElement | null;
    const savePlanStatus = document.getElementById('savePlanStatus');

    function openSavePlanModal() {
      if (!savePlanModal) return;
      if (savePlanNombre) savePlanNombre.value = '';
      if (savePlanDesc)   savePlanDesc.value   = '';
      if (savePlanStatus) savePlanStatus.textContent = '';
      savePlanModal.classList.add('open');
      savePlanNombre?.focus();
    }
    function closeSavePlanModal() { savePlanModal?.classList.remove('open'); }

    savePlanBtn    && savePlanBtn.addEventListener('click', openSavePlanModal);
    savePlanClose  && savePlanClose.addEventListener('click', closeSavePlanModal);
    savePlanCancel && savePlanCancel.addEventListener('click', closeSavePlanModal);
    savePlanModal  && savePlanModal.addEventListener('click', (e: MouseEvent) => {
      if (e.target === savePlanModal) closeSavePlanModal();
    });

    savePlanSubmit && savePlanSubmit.addEventListener('click', async () => {
      const nombre = savePlanNombre?.value.trim();
      if (!nombre) {
        if (savePlanStatus) savePlanStatus.textContent = 'El nombre es obligatorio.';
        savePlanNombre?.focus();
        return;
      }
      if (savePlanSubmit) { (savePlanSubmit as HTMLButtonElement).disabled = true; savePlanSubmit.textContent = 'Guardando…'; }
      if (savePlanStatus) savePlanStatus.textContent = '';

      const entry: any = {
        localId:     `local-${Date.now()}`,
        nombre,
        descripcion: savePlanDesc?.value.trim() || null,
        datos:       captureSnapshot(),
        usuario_email: localStorage.getItem('pc_email') || null,
        creado_en:   new Date().toISOString(),
      };

      // 1. Save to localStorage immediately
      const local = getLocalHistory();
      local.unshift(entry);
      saveLocalHistory(local);

      // 2. Attempt backend sync
      const remote = await savePlanToBackend(entry);
      if (remote) {
        entry.id = remote.id;
        // update localStorage with server id
        const updated = getLocalHistory().map((x: any) => x.localId === entry.localId ? { ...x, id: remote.id } : x);
        saveLocalHistory(updated);
        if (savePlanStatus) savePlanStatus.textContent = '✓ Guardado en servidor y local.';
      } else {
        if (savePlanStatus) savePlanStatus.textContent = '✓ Guardado localmente (sin sesión activa).';
      }

      if (savePlanSubmit) { (savePlanSubmit as HTMLButtonElement).disabled = false; savePlanSubmit.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Guardar'; }
      showToast(`✓ Plan "${nombre}" guardado`);

      setTimeout(closeSavePlanModal, 1200);
    });

    // Historial panel buttons
    document.getElementById('historialRefresh')?.addEventListener('click', loadHistorial);
    document.getElementById('historialExportAll')?.addEventListener('click', () => {
      const local = getLocalHistory();
      if (local.length === 0) { showToast('No hay registros para exportar'); return; }
      const blob = new Blob([JSON.stringify(local, null, 2)], { type: 'application/json' });
      const url  = URL.createObjectURL(blob);
      const a    = Object.assign(document.createElement('a'), { href: url, download: `historial-planificaciones-${new Date().toISOString().slice(0,10)}.json` });
      a.click();
      URL.revokeObjectURL(url);
      showToast('Historial exportado');
    });

    // Load historial when panel is opened
    document.querySelectorAll('.nav-item[data-panel]').forEach(item => {
      item.addEventListener('click', () => {
        const p = (item as HTMLElement).dataset.panel;
        if (p === 'historial') loadHistorial();
        if (p === 'mrp') initMrpPanel();
        if (p === 'recursos') renderResourceCards();
        if (p === 'disrupciones') loadDisrupciones();
        if (p === 'ordenes') loadCheckpointsForOrders();
        if (p === 'plantmap') initPlantMap();
        if (p === 'kpis') loadKpiOverview();
      });
    });

    // ── Disrupciones panel — backend-backed CRUD, feeds /api/plan/alternatives ──
    const DISRUPT_TYPE_LABEL: Record<string, string> = { averia: 'Avería', material: 'Material', urgente: 'Urgente', otro: 'Otro' };
    const DISRUPT_STATUS_LABEL: Record<string, string> = { activa: 'ACTIVA', resuelta: 'RESUELTA', cerrada: 'CERRADA', integrada: 'INTEGRADA' };
    const DISRUPT_STATUS_DOT: Record<string, string> = { activa: 'var(--red)', resuelta: 'var(--green)', cerrada: '#94A3B8', integrada: 'var(--brand)' };
    const DISRUPT_DAY_NAMES = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

    // Astro scopes <style> rules by stamping a data-astro-cid-* attribute on every
    // element in the static template and rewriting selectors to require it. Elements
    // created at runtime (createElement/innerHTML) never get that attribute, so scoped
    // rules silently fail to match them. Copy it from a known-static ancestor onto the
    // whole subtree so dynamically-built rows actually pick up .disrupt-* styling.
    function copyAstroScope(root: Element) {
      const cidAttr = Array.from(document.body.attributes).find(a => a.name.startsWith('data-astro-cid'));
      if (!cidAttr) return;
      root.setAttribute(cidAttr.name, cidAttr.value);
      root.querySelectorAll('*').forEach(el => el.setAttribute(cidAttr.name, cidAttr.value));
    }

    async function fetchDisruptions(): Promise<any[]> {
      const token = localStorage.getItem('pc_token');
      if (!token) return [];
      try {
        const res = await fetch(`${API_BASE}/disruptions`, { headers: { Authorization: `Bearer ${token}` } });
        return res.ok ? await res.json() : [];
      } catch { return []; }
    }

    async function createDisruption(payload: any) {
      const token = localStorage.getItem('pc_token');
      if (!token) return null;
      try {
        const res = await fetch(`${API_BASE}/disruptions`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(payload),
        });
        return res.ok ? await res.json() : null;
      } catch { return null; }
    }

    async function patchDisruption(id: number, payload: any) {
      const token = localStorage.getItem('pc_token');
      if (!token) return null;
      try {
        const res = await fetch(`${API_BASE}/disruptions/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(payload),
        });
        return res.ok ? await res.json() : null;
      } catch { return null; }
    }

    async function deleteDisruptionRemote(id: number) {
      const token = localStorage.getItem('pc_token');
      if (!token) return;
      try {
        await fetch(`${API_BASE}/disruptions/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
      } catch {}
    }

    // ── Order checkpoints — backend-backed CRUD, hung off each Órdenes row ──
    async function fetchCheckpoints(): Promise<any[]> {
      const token = localStorage.getItem('pc_token');
      if (!token) return [];
      try {
        const res = await fetch(`${API_BASE}/checkpoints`, { headers: { Authorization: `Bearer ${token}` } });
        return res.ok ? await res.json() : [];
      } catch { return []; }
    }

    async function createCheckpoint(orderCode: string, title: string) {
      const token = localStorage.getItem('pc_token');
      if (!token) return null;
      try {
        const res = await fetch(`${API_BASE}/checkpoints`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ order_code: orderCode, title }),
        });
        return res.ok ? await res.json() : null;
      } catch { return null; }
    }

    async function patchCheckpoint(id: number, payload: any) {
      const token = localStorage.getItem('pc_token');
      if (!token) return null;
      try {
        const res = await fetch(`${API_BASE}/checkpoints/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(payload),
        });
        return res.ok ? await res.json() : null;
      } catch { return null; }
    }

    async function deleteCheckpointRemote(id: number) {
      const token = localStorage.getItem('pc_token');
      if (!token) return;
      try {
        await fetch(`${API_BASE}/checkpoints/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
      } catch {}
    }

    let allCheckpoints: any[] = [];
    let activeCheckpointOrder: string | null = null;

    async function loadCheckpointsForOrders() {
      allCheckpoints = await fetchCheckpoints();
      enhanceOrderRows();
    }

    // Adds/refreshes a trailing "Checkpoints" cell + button on every order row,
    // reading the order code from the row's first cell. Safe to call repeatedly —
    // it's the only way listeners survive the innerHTML swaps that history-mode
    // restore and MRP-apply do to #ordersBody.
    function enhanceOrderRows() {
      document.querySelectorAll('#ordersBody tr[data-estado]').forEach(row => {
        const code = row.querySelector('td:first-child')?.textContent?.trim();
        if (!code) return;
        let cell = row.querySelector('.order-checkpoints-cell') as HTMLElement | null;
        if (!cell) {
          cell = document.createElement('td');
          cell.className = 'order-checkpoints-cell';
          row.appendChild(cell);
        }
        const items = allCheckpoints.filter(c => c.order_code === code);
        const done = items.filter(c => c.done).length;
        const btn = document.createElement('button');
        btn.className = 'checkpoints-btn' + (items.length > 0 && done === items.length ? ' checkpoints-btn--done' : '');
        btn.textContent = items.length ? `✓ ${done}/${items.length}` : '+ Checkpoints';
        btn.addEventListener('click', () => {
          const desc = row.querySelector('td:nth-child(2)')?.textContent?.trim() || code;
          openCheckpointsModal(code, desc);
        });
        cell.innerHTML = '';
        cell.appendChild(btn);
        copyAstroScope(cell);
      });
    }

    function renderCheckpointList(orderCode: string) {
      const list = document.getElementById('checkpointList');
      const empty = document.getElementById('checkpointEmpty');
      if (!list) return;
      list.innerHTML = '';
      const items = allCheckpoints.filter(c => c.order_code === orderCode);
      if (empty) empty.style.display = items.length ? 'none' : '';

      items.forEach(c => {
        const item = document.createElement('div');
        item.className = 'checkpoint-item';
        item.innerHTML = `
          <input type="checkbox" class="checkpoint-item__check" ${c.done ? 'checked' : ''} />
          <span class="checkpoint-item__title ${c.done ? 'checkpoint-item__title--done' : ''}"></span>
          <button class="checkpoint-item__del" title="Eliminar">×</button>
        `;
        (item.querySelector('.checkpoint-item__title') as HTMLElement).textContent = c.title;

        item.querySelector('.checkpoint-item__check')?.addEventListener('change', async (e) => {
          const checked = (e.target as HTMLInputElement).checked;
          const updated = await patchCheckpoint(c.id, { done: checked });
          if (updated) {
            allCheckpoints = allCheckpoints.map(x => x.id === c.id ? updated : x);
            renderCheckpointList(orderCode);
            enhanceOrderRows();
          } else {
            (e.target as HTMLInputElement).checked = !checked;
            showToast('⚠ No se pudo actualizar');
          }
        });

        item.querySelector('.checkpoint-item__del')?.addEventListener('click', async () => {
          await deleteCheckpointRemote(c.id);
          allCheckpoints = allCheckpoints.filter(x => x.id !== c.id);
          renderCheckpointList(orderCode);
          enhanceOrderRows();
        });

        copyAstroScope(item);
        list.appendChild(item);
      });
    }

    function openCheckpointsModal(orderCode: string, orderLabel: string) {
      activeCheckpointOrder = orderCode;
      const title = document.getElementById('checkpointsModalTitle');
      if (title) title.textContent = `Checkpoints — ${orderCode} · ${orderLabel}`;
      const input = document.getElementById('checkpointNewInput') as HTMLInputElement | null;
      if (input) input.value = '';
      const status = document.getElementById('checkpointModalStatus');
      if (status) status.textContent = '';
      renderCheckpointList(orderCode);
      document.getElementById('checkpointsModal')?.classList.add('open');
      input?.focus();
    }

    function closeCheckpointsModal() {
      document.getElementById('checkpointsModal')?.classList.remove('open');
      activeCheckpointOrder = null;
    }

    document.getElementById('checkpointsModalClose')?.addEventListener('click', closeCheckpointsModal);
    document.getElementById('checkpointCloseBtn')?.addEventListener('click', closeCheckpointsModal);
    document.getElementById('checkpointsModal')?.addEventListener('click', (e: MouseEvent) => {
      if (e.target === document.getElementById('checkpointsModal')) closeCheckpointsModal();
    });

    async function submitNewCheckpoint() {
      const input = document.getElementById('checkpointNewInput') as HTMLInputElement | null;
      const status = document.getElementById('checkpointModalStatus');
      const title = input?.value.trim();
      if (!activeCheckpointOrder || !title) return;
      const created = await createCheckpoint(activeCheckpointOrder, title);
      if (created) {
        allCheckpoints.push(created);
        if (input) input.value = '';
        if (status) status.textContent = '';
        renderCheckpointList(activeCheckpointOrder);
        enhanceOrderRows();
        input?.focus();
      } else if (status) {
        status.textContent = 'No se pudo guardar. ¿Sesión iniciada?';
      }
    }

    document.getElementById('checkpointAddBtn')?.addEventListener('click', submitNewCheckpoint);
    document.getElementById('checkpointNewInput')?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') { e.preventDefault(); submitNewCheckpoint(); }
    });

    function disruptRelativeTime(iso: string): string {
      if (!iso) return '—';
      const d = new Date(iso);
      const now = new Date();
      const yest = new Date(now);
      yest.setDate(now.getDate() - 1);
      if (d.toDateString() === now.toDateString()) return `Hoy ${d.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}`;
      if (d.toDateString() === yest.toDateString()) return 'Ayer';
      return d.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
    }

    function renderDisruptions(rows: any[]) {
      const list = document.getElementById('disruptList');
      const empty = document.getElementById('disruptEmpty');
      if (!list) return;
      list.querySelectorAll('.disrupt-row:not(#disruptEmpty)').forEach(r => r.remove());

      const sub = document.getElementById('disruptSub');
      const activeCount = rows.filter(r => r.status === 'activa').length;
      if (sub) {
        sub.textContent = rows.length === 0
          ? 'Sin disrupciones registradas'
          : `${rows.length} evento${rows.length !== 1 ? 's' : ''} · ${activeCount} activa${activeCount !== 1 ? 's' : ''}`;
      }

      if (rows.length === 0) {
        if (empty) empty.style.display = '';
        return;
      }
      if (empty) empty.style.display = 'none';

      rows.forEach(d => {
        const row = document.createElement('div');
        row.className = 'disrupt-row';
        row.dataset.id = String(d.id);
        const impact = [
          d.resource ? `Recurso: ${d.resource}` : null,
          (d.day != null && d.shift != null) ? `${DISRUPT_DAY_NAMES[d.day] ?? ''} T${d.shift}` : null,
        ].filter(Boolean).join(' · ');
        row.innerHTML = `
          <div class="disrupt-time">${disruptRelativeTime(d.created_at)}</div>
          <div class="disrupt-dot" style="background:${DISRUPT_STATUS_DOT[d.status] || '#94A3B8'}"></div>
          <div class="disrupt-body">
            <div class="disrupt-title"></div>
            <div class="disrupt-detail"></div>
          </div>
          <div class="disrupt-actions"></div>
          <span class="disrupt-status disrupt-status--${d.status}">${DISRUPT_STATUS_LABEL[d.status] || String(d.status).toUpperCase()}</span>
        `;
        // textContent (not innerHTML) for user-supplied title/detail to avoid XSS
        (row.querySelector('.disrupt-title') as HTMLElement).textContent = d.title || '';
        (row.querySelector('.disrupt-detail') as HTMLElement).textContent =
          [DISRUPT_TYPE_LABEL[d.type] || d.type, impact, d.detail].filter(Boolean).join(' · ');

        const actions = row.querySelector('.disrupt-actions') as HTMLElement;
        if (d.status === 'activa') {
          const resolveBtn = document.createElement('button');
          resolveBtn.className = 'btn-ui';
          resolveBtn.style.cssText = 'font-size:.7rem;padding:.28rem .55rem';
          resolveBtn.textContent = 'Resolver';
          resolveBtn.addEventListener('click', async () => {
            resolveBtn.disabled = true;
            const updated = await patchDisruption(d.id, { status: 'resuelta' });
            if (updated) { showToast(`✓ "${d.title}" marcada como resuelta`); loadDisrupciones(); }
            else { resolveBtn.disabled = false; showToast('⚠ No se pudo actualizar'); }
          });
          actions.appendChild(resolveBtn);
        }
        const delBtn = document.createElement('button');
        delBtn.className = 'btn-ui';
        delBtn.style.cssText = 'font-size:.7rem;padding:.28rem .5rem;color:var(--red);border-color:var(--red-bg)';
        delBtn.textContent = '×';
        delBtn.title = 'Eliminar';
        delBtn.addEventListener('click', async () => {
          if (!confirm(`¿Eliminar "${d.title}"?`)) return;
          await deleteDisruptionRemote(d.id);
          loadDisrupciones();
        });
        actions.appendChild(delBtn);

        copyAstroScope(row);
        list.appendChild(row);
      });
    }

    async function loadDisrupciones() {
      const sub = document.getElementById('disruptSub');
      if (sub) sub.textContent = 'Cargando…';
      renderDisruptions(await fetchDisruptions());
    }

    document.getElementById('disruptRefresh')?.addEventListener('click', loadDisrupciones);

    // New-disruption modal wiring
    const disruptModal        = document.getElementById('disruptModal');
    const disruptNewBtn       = document.getElementById('disruptNewBtn');
    const disruptModalClose   = document.getElementById('disruptModalClose');
    const disruptCancel       = document.getElementById('disruptCancel');
    const disruptSubmit       = document.getElementById('disruptSubmit');
    const disruptTitleInput   = document.getElementById('disruptTitle') as HTMLInputElement | null;
    const disruptDetailInput  = document.getElementById('disruptDetail') as HTMLTextAreaElement | null;
    const disruptTypeInput    = document.getElementById('disruptType') as HTMLSelectElement | null;
    const disruptResourceInput = document.getElementById('disruptResource') as HTMLSelectElement | null;
    const disruptDayInput     = document.getElementById('disruptDay') as HTMLSelectElement | null;
    const disruptShiftInput   = document.getElementById('disruptShift') as HTMLSelectElement | null;
    const disruptDurationInput = document.getElementById('disruptDuration') as HTMLInputElement | null;
    const disruptModalStatus  = document.getElementById('disruptModalStatus');

    function openDisruptModal() {
      if (!disruptModal) return;
      if (disruptTitleInput) disruptTitleInput.value = '';
      if (disruptDetailInput) disruptDetailInput.value = '';
      if (disruptTypeInput) disruptTypeInput.value = 'averia';
      if (disruptResourceInput) disruptResourceInput.value = '';
      if (disruptDurationInput) disruptDurationInput.value = '1';
      if (disruptModalStatus) disruptModalStatus.textContent = '';
      disruptModal.classList.add('open');
      disruptTitleInput?.focus();
    }
    function closeDisruptModal() { disruptModal?.classList.remove('open'); }

    disruptNewBtn?.addEventListener('click', openDisruptModal);
    disruptModalClose?.addEventListener('click', closeDisruptModal);
    disruptCancel?.addEventListener('click', closeDisruptModal);
    disruptModal?.addEventListener('click', (e: MouseEvent) => {
      if (e.target === disruptModal) closeDisruptModal();
    });

    disruptSubmit?.addEventListener('click', async () => {
      const title = disruptTitleInput?.value.trim();
      if (!title) {
        if (disruptModalStatus) disruptModalStatus.textContent = 'El título es obligatorio.';
        disruptTitleInput?.focus();
        return;
      }
      (disruptSubmit as HTMLButtonElement).disabled = true;
      disruptSubmit.textContent = 'Creando…';
      if (disruptModalStatus) disruptModalStatus.textContent = '';

      const resource = disruptResourceInput?.value || null;
      const created = await createDisruption({
        type: disruptTypeInput?.value || 'otro',
        title,
        detail: disruptDetailInput?.value.trim() || null,
        resource,
        day: resource ? Number(disruptDayInput?.value ?? 0) : null,
        shift: resource ? Number(disruptShiftInput?.value ?? 1) : null,
        duration_shifts: resource ? Number(disruptDurationInput?.value ?? 1) : null,
        // day/shift count from the week on the planner; without it the server
        // assumes the current week.
        week_start: resource ? ((document.getElementById('plannerWeekStart') as HTMLInputElement | null)?.value || null) : null,
      });

      (disruptSubmit as HTMLButtonElement).disabled = false;
      disruptSubmit.textContent = 'Crear';

      if (created) {
        showToast(`✓ Disrupción "${title}" registrada`);
        closeDisruptModal();
        loadDisrupciones();
      } else if (disruptModalStatus) {
        disruptModalStatus.textContent = 'No se pudo guardar. ¿Sesión iniciada?';
      }
    });

    // ── 8e. MRP & Tiempos panel ─────────────────────────────────────
    const MRP_LS  = 'pc_mrp_rows';
    const TIME_LS = 'pc_process_times';

    const DEFAULT_TIMES = [
      { id: 'cnc-1',    label: 'CNC-1',    color: '#3B82F6', setup: 30, ciclo: 45, buffer: 10, turnos: 2, operarios: 2 },
      { id: 'cnc-2',    label: 'CNC-2',    color: '#8B5CF6', setup: 25, ciclo: 40, buffer: 10, turnos: 2, operarios: 2 },
      { id: 'soldadura',label: 'Soldadura',color: '#10B981', setup: 20, ciclo: 60, buffer: 15, turnos: 1, operarios: 3 },
      { id: 'acabados', label: 'Acabados', color: '#6B7280', setup: 15, ciclo: 30, buffer: 20, turnos: 2, operarios: 1 },
      { id: 'embalaje', label: 'Embalaje', color: '#F59E0B', setup: 10, ciclo: 15, buffer:  5, turnos: 1, operarios: 2 },
    ];

    function getProcessTimes() {
      try {
        const saved = JSON.parse(localStorage.getItem(TIME_LS) || '[]');
        if (saved.length > 0) return saved;
      } catch {}
      return DEFAULT_TIMES.map(d => ({ ...d }));
    }

    function getMrpRows(): any[] {
      try { return JSON.parse(localStorage.getItem(MRP_LS) || '[]'); } catch { return []; }
    }

    // ── Data guidance: one dictionary (served by /api/mrp/dictionary) drives
    // the field help, the requirements panel, the template and the validator.
    let mrpDict: any = null;
    async function loadMrpDict(): Promise<any> {
      if (mrpDict) return mrpDict;
      try { mrpDict = await apiJson('/api/mrp/dictionary'); } catch { mrpDict = null; }
      return mrpDict;
    }
    const FH_STATUS: Record<string, [string, string]> = {
      required: ['Obligatorio', 'fh-tag fh-tag--req'], optional: ['Opcional', 'fh-tag fh-tag--opt'],
      derived: ['Calculado por Planning Core', 'fh-tag fh-tag--der'],
    };
    function findField(ref: string): any {
      if (!mrpDict) return null;
      const tiempos = ref.startsWith('t:');
      const key = tiempos ? ref.slice(2) : ref;
      const pool = tiempos ? [...mrpDict.tiempos, ...mrpDict.tiempos_derived] : [...mrpDict.mrp, ...mrpDict.mrp_derived];
      return pool.find((f: any) => f.key === key) || null;
    }
    let fhOpen: HTMLElement | null = null;
    function closeFieldHelp() { fhOpen?.remove(); fhOpen = null; }
    function fieldHelpCard(f: any): HTMLElement {
      const [st, cls] = FH_STATUS[f.status] || FH_STATUS.optional;
      const derived = f.status === 'derived';
      const sec = (title: string, body: any) => body ? [el('h5', { text: title }), typeof body === 'string' ? el('p', { text: body }) : body] : null;
      return el('div', {},
        el('div', { class: 'fh-pop__head' },
          el('div', {}, el('h4', { text: f.label }), el('span', { class: cls, text: st })),
          el('button', { class: 'fh-pop__close', type: 'button', 'aria-label': 'Cerrar ayuda', text: '×', onclick: closeFieldHelp })),
        sec('¿Qué es?', f.what),
        sec('¿Por qué lo necesita Planning Core?', f.why),
        derived ? sec('Cómo se calcula', f.formula) : sec('¿Qué debo introducir?', f.enter),
        sec('Formato y unidad', derived ? f.unit : [f.format, f.unit ? `Unidad: ${f.unit}.` : ''].join(' ').trim()),
        sec('Ejemplo', derived ? f.example : `${f.example}${f.example_meaning ? ' — ' + f.example_meaning : ''}`),
        derived ? null : sec('Si lo dejas vacío', f.if_empty),
        (f.where || []).length ? sec('¿Dónde suele encontrarse?', el('ul', {}, f.where.map((w: string) => el('li', { text: w })))) : null,
        derived ? sec('¿Tengo que incluirlo?', 'No: Planning Core lo calcula a partir de los otros datos.')
                : sec('¿Lo puede calcular Planning Core?', 'No: es un dato de tu planta que tiene que venir en el archivo.'),
        el('div', { class: 'fh-note', text: 'Los ejemplos son ilustrativos: usa los datos reales de tu planta. Las fuentes indicadas son habituales en fabricación; comprueba cuál aplica en tu empresa.' }));
    }
    function openFieldHelp(ref: string, anchor: HTMLElement) {
      closeFieldHelp();
      const f = findField(ref);
      if (!f) { showToast('La ayuda de este campo no está disponible ahora mismo.'); return; }
      const pop = el('div', { class: 'fh-pop', role: 'dialog', 'aria-label': `Ayuda: ${f.label}` }, fieldHelpCard(f));
      document.body.appendChild(pop);
      const r = anchor.getBoundingClientRect();
      const maxLeft = window.scrollX + document.documentElement.clientWidth - pop.offsetWidth - 16;
      pop.style.left = `${Math.max(16, Math.min(window.scrollX + r.left, maxLeft))}px`;
      pop.style.top = `${window.scrollY + r.bottom + 6}px`;
      fhOpen = pop;
      (pop.querySelector('.fh-pop__close') as HTMLElement | null)?.focus();
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeFieldHelp(); });
    document.addEventListener('click', e => {
      const tgt = e.target as HTMLElement;
      if (fhOpen && !fhOpen.contains(tgt) && !tgt.closest('.fh-btn, .mrpg__field')) closeFieldHelp();
    });
    function helpButton(ref: string, label: string): HTMLElement {
      return el('button', { class: 'fh-btn', type: 'button', text: 'i', 'aria-label': `Qué significa «${label}»`,
        title: `Qué significa «${label}»`,
        onclick: (e: Event) => { e.stopPropagation(); openFieldHelp(ref, e.currentTarget as HTMLElement); } });
    }
    function decorateHelpHeaders() {
      document.querySelectorAll('th[data-help]').forEach(th => {
        if (th.querySelector('.fh-btn')) return;
        th.appendChild(helpButton((th as HTMLElement).dataset.help!, (th.textContent || '').trim()));
      });
    }
    function renderRequirements() {
      const box = document.getElementById('mrpgReq');
      const how = document.getElementById('mrpgHow');
      const counts = document.getElementById('mrpgCounts');
      if (!box || !how) return;
      if (!mrpDict) {
        box.replaceChildren(el('p', { text: 'No se pudo cargar la guía de datos. Recarga la página para intentarlo de nuevo.' }));
        return;
      }
      const c = mrpDict.counts;
      if (counts) counts.textContent = `Obligatorios: ${c.required} · Opcionales: ${c.optional} · Calculados por Planning Core: ${c.derived}. Pulsa ⓘ en cualquier columna para ver qué poner.`;
      const item = (f: any, mark: string) => el('button', { class: 'mrpg__field', type: 'button',
        onclick: (e: Event) => { e.stopPropagation(); openFieldHelp(f.key, e.currentTarget as HTMLElement); } },
        el('span', { 'aria-hidden': 'true', text: mark }), f.label, f.unit ? el('span', { class: 'pcx-muted', text: ` (${f.unit})` }) : null);
      const req = mrpDict.mrp.filter((f: any) => f.status === 'required');
      const opt = mrpDict.mrp.filter((f: any) => f.status === 'optional');
      const pill = (x: string, res = false) => el('span', { class: `mrpg__pill${res ? ' mrpg__pill--res' : ''}`, text: x });
      box.replaceChildren(
        el('div', { class: 'mrpg__cols' },
          el('div', {}, el('h5', { text: `Obligatorios (${req.length})` }),
            el('p', { text: 'Sin ellos Planning Core no puede calcular el plan de forma fiable.' }), req.map((f: any) => item(f, '✓'))),
          el('div', {}, el('h5', { text: `Opcionales (${opt.length})` }),
            el('p', { text: 'Mejoran el plan. Si faltan se usa un valor por defecto que verás en la revisión.' }), opt.map((f: any) => item(f, '○'))),
          el('div', {}, el('h5', { text: `Calculados (${mrpDict.mrp_derived.length})` }),
            el('p', { text: 'Planning Core los calcula: no hace falta incluirlos.' }), mrpDict.mrp_derived.map((f: any) => item(f, 'ƒ')))),
        el('h5', { style: 'margin:.9rem 0 .2rem', text: 'Cómo se convierten tus datos en el plan' }),
        el('div', { class: 'mrpg__deps' }, mrpDict.dependencies.map((d: any) => el('div', { class: 'mrpg__dep' },
          d.parts.map((x: string, i: number) => i % 2 ? el('span', { text: x }) : pill(x)), el('span', { text: '=' }), pill(d.result, true)))),
        el('h5', { style: 'margin:.9rem 0 .2rem', text: 'Ejemplo ilustrativo — sustitúyelo por los datos reales de tu planta' }),
        el('table', { class: 'mrpg__ex' },
          el('thead', {}, el('tr', {}, ['Columna', 'Ejemplo', 'Significado'].map(h => el('th', { text: h })))),
          el('tbody', {}, [...mrpDict.mrp.map((f: any) => el('tr', {}, el('td', { text: f.label }), el('td', { text: String(f.example) }), el('td', { text: f.example_meaning }))),
                           ...mrpDict.mrp_derived.map((f: any) => el('tr', {}, el('td', { text: `${f.label} (calculado)` }), el('td', { text: f.example }), el('td', { text: f.formula })))])));
      how.replaceChildren(el('ol', { class: 'mrpg__steps' }, (mrpDict.guide_steps || []).map((s: string, i: number) =>
        el('li', {}, i === 0 ? el('button', { class: 'mrpg__field', type: 'button', style: 'display:inline;padding:0;color:var(--brand);text-decoration:underline', text: s, onclick: downloadTemplate }) : s))));
    }

    function rowStatus(row: any): { label: string; cls: string } {
      if (!row.fecha) return { label: '—', cls: '' };
      const need = new Date(row.fecha);
      const now  = new Date();
      const days  = Math.round((need.getTime() - now.getTime()) / 86400000);
      if (days < 0)  return { label: 'Vencida',  cls: 'mrp-urgente' };
      if (days <= 3) return { label: `${days}d`,  cls: 'mrp-urgente' };
      if (days <= 7) return { label: `${days}d`,  cls: '' };
      return { label: `${days}d`, cls: 'mrp-ok' };
    }

    async function downloadTemplate() {
      // The MRP sheet keeps the exact header the importer reads and no example
      // rows; explanations and illustrative data are on separate sheets.
      let spec: any = null;
      try { spec = await apiJson('/api/mrp/template'); } catch { spec = null; }
      const sheets = spec?.sheets || [{ name: 'MRP', col_widths: [14, 26, 10, 10, 16, 12, 16],
        rows: [['OF', 'Descripcion', 'Cantidad', 'Unidad', 'Fecha_necesidad', 'Stock_actual', 'Lead_time_dias']] }];
      const wb = XLSX.utils.book_new();
      sheets.forEach((s: any) => {
        const ws = XLSX.utils.aoa_to_sheet(s.rows);
        ws['!cols'] = (s.col_widths || []).map((w: number) => ({ wch: w }));
        XLSX.utils.book_append_sheet(wb, ws, s.name);
      });
      XLSX.writeFile(wb, spec?.file_name || 'plantilla_mrp.xlsx');
    }

    // ── Render MRP table (values from the file go in as text, never markup) ──
    function renderMrpTable(rows: any[]) {
      const tbody   = document.getElementById('mrpBody')!;
      const toolbar = document.getElementById('mrpToolbar')!;
      const wrap    = document.getElementById('mrpTableWrap')!;
      const count   = document.getElementById('mrpCount');
      tbody.replaceChildren();

      if (rows.length === 0) {
        toolbar.style.display = 'none';
        wrap.style.display    = 'none';
        return;
      }

      toolbar.style.display = 'flex';
      wrap.style.display    = '';
      if (count) count.textContent = `${rows.length} líneas cargadas`;

      const num = { style: 'text-align:right;font-variant-numeric:tabular-nums' };
      rows.forEach(row => {
        const st  = rowStatus(row);
        const net = Math.max(0, (Number(row.cant) || 0) - (Number(row.stock) || 0));
        tbody.appendChild(el('tr', {},
          el('td', { style: 'font-weight:600', text: row.of }),
          el('td', { text: row.desc }),
          el('td', { ...num, text: row.cant }),
          el('td', { style: 'color:var(--n40)', text: row.unidad }),
          el('td', { style: 'white-space:nowrap', text: row.fecha || '—' }),
          el('td', { ...num, text: row.stock }),
          el('td', { ...num, text: `${row.lead}d` }),
          el('td', { ...num, style: 'text-align:right;font-weight:600', text: net }),
          el('td', {}, el('span', { class: st.cls, style: 'font-size:.78rem;font-weight:600', text: st.label }))));
      });
    }

    // ── Render time editor ────────────────────────────────────────
    const BASE_LOADS: Record<string, number> = { 'cnc-1': 78, 'cnc-2': 91, 'soldadura': 62, 'acabados': 55, 'embalaje': 30 };
    const SHIFT_MINUTES = 480;
    const PALETTE = ['#3B82F6','#8B5CF6','#10B981','#6B7280','#F59E0B','#EF4444','#06B6D4','#F97316','#84CC16','#EC4899'];

    function calcUdsJornada(t: any): number {
      const netMin = Math.max(0, (SHIFT_MINUTES - (t.setup||0)) * (1 - (t.buffer||0) / 100)) * (t.operarios||1) * (t.turnos||1);
      return Math.floor(netMin / (t.ciclo || 1));
    }

    function calcLoad(t: any): number {
      const baseUds  = calcUdsJornada(DEFAULT_TIMES.find((d: any) => d.id === t.id) || t);
      const newUds   = calcUdsJornada(t);
      const baseLoad = BASE_LOADS[t.id] ?? 75;
      return Math.min(Math.round(baseLoad * (baseUds / (newUds || 1))), 100);
    }

    // ── Recursos y máquinas: dynamic cards sourced from process-times data ──
    // (Tiempos de proceso is the single place to add/edit resources; this
    // panel is a read-only reflection of that same data.)
    function renderResourceCards() {
      const grid = document.getElementById('resourceCardsGrid');
      const sub  = document.getElementById('resourcesSub');
      if (!grid) return;
      const times = getProcessTimes();
      if (sub) sub.textContent = `${times.length} recurso${times.length !== 1 ? 's' : ''} · Estado en tiempo real`;
      grid.innerHTML = times.map((t: any) => {
        const load    = calcLoad(t);
        const uds     = calcUdsJornada(t);
        const pillCls = load >= 90 ? 'cap-pill--over' : load >= 75 ? 'cap-pill--warn' : 'cap-pill--ok';
        const pillTxt = load >= 90 ? 'Saturado' : load >= 75 ? 'Riesgo' : 'OK';
        const barColor = load >= 90 ? 'var(--red)' : load >= 75 ? 'var(--amber)' : 'var(--green)';
        return `
          <div class="res-card">
            <div class="res-card__header">
              <div class="res-card__icon" style="background:${t.color}1A">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${t.color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              </div>
              <div>
                <div class="res-card__name">${t.label}</div>
                <div class="res-card__type">${t.turnos} turno${t.turnos !== 1 ? 's' : ''} · ${t.operarios} operario${t.operarios !== 1 ? 's' : ''}</div>
              </div>
            </div>
            <div class="res-card__order">Setup ${t.setup} min · Ciclo ${t.ciclo} min · Buffer ${t.buffer}%</div>
            <div class="res-card__util-label">Utilización estimada</div>
            <div class="res-card__bar-wrap"><div class="res-card__bar" style="width:${load}%;background:${barColor}"></div></div>
            <div class="res-card__footer">
              <span class="cap-pill ${pillCls}">${load}% · ${pillTxt}</span>
              <span class="res-card__maint">${uds} ud/turno</span>
            </div>
          </div>`;
      }).join('');
    }

    function addTimeRow(tbody: HTMLElement, times: any[], t: any, idx: number) {
      const adjLoad = calcLoad(t);
      const fillCls = adjLoad >= 90 ? 'time-impact-fill--danger' : adjLoad >= 75 ? 'time-impact-fill--warn' : '';
      const uds     = calcUdsJornada(t);
      const tr      = document.createElement('tr');
      tr.dataset.id = t.id;

      tr.innerHTML = `
        <td style="padding:.4rem .6rem">
          <div style="display:flex;align-items:center;gap:.4rem">
            <span class="time-dot" style="background:${escHtml(t.color)};cursor:pointer" title="Cambiar color" data-colorpick="${idx}"></span>
            <input class="time-name-input" data-field="label" data-idx="${idx}" value="${escHtml(t.label)}" placeholder="Nombre proceso" />
          </div>
        </td>
        <td><input class="time-input" data-field="setup"     data-idx="${idx}" type="number" min="0"  max="480" step="5" value="${t.setup}"  /></td>
        <td><input class="time-input" data-field="ciclo"     data-idx="${idx}" type="number" min="1"  max="999" step="1" value="${t.ciclo}"  /></td>
        <td><input class="time-input" data-field="buffer"    data-idx="${idx}" type="number" min="0"  max="100" step="5" value="${t.buffer}" /></td>
        <td>
          <select class="time-input" data-field="turnos" data-idx="${idx}" style="width:80px">
            <option value="1" ${t.turnos===1?'selected':''}>1 turno</option>
            <option value="2" ${t.turnos===2?'selected':''}>2 turnos</option>
            <option value="3" ${t.turnos===3?'selected':''}>3 turnos</option>
          </select>
        </td>
        <td>
          <div style="display:flex;align-items:center;gap:.35rem">
            <input class="time-input" data-field="operarios" data-idx="${idx}" type="number" min="1" max="99" step="1" value="${t.operarios||1}" style="width:52px" />
            <span style="font-size:.72rem;color:var(--n40)">op.</span>
          </div>
        </td>
        <td style="font-size:.82rem;font-weight:600;white-space:nowrap"><span class="time-uds">${uds} ud</span></td>
        <td>
          <div class="time-impact">
            <div class="time-impact-bar"><div class="time-impact-fill ${fillCls}" style="width:${adjLoad}%"></div></div>
            <span style="font-size:.74rem;font-weight:600;color:${adjLoad>=90?'var(--red)':adjLoad>=75?'var(--amber)':'var(--green)'}">${adjLoad}%</span>
          </div>
        </td>
        <td>
          <button class="time-delete-btn" data-del-idx="${idx}" title="Eliminar proceso">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          </button>
        </td>`;

      // Live recalc
      tr.querySelectorAll('.time-input, .time-name-input').forEach(input => {
        input.addEventListener('input', () => {
          const el    = input as HTMLInputElement | HTMLSelectElement;
          const i     = parseInt(el.dataset.idx!);
          const field = el.dataset.field!;
          if (field === 'label') {
            times[i].label = el.value;
          } else {
            const intFields = ['turnos', 'operarios'];
            times[i][field] = intFields.includes(field) ? parseInt(el.value)||1 : parseFloat(el.value)||0;
          }
          // Update uds + load
          const udsEl  = tr.querySelector('.time-uds') as HTMLElement;
          const fill   = tr.querySelector('.time-impact-fill') as HTMLElement;
          const pctEl  = tr.querySelector('.time-impact span') as HTMLElement;
          const newUds = calcUdsJornada(times[i]);
          const load   = calcLoad(times[i]);
          const fc     = load >= 90 ? 'time-impact-fill--danger' : load >= 75 ? 'time-impact-fill--warn' : '';
          if (udsEl) udsEl.textContent = `${newUds} ud`;
          if (fill)  { fill.style.width = `${load}%`; fill.className = `time-impact-fill ${fc}`; }
          if (pctEl) { pctEl.textContent = `${load}%`; pctEl.style.color = load>=90?'var(--red)':load>=75?'var(--amber)':'var(--green)'; }
        });
      });

      // Color picker (cycle through palette on dot click)
      tr.querySelector('[data-colorpick]')?.addEventListener('click', () => {
        const cur  = PALETTE.indexOf(times[idx].color);
        times[idx].color = PALETTE[(cur + 1) % PALETTE.length];
        (tr.querySelector('.time-dot') as HTMLElement).style.background = times[idx].color;
      });

      // Delete row
      tr.querySelector('.time-delete-btn')?.addEventListener('click', () => {
        if (times.length <= 1) { showToast('Debe haber al menos un proceso'); return; }
        times.splice(idx, 1);
        renderTimeTable(times);
      });

      tbody.appendChild(tr);
    }

    function renderTimeTable(times: any[]) {
      const tbody = document.getElementById('timeBody')!;
      tbody.innerHTML = '';
      times.forEach((t, idx) => addTimeRow(tbody, times, t, idx));
    }

    // ── Apply times to Gantt ──────────────────────────────────────
    function applyTimesToGantt(oldTimes: any[], newTimes: any[]) {
      newTimes.forEach((nt, idx) => {
        const ot = oldTimes[idx];
        if (ot.ciclo === nt.ciclo && ot.turnos === nt.turnos && ot.operarios === nt.operarios) return;
        // Throughput ratio: old_uds / new_uds — block widths scale inversely
        const oldUds = calcUdsJornada(ot);
        const newUds = calcUdsJornada(nt);
        const ratio  = (newUds || 1) / (oldUds || 1);
        // Scale blocks for this resource in Semana view
        document.querySelectorAll(`.gantt-block[data-recurso="${nt.label}"]`).forEach(b => {
          const el  = b as HTMLElement;
          const cur = parseFloat(el.style.width) || 50;
          el.style.width = `${Math.min(cur * ratio, 100)}%`;
        });
        // Scale turno blocks
        document.querySelectorAll(`.turno-row[data-resource="${nt.id}"] .turno-block`).forEach(b => {
          const el  = b as HTMLElement;
          const cw  = parseFloat(el.style.width) || 20;
          const cl  = parseFloat(el.style.left)  || 0;
          const nw  = Math.min(cw * ratio, 100 - cl);
          el.style.width = `${nw}%`;
        });
      });
    }

    // ── Panel init ────────────────────────────────────────────────
    let _mrpInited = false;
    async function initMrpPanel() {
      if (_mrpInited) return;
      _mrpInited = true;

      // Tab switching
      document.querySelectorAll('.mrp-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.mrp-tab').forEach(t => t.classList.remove('mrp-tab--active'));
          tab.classList.add('mrp-tab--active');
          const which = (tab as HTMLElement).dataset.mrptab;
          document.getElementById('mrpTabMrp')!.style.display    = which === 'mrp'     ? '' : 'none';
          document.getElementById('mrpTabTiempos')!.style.display = which === 'tiempos' ? '' : 'none';
          document.getElementById('mrpTabRutas')!.style.display   = which === 'rutas'   ? '' : 'none';
          if (which === 'rutas') initRoutingTab();
        });
      });

      // ── MRP tab setup ──
      decorateHelpHeaders();
      loadMrpDict().then(renderRequirements);
      document.getElementById('mrpgTemplate')?.addEventListener('click', downloadTemplate);
      for (const [btnId, panelId] of [['mrpgReqBtn', 'mrpgReq'], ['mrpgHowBtn', 'mrpgHow']]) {
        const btn = document.getElementById(btnId), panel = document.getElementById(panelId);
        btn?.addEventListener('click', () => {
          if (!panel) return;
          panel.hidden = !panel.hidden;
          btn.setAttribute('aria-expanded', String(!panel.hidden));
        });
      }
      const dropzone   = document.getElementById('mrpDropzone')!;
      const fileInput  = document.getElementById('mrpFileInput') as HTMLInputElement;
      const browse     = document.getElementById('mrpBrowse');
      const tplLink    = document.getElementById('mrpTemplateLink');

      browse?.addEventListener('click', () => fileInput.click());
      tplLink?.addEventListener('click', downloadTemplate);
      dropzone.addEventListener('click', e => { if (e.target === dropzone || (e.target as HTMLElement).closest('.mrp-dropzone__icon')) fileInput.click(); });

      dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('drag-over'); });
      dropzone.addEventListener('dragleave', ()   => dropzone.classList.remove('drag-over'));
      dropzone.addEventListener('drop', e => {
        e.preventDefault(); dropzone.classList.remove('drag-over');
        const file = e.dataTransfer?.files[0];
        if (file) loadFile(file);
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files?.[0]) loadFile(fileInput.files[0]);
      });

      // Upload → parse (first sheet named "MRP", else the first) → server
      // validation → analysis. Only rows without errors are ever loaded.
      let lastUpload: { header: any[]; rows: any[][]; name: string } | null = null;

      function workbookToAoa(wb: any): any[][] {
        const name = wb.SheetNames.find((n: string) => n.trim().toUpperCase() === 'MRP') || wb.SheetNames[0];
        return XLSX.utils.sheet_to_json(wb.Sheets[name], { header: 1, defval: '', raw: true, blankrows: false });
      }

      function loadFile(file: File) {
        const isExcel = file.name.match(/\.(xlsx|xls|ods)$/i);
        const isCsv   = file.name.match(/\.(csv|txt)$/i);
        if (!isExcel && !isCsv) { showToast('Formato no soportado. Usa .xlsx, .xls, .ods o .csv'); return; }

        const reader = new FileReader();
        reader.onload = e => {
          let aoa: any[][] = [];
          try {
            const wb = isExcel
              ? XLSX.read(e.target?.result, { type: 'array', cellDates: false })
              : XLSX.read(e.target?.result as string, { type: 'string', raw: true });
            aoa = workbookToAoa(wb);
          } catch {
            showToast('No se pudo leer el archivo. Comprueba que no esté dañado o protegido con contraseña.');
            return;
          }
          if (aoa.length < 2) { showToast('El archivo no tiene líneas de datos debajo de la cabecera.'); return; }
          if (aoa.length - 1 > 20000) { showToast('El archivo tiene más de 20.000 líneas: divídelo en varios archivos.'); return; }
          lastUpload = { header: aoa[0], rows: aoa.slice(1), name: file.name };
          validateUpload();
        };
        if (isExcel) reader.readAsArrayBuffer(file);
        else         reader.readAsText(file, 'UTF-8');
      }

      async function validateUpload(dateOrder?: string) {
        if (!lastUpload) return;
        const box = document.getElementById('mrpAnalysis')!;
        box.hidden = false;
        box.replaceChildren(el('p', { text: `Analizando «${lastUpload.name}»…` }));
        try {
          const res = await apiJson('/api/mrp/validate', { method: 'POST',
            body: JSON.stringify({ header: lastUpload.header, rows: lastUpload.rows, date_order: dateOrder || null }) });
          renderAnalysis(res);
        } catch (err: any) {
          box.replaceChildren(
            el('p', { class: 'mrpa__bad', text: err?.status === 422
              ? 'El archivo tiene celdas demasiado largas o demasiadas columnas (máximo 50 columnas y 500 caracteres por celda). No se ha cargado nada.'
              : 'No se pudo analizar el archivo. Comprueba tu conexión e inténtalo de nuevo; no se ha cargado nada.' }),
            el('button', { class: 'btn-ui', type: 'button', text: 'Reintentar', onclick: () => validateUpload(dateOrder) }));
        }
      }

      function issueTable(issues: any[]): HTMLElement {
        return el('table', { class: 'mrpa__rows' },
          el('thead', {}, el('tr', {}, ['Fila del Excel', 'Tu valor', 'Qué pasa'].map(h => el('th', { text: h })))),
          el('tbody', {}, issues.map((x: any) => el('tr', {},
            el('td', { text: x.row }), el('td', { text: x.value ?? '(vacío)' }),
            el('td', { class: x.level === 'error' ? 'mrpa__bad' : 'mrpa__warn', text: x.problem })))));
      }

      function renderAnalysis(res: any) {
        const box = document.getElementById('mrpAnalysis')!;
        const r = res.readiness;
        const LVL: Record<string, [string, string]> = {
          ready: ['Listo para planificar', 'mrpa__ok'], almost: ['Casi listo', 'mrpa__warn'], not_ready: ['Necesita correcciones', 'mrpa__bad'] };
        const [lvlTxt, lvlCls] = LVL[r.level] || LVL.not_ready;
        const nWarn = res.messages.filter((m: any) => m.level === 'warning').length;
        const reqOk = res.required_found === res.required_total;

        const colRow = (c: any) => {
          const f = findField(c.key);
          const parts: any[] = [];
          if (!c.found) parts.push(el('span', { class: c.status === 'required' ? 'mrpa__bad' : 'pcx-muted', text: c.status === 'required' ? '✕ columna no encontrada' : '○ no incluida (opcional)' }));
          else {
            if (c.key === 'fecha' && res.date_order.needs_confirmation) parts.push(el('span', { class: 'mrpa__warn', text: '⏳ pendiente de confirmar el formato de fecha' }));
            else parts.push(el('span', { class: c.pct_valid >= 95 ? 'mrpa__ok' : c.pct_valid >= 80 ? 'mrpa__warn' : 'mrpa__bad', text: `${c.pct_valid >= 95 ? '✓' : '⚠'} ${c.pct_valid}% válido` }));
            if (c.missing) parts.push(el('span', { class: c.status === 'required' ? 'mrpa__bad' : 'mrpa__warn', text: `⚠ ${c.missing} vacías` }));
            if (c.invalid) parts.push(el('span', { class: 'mrpa__bad', text: `✕ ${c.invalid} no válidas` }));
          }
          const detail = el('div', { hidden: 'hidden' }, c.issues.length ? issueTable(c.issues) : el('p', { class: 'pcx-muted', text: 'Sin incidencias en esta columna.' }));
          const btn = el('button', { type: 'button', 'aria-expanded': 'false',
            onclick: () => { const open = detail.hidden; detail.hidden = !open; btn.setAttribute('aria-expanded', String(open)); } },
            el('b', { text: f?.label || c.label }), parts,
            c.issues.length ? el('span', { class: 'pcx-muted', text: `Ver ${c.issues.length} fila${c.issues.length === 1 ? '' : 's'}` }) : null);
          return el('div', { class: 'mrpa__col' }, btn, detail);
        };

        const msgCard = (m: any) => el('div', { class: `mrpa__msg${m.level === 'warning' ? ' mrpa__msg--warning' : ''}` },
          el('p', {}, el('b', { text: m.title })),
          el('p', {}, el('b', { text: 'Qué afecta: ' }), m.impact),
          el('p', {}, el('b', { text: 'Cómo corregirlo: ' }), m.fix),
          m.rows?.length ? el('p', { class: 'pcx-muted', text: `Filas del Excel: ${m.rows.join(', ')}${m.rows.length >= 50 ? '…' : ''}` }) : null,
          m.help?.length ? el('details', {}, el('summary', { text: '¿Necesitas ayuda para encontrar este dato?' }),
            el('p', { text: 'Normalmente se obtiene de:' }), el('ul', {}, m.help.map((h: string) => el('li', { text: h }))),
            el('p', { class: 'pcx-muted', text: 'Son fuentes habituales en fabricación; comprueba cuál aplica en tu empresa.' })) : null);

        const loadBtn = el('button', { class: 'btn-ui btn-ui--primary', type: 'button',
          text: res.excluded_rows ? `Cargar ${res.loadable_rows} líneas válidas (${res.excluded_rows} con errores se quedan fuera)` : `Cargar ${res.loadable_rows} líneas`,
          onclick: () => {
            const clean = res.rows.filter((x: any) => x.clean).map((x: any) => x.clean);
            localStorage.setItem(MRP_LS, JSON.stringify(clean));
            renderMrpTable(clean);
            showToast(`✓ ${clean.length} líneas MRP cargadas`);
            const sub = document.getElementById('mrpSub');
            if (sub) sub.textContent = `${clean.length} líneas · ${lastUpload?.name || ''}`;
          } });
        if (r.blocking || !res.loadable_rows) loadBtn.setAttribute('disabled', 'disabled');

        box.replaceChildren(...[
          el('h4', { text: `Análisis del archivo · ${lastUpload?.name || ''}` }),
          el('ul', { class: 'mrpa__facts' },
            el('li', { class: 'mrpa__ok', text: `✓ ${res.rows_processed.toLocaleString('es-ES')} líneas procesadas` }),
            el('li', { class: reqOk ? 'mrpa__ok' : 'mrpa__bad', text: `${reqOk ? '✓' : '✕'} ${res.required_found}/${res.required_total} columnas obligatorias encontradas` }),
            res.excluded_rows ? el('li', { class: 'mrpa__bad', text: `✕ ${res.excluded_rows} líneas con errores` }) : null,
            nWarn ? el('li', { class: 'mrpa__warn', text: `⚠ ${nWarn} aviso${nWarn === 1 ? '' : 's'}` }) : null),
          el('div', { class: 'mrpa__score' },
            el('div', {}, el('div', { class: `mrpa__big ${lvlCls}`, text: `${r.overall}%` }), el('div', { class: lvlCls, text: `Preparación: ${lvlTxt}` })),
            el('div', { class: 'mrpa__bd' }, [['Completitud', r.completeness], ['Validez', r.validity], ['Coherencia', r.consistency], ['Líneas cargables', r.loadable_pct]]
              .map(([k, v]) => el('div', {}, el('b', { text: `${v}%` }), String(k)))),
            el('p', { style: 'flex-basis:100%;margin:0', text: res.summary })),
          res.date_order.needs_confirmation ? el('div', { class: 'mrpa__msg' },
            el('p', {}, el('b', { text: 'Confirma el formato de las fechas' })),
            el('p', { text: 'Tu archivo usa fechas como 05/06/2026, que pueden leerse de dos maneras. Planning Core no elige por ti.' }),
            el('div', { class: 'mrpa__actions' },
              el('button', { class: 'btn-ui btn-ui--primary', type: 'button', text: 'Día/mes/año (05/06 = 5 de junio)', onclick: () => validateUpload('DMY') }),
              el('button', { class: 'btn-ui', type: 'button', text: 'Mes/día/año (05/06 = 6 de mayo)', onclick: () => validateUpload('MDY') }))) : null,
          el('h4', { style: 'margin-top:.4rem', text: 'Resultado por columna' }),
          el('div', {}, res.columns.filter((c: any) => c.found || c.status === 'required').map(colRow)),
          res.messages.length ? el('div', {}, el('h4', { style: 'margin-top:.8rem', text: 'Qué corregir' }), res.messages.map(msgCard)) : null,
          el('details', {}, el('summary', { text: 'Cómo se han leído tus columnas' }),
            res.mapping_mode === 'position' ? el('p', { class: 'mrpa__warn', text: 'No reconocimos los nombres de las columnas, así que se han leído por posición, en el orden de la plantilla. Revisa que coincida.' }) : null,
            el('ul', {}, res.mapping.map((m: any) => el('li', {}, `Tu Excel: «${m.yours || '(sin nombre)'}» (columna ${m.column}) → Planning Core: `, el('b', { text: m.label })))),
            res.ignored_columns.length ? el('p', { class: 'pcx-muted', text: `Columnas no usadas: ${res.ignored_columns.join(', ')}.` }) : null),
          el('details', {}, el('summary', { text: `Transformaciones aplicadas (${res.normalizations.length})` }),
            res.normalizations.length
              ? el('table', { class: 'mrpa__rows' },
                  el('thead', {}, el('tr', {}, ['Fila', 'Columna', 'Tu valor', 'Valor usado', 'Regla aplicada'].map(h => el('th', { text: h })))),
                  el('tbody', {}, res.normalizations.map((n: any) => el('tr', {},
                    el('td', { text: n.row }), el('td', { text: n.label }), el('td', { text: n.original }),
                    el('td', { text: n.normalized }), el('td', { text: n.rule })))))
              : el('p', { class: 'pcx-muted', text: 'Ningún valor se ha modificado: se usan exactamente los datos del archivo.' })),
          el('div', { class: 'mrpa__actions' }, loadBtn,
            el('button', { class: 'btn-ui', type: 'button', text: 'Descartar', onclick: () => { box.hidden = true; lastUpload = null; } }))]
          .filter(Boolean) as HTMLElement[]);
      }

      document.getElementById('mrpClear')?.addEventListener('click', () => {
        localStorage.removeItem(MRP_LS);
        renderMrpTable([]);
        const sub = document.getElementById('mrpSub');
        if (sub) sub.textContent = 'Carga tu plan de materiales y ajusta los tiempos por recurso';
        showToast('MRP limpiado');
      });

      document.getElementById('mrpApply')?.addEventListener('click', () => {
        const rows = getMrpRows();
        if (rows.length === 0) return;
        // Add MRP rows to the Orders panel that don't already exist
        const existing = new Set(Array.from(document.querySelectorAll('#ordersBody tr td:first-child')).map(td => td.textContent?.trim()));
        let added = 0;
        rows.forEach(row => {
          if (existing.has(row.of)) return;
          const tr = document.createElement('tr');
          const estado = row.cant > row.stock ? 'riesgo' : 'ok';
          tr.dataset.estado = estado;
          const st = rowStatus(row);
          const pill = el('span', { class: `status-pill ${estado === 'riesgo' ? 'sp--risk' : 'sp--ok'}`, text: estado === 'riesgo' ? 'Riesgo' : 'En plazo' });
          tr.append(el('td', { text: row.of }), el('td', { text: row.desc }), el('td', { text: '—' }),
            el('td', { text: row.fecha || '—' }), el('td', { text: '—' }),
            el('td', {}, el('div', { style: 'display:flex;align-items:center;gap:.5rem' },
              el('div', { class: 'progress-track', style: 'width:72px' }, el('div', { class: 'progress-fill', style: 'width:0%' })),
              el('span', { class: 'progress-pct', text: '0%' }))),
            el('td', {}, pill));
          document.getElementById('ordersBody')?.appendChild(tr);
          added++;
        });
        enhanceOrderRows();
        showToast(added > 0 ? `✓ ${added} orden${added!==1?'es':''} añadida${added!==1?'s':''} al panel de Órdenes` : 'Todas las órdenes ya estaban en el panel');
      });

      // Load existing rows
      renderMrpTable(getMrpRows());

      // ── Backend config helpers ────────────────────────────────────
      async function fetchConfig(): Promise<any> {
        const token = localStorage.getItem('pc_token');
        if (!token) return null;
        try {
          const res = await fetch(`${API_BASE}/config`, { headers: { Authorization: `Bearer ${token}` } });
          if (!res.ok) return null;
          return await res.json();
        } catch { return null; }
      }

      async function pushConfig(payload: any) {
        const token = localStorage.getItem('pc_token');
        if (!token) return;
        try {
          await fetch(`${API_BASE}/config`, {
            method: 'PUT',
            headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch {}
      }

      // ── Tiempos tab setup ──
      // Try to load saved config from backend first, fall back to localStorage
      const remoteConfig = await fetchConfig();
      if (remoteConfig?.process_times?.length) {
        localStorage.setItem(TIME_LS, JSON.stringify(remoteConfig.process_times));
      }

      const times = getProcessTimes();
      renderTimeTable(times);

      document.getElementById('addProcessBtn')?.addEventListener('click', () => {
        const newIdx = times.length;
        const newId  = `proceso-${Date.now()}`;
        times.push({ id: newId, label: 'Nuevo proceso', color: PALETTE[newIdx % PALETTE.length], setup: 15, ciclo: 30, buffer: 10, turnos: 1, operarios: 1 });
        const tbody = document.getElementById('timeBody')!;
        addTimeRow(tbody, times, times[newIdx], newIdx);
      });

      document.getElementById('timeSave')?.addEventListener('click', async () => {
        const oldTimes = getProcessTimes();
        const TIME_RULES: Record<string, [number, number, string]> = {
          setup: [0, 480, 'Setup debe estar entre 0 y 480 minutos por turno'],
          ciclo: [0.01, 999, 'Ciclo debe ser mayor que 0 minutos por unidad: sin él no se puede calcular la capacidad'],
          buffer: [0, 99, 'Buffer debe estar entre 0 y 99 %'],
          turnos: [1, 3, 'Turnos debe ser 1, 2 o 3'],
          operarios: [1, 99, 'Operarios/turno debe ser un entero entre 1 y 99'],
        };
        const problems: string[] = [];
        document.querySelectorAll('#timeBody .time-input').forEach(input => {
          const inp = input as HTMLInputElement;
          const rule = TIME_RULES[inp.dataset.field!];
          if (!rule) return;
          const v = Number(inp.value);
          const bad = inp.value.trim() === '' || !Number.isFinite(v) || v < rule[0] || v > rule[1]
            || ((inp.dataset.field === 'turnos' || inp.dataset.field === 'operarios') && !Number.isInteger(v));
          inp.setAttribute('aria-invalid', String(bad));
          if (bad) problems.push(`${times[Number(inp.dataset.idx)]?.label || 'Recurso'}: ${rule[2]} (valor actual: «${inp.value || 'vacío'}»).`);
        });
        document.querySelectorAll('#timeBody .time-name-input').forEach(input => {
          const inp = input as HTMLInputElement;
          const bad = !inp.value.trim();
          inp.setAttribute('aria-invalid', String(bad));
          if (bad) problems.push('Hay un recurso sin nombre: escribe el nombre de la máquina o proceso.');
        });
        const statusEl = document.getElementById('timeSaveStatus');
        if (problems.length) {
          if (statusEl) statusEl.replaceChildren(el('div', { class: 'time-err' },
            el('b', { text: 'No se ha guardado. Corrige estos valores:' }), el('ul', { style: 'margin:.2rem 0 0;padding-left:1rem' }, problems.map(p => el('li', { text: p })))));
          showToast('Revisa los tiempos marcados en rojo');
          return;
        }
        document.querySelectorAll('#timeBody .time-input').forEach(input => {
          const el    = input as HTMLInputElement | HTMLSelectElement;
          const idx   = parseInt(el.dataset.idx!);
          const field = el.dataset.field!;
          times[idx][field] = field === 'turnos' || field === 'operarios' ? parseInt(el.value) : parseFloat(el.value) || 0;
        });
        localStorage.setItem(TIME_LS, JSON.stringify(times));
        applyTimesToGantt(oldTimes, times);
        renderTimeTable(times);

        // Sync shifts too so backend has the full picture
        const currentShifts = getShifts();
        await pushConfig({ process_times: times, shift_schedule: currentShifts });

        const status = document.getElementById('timeSaveStatus');
        if (status) { status.textContent = '✓ Guardado en servidor y Gantt recalculado'; setTimeout(() => { status.textContent = ''; }, 3000); }
        showToast('✓ Tiempos de proceso actualizados');
      });

      document.getElementById('timeReset')?.addEventListener('click', () => {
        if (!confirm('¿Restablecer todos los tiempos a los valores por defecto?')) return;
        localStorage.removeItem(TIME_LS);
        const defaults = DEFAULT_TIMES.map(d => ({ ...d }));
        renderTimeTable(defaults);
        showToast('Tiempos restablecidos');
      });

      // ── Shift schedule ────────────────────────────────────────────
      const SHIFT_LS = 'pc_shift_schedule';
      const DAYS     = ['L','M','X','J','V','S','D'];

      const DEFAULT_SHIFTS = [
        { id: 1, label: 'Mañana',  color: '#F59E0B', start: '06:00', end: '14:00', days: [0,1,2,3,4],     active: true  },
        { id: 2, label: 'Tarde',   color: '#3B82F6', start: '14:00', end: '22:00', days: [0,1,2,3,4],     active: true  },
        { id: 3, label: 'Noche',   color: '#6366F1', start: '22:00', end: '06:00', days: [0,1,2,3,4,5],   active: false },
      ];

      function getShifts(): any[] {
        try {
          const s = JSON.parse(localStorage.getItem(SHIFT_LS) || '[]');
          if (s.length === 3) return s;
        } catch {}
        return DEFAULT_SHIFTS.map(s => ({ ...s, days: [...s.days] }));
      }

      function parseHM(hm: string): number {
        const [h, m] = hm.split(':').map(Number);
        return (h || 0) * 60 + (m || 0);
      }

      function shiftDuration(s: any): number {
        let start = parseHM(s.start), end = parseHM(s.end);
        if (end <= start) end += 1440; // overnight
        return end - start;
      }

      function fmtDuration(min: number): string {
        const h = Math.floor(min / 60), m = min % 60;
        return m ? `${h}h ${m}min` : `${h}h`;
      }

      function renderShiftTable(shifts: any[]) {
        const tbody = document.getElementById('shiftBody')!;
        tbody.innerHTML = '';

        shifts.forEach((s, si) => {
          const dur = shiftDuration(s);
          const tr  = document.createElement('tr');
          tr.dataset.si = String(si);
          if (!s.active) tr.style.opacity = '.5';

          tr.innerHTML = `
            <td>
              <div style="display:flex;align-items:center;gap:.4rem">
                <span class="shift-dot shift-color-dot" data-si="${si}" style="background:${escHtml(s.color)};cursor:pointer;flex-shrink:0" title="Cambiar color"></span>
                <input class="time-name-input shift-name-input" data-si="${si}" type="text" value="${escHtml(s.label)}" maxlength="40" style="min-width:80px" />
              </div>
            </td>
            <td><input class="time-hm" data-sfield="start" data-si="${si}" type="time" value="${s.start}" ${!s.active?'disabled':''} /></td>
            <td><input class="time-hm" data-sfield="end"   data-si="${si}" type="time" value="${s.end}"   ${!s.active?'disabled':''} /></td>
            <td><span class="shift-duration" id="shift-dur-${si}">${fmtDuration(dur)}</span></td>
            <td>
              <div class="shift-days" id="shift-days-${si}">
                ${DAYS.map((d, di) => `<div class="shift-day ${s.days.includes(di)?'active':''} ${!s.active?'disabled-day':''}" data-si="${si}" data-di="${di}">${d}</div>`).join('')}
              </div>
            </td>
            <td>
              <label class="shift-toggle">
                <input type="checkbox" data-sfield="active" data-si="${si}" ${s.active?'checked':''} />
                <div class="shift-toggle__track"></div>
                <div class="shift-toggle__thumb"></div>
              </label>
            </td>
            <td>
              <button class="time-delete-btn shift-delete-btn" data-si="${si}" title="Eliminar turno">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
              </button>
            </td>`;
          tbody.appendChild(tr);
        });

        // Day pill toggles
        tbody.querySelectorAll('.shift-day:not(.disabled-day)').forEach(pill => {
          pill.addEventListener('click', () => {
            const si = parseInt((pill as HTMLElement).dataset.si!);
            const di = parseInt((pill as HTMLElement).dataset.di!);
            if (!shifts[si].active) return;
            const idx = shifts[si].days.indexOf(di);
            if (idx === -1) shifts[si].days.push(di);
            else           shifts[si].days.splice(idx, 1);
            pill.classList.toggle('active');
          });
        });

        // Time inputs
        tbody.querySelectorAll('.time-hm').forEach(input => {
          input.addEventListener('input', () => {
            const el    = input as HTMLInputElement;
            const si    = parseInt(el.dataset.si!);
            const field = el.dataset.sfield!;
            shifts[si][field] = el.value;
            const dur   = shiftDuration(shifts[si]);
            const durEl = document.getElementById(`shift-dur-${si}`);
            if (durEl) durEl.textContent = fmtDuration(dur);
            // Refresh resource table uds/jornada
            refreshUdsFromShifts(shifts);
          });
        });

        // Active toggle
        tbody.querySelectorAll('input[data-sfield="active"]').forEach(cb => {
          cb.addEventListener('change', () => {
            const el = cb as HTMLInputElement;
            const si = parseInt(el.dataset.si!);
            shifts[si].active = el.checked;
            renderShiftTable(shifts);
            refreshUdsFromShifts(shifts);
          });
        });

        // Editable shift name
        tbody.querySelectorAll('.shift-name-input').forEach(input => {
          input.addEventListener('input', () => {
            const el = input as HTMLInputElement;
            const si = parseInt(el.dataset.si!);
            shifts[si].label = el.value;
          });
        });

        // Shift color dot — cycles through PALETTE
        tbody.querySelectorAll('.shift-color-dot').forEach(dot => {
          dot.addEventListener('click', () => {
            const el = dot as HTMLElement;
            const si = parseInt(el.dataset.si!);
            const cur = PALETTE.indexOf(shifts[si].color);
            shifts[si].color = PALETTE[(cur + 1) % PALETTE.length];
            el.style.background = shifts[si].color;
          });
        });

        // Delete shift
        tbody.querySelectorAll('.shift-delete-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const si = parseInt((btn as HTMLElement).dataset.si!);
            if (shifts.length <= 1) { showToast('Debe haber al menos un turno'); return; }
            shifts.splice(si, 1);
            renderShiftTable(shifts);
            refreshUdsFromShifts(shifts);
          });
        });
      }

      // Recalculate Ud/jornada in the resource table using real shift durations
      function refreshUdsFromShifts(shifts: any[]) {
        const times  = getProcessTimes();
        const tbody  = document.getElementById('timeBody');
        if (!tbody) return;

        times.forEach((t, idx) => {
          // Total minutes available = sum of active shift durations * operarios
          const activeShifts = shifts.filter(s => s.active);
          // Match number of active shifts to the configured turnos for this resource
          const usedShifts   = activeShifts.slice(0, t.turnos);
          const totalMin     = usedShifts.reduce((acc: number, s: any) => acc + shiftDuration(s), 0);
          const netMin       = Math.max(0, (totalMin - t.setup * t.turnos) * (1 - (t.buffer || 0) / 100)) * (t.operarios || 1);
          const uds          = Math.floor(netMin / (t.ciclo || 1));

          const row  = tbody.querySelector(`tr[data-id="${t.id}"]`);
          if (row) {
            const udsEl = row.querySelector('.time-uds') as HTMLElement;
            if (udsEl) udsEl.textContent = `${uds} ud`;
          }
        });
      }

      // Load shifts from backend if available
      if (remoteConfig?.shift_schedule?.length) {
        localStorage.setItem(SHIFT_LS, JSON.stringify(remoteConfig.shift_schedule));
      }

      const shifts = getShifts();
      renderShiftTable(shifts);

      document.getElementById('addShiftBtn')?.addEventListener('click', () => {
        const newId = shifts.length ? Math.max(...shifts.map((s: any) => s.id)) + 1 : 1;
        shifts.push({ id: newId, label: `Turno ${newId}`, color: PALETTE[newId % PALETTE.length], start: '06:00', end: '14:00', days: [0,1,2,3,4], active: true });
        renderShiftTable(shifts);
      });

      document.getElementById('shiftSave')?.addEventListener('click', async () => {
        document.querySelectorAll('#shiftBody .time-hm').forEach(input => {
          const el    = input as HTMLInputElement;
          const si    = parseInt(el.dataset.si!);
          const field = el.dataset.sfield!;
          shifts[si][field] = el.value;
        });
        localStorage.setItem(SHIFT_LS, JSON.stringify(shifts));
        refreshUdsFromShifts(shifts);

        await pushConfig({ process_times: times, shift_schedule: shifts });

        const st = document.getElementById('shiftSaveStatus');
        if (st) { st.textContent = '✓ Guardado en servidor'; setTimeout(() => { st.textContent = ''; }, 3000); }
        showToast('✓ Horarios de turno actualizados');
      });

      document.getElementById('shiftReset')?.addEventListener('click', () => {
        if (!confirm('¿Restablecer los horarios por defecto?')) return;
        localStorage.removeItem(SHIFT_LS);
        const def = DEFAULT_SHIFTS.map(s => ({ ...s, days: [...s.days] }));
        renderShiftTable(def);
        showToast('Horarios restablecidos');
      });
    }

    // ── 8f. Rutas y OF: pieza → ruta versionada → operaciones → recursos ──
    // Everything comes from /api/routing (company-scoped; the server computes
    // times, capacity, sequencing, risks and explanations). Values are rendered
    // through el() (textContent), never as markup.
    const RT_RISK: Record<string, [string, string]> = {
      on_time: ['En plazo', 'rt-pill rt-pill--ok'], at_risk: ['En riesgo', 'rt-pill rt-pill--warn'],
      late: ['Retrasada', 'rt-pill rt-pill--bad'], unplanned: ['Sin planificar', 'rt-pill rt-pill--bad'],
    };
    const RT_QUALITY: Record<string, [string, string]> = {
      READY: ['READY', 'rt-pill rt-pill--ok'], WARNING: ['WARNING', 'rt-pill rt-pill--warn'], ERROR: ['ERROR DE RUTA', 'rt-pill rt-pill--bad'],
    };
    const RT_STATUS: Record<string, string> = {
      NOT_STARTED: 'No iniciada', READY: 'Lista para empezar', PLANNED: 'Planificada', IN_PROGRESS: 'En curso',
      BLOCKED: 'Bloqueada', COMPLETED: 'Terminada', CANCELLED: 'Cancelada',
    };
    const RT_LIFE: Record<string, string> = { planned: 'Planificada (no lanzada)', released: 'Lanzada a planta', historical: 'Histórica' };
    const RT_RSTATUS: Record<string, string> = { draft: 'Borrador', released: 'Liberada', obsolete: 'Obsoleta' };
    const RT_WEEKDAYS = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
    const RT_MISSING = 'DATO FALTANTE';
    const rt: any = { view: 'orders', plan: null, orders: [], parts: [], resources: [], overview: null,
                      openOrder: null, openPart: null, openRouting: null };
    let _rtInited = false;

    function rtErr(e: any): string {
      if (e?.status === 403) return 'No tienes permiso para esta acción: las piezas, rutas y recursos requieren rol de jefe de planta o superior.';
      return e?.message || 'No se pudo conectar con el servidor.';
    }
    function rtDt(s?: string | null): string {
      if (!s) return '—';
      const d = new Date(s);
      return isNaN(+d) ? '—' : d.toLocaleString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
    }
    function rtDate(s?: string | null): string {
      if (!s) return '—';
      const [y, m, d] = String(s).slice(0, 10).split('-');
      return `${d}/${m}/${y}`;
    }
    function rtMin(m: any): string {
      if (m == null) return RT_MISSING;
      const t = Math.round(Number(m)), h = Math.floor(t / 60), mm = t % 60;
      return h ? `${h} h${mm ? ` ${mm} min` : ''}` : `${mm} min`;
    }
    function rtVal(v: any, unit = ''): any {
      return v == null || v === '' ? el('span', { class: 'rt-missing', text: RT_MISSING }) : `${v}${unit}`;
    }
    function rtPill(map: Record<string, [string, string]>, key: string): HTMLElement {
      const m = map[key];
      return el('span', { class: m ? m[1] : 'rt-pill rt-pill--mute', text: m ? m[0] : key || '—' });
    }
    function rtColor(code: string): string {
      let h = 0;
      for (const ch of code || '') h = (h * 31 + ch.charCodeAt(0)) >>> 0;
      return PALETTE[h % PALETTE.length];
    }
    function rtLocalNow(): string {
      const d = new Date(), p = (n: number) => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
    }
    function rtBody(): HTMLElement { return document.getElementById('rtBody')!; }
    function rtCall(path: string, init: RequestInit = {}) { return apiJson('/api/routing' + path, init); }
    function rtJson(method: string, body: any): RequestInit { return { method, body: JSON.stringify(body) }; }
    // Button that disables itself while its async action runs and reports errors.
    function rtBtn(label: string, fn: () => Promise<any>, cls = ''): HTMLElement {
      return el('button', { class: `btn-ui${cls ? ' ' + cls : ''}`, type: 'button', text: label, onclick: async (e: Event) => {
        const b = e.currentTarget as HTMLButtonElement;
        b.disabled = true;
        try { await fn(); } catch (err) { showToast(rtErr(err)); } finally { if (b.isConnected) b.disabled = false; }
      } });
    }
    // Two-step destructive button (no browser dialog).
    function rtConfirmBtn(label: string, confirmLabel: string, fn: () => Promise<any>): HTMLElement {
      const b = el('button', { class: 'btn-ui', type: 'button', text: label }) as HTMLButtonElement;
      b.addEventListener('click', async () => {
        if (b.dataset.armed !== '1') { b.dataset.armed = '1'; b.textContent = confirmLabel; return; }
        b.disabled = true;
        try { await fn(); } catch (err) { showToast(rtErr(err)); b.disabled = false; }
      });
      return b;
    }
    function rtTable(heads: string[], tbody: HTMLElement, cls = 'rt-table'): HTMLElement {
      return el('div', { class: 'rt-table-wrap' }, el('table', { class: cls },
        el('thead', {}, el('tr', {}, heads.map(h => el('th', { text: h })))), tbody));
    }

    async function initRoutingTab() {
      const root = document.getElementById('mrpTabRutas');
      if (!root) return;
      if (!_rtInited) {
        _rtInited = true;
        const views: [string, string][] = [['orders', 'Órdenes y plan'], ['parts', 'Rutas por pieza'], ['resources', 'Recursos']];
        root.replaceChildren(
          el('div', { class: 'rt-head' },
            el('div', { class: 'rt-seg', role: 'tablist', 'aria-label': 'Rutas y OF' }, views.map(([k, l]) =>
              el('button', { type: 'button', role: 'tab', 'data-rtview': k, 'aria-selected': String(rt.view === k), text: l, onclick: () => rtShow(k) }))),
            el('div', { class: 'rt-quality', id: 'rtQuality', 'aria-live': 'polite' })),
          el('div', { id: 'rtBody' }));
      }
      rtRefreshOverview();
      rtShow(rt.view);
    }

    // "Ask the copilot" with the context of what is on screen (read-only answer).
    function rtAskCopilot(label: string, question: string, requestType: string, focus: any): HTMLElement | null {
      if (!hasAccess('copilot')) return null;
      return el('button', { class: 'btn-ui', type: 'button', text: label, title: 'El copiloto analiza estos datos; no modifica nada.',
        onclick: (e: Event) => { e.stopPropagation(); setCopilotFocus(focus); sendCopilot(question, undefined, requestType); } });
    }

    function rtShow(view: string) {
      rt.view = view;
      setCopilotFocus(null);
      document.querySelectorAll('[data-rtview]').forEach(b => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.rtview === view)));
      if (view === 'orders') rtLoadOrders();
      else if (view === 'parts') rtLoadParts();
      else rtLoadResources();
    }

    async function rtRefreshOverview() {
      const box = document.getElementById('rtQuality');
      if (!box) return;
      try { rt.overview = await rtCall('/overview'); }
      catch (e) { box.replaceChildren(el('span', { class: 'rt-bad', text: rtErr(e) })); return; }
      const ov = rt.overview, c = ov.routing_status_counts, n = ov.parts.length, nc = ov.resources.without_calendar.length;
      box.replaceChildren(
        el('span', { class: 'rt-muted', text: `Rutas (${n} pieza${n === 1 ? '' : 's'}):` }),
        el('span', { class: 'rt-pill rt-pill--ok', text: `${c.READY} READY` }),
        c.WARNING ? el('span', { class: 'rt-pill rt-pill--warn', text: `${c.WARNING} WARNING` }) : null,
        c.ERROR ? el('span', { class: 'rt-pill rt-pill--bad', text: `${c.ERROR} ERROR` }) : null,
        ov.orders.routing_errors ? el('span', { class: 'rt-pill rt-pill--bad', text: `${ov.orders.routing_errors} OF con ERROR DE RUTA` }) : null,
        nc ? el('span', { class: 'rt-pill rt-pill--warn', title: ov.resources.without_calendar.join(', '), text: `${nc} recurso${nc === 1 ? '' : 's'} sin calendario` }) : null);
    }

    // ── Órdenes y plan ──
    async function rtLoadOrders() {
      const body = rtBody();
      body.replaceChildren(el('p', { class: 'rt-muted', text: 'Cargando órdenes de fabricación…' }));
      try { [rt.orders, rt.parts] = await Promise.all([rtCall('/orders'), rtCall('/parts')]); }
      catch (e) { body.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); return; }
      if (rt.view === 'orders') rtRenderOrders();
    }

    async function rtReloadOrders() {
      rt.orders = await rtCall('/orders');
      rtRenderOrderList();
      rtRefreshOverview();
    }

    function rtRenderOrders() {
      const mrpRows = getMrpRows();
      const start = el('input', { class: 'rt-in', type: 'datetime-local', value: rtLocalNow() }) as HTMLInputElement;
      const formBox = el('div', { class: 'rt-box', hidden: 'hidden' });
      const result = el('div', { 'aria-live': 'polite' });
      rtBody().replaceChildren(
        el('div', { class: 'rt-bar' },
          rtBtn('Planificar', () => rtRunPlan(start.value, result), 'btn-ui--primary'),
          rtBtn('Simular robustez', () => rtRunSimulation(start.value, result)),
          el('label', {}, 'Inicio', start),
          el('label', { title: 'Qué órdenes reservan capacidad primero' }, 'Secuencia',
            el('select', { class: 'rt-in', onchange: (e: Event) => { rt.sequencing = (e.target as HTMLSelectElement).value; } },
              el('option', { value: 'priority', text: 'Por prioridad', selected: rt.sequencing === 'due_date' ? null : 'selected' }),
              el('option', { value: 'due_date', text: 'Por fecha de necesidad', selected: rt.sequencing === 'due_date' ? 'selected' : null }))),
          el('button', { class: 'btn-ui', type: 'button', disabled: mrpRows.length ? null : 'disabled',
            title: mrpRows.length ? 'Una OF por línea con necesidad neta > 0' : 'Carga primero un Excel en la pestaña Plan MRP',
            text: mrpRows.length ? `Crear OF desde el MRP (${mrpRows.length} líneas)` : 'Crear OF desde el MRP',
            onclick: () => rtImportMrp(result) }),
          el('button', { class: 'btn-ui', type: 'button', text: 'Nueva OF', onclick: () => {
            formBox.hidden = !formBox.hidden;
            if (!formBox.hidden) rtOrderForm(formBox);
          } })),
        el('p', { class: 'rt-muted', style: 'margin:-.3rem 0 .8rem', text: 'Planificar ordena las OF por prioridad y fecha de necesidad y coloca cada operación en su recurso respetando la secuencia, el calendario, el mantenimiento y la capacidad. Cada retraso se explica con su causa.' }),
        formBox, result, el('div', { id: 'rtPlanBox' }), el('div', { id: 'rtSimBox' }), el('div', { id: 'rtOrdersBox' }));
      rtRenderPlan();
      rtRenderSim();
      rtRenderOrderList();
    }

    function rtOrderForm(box: HTMLElement) {
      const num = el('input', { class: 'rt-in', maxlength: '60', placeholder: 'OF-12345' }) as HTMLInputElement;
      const part = el('select', { class: 'rt-in' }, el('option', { value: '', text: '— Selecciona la pieza —' }),
        rt.parts.map((p: any) => el('option', { value: String(p.id), text: `${p.part_number}${p.name && p.name !== p.part_number ? ' · ' + p.name : ''}` }))) as HTMLSelectElement;
      const qty = el('input', { class: 'rt-in', type: 'number', min: '0', step: 'any' }) as HTMLInputElement;
      const due = el('input', { class: 'rt-in', type: 'date' }) as HTMLInputElement;
      const prio = el('select', { class: 'rt-in' }, [1, 2, 3, 4, 5].map(n => el('option', { value: String(n), selected: n === 3 ? 'selected' : null,
        text: n === 1 ? '1 (máxima)' : n === 5 ? '5 (mínima)' : String(n) }))) as HTMLSelectElement;
      const msg = el('p', { class: 'rt-bad', 'aria-live': 'polite' });
      box.replaceChildren(
        el('h4', { text: 'Nueva orden de fabricación' }),
        el('p', { class: 'rt-muted', style: 'margin:0 0 .6rem', text: 'Sus operaciones se generan automáticamente con la ruta liberada de la pieza.' }),
        el('div', { class: 'rt-form' },
          el('label', {}, 'Nº de OF', num), el('label', {}, 'Pieza', part), el('label', {}, 'Cantidad', qty),
          el('label', {}, 'Fecha de necesidad', due), el('label', {}, 'Prioridad', prio),
          rtBtn('Crear OF', async () => {
            msg.textContent = '';
            const q = Number(qty.value);
            if (!num.value.trim() || !(q > 0)) { msg.textContent = 'Indica el número de OF y una cantidad mayor que 0.'; return; }
            try {
              const o = await rtCall('/orders', rtJson('POST', { order_number: num.value.trim(), part_id: part.value ? Number(part.value) : null,
                quantity: q, due_date: due.value || null, priority: Number(prio.value) }));
              showToast(o.routing_status === 'ERROR' ? `OF ${o.order_number} creada con ERROR DE RUTA: revísala` : `✓ OF ${o.order_number} creada con ${o.operations.length} operaciones`);
              box.hidden = true;
              rt.openOrder = o.id;
              await rtReloadOrders();
            } catch (e) { msg.textContent = rtErr(e); }
          }, 'btn-ui--primary')),
        msg);
    }

    async function rtImportMrp(box: HTMLElement) {
      const rows = getMrpRows();
      if (!rows.length) return;
      box.replaceChildren(el('p', { class: 'rt-muted', text: 'Creando OF a partir del MRP…' }));
      try {
        const res = await rtCall('/orders/import-mrp', rtJson('POST', { rows }));
        rt.sim = null; rtRenderSim();
        const errs = res.created.filter((c: any) => c.routing_status === 'ERROR');
        box.replaceChildren(el('div', { class: 'rt-box' },
          el('h4', { text: res.summary }),
          errs.length ? el('div', { class: 'rt-alert' }, el('b', { text: 'OF con ERROR DE RUTA (sin operaciones hasta corregirlo):' }),
            el('ul', { style: 'margin:.2rem 0 0;padding-left:1rem' }, errs.slice(0, 30).map((c: any) => el('li', { text: `${c.of}: ${c.issue}` })))) : null,
          res.skipped.length ? el('details', {}, el('summary', { text: `Líneas sin OF (${res.skipped.length})` }),
            el('ul', {}, res.skipped.slice(0, 100).map((s: any) => el('li', { text: `${s.of}: ${s.reason}` })))) : null,
          el('p', { class: 'rt-muted', style: 'margin:.5rem 0 0', text: 'La pieza de cada línea se identifica solo por coincidencia exacta del número de pieza con «OF / Material» o «Descripción»; si no coincide, asígnala en la OF. Cantidad de la OF = necesidad neta (cantidad − stock).' })));
        await rtReloadOrders();
      } catch (e) { box.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); }
    }


    // Monte Carlo on the OF plan: how likely each OF is to make its need date.
    // Read-only on the server; the result is kept in rt.sim until the data or
    // the plan changes (then it is stale and dropped).
    async function rtRunSimulation(start: string, box: HTMLElement) {
      box.replaceChildren(el('p', { class: 'rt-muted', text: 'Simulando cientos de escenarios (duraciones variables y averías)…' }));
      try {
        rt.sim = await rtCall('/simulate', rtJson('POST', { start: start || null, sequencing: rt.sequencing || 'priority' }));
        box.replaceChildren();
        rtRenderSim();
        rtRenderOrderList();
        showToast('✓ Simulación de robustez lista');
      } catch (e) { box.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); }
    }

    function rtPct(p: number | null | undefined) { return p == null ? '—' : `${Math.round(p * 100)}%`; }
    function rtPctCls(p: number | null | undefined) { return p == null ? '' : p >= 0.9 ? 'rt-ok' : p >= 0.6 ? 'rt-warn' : 'rt-bad'; }

    function rtRenderSim() {
      const box = document.getElementById('rtSimBox');
      if (!box) return;
      const sim = rt.sim;
      if (!sim) { box.replaceChildren(); return; }
      const s = sim.summary;
      const stat = (v: any, label: string, cls = '') => el('div', { class: 'rt-stat' }, el('b', { class: cls, text: String(v) }), el('span', { text: label }));
      const rows = sim.orders.filter((o: any) => o.p_on_time != null).slice(0, 12);
      box.replaceChildren(el('div', { class: 'rt-box' },
        el('h4', { text: `Robustez Monte Carlo de las OF · ${sim.iterations} escenarios${sim.truncated ? ' (cortado por tiempo)' : ''}` }),
        sim.model?.calibrated ? null : el('div', { class: 'rt-pill rt-pill--warn', style: 'display:inline-block;margin-bottom:.5rem',
          text: 'Averías con parámetros por defecto: se calibrarán con tu historial cuando haya al menos 5 averías resueltas en 12 semanas' }),
        el('div', { class: 'rt-stats' },
          stat(rtPct(s.p_all_on_time), 'Prob. de que todas lleguen a tiempo', rtPctCls(s.p_all_on_time)),
          stat(s.expected_late_orders, 'OF con retraso esperadas', s.expected_late_orders >= 1 ? 'rt-bad' : ''),
          stat(s.at_risk_orders, 'OF con menos del 80% de prob.', s.at_risk_orders ? 'rt-warn' : ''),
          stat(s.most_frequent_bottleneck || '—', 'Recurso que más retrasos causa')),
        s.unreliable_orders ? el('p', { class: 'rt-muted', style: 'margin:-.3rem 0 .6rem', text:
          `${s.unreliable_orders} probabilidad${s.unreliable_orders === 1 ? '' : 'es'} marcada${s.unreliable_orders === 1 ? '' : 's'} con ≈ `
          + `tiene${s.unreliable_orders === 1 ? '' : 'n'} un intervalo de confianza amplio: no cupieron suficientes escenarios en el tiempo disponible. `
          + 'Tómalas como orientativas.' }) : null,
        rows.length ? rtTable(['OF', 'Necesidad', 'Prob. a tiempo', 'Fin P50', 'Fin P90', 'Retraso P90', 'Causa principal'],
          el('tbody', {}, rows.map((o: any) => el('tr', {},
            el('td', {}, el('b', { text: o.order_number })),
            el('td', { text: rtDate(o.due_date) }),
            el('td', { class: `rt-num ${o.p_on_time_reliable === false ? 'rt-muted' : rtPctCls(o.p_on_time)}`,
                       title: o.p_on_time_ci ? `IC95 ${rtPct(o.p_on_time_ci[0])}–${rtPct(o.p_on_time_ci[1])}`
                         + (o.p_on_time_reliable === false ? ' · poco fiable: pocos escenarios en el tiempo disponible' : '') : '',
                       text: (o.p_on_time_reliable === false ? '≈' : '') + rtPct(o.p_on_time) }),
            el('td', { text: rtDt(o.end_p50) }), el('td', { text: rtDt(o.end_p90) }),
            el('td', { class: 'rt-num', text: o.late_h_p90 ? (o.late_h_p90 >= 24 ? `${(o.late_h_p90 / 24).toFixed(1)} días` : `${o.late_h_p90} h`) : '—' }),
            el('td', { text: o.main_cause_resource ? `${o.main_cause_resource} (${rtPct(o.main_cause_share)} de los retrasos)` : '—' })))))
          : el('p', { class: 'rt-muted', text: sim.orders.length
              ? 'Ninguna OF abierta tiene fecha de necesidad: no hay plazo que evaluar.'
              : 'No hay OF abiertas que simular. Créalas o impórtalas desde el MRP.' }),
        el('p', { class: 'rt-muted', style: 'margin:.5rem 0 0', text: 'Cada escenario replanifica todas las OF con duraciones variables (más en laminado manual y NDT, menos en el curado) y averías aleatorias, respetando calendarios, mantenimiento y disrupciones activas. No cambia tu plan guardado.' })));
    }

    async function rtRunPlan(start: string, box: HTMLElement) {
      box.replaceChildren(el('p', { class: 'rt-muted', text: 'Planificando con capacidad finita…' }));
      try {
        rt.plan = await rtCall('/plan', rtJson('POST', { start: start || null, sequencing: rt.sequencing || 'priority' }));
        rt.sim = null; rtRenderSim();
        box.replaceChildren();
        rt.orders = rt.plan.orders;
        rtRenderPlan();
        rtRenderOrderList();
        rtRefreshOverview();
        loadHomeWidgets();
        showToast('✓ Planificación actualizada');
      } catch (e) { box.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); }
    }

    function rtBarOf(op: any) {
      const res = op.subcontracted ? 'Externo' : (op.planned_resource_code || op.resource_code || '?');
      return { s: op.planned_start, e: op.planned_end, label: `${op.code} ${res}`, color: op.subcontracted ? '#64748B' : rtColor(res),
               risk: !!op.risk, title: `${op.code} · ${op.name} · ${res}\n${rtDt(op.planned_start)} → ${rtDt(op.planned_end)}${op.risk_reason ? '\n' + op.risk_reason : ''}` };
    }

    // Gantt-style timeline: one row per OF (or per operation), bars positioned
    // on a shared time axis, the need date as a red line.
    function rtTimeline(rows: any[], ariaLabel: string): HTMLElement {
      const bars = rows.flatMap(r => r.bars).filter((b: any) => b.s && b.e);
      if (!bars.length) return el('p', { class: 'rt-muted', text: 'Sin operaciones planificadas todavía: pulsa «Planificar».' });
      const t0 = Math.min(...bars.map((b: any) => +new Date(b.s)));
      let t1 = Math.max(...bars.map((b: any) => +new Date(b.e)));
      const dl = (d: string) => +new Date(`${String(d).slice(0, 10)}T00:00:00`);
      rows.forEach(r => { if (r.deadline && dl(r.deadline) > t0) t1 = Math.max(t1, dl(r.deadline)); });
      const day0 = new Date(t0); day0.setHours(0, 0, 0, 0);
      const span = Math.max(3600000, t1 - +day0);
      const days = Math.max(1, Math.ceil(span / 86400000));
      const pct = (t: number) => Math.max(0, Math.min(100, (t - +day0) / span * 100));
      const every = Math.max(1, Math.ceil(days / 30));
      const ticks = (labels: boolean) => Array.from({ length: days }, (_, i) => {
        const d = new Date(+day0 + i * 86400000);
        return i % every ? null : el('div', { class: 'rt-tl__day', style: `left:${pct(+d)}%`,
          text: labels ? d.toLocaleDateString('es-ES', { weekday: 'short', day: '2-digit', month: '2-digit' }) : '' });
      });
      return el('div', { class: 'rt-tl', role: 'group', 'aria-label': ariaLabel },
        el('div', { class: 'rt-tl__inner', style: `min-width:${Math.min(4200, Math.max(620, 130 + Math.ceil(days / every) * 80))}px` },
          el('div', { class: 'rt-tl__row rt-tl__row--scale' }, el('div', { class: 'rt-tl__label' }), el('div', { class: 'rt-tl__track' }, ticks(true))),
          rows.map(r => el('div', { class: 'rt-tl__row' },
            el('div', { class: 'rt-tl__label', title: r.sub ? `${r.label} · ${r.sub}` : r.label }, el('b', { text: r.label }), r.sub ? el('span', { class: 'rt-muted', text: ` ${r.sub}` }) : null),
            el('div', { class: 'rt-tl__track' }, ticks(false),
              r.deadline ? el('div', { class: 'rt-tl__deadline', style: `left:${pct(dl(r.deadline))}%`, title: `Fecha de necesidad ${rtDate(r.deadline)}` }) : null,
              r.bars.filter((b: any) => b.s && b.e).map((b: any) => {
                const s = +new Date(b.s), e = +new Date(b.e);
                return el('div', { class: `rt-tl__bar${b.risk ? ' rt-tl__bar--risk' : ''}`, title: b.title, text: b.label,
                  style: `left:${pct(s)}%;width:${Math.max(0.2, (e - s) / span * 100)}%;background:${b.color}` });
              }))))));
    }

    const RT_SEQ: Record<string, string> = { priority: 'por prioridad', due_date: 'por fecha de necesidad' };

    // Every plan is also computed with the other sequencing rule (in memory).
    // When that one delivers more OFs on time, say it with the numbers and offer it.
    function rtSequencingHint(plan: any, box: HTMLElement) {
      const c = plan?.sequencing_comparison;
      if (!c?.other_is_better) return null;
      const bad = (x: any) => (x.late || 0) + (x.unplanned || 0);
      const gain = bad(c.current) - bad(c.other);
      return el('div', { class: 'rt-alert', style: 'display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin:.2rem 0 .8rem' },
        el('span', { style: 'flex:1 1 18rem', text: `Con la secuencia ${RT_SEQ[c.other.sequencing]} llegarían a tiempo ${gain} `
          + `${gain === 1 ? 'orden de fabricación más' : 'órdenes de fabricación más'} `
          + `(retrasadas o sin planificar: ${bad(c.current)} → ${bad(c.other)}).` }),
        rtBtn(`Planificar ${RT_SEQ[c.other.sequencing]}`, async () => {
          rt.sequencing = c.other.sequencing;
          await rtRunPlan(String(plan.plan_start || '').slice(0, 16), box);
          rtRenderOrders();
        }));
    }

    function rtRenderPlan() {
      const box = document.getElementById('rtPlanBox');
      if (!box) return;
      if (!rt.plan) { box.replaceChildren(); return; }
      const s = rt.plan.summary, cap = rt.plan.capacity.filter((c: any) => c.required_h || c.status === 'NO_CALENDAR');
      const stat = (v: any, label: string, cls = '') => el('div', { class: 'rt-stat' }, el('b', { class: cls, text: String(v) }), el('span', { text: label }));
      const capPill = (c: any) => c.status === 'OVERLOAD' ? el('span', { class: 'rt-pill rt-pill--bad', text: `SOBRECARGA +${c.overload_h} h` })
        : c.status === 'HIGH' ? el('span', { class: 'rt-pill rt-pill--warn', text: 'Carga alta' })
        : c.status === 'NO_CALENDAR' ? el('span', { class: 'rt-pill rt-pill--warn', text: `Sin calendario (${RT_MISSING})` })
        : el('span', { class: 'rt-pill rt-pill--ok', text: 'OK' });
      const over = cap.filter((c: any) => c.status === 'OVERLOAD');
      box.replaceChildren(el('div', { class: 'rt-box' },
        el('h4', { text: `Plan desde ${rtDt(rt.plan.period.start)} · capacidad evaluada hasta ${rtDt(rt.plan.period.end)}`
          + ` · secuencia ${RT_SEQ[rt.plan.sequencing] || RT_SEQ.priority}` }),
        rtSequencingHint(rt.plan, box),
        el('div', { class: 'rt-stats' },
          stat(s.on_time_pct == null ? '—' : `${s.on_time_pct}%`, `OF en plazo (${s.on_time} de ${s.orders_with_due_date} con fecha)`,
               s.on_time_pct == null ? '' : s.on_time_pct >= 95 ? 'rt-ok' : 'rt-bad'),
          stat(s.at_risk, 'En riesgo', s.at_risk ? 'rt-warn' : ''), stat(s.late, 'Retrasadas', s.late ? 'rt-bad' : ''),
          stat(s.unplanned, 'Sin planificar', s.unplanned ? 'rt-bad' : '')),
        el('h4', { style: 'margin-top:.4rem', text: 'Capacidad por recurso en el periodo' }),
        cap.length ? rtTable(['Recurso', 'Necesarias', 'Disponibles', 'Carga', 'Estado', ''], el('tbody', {}, cap.map((c: any) => el('tr', { title: c.message },
          el('td', {}, el('b', { text: c.resource })), el('td', { class: 'rt-num', text: `${c.required_h} h` }),
          el('td', { class: 'rt-num', text: c.available_h == null ? RT_MISSING : `${c.available_h} h` }),
          el('td', { class: 'rt-num', text: c.load_pct == null ? '—' : `${c.load_pct}%` }), el('td', {}, capPill(c)),
          el('td', {}, c.status === 'OVERLOAD' || c.status === 'NO_CALENDAR' ? rtAskCopilot('¿Por qué?',
            c.status === 'OVERLOAD' ? `¿Por qué está sobrecargado ${c.resource}, qué OF afecta y cómo lo soluciono?`
              : `¿Qué pasa con ${c.resource}, que no tiene calendario?`, 'check_capacity',
            { resource_id: c.resource_id, label: `Recurso ${c.resource}` }) : null)))))
          : el('p', { class: 'rt-muted', text: 'Ninguna OF con fecha de necesidad dentro del periodo consume capacidad.' }),
        over.length ? el('ul', { class: 'rt-bad', style: 'margin:.5rem 0 0;padding-left:1rem' }, over.map((c: any) => el('li', { text: c.message }))) : null,
        el('h4', { style: 'margin-top:.9rem', text: 'Secuencia planificada' }),
        rtTimeline(rt.plan.orders.filter((o: any) => o.planned_start).map((o: any) => ({ label: o.order_number, sub: o.part_number, deadline: o.due_date,
          bars: o.operations.filter((op: any) => !['COMPLETED', 'CANCELLED'].includes(op.status)).map(rtBarOf) })), 'Diagrama de Gantt de las OF planificadas')));
    }

    function rtRenderOrderList() {
      const box = document.getElementById('rtOrdersBox');
      if (!box) return;
      if (!rt.orders.length) {
        box.replaceChildren(el('div', { class: 'rt-box' },
          el('p', { text: 'No hay OF abiertas. Crea una OF con su pieza o genera las OF desde el MRP cargado.' }),
          el('p', { class: 'rt-muted', style: 'margin-top:.3rem', text: 'Cada OF recibe automáticamente las operaciones de la ruta liberada de su pieza (pestaña «Rutas por pieza»).' })));
        return;
      }
      const tbody = el('tbody');
      const simBy: Record<number, any> = {};
      (rt.sim?.orders || []).forEach((x: any) => { simBy[x.id] = x; });
      const withSim = !!rt.sim;
      rt.orders.forEach((o: any) => {
        const open = rt.openOrder === o.id;
        const toggle = () => { rt.openOrder = open ? null : o.id; if (open) setCopilotFocus(null); rtRenderOrderList(); };
        tbody.appendChild(el('tr', { class: 'rt-click', tabindex: '0', 'aria-expanded': String(open), onclick: toggle,
            onkeydown: (e: KeyboardEvent) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } } },
          el('td', { 'data-label': 'OF' }, el('b', { text: o.order_number })),
          el('td', { 'data-label': 'Pieza · ruta' }, o.part_number ? `${o.part_number}${o.routing_version ? ' · V' + o.routing_version : ''}` : el('span', { class: 'rt-bad', text: 'Sin pieza' })),
          el('td', { 'data-label': 'Cantidad', class: 'rt-num', text: `${o.quantity}${o.unit ? ' ' + o.unit : ''}` }),
          el('td', { 'data-label': 'Ruta' }, o.route.length ? o.route.join(' → ') : rtPill(RT_QUALITY, 'ERROR')),
          el('td', { 'data-label': 'Necesidad', text: rtDate(o.due_date) }),
          el('td', { 'data-label': 'Fin planificado', text: rtDt(o.planned_end) }),
          el('td', { 'data-label': 'Estado', text: RT_STATUS[o.execution_status] || o.execution_status }),
          el('td', { 'data-label': 'Riesgo' }, o.risk ? rtPill(RT_RISK, o.risk) : el('span', { class: 'rt-muted', text: 'Sin planificar aún' })),
          withSim ? el('td', { 'data-label': 'Prob. a tiempo',
            class: `rt-num ${simBy[o.id]?.p_on_time_reliable === false ? 'rt-muted' : rtPctCls(simBy[o.id]?.p_on_time)}`,
            text: (simBy[o.id]?.p_on_time_reliable === false ? '≈' : '') + rtPct(simBy[o.id]?.p_on_time) }) : null));
        if (open) tbody.appendChild(el('tr', { class: 'rt-detail-row' },
          el('td', { colspan: withSim ? '9' : '8', id: `rtOrder-${o.id}` }, el('p', { class: 'rt-muted', text: 'Cargando OF…' }))));
      });
      box.replaceChildren(el('h4', { style: 'margin:.4rem 0', text: `Órdenes de fabricación abiertas (${rt.orders.length})` }),
        rtTable(['OF', 'Pieza · ruta', 'Cantidad', 'Ruta', 'Necesidad', 'Fin planificado', 'Estado', 'Riesgo', ...(withSim ? ['Prob. a tiempo'] : [])], tbody, 'rt-table rt-table--cards'));
      if (rt.openOrder) rtLoadOrderDetail(rt.openOrder);
    }

    async function rtLoadOrderDetail(id: number) {
      const cell = document.getElementById(`rtOrder-${id}`);
      if (!cell) return;
      try {
        const o = await rtCall(`/orders/${id}`);
        const fromPlan = (rt.plan?.orders || []).find((x: any) => x.id === id);
        document.getElementById(`rtOrder-${id}`)?.replaceChildren(rtOrderCard(o, fromPlan));
        setCopilotFocus({ order_id: o.id, label: o.order_number });
      } catch (e) { cell.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); }
    }

    function rtOrderCard(o: any, fromPlan: any): HTMLElement {
      const waits: Record<number, any[]> = {};
      (fromPlan?.operations || []).forEach((op: any) => { if (op.waits?.length) waits[op.id] = op.waits; });
      const ops = [...o.operations].sort((a: any, b: any) => a.sequence - b.sequence);
      const patch = async (body: any, ok: string) => { await rtCall(`/orders/${o.id}`, rtJson('PATCH', body)); showToast(ok); await rtReloadOrders(); };
      const reroute = async (ok: string) => { await rtCall(`/orders/${o.id}/reroute`, { method: 'POST' }); showToast(ok); await rtReloadOrders(); };
      const started = ops.some((x: any) => ['IN_PROGRESS', 'COMPLETED'].includes(x.status));
      const actions = el('div', { class: 'rt-actions' },
        o.status === 'planned' && o.routing_status !== 'ERROR' && ops.length ? rtBtn('Lanzar a planta', () => patch({ status: 'released' }, `✓ OF ${o.order_number} lanzada`), 'btn-ui--primary') : null,
        o.status === 'released' && !started ? rtBtn('Volver a planificada', () => patch({ status: 'planned' }, 'OF devuelta a planificada')) : null,
        o.newer_released_version && o.lifecycle === 'planned' && !started ? rtBtn(`Pasar a la ruta V${o.newer_released_version}`, () => reroute(`OF ${o.order_number} regenerada con la ruta V${o.newer_released_version}`)) : null,
        o.routing_status === 'ERROR' && o.part_number && o.lifecycle === 'planned' ? rtBtn('Reintentar asignación de ruta', () => reroute('Ruta reasignada')) : null,
        o.lifecycle !== 'historical' ? rtConfirmBtn('Cancelar OF', 'Confirmar cancelación', () => patch({ status: 'cancelled' }, `OF ${o.order_number} cancelada`)) : null,
        o.status === 'planned' && !started ? rtConfirmBtn('Borrar OF', 'Confirmar borrado', async () => {
          await rtCall(`/orders/${o.id}`, { method: 'DELETE' }); showToast(`OF ${o.order_number} borrada`); rt.openOrder = null; await rtReloadOrders(); }) : null,
        rtAskCopilot(o.risk && o.risk !== 'on_time' ? '¿Por qué? Preguntar al copiloto' : 'Preguntar al copiloto',
          o.risk === 'late' ? `¿Por qué se retrasa la ${o.order_number} y cómo puedo evitarlo?`
            : o.risk === 'unplanned' ? `¿Por qué no se puede planificar la ${o.order_number} y qué falta?`
            : o.risk === 'at_risk' ? `¿Por qué está en riesgo la ${o.order_number}?` : `Explícame la ${o.order_number}: ruta, capacidad y riesgos.`,
          o.risk === 'late' ? 'why_delayed' : 'whats_wrong', { order_id: o.id, label: o.order_number }));
      let assign: HTMLElement | null = null;
      if (!o.part_number && o.lifecycle === 'planned') {
        const sel = el('select', { class: 'rt-in' }, el('option', { value: '', text: '— Selecciona la pieza —' }),
          rt.parts.map((p: any) => el('option', { value: String(p.id), text: p.part_number }))) as HTMLSelectElement;
        assign = el('div', { class: 'rt-bar' }, el('label', {}, 'Asignar pieza', sel), rtBtn('Asignar y generar operaciones', async () => {
          if (!sel.value) throw new Error('Selecciona una pieza.');
          await patch({ part_id: Number(sel.value) }, 'Pieza asignada: operaciones generadas con su ruta');
        }, 'btn-ui--primary'));
      }
      const chain = el('div', { class: 'rt-route', 'aria-label': 'Ruta de fabricación de la OF' }, ops.flatMap((op: any, i: number) => [
        i ? el('span', { class: 'rt-route__arrow', 'aria-hidden': 'true', text: '→' }) : null,
        el('span', { class: 'rt-route__op' + (op.status === 'COMPLETED' ? ' rt-route__op--done' : '') + (op.status === 'IN_PROGRESS' ? ' rt-route__op--run' : '')
            + (op.risk ? ' rt-route__op--risk' : '') + (op.status === 'CANCELLED' || (op.status === 'BLOCKED' && op.optional) ? ' rt-route__op--skip' : '') },
          el('b', { text: String(op.sequence) }), ` ${op.name}`,
          el('small', { text: `${op.subcontracted ? 'Subcontratada' : (op.resource_code || RT_MISSING)} · ${RT_STATUS[op.status] || op.status}` }))]));
      const t = o.totals;
      return el('div', { class: 'rt-box', style: 'margin:.3rem 0 0' },
        el('div', { class: 'rt-bar', style: 'justify-content:space-between;margin-bottom:.4rem' },
          el('div', {}, el('h4', { style: 'margin:0', text: o.order_number }),
            el('span', { class: 'rt-muted', text: `${o.part_number ? 'Pieza ' + o.part_number + (o.part_name && o.part_name !== o.part_number ? ' · ' + o.part_name : '') : 'Sin pieza'} · Cantidad ${o.quantity}${o.unit ? ' ' + o.unit : ''} · Necesidad ${rtDate(o.due_date)} · Prioridad ${o.priority}` })),
          el('div', { class: 'rt-bar', style: 'margin:0' }, el('span', { class: 'rt-pill rt-pill--mute', text: RT_LIFE[o.lifecycle] || o.lifecycle }),
            el('span', { class: 'rt-pill rt-pill--mute', text: RT_STATUS[o.execution_status] || o.execution_status }), o.risk ? rtPill(RT_RISK, o.risk) : null)),
        o.risk_reason ? el('p', { class: o.risk === 'on_time' ? 'rt-why' : 'rt-alert', text: o.risk_reason }) : null,
        el('p', { class: 'rt-why' }, el('b', { text: '¿Por qué estas operaciones? ' }), o.explanation?.routing || ''),
        o.routing_issues?.length ? el('div', { class: o.routing_status === 'ERROR' ? 'rt-alert' : 'rt-alert rt-alert--warn' },
          el('b', { text: o.routing_status === 'ERROR' ? 'ERROR DE RUTA' : 'Avisos de la ruta (WARNING)' }),
          el('ul', { style: 'margin:.2rem 0 0;padding-left:1rem' }, o.routing_issues.map((i: any) => el('li', { text: i.message })))) : null,
        o.newer_released_version && (o.lifecycle !== 'planned' || started) ? el('p', { class: 'rt-muted', text: `Existe la ruta V${o.newer_released_version}; esta OF conserva la V${o.routing_version} con la que se creó (${o.lifecycle === 'historical' ? 'OF histórica' : started ? 'ya tiene operaciones iniciadas' : 'OF ya lanzada'}).` }) : null,
        assign,
        ops.length ? chain : null,
        ops.some((op: any) => op.planned_start) ? rtTimeline(ops.filter((op: any) => op.planned_start && op.planned_end).map((op: any) => ({ label: op.code, sub: op.name, deadline: o.due_date, bars: [rtBarOf(op)] })), `Operaciones planificadas de ${o.order_number}`) : null,
        t && ops.length ? el('p', { class: 'rt-muted', text: `Tiempos de la OF (por separado): setup ${rtMin(t.setup_min)} · proceso ${rtMin(t.processing_min)} · cola ${rtMin(t.queue_min)} · transferencia ${rtMin(t.transfer_min)}${t.external_min ? ' · subcontratación ' + rtMin(t.external_min) : ''}${t.missing.length ? ' · Datos faltantes: ' + t.missing.join(', ') : ''}` }) : null,
        ops.map((op: any) => rtOpCard(o, op, waits[op.id] || [])),
        actions);
    }

    function rtOpCard(o: any, op: any, waits: any[]): HTMLElement {
      const t = op.times, cap = op.resource_capacity;
      const kv = (k: string, v: any) => el('div', {}, el('span', { text: k }), v);
      const why = o.explanation?.operations?.[op.id];
      const riskPill = op.risk === 'capacity' ? el('span', { class: 'rt-pill rt-pill--bad', text: '⚠ Riesgo de capacidad' })
        : op.risk === 'late' ? el('span', { class: 'rt-pill rt-pill--bad', text: 'Fuera de plazo' })
        : op.risk === 'unplanned' ? el('span', { class: 'rt-pill rt-pill--bad', text: 'Sin planificar' }) : null;
      return el('details', { class: 'rt-op', ontoggle: (e: Event) => {
          const open = (e.currentTarget as HTMLDetailsElement).open;
          setCopilotFocus(open ? { order_id: o.id, operation_id: op.id, label: `${o.order_number} · ${op.code}` }
                               : { order_id: o.id, label: o.order_number });
        } },
        el('summary', {}, el('b', { text: op.code }), el('span', { text: op.name }),
          el('span', { class: 'rt-muted', text: op.subcontracted ? 'Subcontratada' : (op.planned_resource_code || op.resource_code || RT_MISSING) }),
          el('span', { class: 'rt-pill rt-pill--mute', text: RT_STATUS[op.status] || op.status }), riskPill,
          op.optional ? el('span', { class: 'rt-pill rt-pill--mute', text: 'Opcional' }) : null,
          op.quality_gate ? el('span', { class: 'rt-pill rt-pill--info', text: 'Control de calidad' }) : null),
        el('div', { class: 'rt-op__body' },
          why ? el('p', { class: 'rt-why' }, el('b', { text: '¿Por qué está aquí? ' }), why) : null,
          el('div', { class: 'rt-kv' },
            kv('Descripción', op.description || '—'),
            kv('Recurso', op.subcontracted ? 'Proveedor externo' : rtVal(op.resource_code)),
            op.planned_resource_code && op.planned_resource_code !== op.resource_code ? kv('Planificada en (alternativo)', op.planned_resource_code) : null,
            op.alt_resource_codes?.length ? kv('Recursos alternativos', op.alt_resource_codes.join(', ')) : null,
            op.machine ? kv('Máquina', op.machine) : null,
            kv('Cantidad', `${op.quantity}${op.unit ? ' ' + op.unit : ''}`),
            op.subcontracted ? kv('Plazo del proveedor', rtVal(op.external_lead_h, ' h')) : kv('Proceso', rtVal(op.run_min_per_unit, ' min/ud')),
            op.subcontracted ? null : kv('Setup', rtVal(op.setup_min, ' min')),
            op.subcontracted ? null : kv('Proceso total', t.processing_min == null ? rtVal(null) : rtMin(t.processing_min)),
            kv('Cola (antes)', op.queue_min == null ? 'No informada' : rtMin(op.queue_min)),
            kv('Transferencia (después)', op.transfer_min == null ? 'No informada' : rtMin(op.transfer_min)),
            op.subcontracted ? null : kv('Capacidad necesaria', op.required_txt || rtVal(null)),
            op.subcontracted ? null : kv('Disponible del recurso en el periodo', cap ? (cap.available_h == null ? rtVal(null)
              : `${cap.available_h} h · el recurso necesita ${cap.required_h} h en total`) : 'Planifica para calcularlo'),
            kv('Inicio → fin planificado', `${rtDt(op.planned_start)} → ${rtDt(op.planned_end)}`),
            op.actual_start || op.actual_end ? kv('Real', `${rtDt(op.actual_start)} → ${rtDt(op.actual_end)}`) : null,
            kv('Predecesoras', op.predecessor_sequences?.length ? op.predecessor_sequences.map((s: number) => 'OP' + s).join(', ') : 'Ninguna (inicio)')),
          op.risk_reason ? el('p', { class: op.risk ? 'rt-alert' : 'rt-alert rt-alert--warn', text: op.risk_reason }) : null,
          op.block_reason ? el('p', { class: 'rt-alert rt-alert--warn', text: `Bloqueada: ${op.block_reason}` }) : null,
          waits.length && !op.risk_reason ? el('p', { class: 'rt-muted', text: waits.map((w: any) => `Espera ${w.minutes_txt} por ${w.resource} (ocupado por ${w.held_by}).`).join(' ') }) : null,
          rtOpActions(o, op)));
    }

    function rtOpActions(o: any, op: any): HTMLElement | null {
      if (o.lifecycle === 'historical' || ['COMPLETED', 'CANCELLED'].includes(op.status)) return null;
      const send = async (body: any, ok: string) => { await rtCall(`/orders/${o.id}/operations/${op.id}`, rtJson('PATCH', body)); showToast(ok); await rtReloadOrders(); };
      const box = el('div', { class: 'rt-actions' });
      if (op.status === 'BLOCKED') box.append(rtBtn('Desbloquear', () => send({ status: 'NOT_STARTED' }, `${op.code} desbloqueada`)));
      else {
        if (o.status === 'released' && op.status !== 'IN_PROGRESS') box.append(rtBtn('Iniciar', () => send({ status: 'IN_PROGRESS' }, `${op.code} en curso`), 'btn-ui--primary'));
        if (o.status === 'released') box.append(rtBtn('Terminar', () => send({ status: 'COMPLETED' }, `✓ ${op.code} terminada`)));
        const reason = el('input', { class: 'rt-in', maxlength: '250', placeholder: 'Motivo del bloqueo', 'aria-label': `Motivo del bloqueo de ${op.code}` }) as HTMLInputElement;
        box.append(reason, rtBtn('Bloquear', async () => {
          if (!reason.value.trim()) { reason.setAttribute('aria-invalid', 'true'); throw new Error('Indica el motivo del bloqueo.'); }
          await send({ status: 'BLOCKED', block_reason: reason.value.trim() }, `${op.code} bloqueada`);
        }));
        if (o.status !== 'released') box.append(el('span', { class: 'rt-muted', text: 'Lanza la OF para registrar inicio y fin.' }));
      }
      if (op.optional) box.append(rtConfirmBtn('Cancelar (opcional)', 'Confirmar', () => send({ status: 'CANCELLED' }, `${op.code} cancelada`)));
      const ask = rtAskCopilot('Preguntar al copiloto', op.risk ? `¿Por qué ${op.code} de la ${o.order_number} tiene riesgo y qué puedo hacer?`
        : `Explícame ${op.code} de la ${o.order_number}: tiempos, recurso y capacidad.`, op.risk ? 'whats_wrong' : 'explain_plan',
        { order_id: o.id, operation_id: op.id, label: `${o.order_number} · ${op.code}` });
      if (ask) box.append(ask);
      return box;
    }

    // ── Rutas por pieza ──
    async function rtLoadParts() {
      const body = rtBody();
      body.replaceChildren(el('p', { class: 'rt-muted', text: 'Cargando piezas y rutas…' }));
      try { [rt.parts, rt.resources] = await Promise.all([rtCall('/parts'), rtCall('/resources')]); }
      catch (e) { body.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); return; }
      if (rt.view === 'parts') rtRenderParts();
    }

    function rtRenderParts() {
      const form = el('div', { class: 'rt-box', hidden: 'hidden' });
      const tbody = el('tbody', {}, rt.parts.map((p: any) => {
        const q = p.quality || {};
        const rel = p.versions.find((v: any) => v.status === 'released');
        const first = (q.issues || [])[0];
        const open = () => { rt.openRouting = null; rtOpenPart(p.id); };
        return el('tr', { class: 'rt-click', tabindex: '0', 'aria-expanded': String(rt.openPart === p.id), onclick: open,
            onkeydown: (e: KeyboardEvent) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } } },
          el('td', { 'data-label': 'Pieza' }, el('b', { text: p.part_number })),
          el('td', { 'data-label': 'Nombre', text: p.name || '—' }),
          el('td', { 'data-label': 'Unidad', text: p.unit || '—' }),
          el('td', { 'data-label': 'Ruta liberada' }, rel ? `V${rel.version}` : el('span', { class: 'rt-bad', text: 'Ninguna' }),
            p.versions.some((v: any) => v.status === 'draft') ? el('span', { class: 'rt-muted', text: ' · borrador' }) : null),
          el('td', { 'data-label': 'Estado de datos' }, rtPill(RT_QUALITY, q.status), first ? el('div', { class: 'rt-muted', style: 'font-size:.72rem;margin-top:.2rem', text: first.message }) : null),
          el('td', { 'data-label': 'Operaciones', class: 'rt-num', text: String(q.operations ?? 0) }),
          el('td', { 'data-label': 'Recursos', class: 'rt-num', text: q.resources ? `${q.resources.ok}/${q.resources.total}` : '—' }),
          el('td', { 'data-label': 'Tiempos', class: 'rt-num', text: q.times ? `${q.times.ok}/${q.times.total}` : '—' }),
          el('td', { 'data-label': 'Dependencias', class: 'rt-num', text: q.dependencies ? `${q.dependencies.ok}/${q.dependencies.total}` : '—' }));
      }));
      rtBody().replaceChildren(
        el('div', { class: 'rt-bar' },
          el('button', { class: 'btn-ui btn-ui--primary', type: 'button', text: 'Nueva pieza', onclick: () => { form.hidden = !form.hidden; if (!form.hidden) rtPartForm(form); } }),
          el('button', { class: 'btn-ui', type: 'button', text: 'Crear desde un tipo de pieza', onclick: () => { form.hidden = false; rtFromPieceType(form); } })),
        el('p', { class: 'rt-muted', style: 'margin:-.3rem 0 .8rem', text: 'Cada pieza tiene su propia ruta (secuencia de operaciones con recurso y tiempos). Las versiones liberadas no se modifican: un cambio es una nueva versión, y cada OF conserva la versión con la que se creó.' }),
        form,
        rt.parts.length ? rtTable(['Pieza', 'Nombre', 'Unidad', 'Ruta liberada', 'Estado de datos', 'Operaciones', 'Recursos', 'Tiempos', 'Dependencias'], tbody, 'rt-table rt-table--cards')
          : el('div', { class: 'rt-box' }, el('p', { text: 'Aún no hay piezas. Crea una pieza y define su ruta de fabricación.' })),
        el('div', { id: 'rtRoutingBox', style: 'margin-top:1rem' }));
      if (rt.openPart) rtOpenPart(rt.openPart);
    }

    function rtPartForm(box: HTMLElement) {
      const num = el('input', { class: 'rt-in', maxlength: '60', placeholder: 'PART-001' }) as HTMLInputElement;
      const name = el('input', { class: 'rt-in', maxlength: '160' }) as HTMLInputElement;
      const unit = el('input', { class: 'rt-in', maxlength: '20', placeholder: 'ud, kg, m…' }) as HTMLInputElement;
      const desc = el('input', { class: 'rt-in', maxlength: '500' }) as HTMLInputElement;
      box.replaceChildren(el('h4', { text: 'Nueva pieza' }), el('div', { class: 'rt-form' },
        el('label', {}, 'Nº de pieza', num), el('label', {}, 'Nombre', name), el('label', {}, 'Unidad', unit), el('label', {}, 'Descripción', desc),
        rtBtn('Crear pieza', async () => {
          if (!num.value.trim()) throw new Error('Indica el número de pieza.');
          const p = await rtCall('/parts', rtJson('POST', { part_number: num.value.trim(), name: name.value.trim() || null,
            unit: unit.value.trim() || null, description: desc.value.trim() || null }));
          showToast(`✓ Pieza ${p.part_number} creada: define ahora su ruta`);
          rt.openPart = p.id; rt.openRouting = null;
          await rtLoadParts(); rtRefreshOverview();
        }, 'btn-ui--primary')));
    }

    async function rtFromPieceType(box: HTMLElement) {
      box.replaceChildren(el('p', { class: 'rt-muted', text: 'Cargando tipos de pieza…' }));
      let pts: any[] = [];
      try { pts = await apiJson('/api/piece-types'); } catch (e) { box.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); return; }
      const sel = el('select', { class: 'rt-in' }, pts.map((p: any) => el('option', { value: String(p.id),
        text: `${p.name} · ATL ${p.atl_hours} h · autoclave ${p.autoclave_hours} h · NDT ${p.ndt_hours} h · CNC ${p.cnc_hours} h` }))) as HTMLSelectElement;
      box.replaceChildren(el('h4', { text: 'Crear pieza y ruta desde un tipo de pieza' }),
        el('p', { class: 'rt-muted', style: 'margin:0 0 .6rem', text: 'Convierte las horas ATL / autoclave / NDT / CNC del tipo de pieza en una ruta V1 en borrador. No se inventa nada: el setup queda como DATO FALTANTE y cada operación usa el recurso con el mismo código si existe. Revísala y libérala.' }),
        pts.length ? el('div', { class: 'rt-bar' }, sel, rtBtn('Crear pieza y ruta V1', async () => {
          const res = await rtCall('/parts/from-piece-type', rtJson('POST', { piece_type_id: Number(sel.value) }));
          showToast(`✓ ${res.part.part_number}: ruta V1 en borrador creada`);
          rt.openPart = res.part.id; rt.openRouting = res.routing.id;
          await rtLoadParts(); rtRefreshOverview();
        }, 'btn-ui--primary')) : el('p', { text: 'No hay tipos de pieza.' }));
    }

    async function rtOpenPart(pid: number) {
      rt.openPart = pid;
      document.querySelectorAll('#rtBody tbody tr.rt-click').forEach(tr => tr.setAttribute('aria-expanded', 'false'));
      const box = document.getElementById('rtRoutingBox');
      if (!box) return;
      box.replaceChildren(el('p', { class: 'rt-muted', text: 'Cargando ruta…' }));
      let versions: any[] = [];
      try { versions = await rtCall(`/parts/${pid}/routings`); }
      catch (e) { box.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); return; }
      const part = rt.parts.find((p: any) => p.id === pid) || versions[0]?.part;
      if (!part) return;
      const cur = versions.find(v => v.id === rt.openRouting) || versions.find(v => v.status === 'draft')
        || versions.find(v => v.status === 'released') || versions[0];
      rt.openRouting = cur ? cur.id : null;
      box.replaceChildren(rtRoutingPanel(part, versions, cur));
      setCopilotFocus({ part_id: part.id, label: `Pieza ${part.part_number}` });
    }

    async function rtAfterRoutingChange(ok: string) {
      showToast(ok);
      rt.parts = await rtCall('/parts');
      rtRenderParts();
      rtRefreshOverview();
    }

    function rtRoutingPanel(part: any, versions: any[], cur: any): HTMLElement {
      const hasDraft = versions.some(v => v.status === 'draft');
      const head = el('div', { class: 'rt-bar', style: 'justify-content:space-between' },
        el('h4', { style: 'margin:0', text: `Ruta de fabricación · ${part.part_number}` }),
        el('div', { class: 'rt-bar', style: 'margin:0' },
          rtAskCopilot('Preguntar al copiloto', `Explícame la ruta de ${part.part_number}: por qué tiene estas operaciones, qué datos faltan y qué operación consume más capacidad.`,
            'explain_plan', { part_id: part.id, label: `Pieza ${part.part_number}` }),
          versions.map(v => el('button', { class: `btn-ui${cur && v.id === cur.id ? ' btn-ui--primary' : ''}`, type: 'button', 'aria-pressed': String(!!cur && v.id === cur.id),
            text: `V${v.version} · ${RT_RSTATUS[v.status] || v.status}`, onclick: () => { rt.openRouting = v.id; rtOpenPart(part.id); } })),
          !hasDraft ? rtBtn(cur ? `Nueva versión (copia de V${cur.version})` : 'Crear ruta V1', async () => {
            const nv = await rtCall(`/parts/${part.id}/routings`, rtJson('POST', { copy_from_id: cur ? cur.id : null }));
            rt.openRouting = nv.id;
            await rtAfterRoutingChange(`V${nv.version} creada en borrador`);
          }) : null));
      if (!cur) return el('div', { class: 'rt-box' }, head, el('p', { text: 'Esta pieza aún no tiene ruta: crea la V1 y añade sus operaciones.' }));
      const v = cur.validation;
      const val = el('div', { class: v.status === 'READY' ? 'rt-why' : v.status === 'WARNING' ? 'rt-alert rt-alert--warn' : 'rt-alert' },
        el('div', { class: 'rt-bar', style: 'margin:0' }, rtPill(RT_QUALITY, v.status),
          el('span', { text: `Operaciones: ${v.operations} · Recursos: ${v.resources.ok}/${v.resources.total} · Tiempos: ${v.times.ok}/${v.times.total} · Dependencias: ${v.dependencies.ok}/${v.dependencies.total}` })),
        v.issues.length ? el('ul', { style: 'margin:.3rem 0 0;padding-left:1rem' }, v.issues.map((i: any) => el('li', { text: i.message })))
          : el('p', { style: 'margin:.3rem 0 0', text: 'Ruta completa: lista para generar las operaciones de las OF.' }));
      const meta = el('p', { class: 'rt-muted', style: 'margin:0 0 .5rem', text: `V${cur.version} · ${RT_RSTATUS[cur.status] || cur.status}`
        + (cur.released_at ? ` el ${rtDt(cur.released_at)}` : '') + ` · ${cur.orders_using} OF la usan`
        + (cur.status !== 'draft' ? ' · Solo lectura: para cambiarla crea una nueva versión (las OF existentes conservan la suya).' : '')
        + (cur.notes ? ` · ${cur.notes}` : '') });
      return el('div', { class: 'rt-box' }, head, meta, val, cur.editable ? rtRoutingEditor(part, cur) : rtRoutingReadonly(cur));
    }

    function rtRoutingReadonly(cur: any): HTMLElement {
      const ops = cur.operations;
      return el('div', {},
        el('div', { class: 'rt-route' }, ops.flatMap((op: any, i: number) => [i ? el('span', { class: 'rt-route__arrow', 'aria-hidden': 'true', text: '→' }) : null,
          el('span', { class: 'rt-route__op' }, el('b', { text: String(op.sequence) }), ` ${op.name}`, el('small', { text: op.subcontracted ? 'Subcontratada' : (op.resource_code || RT_MISSING) }))])),
        rtTable(['Op.', 'Operación', 'Recurso', 'Alternativos', 'Setup', 'Proceso', 'Cola', 'Transf.', 'Cant./ud', 'Predecesoras', 'Tipo'], el('tbody', {}, ops.map((op: any) => el('tr', {},
          el('td', {}, el('b', { text: op.code })), el('td', { text: op.name, title: op.description || '' }),
          el('td', {}, op.subcontracted ? 'Externo' : rtVal(op.resource_code)), el('td', { text: op.alt_resource_codes.join(', ') || '—' }),
          el('td', {}, op.subcontracted ? '—' : rtVal(op.setup_min, ' min')), el('td', {}, op.subcontracted ? rtVal(op.external_lead_h, ' h ext.') : rtVal(op.run_min_per_unit, ' min/ud')),
          el('td', { text: op.queue_min == null ? '—' : `${op.queue_min} min` }), el('td', { text: op.transfer_min == null ? '—' : `${op.transfer_min} min` }),
          el('td', { class: 'rt-num', text: String(op.required_qty ?? 1) }),
          el('td', { text: op.predecessor_sequences.length ? op.predecessor_sequences.map((s: number) => 'OP' + s).join(', ') : 'Inicio' }),
          el('td', { text: [op.optional ? 'Opcional' : 'Obligatoria', op.subcontracted ? 'Subcontratada' : '', op.quality_gate ? 'Calidad' : ''].filter(Boolean).join(' · ') }))))));
    }

    function rtRoutingEditor(part: any, cur: any): HTMLElement {
      const tbody = el('tbody');
      const msg = el('div', { 'aria-live': 'polite' });
      const numIn = (v: any, label: string, step = 'any') => el('input', { class: 'rt-in', type: 'number', min: '0', step, value: v == null ? '' : String(v), placeholder: '—', 'aria-label': label }) as HTMLInputElement;
      const addRow = (op: any) => {
        const code = () => `OP${f.sequence.value || '?'}`;
        const f: any = {
          sequence: numIn(op.sequence, 'Secuencia', '1'),
          name: el('input', { class: 'rt-in', value: op.name || '', maxlength: '120', placeholder: 'Mecanizado', 'aria-label': 'Operación' }),
          description: el('input', { class: 'rt-in', value: op.description || '', maxlength: '500', 'aria-label': 'Descripción' }),
          resource_id: el('select', { class: 'rt-in', 'aria-label': 'Recurso' }, el('option', { value: '', text: '— Sin recurso —' }),
            rt.resources.map((r: any) => el('option', { value: String(r.id), text: r.code, selected: r.id === op.resource_id ? 'selected' : null }))),
          alt: el('select', { class: 'rt-in', multiple: 'multiple', size: '2', 'aria-label': 'Recursos alternativos' },
            rt.resources.map((r: any) => el('option', { value: String(r.id), text: r.code, selected: (op.alt_resource_ids || []).includes(r.id) ? 'selected' : null }))),
          machine: el('input', { class: 'rt-in', value: op.machine || '', maxlength: '60', 'aria-label': 'Máquina' }),
          setup_min: numIn(op.setup_min, 'Setup (min)'), run_min_per_unit: numIn(op.run_min_per_unit, 'Proceso (min/ud)'),
          queue_min: numIn(op.queue_min, 'Cola (min)'), transfer_min: numIn(op.transfer_min, 'Transferencia (min)'),
          required_qty: numIn(op.required_qty ?? 1, 'Cantidad por unidad de OF'),
          unit: el('input', { class: 'rt-in', value: op.unit || '', maxlength: '20', placeholder: part.unit || '', 'aria-label': 'Unidad' }),
          // Existing operations show their stored predecessors explicitly ("-" = none), so saving never changes them silently.
          preds: el('input', { class: 'rt-in', value: op.predecessor_sequences ? (op.predecessor_sequences.length ? op.predecessor_sequences.join(', ') : '-') : '',
            placeholder: 'anterior', 'aria-label': 'Predecesoras', title: 'Secuencias separadas por comas. Vacío = la operación anterior. «-» = ninguna (puede ir en paralelo).' }),
          optional: el('input', { type: 'checkbox', checked: op.optional ? 'checked' : null, 'aria-label': 'Opcional' }),
          subcontracted: el('input', { type: 'checkbox', checked: op.subcontracted ? 'checked' : null, 'aria-label': 'Subcontratada' }),
          external_lead_h: numIn(op.external_lead_h, 'Plazo externo (h)'),
          quality_gate: el('input', { type: 'checkbox', checked: op.quality_gate ? 'checked' : null, 'aria-label': 'Control de calidad' }),
        };
        const tr = el('tr', {}, ['sequence', 'name', 'description', 'resource_id', 'alt', 'machine', 'setup_min', 'run_min_per_unit', 'queue_min',
          'transfer_min', 'required_qty', 'unit', 'preds', 'optional', 'subcontracted', 'external_lead_h', 'quality_gate'].map(k => el('td', {}, f[k])),
          el('td', {}, el('button', { class: 'btn-ui', type: 'button', text: '×', 'aria-label': 'Quitar operación', title: 'Quitar operación', onclick: () => tr.remove() })));
        (tr as any)._f = f;
        (tr as any)._code = code;
        tbody.appendChild(tr);
      };
      cur.operations.forEach(addRow);
      const collect = () => {
        const ops: any[] = [], errs: string[] = [];
        tbody.querySelectorAll('tr').forEach((tr: any) => {
          const f = tr._f;
          const n = (i: HTMLInputElement) => i.value.trim() === '' ? null : Number(i.value);
          const seq = n(f.sequence);
          if (seq == null || !Number.isInteger(seq) || seq < 1) errs.push('Hay una operación sin número de secuencia válido (entero mayor que 0).');
          if (!f.name.value.trim()) errs.push(`${tr._code()}: falta el nombre de la operación.`);
          const pv = f.preds.value.trim();
          let preds: number[] | null = null;
          if (pv === '-') preds = [];
          else if (pv) {
            preds = pv.split(/[,;\s]+/).filter(Boolean).map((x: string) => Number(x.replace(/^op/i, '')));
            if (preds!.some(x => !Number.isInteger(x))) errs.push(`${tr._code()}: predecesoras no válidas («${pv}»). Usa números de secuencia separados por comas.`);
          }
          ops.push({ sequence: seq, name: f.name.value.trim(), description: f.description.value.trim() || null,
            resource_id: f.resource_id.value ? Number(f.resource_id.value) : null,
            alt_resource_ids: Array.from(f.alt.selectedOptions as HTMLCollectionOf<HTMLOptionElement>).map(o => Number(o.value)),
            machine: f.machine.value.trim() || null, setup_min: n(f.setup_min), run_min_per_unit: n(f.run_min_per_unit),
            queue_min: n(f.queue_min), transfer_min: n(f.transfer_min), required_qty: n(f.required_qty) ?? 1,
            unit: f.unit.value.trim() || null, predecessors: preds, optional: f.optional.checked,
            subcontracted: f.subcontracted.checked, external_lead_h: n(f.external_lead_h), quality_gate: f.quality_gate.checked });
        });
        return { ops, errs };
      };
      const save = async () => {
        const { ops, errs } = collect();
        if (errs.length) {
          msg.replaceChildren(el('div', { class: 'rt-alert' }, el('b', { text: 'No se ha guardado:' }), el('ul', { style: 'margin:.2rem 0 0;padding-left:1rem' }, errs.map(x => el('li', { text: x })))));
          throw new Error('Revisa las operaciones marcadas.');
        }
        await rtCall(`/routings/${cur.id}/operations`, rtJson('PUT', { operations: ops }));
      };
      return el('div', {},
        el('p', { class: 'rt-muted', style: 'margin:.6rem 0 .4rem', text: 'Tiempos en minutos (proceso por unidad). Deja vacío lo que no sepas: aparecerá como DATO FALTANTE y la validación dirá si impide planificar. Cola = espera antes de la operación; transferencia = traslado a la siguiente.' }),
        rtTable(['Sec.', 'Operación', 'Descripción', 'Recurso', 'Alternativos', 'Máquina', 'Setup (min)', 'Proceso (min/ud)', 'Cola (min)', 'Transf. (min)',
          'Cant./ud', 'Unidad', 'Predecesoras', 'Opc.', 'Subc.', 'Plazo ext. (h)', 'Calidad', ''], tbody, 'rt-table rt-edit'),
        el('div', { class: 'rt-actions' },
          el('button', { class: 'btn-ui', type: 'button', text: '+ Añadir operación', onclick: () => {
            const seqs = Array.from(tbody.querySelectorAll('tr')).map((tr: any) => Number(tr._f.sequence.value) || 0);
            addRow({ sequence: (Math.max(0, ...seqs) + 10), required_qty: 1 });
          } }),
          rtBtn('Guardar borrador', async () => { await save(); msg.replaceChildren(); await rtAfterRoutingChange(`✓ V${cur.version} guardada`); }),
          rtBtn(`Liberar V${cur.version}`, async () => {
            await save();
            try { await rtCall(`/routings/${cur.id}/release`, { method: 'POST' }); }
            catch (e: any) {
              const issues = e?.body?.detail?.validation?.issues || [];
              msg.replaceChildren(el('div', { class: 'rt-alert' }, el('b', { text: e.message }),
                el('ul', { style: 'margin:.2rem 0 0;padding-left:1rem' }, issues.filter((i: any) => i.level === 'ERROR').map((i: any) => el('li', { text: i.message })))));
              await rtAfterRoutingChange('Borrador guardado, pero no se puede liberar');
              return;
            }
            await rtAfterRoutingChange(`✓ V${cur.version} liberada: las nuevas OF de ${part.part_number} la usarán`);
          }, 'btn-ui--primary'),
          rtConfirmBtn('Borrar borrador', 'Confirmar borrado', async () => {
            await rtCall(`/routings/${cur.id}`, { method: 'DELETE' }); rt.openRouting = null;
            await rtAfterRoutingChange(`Borrador V${cur.version} borrado`);
          })),
        msg);
    }

    // ── Recursos ──
    async function rtLoadResources() {
      const body = rtBody();
      body.replaceChildren(el('p', { class: 'rt-muted', text: 'Cargando recursos…' }));
      try { rt.resources = await rtCall('/resources'); }
      catch (e) { body.replaceChildren(el('p', { class: 'rt-bad', text: rtErr(e) })); return; }
      if (rt.view === 'resources') rtRenderResources();
    }

    function rtRenderResources() {
      const tbody = el('tbody');
      const result = el('div', { 'aria-live': 'polite' });
      const addRow = (r: any) => {
        const txt = (v: any, label: string, max: string) => el('input', { class: 'rt-in', value: v || '', maxlength: max, 'aria-label': label }) as HTMLInputElement;
        const num = (v: any, label: string, step = 'any') => el('input', { class: 'rt-in', type: 'number', min: '0', step, value: v == null ? '' : String(v), placeholder: '—', 'aria-label': label }) as HTMLInputElement;
        const f: any = {
          code: txt(r.code, 'Código', '40'), name: txt(r.name, 'Nombre', '120'),
          parallel_units: num(r.parallel_units ?? 1, 'Unidades en paralelo', '1'), hours_per_day: num(r.hours_per_day, 'Horas por día'),
          day_start: el('input', { class: 'rt-in', type: 'time', value: r.day_start || '', 'aria-label': 'Hora de inicio' }),
          efficiency_pct: num(r.efficiency_pct ?? 100, 'Eficiencia %'),
          active: el('input', { type: 'checkbox', checked: r.active === false ? null : 'checked', 'aria-label': 'Activo' }),
          days: RT_WEEKDAYS.map((d, i) => el('input', { type: 'checkbox', checked: (r.working_days || []).includes(i) ? 'checked' : null, 'aria-label': `Día ${d}` })),
        };
        const dt = el('td', { colspan: '10' });
        const dtRow = el('tr', { hidden: 'hidden' }, dt);
        const cap = r.id ? (r.calendar_ok ? `${r.weekly_hours} h/semana` : null) : null;
        const tr = el('tr', {},
          el('td', {}, f.code), el('td', {}, f.name), el('td', {}, f.parallel_units), el('td', {}, f.hours_per_day),
          el('td', {}, el('div', { class: 'rt-days' }, RT_WEEKDAYS.map((d, i) => el('label', {}, d, f.days[i])))),
          el('td', {}, f.day_start), el('td', {}, f.efficiency_pct), el('td', {}, f.active),
          el('td', {}, cap ? cap : el('span', { class: 'rt-missing', text: r.id ? `${RT_MISSING}: ${(r.missing || []).map((m: string) => m === 'hours_per_day' ? 'horas/día' : 'días').join(', ')}` : '—' })),
          el('td', {}, el('div', { class: 'rt-actions', style: 'margin:0;flex-wrap:nowrap' },
            rtBtn(r.id ? 'Guardar' : 'Crear', async () => {
              if (!f.code.value.trim()) { f.code.setAttribute('aria-invalid', 'true'); throw new Error('Indica el código del recurso.'); }
              const n = (i: HTMLInputElement) => i.value.trim() === '' ? null : Number(i.value);
              const days = f.days.map((c: HTMLInputElement, i: number) => c.checked ? i : -1).filter((i: number) => i >= 0);
              const body = { code: f.code.value.trim(), name: f.name.value.trim() || null, parallel_units: n(f.parallel_units) || 1,
                hours_per_day: n(f.hours_per_day), working_days: days.length ? days : null, day_start: f.day_start.value || null,
                efficiency_pct: n(f.efficiency_pct) || 100, active: f.active.checked, notes: r.notes || null };
              await rtCall(r.id ? `/resources/${r.id}` : '/resources', rtJson(r.id ? 'PATCH' : 'POST', body));
              showToast(`✓ Recurso ${body.code} guardado`);
              await rtLoadResources(); rtRefreshOverview();
            }, r.id ? '' : 'btn-ui--primary'),
            r.id ? el('button', { class: 'btn-ui', type: 'button', text: `Mantenimiento (${r.downtimes.length})`, onclick: () => {
              dtRow.hidden = !dtRow.hidden; if (!dtRow.hidden) rtDowntimes(dt, r);
            } }) : null,
            r.id ? rtConfirmBtn('Borrar', 'Confirmar', async () => {
              await rtCall(`/resources/${r.id}`, { method: 'DELETE' }); showToast(`Recurso ${r.code} borrado`); await rtLoadResources();
            }) : el('button', { class: 'btn-ui', type: 'button', text: '×', 'aria-label': 'Descartar', onclick: () => tr.remove() }))));
        tbody.append(tr, dtRow);
      };
      rt.resources.forEach(addRow);
      rtBody().replaceChildren(
        el('div', { class: 'rt-bar' },
          el('button', { class: 'btn-ui btn-ui--primary', type: 'button', text: 'Añadir recurso', onclick: () => addRow({ parallel_units: 1, efficiency_pct: 100, active: true }) }),
          rtBtn('Importar desde Tiempos de proceso', async () => {
            const res = await rtCall('/resources/import-tiempos', { method: 'POST' });
            result.replaceChildren(el('div', { class: res.missing.length ? 'rt-alert rt-alert--warn' : 'rt-why' },
              `Creados: ${res.created.join(', ') || 'ninguno'}. `, res.skipped.length ? `Ya existían: ${res.skipped.map((s: any) => s.code).join(', ')}. ` : '',
              res.missing.length ? `Falta: ${res.missing.join('; ')} (${RT_MISSING}): complétalo aquí.` : ''));
            await rtLoadResources(); rtRefreshOverview();
          })),
        el('p', { class: 'rt-muted', style: 'margin:-.3rem 0 .8rem', text: 'Cada recurso tiene su calendario: horas de trabajo por día laborable a partir de la hora de inicio, días laborables, unidades idénticas en paralelo y eficiencia (tiempo productivo). Sin horas o días, su capacidad es DATO FALTANTE y las operaciones que lo usan no se planifican. «Importar desde Tiempos» usa solo lo que guardaste en esa pestaña (turnos × 8 h, operarios = unidades, 100 − buffer = eficiencia).' }),
        result,
        rtTable(['Código', 'Nombre', 'Unidades', 'h/día', 'Días laborables', 'Inicio', 'Eficiencia %', 'Activo', 'Capacidad', ''], tbody, 'rt-table rt-edit'),
        rt.resources.length ? null : el('p', { class: 'rt-muted', style: 'margin-top:.5rem', text: 'Aún no hay recursos: añádelos o impórtalos desde Tiempos de proceso.' }));
    }

    function rtDowntimes(cell: HTMLElement, r: any) {
      const s = el('input', { class: 'rt-in', type: 'datetime-local', 'aria-label': 'Inicio del mantenimiento' }) as HTMLInputElement;
      const e = el('input', { class: 'rt-in', type: 'datetime-local', 'aria-label': 'Fin del mantenimiento' }) as HTMLInputElement;
      const reason = el('input', { class: 'rt-in', maxlength: '200', placeholder: 'Motivo (preventivo, avería…)', 'aria-label': 'Motivo' }) as HTMLInputElement;
      cell.replaceChildren(el('div', { class: 'rt-why' },
        el('b', { text: `Mantenimiento y paradas de ${r.code}` }),
        r.downtimes.length ? el('ul', { style: 'margin:.3rem 0;padding-left:1rem' }, r.downtimes.map((d: any) => el('li', {},
          `${rtDt(d.starts_at)} → ${rtDt(d.ends_at)}${d.reason ? ' · ' + d.reason : ''} `,
          d.id ? rtBtn('Quitar', async () => { await rtCall(`/resources/${r.id}/downtimes/${d.id}`, { method: 'DELETE' }); showToast('Mantenimiento quitado'); await rtLoadResources(); })
            : el('span', { class: 'rt-muted', text: '(disrupción activa: se resuelve en Disrupciones)' }))))
          : el('p', { class: 'rt-muted', style: 'margin:.3rem 0', text: 'Sin paradas registradas: el recurso está disponible en todo su calendario.' }),
        el('div', { class: 'rt-bar', style: 'margin:.3rem 0 0' }, el('label', {}, 'Desde', s), el('label', {}, 'Hasta', e), reason,
          rtBtn('Añadir parada', async () => {
            if (!s.value || !e.value) throw new Error('Indica inicio y fin.');
            await rtCall(`/resources/${r.id}/downtimes`, rtJson('POST', { starts_at: s.value, ends_at: e.value, reason: reason.value.trim() || null }));
            showToast('✓ Parada registrada: la planificación la respetará'); await rtLoadResources();
          }, 'btn-ui--primary'))));
    }

    // ── Admin panel ───────────────────────────────────────────────
    function initAdminPanel(isAdmin: boolean) {
      if (!isAdmin) return;
      const navSection = document.getElementById('nav-admin-section');
      if (navSection) navSection.style.display = '';

      // Platform admin (Planning Core) manages every tenant, plans and contracts.
      // A company admin manages only their own company's users and permissions —
      // the API enforces this; the UI just doesn't offer what would be refused.
      const isPlatform = currentUser?.role === 'platform_admin';
      if (!isPlatform) {
        const nb = document.getElementById('newCompanyBtn'); if (nb) nb.style.display = 'none';
        document.getElementById('au-role-platform')?.remove();
        const cp = document.getElementById('cmp-plan') as HTMLSelectElement | null; if (cp) cp.disabled = true;
      }
      const ROLE_LABELS: Record<string, string> = {
        platform_admin: 'Admin plataforma', company_admin: 'Admin empresa',
        plant_manager: 'Jefe de planta', department_manager: 'Jefe de departamento', user: 'Usuario',
      };
      const STATUS_BADGES: Record<string, [string, string]> = {
        full:    ['Todos (plan)', 'background:#FEF3C7;color:#92400E'],
        pending: ['Pendiente de permisos', 'background:#FEE2E2;color:#B91C1C'],
        review:  ['Revisar permisos', 'background:#FFEDD5;color:#C2410C'],
        active:  ['', 'background:#DCFCE7;color:#166534'],
      };
      function statusBadge(u: any): string {
        const st = u.permission_status || 'pending';
        const [label, style] = STATUS_BADGES[st] || STATUS_BADGES.pending;
        const n = (u.modules || []).length;
        const text = st === 'active' ? `${n} módulo${n !== 1 ? 's' : ''}` : st === 'review' ? `${label} (${n})` : label;
        return `<span class="admin-badge" style="${style}">${escapeHtml(text)}</span>`;
      }

      const INDUSTRY_LABELS: Record<string, string> = {
        'composites-aeronautica': '✈️ Composites & Aeronáutica',
        'impresion-packaging': '🖨️ Impresión & Packaging',
        'fundicion-metalurgia': '⚙️ Fundición & Metalurgia',
        'fabricacion-muebles': '🪑 Muebles & Madera',
        'medtech-dispositivos': '💊 MedTech',
        'ferroviario-mro': '🚆 Ferroviario MRO',
        'agroalimentario': '🌾 Agroalimentaria',
        'naval-astilleros': '⚓ Naval & Astilleros',
        'construccion-industrial': '🏗️ Construcción Industrial',
      };
      const PLAN_LABELS: Record<string, string> = { starter: 'Starter', pro: 'Pro', enterprise: 'Enterprise' };

      let adminCompanies: any[] = [];
      let editingCompanyId: number | null = null;
      let adminPieceTypes: any[] = [];
      let editingPieceTypeId: number | null = null;
      let adminUsersList: any[] = [];
      let editingUserId: number | null = null;

      // Tab switching
      document.querySelectorAll('.admin-tab').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.admin-tab').forEach(b => b.classList.remove('admin-tab--active'));
          btn.classList.add('admin-tab--active');
          const tab = (btn as HTMLElement).dataset.atab;
          document.getElementById('adminPanelCompanies')!.style.display = tab === 'companies' ? '' : 'none';
          document.getElementById('adminPanelUsers')!.style.display = tab === 'users' ? '' : 'none';
          document.getElementById('adminPanelPieceTypes')!.style.display = tab === 'piecetypes' ? '' : 'none';
          if (tab === 'users') loadAdminUsers();
          if (tab === 'piecetypes') loadAdminPieceTypes();
        });
      });

      // ── Companies ──
      async function loadAdminCompanies() {
        const token = localStorage.getItem('pc_token');
        if (!token) return;
        try {
          const res = await fetch(`${API_BASE}/admin/companies`, { headers: { Authorization: `Bearer ${token}` } });
          adminCompanies = await res.json();
        } catch { adminCompanies = []; }
        renderCompanies();
        populateCompanySelect();
      }

      function renderCompanies() {
        const tbody = document.getElementById('companiesBody')!;
        if (!adminCompanies.length) {
          tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--n50)">No hay empresas. Crea la primera.</td></tr>';
          return;
        }
        tbody.innerHTML = adminCompanies.map(c => `
          <tr>
            <td style="font-weight:600">${escapeHtml(c.name)}</td>
            <td style="font-size:.78rem;color:var(--n30)">${c.industry ? escHtml(INDUSTRY_LABELS[c.industry] || c.industry) : '<span style="color:var(--n80)">—</span>'}</td>
            <td>${c.plan ? `<span class="admin-badge admin-badge--plan">${PLAN_LABELS[c.plan] || c.plan}</span>` : '<span style="color:var(--n80)">—</span>'}</td>
            <td style="font-size:.78rem;color:var(--n50)">${c.user_count} usuario${c.user_count !== 1 ? 's' : ''}</td>
            <td style="font-size:.78rem;color:var(--n50)">${new Date(c.created_at).toLocaleDateString('es-ES')}</td>
            <td>
              <button class="admin-action-btn" data-edit-company="${c.id}">Editar</button>
              <button class="admin-action-btn" data-company-modules="${c.id}">Módulos (${(c.modules || []).length})</button>
              ${isPlatform ? `<button class="admin-action-btn del" data-del-company="${c.id}" data-del-company-name="${escapeHtml(c.name)}">Eliminar</button>` : ''}
            </td>
          </tr>`).join('');

        tbody.querySelectorAll('[data-edit-company]').forEach(btn => {
          btn.addEventListener('click', () => openCompanyModal(parseInt((btn as HTMLElement).dataset.editCompany!)));
        });
        tbody.querySelectorAll('[data-company-modules]').forEach(btn => {
          btn.addEventListener('click', () => openCompanyModulesModal(parseInt((btn as HTMLElement).dataset.companyModules!)));
        });
        tbody.querySelectorAll('[data-del-company]').forEach(btn => {
          const el = btn as HTMLElement;
          btn.addEventListener('click', () => deleteCompany(parseInt(el.dataset.delCompany!), el.dataset.delCompanyName!));
        });
      }

      function populateCompanySelect() {
        const sel = document.getElementById('au-company-id')!;
        const cur = (sel as HTMLSelectElement).value;
        sel.innerHTML = '<option value="">— Sin empresa —</option>' +
          adminCompanies.map(c => `<option value="${c.id}">${escapeHtml(c.name)}${c.industry ? ' · ' + escHtml(INDUSTRY_LABELS[c.industry] || c.industry) : ''}</option>`).join('');
        (sel as HTMLSelectElement).value = cur;
      }

      // A stored value that predates the current option list (legacy free text)
      // would otherwise silently become "— Sin asignar —" and be wiped on save.
      // Show it as its own option so it round-trips unchanged; the API accepts
      // an unchanged legacy value but refuses any new unknown one.
      function setSelectKeepingLegacy(sel: HTMLSelectElement, value: string | null | undefined) {
        sel.querySelectorAll('option[data-legacy]').forEach(o => o.remove());
        const v = value || '';
        if (v && ![...sel.options].some(o => o.value === v)) {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = `${v} (valor anterior)`;
          opt.dataset.legacy = '1';
          sel.appendChild(opt);
        }
        sel.value = v;
      }

      function openCompanyModal(id?: number) {
        editingCompanyId = id || null;
        document.getElementById('companyModalTitle')!.textContent = id ? 'Editar empresa' : 'Nueva empresa';
        document.getElementById('companyModalErr')!.textContent = '';
        const c = id ? adminCompanies.find(x => x.id === id) : null;
        (document.getElementById('cmp-name') as HTMLInputElement).value = c?.name || '';
        setSelectKeepingLegacy(document.getElementById('cmp-industry') as HTMLSelectElement, c?.industry);
        setSelectKeepingLegacy(document.getElementById('cmp-plan') as HTMLSelectElement, c?.plan);
        (document.getElementById('cmp-pilot-start') as HTMLInputElement).value = c?.pilot_start || '';
        (document.getElementById('cmp-pilot-weeks') as HTMLInputElement).value = c?.pilot_weeks != null ? String(c.pilot_weeks) : '';
        document.getElementById('companyModal')!.style.display = 'flex';
      }

      function closeCompanyModal() { document.getElementById('companyModal')!.style.display = 'none'; }

      async function saveCompany() {
        const token = localStorage.getItem('pc_token');
        const name = (document.getElementById('cmp-name') as HTMLInputElement).value.trim();
        const industry = (document.getElementById('cmp-industry') as HTMLSelectElement).value || null;
        const plan = (document.getElementById('cmp-plan') as HTMLSelectElement).value || null;
        const pilot_start = (document.getElementById('cmp-pilot-start') as HTMLInputElement).value || null;
        const pwRaw = (document.getElementById('cmp-pilot-weeks') as HTMLInputElement).value.trim();
        const pilot_weeks = pwRaw ? parseInt(pwRaw, 10) : null;
        const errEl = document.getElementById('companyModalErr')!;
        if (!name) { errEl.textContent = 'El nombre es obligatorio'; return; }
        errEl.textContent = '';
        const url = editingCompanyId ? `${API_BASE}/admin/companies/${editingCompanyId}` : `${API_BASE}/admin/companies`;
        const method = editingCompanyId ? 'PATCH' : 'POST';
        const res = await fetch(url, { method, headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ name, industry, plan, pilot_start, pilot_weeks }) });
        if (!res.ok) { const d = await res.json(); errEl.textContent = d.detail || 'Error al guardar'; return; }
        closeCompanyModal();
        loadAdminCompanies();
        showToast(editingCompanyId ? '✓ Empresa actualizada' : '✓ Empresa creada');
      }

      async function deleteCompany(id: number, name: string) {
        if (!confirm(`¿Eliminar "${name}"?\nLos usuarios vinculados quedarán sin empresa.`)) return;
        const token = localStorage.getItem('pc_token');
        await fetch(`${API_BASE}/admin/companies/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
        loadAdminCompanies();
        showToast('Empresa eliminada');
      }

      document.getElementById('newCompanyBtn')?.addEventListener('click', () => openCompanyModal());
      document.getElementById('companyModalClose')?.addEventListener('click', closeCompanyModal);
      document.getElementById('companyModalCancel')?.addEventListener('click', closeCompanyModal);
      document.getElementById('companyModalSave')?.addEventListener('click', saveCompany);

      // ── Users ──
      async function loadAdminUsers() {
        const token = localStorage.getItem('pc_token');
        if (!token) return;
        await loadAdminCompanies();
        try {
          const res = await fetch(`${API_BASE}/admin/users`, { headers: { Authorization: `Bearer ${token}` } });
          const users = await res.json();
          adminUsersList = users;
          renderAdminUsers(users);
        } catch { document.getElementById('usersBody')!.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--red)">Error al cargar usuarios</td></tr>'; }
      }

      function renderAdminUsers(users: any[]) {
        const tbody = document.getElementById('usersBody')!;
        if (!users.length) { tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--n50)">No hay usuarios todavía</td></tr>'; return; }
        tbody.innerHTML = users.map(u => {
          const companyName = u.company_id ? (adminCompanies.find((c: any) => c.id === u.company_id)?.name || u.company || '—') : (u.company || '—');
          const sectors = u.is_admin ? '<span style="color:var(--amber);font-size:.72rem">Todos</span>'
            : (u.sector ? escapeHtml(u.sector.split(',').map((s: string) => s.trim()).join(', ')) : '<span style="color:var(--red);font-size:.72rem">Sin asignar</span>');
          return `<tr>
            <td><div style="font-weight:600">${escapeHtml(u.name)}</div><div style="font-size:.72rem;color:var(--n50)">${escapeHtml(u.email)}</div></td>
            <td style="font-size:.78rem;color:var(--n30)">${escapeHtml(companyName)}</td>
            <td style="font-size:.78rem;color:var(--n50)">${sectors}</td>
            <td><span class="admin-badge ${u.is_admin ? 'admin-badge--admin' : ''}" style="${!u.is_admin ? 'background:var(--n90);color:var(--n50)' : ''}">${escapeHtml(ROLE_LABELS[u.role] || (u.is_admin ? 'Admin' : 'Usuario'))}</span></td>
            <td>${statusBadge(u)}</td>
            <td><span class="admin-badge ${u.is_active ? 'admin-badge--active' : 'admin-badge--inactive'}">${u.is_active ? 'Activo' : 'Inactivo'}</span></td>
            <td style="font-size:.72rem;color:var(--n50)">${u.last_login ? new Date(u.last_login).toLocaleDateString('es-ES') : 'Nunca'}</td>
            <td>
              <button class="admin-action-btn" data-edit-user="${u.id}">Editar</button>
              ${u.is_admin ? '' : `<button class="admin-action-btn" data-perms-user="${u.id}">Permisos</button>`}
              <button class="admin-action-btn" data-toggle-user="${u.id}" data-toggle-active="${u.is_active}">${u.is_active ? 'Revocar' : 'Reactivar'}</button>
              <button class="admin-action-btn del" data-del-user="${u.id}" data-del-user-name="${escapeHtml(u.name)}">Eliminar</button>
            </td>
          </tr>`;
        }).join('');

        tbody.querySelectorAll('[data-edit-user]').forEach(btn => {
          btn.addEventListener('click', () => openUserModal(parseInt((btn as HTMLElement).dataset.editUser!)));
        });
        tbody.querySelectorAll('[data-perms-user]').forEach(btn => {
          btn.addEventListener('click', () => openUserModulesModal(parseInt((btn as HTMLElement).dataset.permsUser!)));
        });
        tbody.querySelectorAll('[data-toggle-user]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const el = btn as HTMLElement;
            const isActive = el.dataset.toggleActive === 'true';
            const target = adminUsersList.find((x: any) => x.id === parseInt(el.dataset.toggleUser!));
            if (isActive && !confirm(`¿Revocar el acceso de ${target?.name || 'este usuario'}? No podrá iniciar sesión hasta que se reactive.`)) return;
            const token = localStorage.getItem('pc_token');
            const res = await fetch(`${API_BASE}/admin/users/${el.dataset.toggleUser}`, { method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ is_active: !isActive }) });
            if (!res.ok) { const d = await res.json().catch(() => ({})); showToast(`⚠ ${d.detail || 'No se pudo actualizar'}`); return; }
            showToast(isActive ? '✓ Acceso revocado' : '✓ Acceso restaurado');
            loadAdminUsers();
          });
        });
        tbody.querySelectorAll('[data-del-user]').forEach(btn => {
          const el = btn as HTMLElement;
          btn.addEventListener('click', async () => {
            if (!confirm(`¿Eliminar a ${el.dataset.delUserName}?`)) return;
            const token = localStorage.getItem('pc_token');
            const res = await fetch(`${API_BASE}/admin/users/${el.dataset.delUser}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
            if (!res.ok) {
              // e.g. 409: the user owns planning history -> deactivate instead.
              const d = await res.json().catch(() => ({}));
              showToast(`⚠ ${d.detail || 'No se pudo eliminar el usuario'}`);
            }
            loadAdminUsers();
          });
        });
      }

      function openUserModal(id?: number) {
        editingUserId = id || null;
        const u = id ? adminUsersList.find((x: any) => x.id === id) : null;
        document.getElementById('adminUserModalErr')!.textContent = '';
        document.getElementById('adminUserModalTitle')!.textContent = id ? 'Editar usuario' : 'Nuevo usuario';
        (document.getElementById('au-name') as HTMLInputElement).value = u?.name || '';
        (document.getElementById('au-email') as HTMLInputElement).value = u?.email || '';
        (document.getElementById('au-password') as HTMLInputElement).value = '';
        const roleSel = document.getElementById('au-role') as HTMLSelectElement;
        // Roles without an option here (plant/department manager) are set via the API; show them as standard.
        roleSel.value = u?.role && roleSel.querySelector(`option[value="${u.role}"]`) ? u.role : (u?.is_admin ? 'company_admin' : 'user');
        (document.getElementById('au-company-id') as HTMLSelectElement).value = u?.company_id ? String(u.company_id) : '';
        const currentSectors = new Set((u?.sector || '').split(',').map((s: string) => s.trim()).filter(Boolean));
        document.querySelectorAll('#au-sectors input').forEach(i => {
          (i as HTMLInputElement).checked = currentSectors.has((i as HTMLInputElement).value);
        });

        const pwLabel = document.getElementById('au-password-label')!;
        const pwInput = document.getElementById('au-password') as HTMLInputElement;
        const activeGroup = document.getElementById('au-active-group')!;
        if (id) {
          pwLabel.innerHTML = 'Nueva contraseña (opcional)';
          pwInput.placeholder = 'Dejar en blanco para no cambiarla';
          activeGroup.style.display = '';
          (document.getElementById('au-active') as HTMLSelectElement).value = u?.is_active === false ? 'false' : 'true';
        } else {
          pwLabel.innerHTML = 'Contraseña <span style="color:var(--red)">*</span>';
          pwInput.placeholder = 'Mínimo 8 caracteres';
          activeGroup.style.display = 'none';
        }

        populateCompanySelect();
        const coSel = document.getElementById('au-company-id') as HTMLSelectElement;
        coSel.value = u?.company_id ? String(u.company_id) : '';
        if (!isPlatform) {
          // A company admin only ever creates users in their own company (the API
          // forces it); adminCompanies holds just that one company for them.
          if (!coSel.value && adminCompanies[0]) coSel.value = String(adminCompanies[0].id);
          coSel.disabled = true;
        }
        document.getElementById('adminUserModal')!.classList.add('open');
      }

      async function saveAdminUser() {
        const token = localStorage.getItem('pc_token');
        const errEl = document.getElementById('adminUserModalErr')!;
        const name = (document.getElementById('au-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('au-email') as HTMLInputElement).value.trim();
        const password = (document.getElementById('au-password') as HTMLInputElement).value;
        const companyIdRaw = (document.getElementById('au-company-id') as HTMLSelectElement).value;
        const sectors = [...document.querySelectorAll('#au-sectors input:checked')].map(i => (i as HTMLInputElement).value).join(',') || null;
        const role = (document.getElementById('au-role') as HTMLSelectElement).value;
        const is_admin = role === 'company_admin' || role === 'platform_admin';  // legacy field, kept in sync

        if (!name || !email) { errEl.textContent = 'Nombre y email son obligatorios'; return; }
        if (!editingUserId && !password) { errEl.textContent = 'La contraseña es obligatoria para un usuario nuevo'; return; }
        if (password && password.length < 8) { errEl.textContent = 'La contraseña debe tener al menos 8 caracteres'; return; }
        errEl.textContent = '';

        let url = `${API_BASE}/admin/users`;
        let method = 'POST';
        let body: any = { name, email, password, company_id: companyIdRaw ? parseInt(companyIdRaw) : null, sector: sectors, role, is_admin };
        const editedUser = editingUserId ? adminUsersList.find((x: any) => x.id === editingUserId) : null;
        if (editingUserId) {
          url = `${API_BASE}/admin/users/${editingUserId}`;
          method = 'PATCH';
          const is_active = (document.getElementById('au-active') as HTMLSelectElement).value === 'true';
          body = { name, email, company_id: companyIdRaw ? parseInt(companyIdRaw) : null, sector: sectors, is_active };
          // Only send a role change when the selector actually changed, so a
          // plant/department manager shown as "standard" isn't downgraded.
          const shownRole = editedUser?.role && document.querySelector(`#au-role option[value="${editedUser.role}"]`) ? editedUser.role : (editedUser?.is_admin ? 'company_admin' : 'user');
          if (role !== shownRole) { body.role = role; body.is_admin = is_admin; }
          if (password) body.new_password = password;
        }

        const res = await fetch(url, { method, headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (!res.ok) { const d = await res.json().catch(() => ({})); errEl.textContent = d.detail || 'Error al guardar'; return; }
        const saved = await res.json().catch(() => null);
        // Changing your own password revokes your other sessions; the API hands
        // this one a fresh token so you stay signed in here.
        if (saved?.access_token) localStorage.setItem('pc_token', saved.access_token);
        document.getElementById('adminUserModal')!.classList.remove('open');
        await loadAdminUsers();
        showToast(editingUserId ? '✓ Usuario actualizado' : '✓ Usuario creado');
        // A new standard user has no access until modules are assigned: go straight there.
        if (!editingUserId && saved && !saved.is_admin) openUserModulesModal(saved.id);
      }

      // ── Permisos de módulos por usuario ──
      let permsUserId: number | null = null;
      let permsModules: any[] = [];

      function renderToggleRow(m: any, checked: boolean, disabled: boolean, attr: string): string {
        return `<label style="display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.65rem .85rem;border-bottom:1px solid var(--n90);cursor:${disabled ? 'default' : 'pointer'}">
            <span><span style="font-weight:600;font-size:.86rem">${escapeHtml(m.name)}</span>
            ${m.description ? `<span style="display:block;font-size:.72rem;color:var(--n50)">${escapeHtml(m.description)}</span>` : ''}</span>
            <span style="display:flex;align-items:center;gap:.5rem;flex-shrink:0">
              <span data-onoff style="font-size:.7rem;font-weight:700;letter-spacing:.04em;color:${checked ? 'var(--green, #16A34A)' : 'var(--n50)'}">${checked ? 'ON' : 'OFF'}</span>
              <input type="checkbox" ${attr}="${escapeHtml(m.key)}" ${checked ? 'checked' : ''} ${disabled ? 'disabled' : ''} style="width:18px;height:18px;accent-color:var(--brand)">
            </span>
          </label>`;
      }

      function wireOnOff(list: HTMLElement) {
        list.querySelectorAll('input[type=checkbox]').forEach(cb => cb.addEventListener('change', () => {
          const lbl = cb.closest('label')?.querySelector('[data-onoff]') as HTMLElement | null;
          const on = (cb as HTMLInputElement).checked;
          if (lbl) { lbl.textContent = on ? 'ON' : 'OFF'; lbl.style.color = on ? 'var(--green, #16A34A)' : 'var(--n50)'; }
        }));
      }

      async function openUserModulesModal(userId: number) {
        const token = localStorage.getItem('pc_token');
        const errEl = document.getElementById('userModulesModalErr')!;
        errEl.textContent = '';
        const res = await fetch(`${API_BASE}/admin/users/${userId}/modules`, { headers: { Authorization: `Bearer ${token}` } });
        if (!res.ok) { const d = await res.json().catch(() => ({})); showToast(`⚠ ${d.detail || 'No se pudieron cargar los permisos'}`); return; }
        const data = await res.json();
        permsUserId = userId;
        permsModules = data.modules || [];
        document.getElementById('um-user-name')!.textContent = data.name || '';
        document.getElementById('um-user-role')!.textContent = `Rol: ${ROLE_LABELS[data.role] || data.role}`;
        document.getElementById('um-status')!.outerHTML = `<span id="um-status">${statusBadge({ permission_status: data.status, modules: permsModules.filter((m: any) => m.enabled) })}</span>`;
        const list = document.getElementById('um-list')!;
        list.innerHTML = permsModules.length
          ? permsModules.map((m: any) => renderToggleRow(m, !!m.enabled, false, 'data-um-key')).join('')
          : '<div style="padding:1rem;font-size:.82rem;color:var(--n50)">La empresa no tiene módulos contratados.</div>';
        wireOnOff(list);
        document.getElementById('userModulesModal')!.classList.add('open');
      }

      function setAllPerms(on: boolean) {
        document.querySelectorAll('#um-list input[data-um-key]').forEach(cb => {
          (cb as HTMLInputElement).checked = on;
          cb.dispatchEvent(new Event('change'));
        });
      }

      async function saveUserModules() {
        if (permsUserId == null) return;
        const token = localStorage.getItem('pc_token');
        const errEl = document.getElementById('userModulesModalErr')!;
        const modules: Record<string, boolean> = {};
        document.querySelectorAll('#um-list input[data-um-key]').forEach(cb => {
          modules[(cb as HTMLInputElement).getAttribute('data-um-key')!] = (cb as HTMLInputElement).checked;
        });
        const res = await fetch(`${API_BASE}/admin/users/${permsUserId}/modules`, {
          method: 'PUT',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ modules }),
        });
        if (!res.ok) { const d = await res.json().catch(() => ({})); errEl.textContent = d.detail || 'Error al guardar los permisos'; return; }
        document.getElementById('userModulesModal')!.classList.remove('open');
        showToast('✓ Permisos guardados');
        loadAdminUsers();
      }

      const closePerms = () => document.getElementById('userModulesModal')!.classList.remove('open');
      document.getElementById('userModulesModalClose')?.addEventListener('click', closePerms);
      document.getElementById('userModulesModalCancel')?.addEventListener('click', closePerms);
      document.getElementById('userModulesModalSave')?.addEventListener('click', saveUserModules);
      document.getElementById('um-all')?.addEventListener('click', () => setAllPerms(true));
      document.getElementById('um-none')?.addEventListener('click', () => setAllPerms(false));
      document.getElementById('userModulesModal')?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === document.getElementById('userModulesModal')) closePerms();
      });

      // ── Módulos contratados por empresa (editable solo por la plataforma) ──
      async function openCompanyModulesModal(companyId: number) {
        const token = localStorage.getItem('pc_token');
        const errEl = document.getElementById('companyModulesModalErr')!;
        errEl.textContent = '';
        const res = await fetch(`${API_BASE}/admin/companies/${companyId}/modules`, { headers: { Authorization: `Bearer ${token}` } });
        if (!res.ok) { showToast('⚠ No se pudieron cargar los módulos'); return; }
        const data = await res.json();
        const company = adminCompanies.find((c: any) => c.id === companyId);
        document.getElementById('cm-title')!.textContent = `Módulos contratados · ${company?.name || ''}`;
        document.getElementById('cm-hint')!.textContent = isPlatform
          ? `Plan: ${company?.plan ? (PLAN_LABELS[company.plan] || company.plan) : '—'}. Cambiar el plan de la empresa restablece estos módulos al paquete del plan; aquí puedes añadir o quitar módulos sueltos.`
          : 'Módulos incluidos en vuestra suscripción. Para ampliarla, contacta con Planning Core.';
        const list = document.getElementById('cm-list')!;
        list.innerHTML = (data.modules || []).map((m: any) => renderToggleRow(m, !!m.contracted, !isPlatform, 'data-cm-key')).join('');
        wireOnOff(list);
        list.querySelectorAll('input[data-cm-key]').forEach(cb => cb.addEventListener('change', async () => {
          const input = cb as HTMLInputElement;
          const r = await fetch(`${API_BASE}/admin/companies/${companyId}/modules/${input.getAttribute('data-cm-key')}`, {
            method: 'PUT',
            headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: input.checked }),
          });
          if (!r.ok) {
            input.checked = !input.checked;
            input.dispatchEvent(new Event('change'));
            errEl.textContent = 'No se pudo actualizar el contrato';
          }
        }));
        document.getElementById('companyModulesModal')!.classList.add('open');
      }

      const closeCompanyModules = () => { document.getElementById('companyModulesModal')!.classList.remove('open'); loadAdminCompanies(); };
      document.getElementById('companyModulesModalClose')?.addEventListener('click', closeCompanyModules);
      document.getElementById('companyModulesModalDone')?.addEventListener('click', closeCompanyModules);

      document.getElementById('newUserBtn')?.addEventListener('click', () => openUserModal());
      document.getElementById('adminUserModalClose')?.addEventListener('click', () => { document.getElementById('adminUserModal')!.classList.remove('open'); });
      document.getElementById('adminUserModalCancel')?.addEventListener('click', () => { document.getElementById('adminUserModal')!.classList.remove('open'); });
      document.getElementById('adminUserModalSave')?.addEventListener('click', saveAdminUser);
      document.getElementById('adminUserModal')?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === document.getElementById('adminUserModal')) document.getElementById('adminUserModal')!.classList.remove('open');
      });

      // ── Tipos de pieza ──
      async function loadAdminPieceTypes() {
        const token = localStorage.getItem('pc_token');
        if (!token) return;
        try {
          const res = await fetch(`${API_BASE}/api/piece-types`, { headers: { Authorization: `Bearer ${token}` } });
          adminPieceTypes = res.ok ? await res.json() : [];
        } catch { adminPieceTypes = []; }
        renderPieceTypesAdmin();
      }

      function renderPieceTypesAdmin() {
        const tbody = document.getElementById('pieceTypesBody')!;
        if (!adminPieceTypes.length) {
          tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--n50)">No hay tipos de pieza. Crea el primero.</td></tr>';
          return;
        }
        tbody.innerHTML = adminPieceTypes.map((pt: any) => `
          <tr>
            <td style="font-weight:600">${escHtml(pt.name)}</td>
            <td style="font-size:.78rem;color:var(--n30)">${escHtml(pt.layup_type)}</td>
            <td style="font-size:.78rem;color:var(--n50);white-space:nowrap">${pt.atl_hours}h / ${pt.autoclave_hours}h / ${pt.ndt_hours}h / ${pt.cnc_hours}h</td>
            <td style="font-size:.78rem;color:var(--n50);white-space:nowrap">${pt.workers_atl}/${pt.workers_bag}/${pt.workers_autoclave}/${pt.workers_ndt}/${pt.workers_cnc}</td>
            <td>
              <button class="admin-action-btn" data-edit-pt="${pt.id}">Editar</button>
              <button class="admin-action-btn del" data-del-pt="${pt.id}" data-del-pt-name="${escHtml(pt.name)}">Eliminar</button>
            </td>
          </tr>`).join('');

        tbody.querySelectorAll('[data-edit-pt]').forEach(btn => {
          btn.addEventListener('click', () => openPieceTypeModal(parseInt((btn as HTMLElement).dataset.editPt!)));
        });
        tbody.querySelectorAll('[data-del-pt]').forEach(btn => {
          const el = btn as HTMLElement;
          btn.addEventListener('click', () => deletePieceType(parseInt(el.dataset.delPt!), el.dataset.delPtName!));
        });
      }

      function openPieceTypeModal(id?: number) {
        editingPieceTypeId = id || null;
        const pt = id ? adminPieceTypes.find((p: any) => p.id === id) : null;
        document.getElementById('pieceTypeModalTitle')!.textContent = id ? 'Editar tipo de pieza' : 'Nuevo tipo de pieza';
        document.getElementById('pieceTypeModalErr')!.textContent = '';
        (document.getElementById('pt-name') as HTMLInputElement).value = pt?.name || '';
        (document.getElementById('pt-layup') as HTMLInputElement).value = pt?.layup_type || 'Cuasi-isótropo';
        (document.getElementById('pt-atl-hours') as HTMLInputElement).value = String(pt?.atl_hours ?? 4);
        (document.getElementById('pt-autoclave-hours') as HTMLInputElement).value = String(pt?.autoclave_hours ?? 8);
        (document.getElementById('pt-ndt-hours') as HTMLInputElement).value = String(pt?.ndt_hours ?? 2);
        (document.getElementById('pt-cnc-hours') as HTMLInputElement).value = String(pt?.cnc_hours ?? 2);
        (document.getElementById('pt-workers-atl') as HTMLInputElement).value = String(pt?.workers_atl ?? 1);
        (document.getElementById('pt-workers-bag') as HTMLInputElement).value = String(pt?.workers_bag ?? 2);
        (document.getElementById('pt-workers-autoclave') as HTMLInputElement).value = String(pt?.workers_autoclave ?? 1);
        (document.getElementById('pt-workers-ndt') as HTMLInputElement).value = String(pt?.workers_ndt ?? 1);
        (document.getElementById('pt-workers-cnc') as HTMLInputElement).value = String(pt?.workers_cnc ?? 1);
        document.getElementById('pieceTypeModal')!.classList.add('open');
        document.getElementById('pt-name')?.focus();
      }
      function closePieceTypeModal() { document.getElementById('pieceTypeModal')!.classList.remove('open'); }

      async function savePieceType() {
        const token = localStorage.getItem('pc_token');
        const errEl = document.getElementById('pieceTypeModalErr')!;
        const name = (document.getElementById('pt-name') as HTMLInputElement).value.trim();
        if (!name) { errEl.textContent = 'El nombre es obligatorio'; return; }
        errEl.textContent = '';
        const body = {
          name,
          layup_type: (document.getElementById('pt-layup') as HTMLInputElement).value.trim() || 'Cuasi-isótropo',
          atl_hours: Number((document.getElementById('pt-atl-hours') as HTMLInputElement).value) || 0,
          autoclave_hours: Number((document.getElementById('pt-autoclave-hours') as HTMLInputElement).value) || 0,
          ndt_hours: Number((document.getElementById('pt-ndt-hours') as HTMLInputElement).value) || 0,
          cnc_hours: Number((document.getElementById('pt-cnc-hours') as HTMLInputElement).value) || 0,
          workers_atl: Number((document.getElementById('pt-workers-atl') as HTMLInputElement).value) || 0,
          workers_bag: Number((document.getElementById('pt-workers-bag') as HTMLInputElement).value) || 0,
          workers_autoclave: Number((document.getElementById('pt-workers-autoclave') as HTMLInputElement).value) || 0,
          workers_ndt: Number((document.getElementById('pt-workers-ndt') as HTMLInputElement).value) || 0,
          workers_cnc: Number((document.getElementById('pt-workers-cnc') as HTMLInputElement).value) || 0,
        };
        const url = editingPieceTypeId ? `${API_BASE}/api/piece-types/${editingPieceTypeId}` : `${API_BASE}/api/piece-types`;
        const method = editingPieceTypeId ? 'PATCH' : 'POST';
        const res = await fetch(url, { method, headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (!res.ok) { const d = await res.json(); errEl.textContent = d.detail || 'Error al guardar'; return; }
        closePieceTypeModal();
        loadAdminPieceTypes();
        showToast(editingPieceTypeId ? '✓ Tipo de pieza actualizado' : '✓ Tipo de pieza creado');
      }

      async function deletePieceType(id: number, name: string) {
        if (!confirm(`¿Eliminar "${name}"? Los planes que lo usen dejarán de poder referenciarlo.`)) return;
        const token = localStorage.getItem('pc_token');
        const res = await fetch(`${API_BASE}/api/piece-types/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
        if (!res.ok) { showToast('⚠ No se pudo eliminar'); return; }
        loadAdminPieceTypes();
        showToast('Tipo de pieza eliminado');
      }

      document.getElementById('newPieceTypeBtn')?.addEventListener('click', () => openPieceTypeModal());
      document.getElementById('pieceTypeModalClose')?.addEventListener('click', closePieceTypeModal);
      document.getElementById('pieceTypeModalCancel')?.addEventListener('click', closePieceTypeModal);
      document.getElementById('pieceTypeModalSave')?.addEventListener('click', savePieceType);
      document.getElementById('pieceTypeModal')?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === document.getElementById('pieceTypeModal')) closePieceTypeModal();
      });

      // Load on panel open
      document.querySelector('.nav-item[data-panel="admin"]')?.addEventListener('click', () => {
        loadAdminCompanies();
      });
    }

    // ── Theme toggle (topbar) — writes to pc_settings, delegates to applySettings ──
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    themeToggleBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      saveSettings({ theme: isDark ? 'light' : 'dark' });
      applySettings();
    });

    // ── Configuración panel wiring ──────────────────────────────
    (function initConfigPanel() {
      const segWire = (id: string, key: string) => {
        const box = document.getElementById(id);
        if (!box) return;
        box.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('click', () => {
            saveSettings({ [key]: (btn as HTMLElement).dataset.val });
            applySettings();
            showToast('✓ ' + t('cfgToastSaved'));
          });
        });
      };
      segWire('cfgLang', 'lang');
      segWire('cfgTheme', 'theme');
      segWire('cfgDensity', 'density');

      const sp = document.getElementById('cfgStartPanel') as HTMLSelectElement | null;
      sp?.addEventListener('change', () => {
        saveSettings({ startPanel: sp.value });
        showToast('✓ ' + t('cfgToastSaved'));
      });

      document.querySelectorAll('#cfgColors input[type="color"]').forEach(inp => {
        inp.addEventListener('input', () => {
          const el = inp as HTMLInputElement;
          const colors = Object.assign({}, getSettings().cellColors, { [el.dataset.key!]: el.value });
          saveSettings({ cellColors: colors });
          applySettings();
        });
      });
      document.getElementById('cfgColorsReset')?.addEventListener('click', () => {
        saveSettings({ cellColors: {} });
        applySettings();
        showToast('✓ ' + t('cfgToastColors'));
      });

      document.getElementById('cfgResetOnboarding')?.addEventListener('click', () => {
        try { localStorage.removeItem('pc_onboarding'); } catch (_) {}
        location.reload();
      });
      document.getElementById('cfgClearLocal')?.addEventListener('click', () => {
        if (!confirm(t('cfgConfirmClear'))) return;
        ['pc_onboarding', 'pc_process_times', 'pc_shift_schedule', 'pc_settings', 'theme', 'pc_token']
          .forEach(k => { try { localStorage.removeItem(k); } catch (_) {} });
        location.href = '/app';
      });

      syncConfigPanel();
    })();

    // ── Ayuda & soporte panel wiring ───────────────────────────
    (function initHelpPanel() {
      const panel = document.getElementById('panel-ayuda');
      if (!panel) return;

      // Replay tutorial (same as Configuración)
      document.getElementById('helpReplayTutorial')?.addEventListener('click', () => {
        try { localStorage.removeItem('pc_onboarding'); } catch (_) {}
        location.reload();
      });

      // Quick links → click the matching nav item
      panel.querySelectorAll('[data-help-goto]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.helpGoto!;
          (document.querySelector(`.nav-item[data-panel="${id}"]`) as HTMLElement | null)?.click();
        });
      });

      // ── System status ──
      async function checkStatus() {
        const set = (id: string, html: string) => { const el = document.getElementById(id); if (el) el.innerHTML = html; };
        set('helpStatusApi', t('helpStatusChecking'));
        set('helpStatusVersion', '…'); set('helpStatusLatency', '…');
        set('helpStatusApp', `<span class="help-dot help-dot--ok"></span>${location.host}`);
        const started = performance.now();
        try {
          const res = await fetch(`${API}/health`, { cache: 'no-store' });
          const ms = Math.round(performance.now() - started);
          const j = await res.json().catch(() => ({}));
          if (res.ok) {
            set('helpStatusApi', `<span class="help-dot help-dot--ok"></span>${t('helpStatusOk')}`);
            set('helpStatusVersion', j.version ? `v${j.version}${j.route_count ? ' · ' + j.route_count + ' rutas' : ''}` : '—');
          } else {
            set('helpStatusApi', `<span class="help-dot help-dot--bad"></span>${t('helpStatusDown')} (${res.status})`);
            set('helpStatusVersion', '—');
          }
          set('helpStatusLatency', `${ms} ms`);
        } catch (_) {
          set('helpStatusApi', `<span class="help-dot help-dot--bad"></span>${t('helpStatusDown')}`);
          set('helpStatusVersion', '—');
          set('helpStatusLatency', '—');
        }
      }
      document.getElementById('helpStatusCheck')?.addEventListener('click', checkStatus);
      // run once when the panel is first opened
      let statusRan = false;
      document.querySelector('.nav-item[data-panel="ayuda"]')?.addEventListener('click', () => {
        if (!statusRan) { statusRan = true; checkStatus(); }
        renderCtx();
      });

      // ── Contact form ──
      const form = document.getElementById('helpSupportForm') as HTMLFormElement | null;
      const msgEl = document.getElementById('helpSupportMsg');
      const ctxEl = document.getElementById('helpSupportCtx');
      const sendBtn = document.getElementById('helpSupportSend') as HTMLButtonElement | null;
      function currentPanelId(): string {
        const active = document.querySelector('.nav-item[data-panel].nav-item--active') as HTMLElement | null;
        return active?.dataset.panel || 'ayuda';
      }
      function renderCtx() {
        if (ctxEl) ctxEl.textContent = t('helpCtx');
      }
      renderCtx();
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!msgEl) return;
        const message = (document.getElementById('helpSupportMessage') as HTMLTextAreaElement).value.trim();
        const topic   = (document.getElementById('helpSupportTopic') as HTMLSelectElement).value;
        msgEl.className = 'help-form__msg';
        if (!message) { msgEl.textContent = t('helpSendErrEmpty'); msgEl.classList.add('help-form__msg--err'); return; }
        const token = localStorage.getItem('pc_token');
        const body = {
          topic, message,
          page: currentPanelId(),
          company: (currentUser && currentUser.company) || null,
          app_version: location.host,
          user_agent: navigator.userAgent,
          lang: getSettings().lang,
        };
        if (sendBtn) sendBtn.disabled = true;
        msgEl.textContent = t('helpSendSending');
        try {
          const res = await fetch(`${API}/api/support`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
            body: JSON.stringify(body),
          });
          if (!res.ok) throw new Error('http ' + res.status);
          msgEl.textContent = t('helpSendOk');
          msgEl.classList.add('help-form__msg--ok');
          (document.getElementById('helpSupportMessage') as HTMLTextAreaElement).value = '';
        } catch (_) {
          msgEl.textContent = t('helpSendErrNet');
          msgEl.classList.add('help-form__msg--err');
        } finally {
          if (sendBtn) sendBtn.disabled = false;
        }
      });
    })();

    // ── Topbar: notifications & settings buttons ─────────────────
    function navToPanel(panelId: string) {
      if (!canOpenPanel(panelId)) { openNoAccessPanel(); closeMobileSidebar(); return; }
      document.querySelectorAll('.nav-item[data-panel]').forEach(n => n.classList.remove('nav-item--active'));
      document.querySelector(`.nav-item[data-panel="${panelId}"]`)?.classList.add('nav-item--active');
      document.querySelectorAll('.dash-panel').forEach(p => (p as HTMLElement).style.display = 'none');
      const target = document.getElementById(`panel-${panelId}`);
      if (target) target.style.display = '';
      closeMobileSidebar();
    }

    // ── Mobile sidebar drawer ──────────────────────────────────────
    const sidebarEl2       = document.getElementById('sidebar');
    const sidebarToggleBtn = document.getElementById('sidebarToggle');
    const sidebarBackdropEl = document.getElementById('sidebarBackdrop');

    function openMobileSidebar() {
      sidebarEl2?.classList.add('mobile-open');
      sidebarBackdropEl?.classList.add('open');
    }
    function closeMobileSidebar() {
      sidebarEl2?.classList.remove('mobile-open');
      sidebarBackdropEl?.classList.remove('open');
    }
    sidebarToggleBtn?.addEventListener('click', () => {
      // Desktop: fold / unfold the menu (saved in the user's layout). Mobile: slide-over.
      if (window.innerWidth > 860) { lwToggleSidebar(); return; }
      if (sidebarEl2?.classList.contains('mobile-open')) closeMobileSidebar();
      else openMobileSidebar();
    });
    sidebarBackdropEl?.addEventListener('click', closeMobileSidebar);
    window.addEventListener('resize', () => {
      if (window.innerWidth > 860) closeMobileSidebar();
    });

    // ── Global search ────────────────────────────────────────────
    const searchOverlay   = document.getElementById('searchOverlay');
    const searchInput     = document.getElementById('searchInput') as HTMLInputElement | null;
    const searchResultsEl = document.getElementById('searchResults');

    const searchCache: { planificaciones: any[]; companies: any[]; users: any[]; pieceTypes: any[] } = { planificaciones: [], companies: [], users: [], pieceTypes: [] };
    let searchCacheLoaded = false;
    let searchActiveIndex = -1;
    let currentSearchResults: any[] = [];

    const SEARCH_ICONS: Record<string, string> = {
      orden: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>',
      alerta: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
      disrupcion: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
      plan: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>',
      empresa: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>',
      usuario: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>',
      piezatipo: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
    };

    function escapeHtml(s: string): string {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return s.replace(/[&<>"']/g, c => map[c]);
    }
    function highlightMatch(text: string, q: string): string {
      const idx = text.toLowerCase().indexOf(q.toLowerCase());
      if (idx === -1 || !q) return escapeHtml(text);
      return escapeHtml(text.slice(0, idx)) + '<mark>' + escapeHtml(text.slice(idx, idx + q.length)) + '</mark>' + escapeHtml(text.slice(idx + q.length));
    }

    async function loadSearchCache() {
      searchCacheLoaded = true;
      const token = localStorage.getItem('pc_token');
      try {
        const res = await fetch(`${API_BASE}/planificaciones`, { headers: { Authorization: `Bearer ${token}` } });
        searchCache.planificaciones = res.ok ? await res.json() : [];
      } catch { searchCache.planificaciones = []; }
      if (currentUser?.is_admin) {
        try {
          const [compRes, usersRes] = await Promise.all([
            fetch(`${API_BASE}/admin/companies`, { headers: { Authorization: `Bearer ${token}` } }),
            fetch(`${API_BASE}/admin/users`, { headers: { Authorization: `Bearer ${token}` } }),
          ]);
          searchCache.companies = compRes.ok ? await compRes.json() : [];
          searchCache.users = usersRes.ok ? await usersRes.json() : [];
        } catch { searchCache.companies = []; searchCache.users = []; }
        try {
          const ptRes = await fetch(`${API_BASE}/api/piece-types`, { headers: { Authorization: `Bearer ${token}` } });
          searchCache.pieceTypes = ptRes.ok ? await ptRes.json() : [];
        } catch { searchCache.pieceTypes = []; }
      }
    }

    function jumpToRow(panel: string, row: Element) {
      navToPanel(panel);
      closeSearch();
      setTimeout(() => {
        row.scrollIntoView({ block: 'center', behavior: 'smooth' });
        row.classList.add('search-highlight-flash');
        setTimeout(() => row.classList.remove('search-highlight-flash'), 1600);
      }, 100);
    }

    function runSearch(qRaw: string) {
      const q = qRaw.trim();
      searchActiveIndex = -1;
      if (!q) { renderSearchResults([], ''); return; }
      const ql = q.toLowerCase();
      const results: any[] = [];

      document.querySelectorAll('#ordersBody tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        if (!cells.length) return;
        const id = cells[0]?.textContent?.trim() || '';
        const desc = cells[1]?.textContent?.trim() || '';
        const resource = cells[2]?.textContent?.trim() || '';
        if (`${id} ${desc} ${resource}`.toLowerCase().includes(ql)) {
          results.push({ group: 'Órdenes', type: 'orden', title: id, sub: `${desc} · ${resource}`, action: () => jumpToRow('ordenes', row) });
        }
      });

      document.querySelectorAll('#alertList .alert-row').forEach(row => {
        const text = row.querySelector('.alert-desc')?.textContent?.trim() || '';
        if (text.toLowerCase().includes(ql)) {
          results.push({ group: 'Alertas', type: 'alerta', title: text.length > 70 ? text.slice(0, 70) + '…' : text, sub: '', action: () => jumpToRow('alertas', row) });
        }
      });

      document.querySelectorAll('#panel-disrupciones .disrupt-row').forEach(row => {
        const title = row.querySelector('.disrupt-title')?.textContent?.trim() || '';
        const detail = row.querySelector('.disrupt-detail')?.textContent?.trim() || '';
        if (`${title} ${detail}`.toLowerCase().includes(ql)) {
          results.push({ group: 'Disrupciones', type: 'disrupcion', title, sub: detail, action: () => jumpToRow('disrupciones', row) });
        }
      });

      searchCache.planificaciones.forEach((p: any) => {
        if (`${p.nombre} ${p.descripcion || ''}`.toLowerCase().includes(ql)) {
          results.push({
            group: 'Planificaciones guardadas', type: 'plan', title: p.nombre, sub: p.descripcion || '',
            action: () => { navToPanel('historial'); closeSearch(); },
          });
        }
      });

      searchCache.companies.forEach((c: any) => {
        if ((c.name || '').toLowerCase().includes(ql)) {
          results.push({
            group: 'Empresas', type: 'empresa', title: c.name, sub: c.industry || '',
            action: () => { navToPanel('admin'); document.getElementById('adminTabCompanies')?.dispatchEvent(new MouseEvent('click')); closeSearch(); },
          });
        }
      });
      searchCache.users.forEach((u: any) => {
        if (`${u.name} ${u.email}`.toLowerCase().includes(ql)) {
          results.push({
            group: 'Usuarios', type: 'usuario', title: u.name, sub: u.email,
            action: () => { navToPanel('admin'); document.getElementById('adminTabUsers')?.dispatchEvent(new MouseEvent('click')); closeSearch(); },
          });
        }
      });
      searchCache.pieceTypes.forEach((pt: any) => {
        if (`${pt.name} ${pt.layup_type}`.toLowerCase().includes(ql)) {
          results.push({
            group: 'Tipos de pieza', type: 'piezatipo', title: pt.name, sub: pt.layup_type,
            action: () => { navToPanel('admin'); document.getElementById('adminTabPieceTypes')?.dispatchEvent(new MouseEvent('click')); closeSearch(); },
          });
        }
      });

      renderSearchResults(results, q);
    }

    function renderSearchResults(results: any[], q: string) {
      currentSearchResults = results;
      if (!searchResultsEl) return;
      if (!results.length) {
        searchResultsEl.innerHTML = `<div class="search-empty">${q ? 'Sin resultados para “' + escapeHtml(q) + '”.' : 'Escribe para buscar en todo el panel.'}</div>`;
        return;
      }
      const groups: Record<string, any[]> = {};
      results.forEach(r => {
        if (!groups[r.group]) groups[r.group] = [];
        groups[r.group].push(r);
      });
      let html = '';
      let idx = 0;
      Object.entries(groups).forEach(([group, items]) => {
        html += `<div class="search-group-label">${escapeHtml(group)}</div>`;
        items.forEach(r => {
          html += `<div class="search-result-item" data-idx="${idx}">
            <div class="search-result-icon">${SEARCH_ICONS[r.type] || ''}</div>
            <div class="search-result-body">
              <div class="search-result-title">${highlightMatch(r.title, q)}</div>
              ${r.sub ? `<div class="search-result-sub">${escapeHtml(r.sub)}</div>` : ''}
            </div>
          </div>`;
          idx++;
        });
      });
      searchResultsEl.innerHTML = html;
      searchResultsEl.querySelectorAll('.search-result-item').forEach(el => {
        el.addEventListener('click', () => {
          const i = parseInt((el as HTMLElement).dataset.idx || '-1');
          currentSearchResults[i]?.action();
        });
      });
    }

    function updateActiveResult(items: NodeListOf<Element>) {
      items.forEach((it, i) => it.classList.toggle('search-result-item--active', i === searchActiveIndex));
      (items[searchActiveIndex] as HTMLElement)?.scrollIntoView({ block: 'nearest' });
    }

    function openSearch() {
      searchOverlay?.classList.add('open');
      closeMobileSidebar();
      searchInput?.focus();
      if (!searchCacheLoaded) loadSearchCache();
    }
    function closeSearch() {
      searchOverlay?.classList.remove('open');
      if (searchInput) searchInput.value = '';
      renderSearchResults([], '');
    }

    let searchDebounce: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => runSearch(searchInput!.value), 120);
    });
    searchInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      const items = searchResultsEl?.querySelectorAll('.search-result-item');
      if (!items || !items.length) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        searchActiveIndex = Math.min(searchActiveIndex + 1, items.length - 1);
        updateActiveResult(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        searchActiveIndex = Math.max(searchActiveIndex - 1, 0);
        updateActiveResult(items);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const target = searchActiveIndex >= 0 ? currentSearchResults[searchActiveIndex] : currentSearchResults[0];
        target?.action();
      }
    });
    document.getElementById('searchBtn')?.addEventListener('click', openSearch);
    searchOverlay?.addEventListener('click', (e: MouseEvent) => { if (e.target === searchOverlay) closeSearch(); });
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
      else if (e.key === 'Escape' && searchOverlay?.classList.contains('open')) closeSearch();
    });

    // Bell → open Alertas panel
    document.getElementById('notifBtn')?.addEventListener('click', () => {
      if (document.getElementById('dashboard-view')?.style.display === 'none') return;
      navToPanel('alertas');
    });

    // Gear → dropdown
    const settingsBtn      = document.getElementById('settingsBtn');
    const settingsDropdown = document.getElementById('settingsDropdown');

    settingsBtn?.addEventListener('click', e => {
      e.stopPropagation();
      settingsDropdown?.classList.toggle('open');
    });

    document.addEventListener('click', e => {
      if (settingsDropdown && !settingsDropdown.contains(e.target as Node) && e.target !== settingsBtn) {
        settingsDropdown.classList.remove('open');
      }
    });

    settingsDropdown?.querySelectorAll('[data-settings-action]').forEach(item => {
      item.addEventListener('click', () => {
        settingsDropdown.classList.remove('open');
        const action = (item as HTMLElement).dataset.settingsAction;
        if (action === 'mrp') {
          navToPanel('mrp');
          initMrpPanel();
        } else if (action === 'historial') {
          navToPanel('historial');
          loadHistorial();
        } else if (action === 'tiempos') {
          navToPanel('mrp');
          initMrpPanel();
          // Switch to tiempos tab
          setTimeout(() => {
            document.querySelector('.mrp-tab[data-mrptab="tiempos"]')?.dispatchEvent(new MouseEvent('click'));
          }, 50);
        } else if (action === 'logout') {
          revokeServerSession();
          localStorage.removeItem('pc_token');
          localStorage.removeItem('pc_email');
          showToast('Sesión cerrada');
          setTimeout(() => { window.location.href = '/'; }, 1000);
        } else if (action === 'seguridad') {
          openSecurityQuestionModal();
        }
      });
    });

    // User pill (top-right) -> account dropdown: basics + logout
    const userPill = document.getElementById('user-pill');
    const userMenu = document.getElementById('userMenu');

    function populateUserMenu() {
      const u: any = currentUser || {};
      const nm = document.getElementById('userMenuName');
      const em = document.getElementById('userMenuEmail');
      const rl = document.getElementById('userMenuRole');
      if (nm) nm.textContent = u.name || u.email || 'Usuario';
      if (em) em.textContent = u.email || '';
      if (rl) rl.textContent = u.is_admin ? 'Administrador' : 'Usuario';
    }

    userPill?.addEventListener('click', e => {
      if (userMenu && userMenu.contains(e.target as Node)) return; // let inner clicks through
      e.stopPropagation();
      if (!userMenu?.classList.contains('open')) populateUserMenu();
      userMenu?.classList.toggle('open');
    });

    document.addEventListener('click', e => {
      if (userMenu && !userPill?.contains(e.target as Node)) userMenu.classList.remove('open');
    });

    userMenu?.querySelectorAll('[data-user-action]').forEach(item => {
      item.addEventListener('click', e => {
        e.stopPropagation();
        userMenu.classList.remove('open');
        const action = (item as HTMLElement).dataset.userAction;
        if (action === 'config' || action === 'ayuda') {
          (document.querySelector(`.nav-item[data-panel="${action}"]`) as HTMLElement | null)?.click();
        } else if (action === 'seguridad') {
          openSecurityQuestionModal();
        } else if (action === 'logout') {
          revokeServerSession();
          localStorage.removeItem('pc_token');
          localStorage.removeItem('pc_email');
          showToast('Sesión cerrada');
          setTimeout(() => { window.location.href = '/'; }, 1000);
        }
      });
    });

    // ── Security question modal ─────────────────────────────────────
    const securityQuestionModal  = document.getElementById('securityQuestionModal');
    const securityQuestionStatus = document.getElementById('securityQuestionStatus');

    async function openSecurityQuestionModal() {
      if (!securityQuestionModal) return;
      if (securityQuestionStatus) securityQuestionStatus.textContent = 'Cargando…';
      (document.getElementById('sq-question') as HTMLInputElement).value = '';
      (document.getElementById('sq-answer') as HTMLInputElement).value = '';
      securityQuestionModal.classList.add('open');
      const token = localStorage.getItem('pc_token');
      try {
        const res = await fetch(`${API_BASE}/auth/security-question`, { headers: { Authorization: `Bearer ${token}` } });
        const data = await res.json();
        if (data.has_security_question) {
          (document.getElementById('sq-question') as HTMLInputElement).value = data.question;
          if (securityQuestionStatus) securityQuestionStatus.textContent = 'Ya tienes una pregunta configurada. Puedes actualizarla (deberás escribir la respuesta de nuevo).';
        } else {
          if (securityQuestionStatus) securityQuestionStatus.textContent = 'Aún no tienes una pregunta de seguridad configurada.';
        }
      } catch {
        if (securityQuestionStatus) securityQuestionStatus.textContent = '';
      }
    }
    function closeSecurityQuestionModal() { securityQuestionModal?.classList.remove('open'); }

    document.getElementById('securityQuestionClose')?.addEventListener('click', closeSecurityQuestionModal);
    document.getElementById('securityQuestionCancel')?.addEventListener('click', closeSecurityQuestionModal);
    securityQuestionModal?.addEventListener('click', (e: MouseEvent) => {
      if (e.target === securityQuestionModal) closeSecurityQuestionModal();
    });
    document.getElementById('securityQuestionSave')?.addEventListener('click', async () => {
      const question = (document.getElementById('sq-question') as HTMLInputElement).value.trim();
      const answer   = (document.getElementById('sq-answer') as HTMLInputElement).value.trim();
      if (!question || !answer) {
        if (securityQuestionStatus) securityQuestionStatus.textContent = 'La pregunta y la respuesta son obligatorias.';
        return;
      }
      const btn = document.getElementById('securityQuestionSave') as HTMLButtonElement;
      btn.disabled = true;
      const token = localStorage.getItem('pc_token');
      try {
        const res = await fetch(`${API_BASE}/auth/security-question`, {
          method: 'PUT',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ question, answer }),
        });
        if (!res.ok) { const d = await res.json(); throw new Error(d.detail || 'Error al guardar'); }
        showToast('✓ Pregunta de seguridad guardada');
        closeSecurityQuestionModal();
      } catch (e: any) {
        if (securityQuestionStatus) securityQuestionStatus.textContent = e.message || 'Error al guardar';
      } finally {
        btn.disabled = false;
      }
    });

    // Sync notif badge with alert count
    function syncNotifBadge() {
      const active = document.querySelectorAll('#alertList .alert-row:not(.alert-row--resolved)').length;
      const badge  = document.getElementById('notifBadge');
      if (badge) badge.style.display = active > 0 ? '' : 'none';
    }
    // Run once and re-run whenever alerts change (observe the list)
    syncNotifBadge();
    const _alertObserver = new MutationObserver(syncNotifBadge);
    const _alertList = document.getElementById('alertList');
    if (_alertList) _alertObserver.observe(_alertList, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });

    // 3. Alert banner — "Ver sugerencia"
    const alertCTA    = document.querySelector('.alert-banner__cta');
    const alertBanner = document.querySelector('.alert-banner');
    if (alertCTA && alertBanner) {
      alertCTA.addEventListener('click', () => {
        alertBanner.style.transition = 'opacity .25s, transform .25s';
        alertBanner.style.opacity = '0';
        alertBanner.style.transform = 'translateY(-6px)';
        setTimeout(() => { alertBanner.style.display = 'none'; }, 260);
        showToast('✓ Sugerencia aplicada · OF-2041 movida al turno tarde');
      });
    }

    // 4. Replanificar IA
    const replanBtn = document.querySelector('.btn-ui--primary');
    if (replanBtn) {
      replanBtn.addEventListener('click', async () => {
        if (replanBtn.disabled) return;
        const original = replanBtn.innerHTML;
        replanBtn.disabled = true;
        replanBtn.innerHTML = `<svg class="spin-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Calculando…`;
        await new Promise(r => setTimeout(r, 2200));
        replanBtn.innerHTML = original;
        replanBtn.disabled = false;
        showToast('✓ Plan optimizado · 3 órdenes reordenadas · CNC-2 pasa al 81%', 4000);
      });
    }

    // 5. Exportar
    // By id: the positional selectors picked the wrong buttons («Guardar plan»
    // showed the Escenarios toast) and the toast claimed a download that never happened.
    const exportBtn = document.getElementById('exportPlanBtn');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => exportPlan(exportBtn as HTMLButtonElement));
    }

    // 6. Escenarios
    const scenariosBtn = document.getElementById('scenariosHeaderBtn');
    if (scenariosBtn) {
      scenariosBtn.addEventListener('click', () => {
        // The real scenario comparison is the planner: open it (and un-minimise its block).
        const planBtn = [...document.querySelectorAll<HTMLButtonElement>('#panel-gantt .gantt-card button')]
          .find(b => b.textContent?.trim().startsWith('Planificar IA'));
        const block = document.querySelector<HTMLElement>('#panel-gantt .lw[data-widget="gantt"]');
        if (block?.classList.contains('lw--collapsed')) (block.querySelector('[data-lw="collapse"]') as HTMLButtonElement)?.click();
        planBtn?.click();
        block?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    // 7. FILTRAR — real filter dropdown
    const filterBtn     = document.getElementById('filterBtn');
    const filterDropdown = document.getElementById('filterDropdown');
    const filterBadge   = document.getElementById('filterBadge');
    const filterApply   = document.getElementById('filterApply');
    const filterClear   = document.getElementById('filterClear');
    const ganttSub2     = document.querySelector('.gantt-header__sub');

    // Status chip toggle
    document.querySelectorAll('#filterDropdown [data-status]').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('#filterDropdown [data-status]').forEach(c => c.classList.remove('chip--active'));
        chip.classList.add('chip--active');
      });
    });

    filterBtn && filterBtn.addEventListener('click', e => {
      e.stopPropagation();
      filterDropdown.classList.toggle('open');
    });

    document.addEventListener('click', e => {
      if (filterDropdown && !filterDropdown.contains(e.target) && e.target !== filterBtn) {
        filterDropdown.classList.remove('open');
      }
    });

    function applyFilters() {
      const checkboxes = document.querySelectorAll('#filterDropdown input[type=checkbox]');
      const statusChip = document.querySelector('#filterDropdown [data-status].chip--active');
      const activeStatus = statusChip ? statusChip.dataset.status : 'todos';

      const unchecked = Array.from(checkboxes).filter(cb => !cb.checked).map(cb => cb.dataset.resource);

      // Filter semana rows
      document.querySelectorAll('.gantt-grid .gantt-row').forEach(row => {
        const res = row.dataset.resource;
        if (unchecked.includes(res)) {
          row.classList.add('gantt-row--hidden');
        } else {
          // Apply status filter to blocks inside
          if (activeStatus !== 'todos') {
            const blocks = row.querySelectorAll('.gantt-block');
            let hasMatch = false;
            blocks.forEach(b => {
              const match = activeStatus === 'riesgo'
                ? b.dataset.estado === 'En riesgo'
                : b.dataset.estado === 'En plazo';
              b.style.opacity = match ? '1' : '0.2';
              if (match) hasMatch = true;
            });
            row.classList.toggle('gantt-row--hidden', !hasMatch);
          } else {
            row.querySelectorAll('.gantt-block').forEach(b => b.style.opacity = '1');
            row.classList.remove('gantt-row--hidden');
          }
        }
      });

      // Filter turno rows
      document.querySelectorAll('.turno-row').forEach(row => {
        const res = row.dataset.resource;
        row.style.display = unchecked.includes(res) ? 'none' : '';
      });

      // Update badge + button state
      const totalHidden = unchecked.length + (activeStatus !== 'todos' ? 1 : 0);
      if (totalHidden > 0) {
        filterBadge.textContent = totalHidden;
        filterBadge.style.display = '';
        filterBtn.classList.add('filter-btn--active');
      } else {
        filterBadge.style.display = 'none';
        filterBtn.classList.remove('filter-btn--active');
      }

      // Update subtitle
      const visibleSemana = document.querySelectorAll('.gantt-grid .gantt-row:not(.gantt-row--hidden)').length;
      if (ganttSub2) ganttSub2.textContent = `${visibleSemana} recursos · 12 órdenes activas`;

      filterDropdown.classList.remove('open');
    }

    function clearFilters() {
      document.querySelectorAll('#filterDropdown input[type=checkbox]').forEach(cb => cb.checked = true);
      document.querySelectorAll('#filterDropdown [data-status]').forEach(c => c.classList.remove('chip--active'));
      document.querySelector('#filterDropdown [data-status="todos"]').classList.add('chip--active');
      document.querySelectorAll('.gantt-grid .gantt-row').forEach(r => {
        r.classList.remove('gantt-row--hidden');
        r.querySelectorAll('.gantt-block').forEach(b => b.style.opacity = '1');
      });
      document.querySelectorAll('.turno-row').forEach(r => r.style.display = '');
      filterBadge.style.display = 'none';
      filterBtn.classList.remove('filter-btn--active');
      if (ganttSub2) ganttSub2.textContent = '5 recursos · 12 órdenes activas';
      filterDropdown.classList.remove('open');
    }

    filterApply && filterApply.addEventListener('click', applyFilters);
    filterClear && filterClear.addEventListener('click', clearFilters);

    // 9. Block click — detail popover (editable)
    const blockPopover      = document.getElementById('blockPopover');
    const blockPopoverClose = document.getElementById('blockPopoverClose');
    const bpOfInput    = document.getElementById('bpOfInput');
    const bpRecursoSel = document.getElementById('bpRecursoSel');
    const bpInicioInp  = document.getElementById('bpInicioInp');
    const bpFinInp     = document.getElementById('bpFinInp');
    const bpPctInp     = document.getElementById('bpPctInp');
    const bpPctVal     = document.getElementById('bpPctVal');
    const bpEstadoSel  = document.getElementById('bpEstadoSel');
    const bpDeleteBtn  = document.getElementById('bpDeleteBtn');
    const bpSaveBtn    = document.getElementById('bpSaveBtn');

    // Populate recurso options from gantt rows
    const RECURSOS = Array.from(document.querySelectorAll('.gantt-row[data-resource]'))
      .map(r => r.dataset.resource).filter(Boolean);
    RECURSOS.forEach(r => bpRecursoSel.add(new Option(r, r)));

    // Live progress label
    bpPctInp && bpPctInp.addEventListener('input', () => { bpPctVal.textContent = bpPctInp.value + '%'; });

    let activePopoverBlock = null;

    function showBlockPopover(block, e) {
      const d = block.dataset;
      if (!d.of) return;
      activePopoverBlock = block;

      bpOfInput.value          = d.of || '';
      bpRecursoSel.value       = d.recurso || (RECURSOS[0] ?? '');
      bpInicioInp.value        = d.inicio  || '';
      bpFinInp.value           = d.fin     || '';
      const pctNum             = parseInt(d.pct) || 0;
      bpPctInp.value           = pctNum;
      bpPctVal.textContent     = pctNum + '%';
      bpEstadoSel.value        = d.estado  || 'En plazo';

      const vw = window.innerWidth, vh = window.innerHeight;
      let x = e.clientX + 12, y = e.clientY + 12;
      if (x + 260 > vw) x = e.clientX - 260;
      if (y + 260 > vh) y = e.clientY - 260;
      blockPopover.style.left = x + 'px';
      blockPopover.style.top  = y + 'px';
      blockPopover.classList.add('open');
    }

    function attachBlockClick(block) {
      block.addEventListener('click', e => {
        if (block.classList.contains('dragging')) return;
        e.stopPropagation();
        showBlockPopover(block, e);
      });
    }
    document.querySelectorAll('.gantt-block[data-of], .turno-block[data-of]').forEach(b => attachBlockClick(b));

    blockPopoverClose && blockPopoverClose.addEventListener('click', () => {
      blockPopover.classList.remove('open');
      activePopoverBlock = null;
    });
    document.addEventListener('click', e => {
      if (blockPopover && !blockPopover.contains(e.target)) {
        blockPopover.classList.remove('open');
        activePopoverBlock = null;
      }
    });

    // Save handler — updates all blocks with same OF
    bpSaveBtn && bpSaveBtn.addEventListener('click', () => {
      if (!activePopoverBlock) return;
      const oldOf      = activePopoverBlock.dataset.of;
      const oldRecurso = activePopoverBlock.dataset.recurso;
      const newOf      = bpOfInput.value.trim()   || oldOf;
      const newRecurso = bpRecursoSel.value;
      const newInicio = bpInicioInp.value.trim();
      const newFin    = bpFinInp.value.trim();
      const newPct    = bpPctInp.value + '%';
      const newEstado = bpEstadoSel.value;

      // Color by estado
      const estadoColor = { 'En plazo':'blue', 'En riesgo':'yellow', 'Retrasada':'red', 'Completada':'green' };
      const newColor = estadoColor[newEstado] || 'blue';

      // Update all blocks sharing the same OF
      document.querySelectorAll(`[data-of="${oldOf}"]`).forEach(bl => {
        bl.dataset.of      = newOf;
        bl.dataset.recurso = newRecurso;
        bl.dataset.inicio  = newInicio;
        bl.dataset.fin     = newFin;
        bl.dataset.pct     = newPct;
        bl.dataset.estado  = newEstado;

        // Update label text (keep "OF · desc" pattern)
        const oldText = bl.textContent.trim();
        const desc = oldText.includes('·') ? oldText.split('·').slice(1).join('·').trim() : '';
        const gbText = bl.querySelector('.gb-text');
        if (gbText) gbText.textContent = desc ? `${newOf} · ${desc}` : newOf;
        else if (!bl.querySelector('.gantt-resize')) bl.textContent = desc ? `${newOf} · ${desc}` : newOf;

        // Update estado color class
        ['gb--blue','gb--green','gb--yellow','gb--red','gb--purple','gb--orange'].forEach(c => bl.classList.remove(c));
        bl.classList.add(`gb--${newColor}`);
      });

      // Move block to new resource row if changed
      if (newRecurso !== oldRecurso) {
        // dataset already updated above; if gantt block, move to first cell of new resource
        if (activePopoverBlock.classList.contains('gantt-block')) {
          const newRow = document.querySelector(`.gantt-row[data-resource="${newRecurso}"]`);
          if (newRow) {
            const cells = newRow.querySelector('.gantt-timeline').querySelectorAll('.gantt-cell');
            const currentCell = activePopoverBlock.parentElement;
            const cellIdx = currentCell ? Array.from(currentCell.parentElement?.children || []).indexOf(currentCell) : 0;
            const targetCell = cells[Math.max(0, cellIdx)] || cells[0];
            if (targetCell) targetCell.appendChild(activePopoverBlock);
          }
        }
      }

      showToast(`✓ ${newOf} actualizada`);
      blockPopover.classList.remove('open');
      activePopoverBlock = null;
    });

    // Delete handler — removes all blocks with same OF
    bpDeleteBtn && bpDeleteBtn.addEventListener('click', () => {
      if (!activePopoverBlock) return;
      const ofVal = activePopoverBlock.dataset.of;
      document.querySelectorAll(`[data-of="${ofVal}"]`).forEach(bl => bl.remove());
      showToast(`Orden ${ofVal} eliminada`);
      blockPopover.classList.remove('open');
      activePopoverBlock = null;
    });

    // 10. ADD ORDER MODAL
    const orderModal  = document.getElementById('orderModal');
    const addOrderBtn = document.getElementById('addOrderBtn');
    const modalClose2 = document.getElementById('modalClose');
    const modalCancel = document.getElementById('modalCancel');
    const modalSubmit = document.getElementById('modalSubmit');
    const DIAS = ['Lun 19','Mar 20','Mié 21','Jue 22','Vie 23'];

    // Populate hour selects once
    const startSel = document.getElementById('f-start');
    const endSel   = document.getElementById('f-end');
    for (let h = 6; h <= 22; h++) {
      const t = String(h).padStart(2,'0') + ':00';
      startSel.add(new Option(t, h));
      endSel.add(new Option(t, h));
    }
    startSel.value = 8;
    endSel.value   = 14;

    // Color picker
    let selectedColor = 'blue';
    document.querySelectorAll('.color-opt').forEach(opt => {
      opt.addEventListener('click', () => {
        document.querySelectorAll('.color-opt').forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        selectedColor = opt.dataset.color;
      });
    });

    function openOrderModal() {
      const isTurno = ganttTurno.style.display !== 'none';
      document.getElementById('modal-semana').hidden = isTurno;
      document.getElementById('modal-turno').hidden  = !isTurno;

      // Auto-generate next order ID
      const nums = Array.from(document.querySelectorAll('[data-of]'))
        .map(el => parseInt(el.dataset.of.replace('OF-','')))
        .filter(n => !isNaN(n));
      const nextNum = nums.length ? Math.max(...nums) + 1 : 2050;
      document.getElementById('f-of').value = `OF-${nextNum}`;
      document.getElementById('f-desc').value = '';

      orderModal.classList.add('open');
    }

    function closeOrderModal() { orderModal.classList.remove('open'); }

    addOrderBtn && addOrderBtn.addEventListener('click', openOrderModal);
    modalClose2 && modalClose2.addEventListener('click', closeOrderModal);
    modalCancel && modalCancel.addEventListener('click', closeOrderModal);
    orderModal.addEventListener('click', e => { if (e.target === orderModal) closeOrderModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && orderModal.classList.contains('open')) closeOrderModal(); });

    modalSubmit && modalSubmit.addEventListener('click', () => {
      const of       = document.getElementById('f-of').value.trim()   || `OF-${Date.now()}`;
      const desc     = document.getElementById('f-desc').value.trim();
      const resource = document.getElementById('f-recurso').value;
      const label    = desc ? `${of} · ${desc}` : of;
      const isTurno  = ganttTurno.style.display !== 'none';

      if (isTurno) {
        const startH = parseInt(startSel.value);
        const endH   = parseInt(endSel.value);
        if (endH <= startH) { showToast('⚠ La hora de fin debe ser posterior al inicio'); return; }
        const totalHours = 16;
        const leftPct  = (startH - 6) / totalHours * 100;
        const widthPct = (endH - startH) / totalHours * 100;

        const block = document.createElement('div');
        block.className = `turno-block gb--${selectedColor}`;
        block.style.left  = leftPct + '%';
        block.style.width = (widthPct - 0.5) + '%';
        block.textContent = label;
        block.dataset.of      = of;
        block.dataset.recurso = resource;
        block.dataset.inicio  = `Mié 21 · ${String(startH).padStart(2,'0')}:00`;
        block.dataset.fin     = `Mié 21 · ${String(endH).padStart(2,'0')}:00`;
        block.dataset.pct     = '0%';
        block.dataset.estado  = 'En plazo';

        const track = document.querySelector(`.turno-row[data-resource="${resource}"] .turno-track`);
        if (track) { track.appendChild(block); initTurnoBlock(block); attachBlockClick(block); }

      } else {
        const dayIdx = parseInt(document.getElementById('f-dia').value);
        const dur    = document.getElementById('f-dur').value;

        const block = document.createElement('div');
        block.className = `gantt-block gb--${selectedColor}`;
        block.style.width     = dur + '%';
        block.style.marginTop = '2px';
        block.textContent     = label;
        block.dataset.of      = of;
        block.dataset.recurso = resource;
        block.dataset.inicio  = DIAS[dayIdx] + ' · 06:00';
        block.dataset.fin     = DIAS[dayIdx] + ' · 22:00';
        block.dataset.pct     = '0%';
        block.dataset.estado  = 'En plazo';

        const row = document.querySelector(`.gantt-row[data-resource="${resource}"]`);
        if (row) {
          const cells = row.querySelector('.gantt-timeline').querySelectorAll('.gantt-cell');
          if (cells[dayIdx]) { cells[dayIdx].appendChild(block); initGanttBlock(block); attachBlockClick(block); }
        }
      }

      showToast(`✓ ${of} añadida al Gantt`);
      closeOrderModal();
    });

    // 11. ZOOM ── ±
    const ZOOM_STEPS = [50, 75, 100, 140, 190, 260];
    const BASE_COL_PX = 160; // px per column at 100%
    let zoomIdx = 2; // index for 100%
    const zoomInBtn  = document.getElementById('zoomIn');
    const zoomOutBtn = document.getElementById('zoomOut');
    const zoomLbl    = document.getElementById('zoomLabel');

    function applyZoom() {
      const pct = ZOOM_STEPS[zoomIdx];
      zoomLbl.textContent = pct + '%';
      zoomOutBtn.disabled = zoomIdx === 0;
      zoomInBtn.disabled  = zoomIdx === ZOOM_STEPS.length - 1;

      if (zoomIdx === 2) {
        // Reset to fluid layout
        document.querySelectorAll('.gantt-grid').forEach(g => g.style.gridTemplateColumns = '');
        document.querySelectorAll('.gantt-days, .gantt-timeline').forEach(el => el.style.gridTemplateColumns = '');
        document.querySelectorAll('.turno-track, .turno-empty-track').forEach(el => el.style.minWidth = '');
        document.querySelectorAll('.turno-hour-header').forEach(el => el.style.minWidth = '');
        document.querySelectorAll('#gantt-turno [style*="grid-template-columns"]').forEach(el => el.style.gridTemplateColumns = '');
      } else {
        const colW  = Math.round(BASE_COL_PX * pct / 100);
        const totalW = 5 * colW;
        document.querySelectorAll('.gantt-grid').forEach(g => {
          g.style.gridTemplateColumns = `148px ${totalW}px`;
        });
        document.querySelectorAll('.gantt-days, .gantt-timeline').forEach(el => {
          el.style.gridTemplateColumns = `repeat(5, ${colW}px)`;
        });
        // Turno: make tracks wide enough
        const turnoMinW = Math.round(800 * pct / 100);
        document.querySelectorAll('.turno-track, .turno-empty-track, .turno-hour-header').forEach(el => {
          el.style.minWidth = turnoMinW + 'px';
        });
        // Turno grid header
        document.querySelectorAll('#gantt-turno > div[style*="grid-template-columns"]').forEach(el => {
          el.style.gridTemplateColumns = `148px ${turnoMinW}px`;
        });
      }
    }

    zoomInBtn  && zoomInBtn.addEventListener('click',  () => { if (zoomIdx < ZOOM_STEPS.length - 1) { zoomIdx++; applyZoom(); } });
    zoomOutBtn && zoomOutBtn.addEventListener('click', () => { if (zoomIdx > 0)                     { zoomIdx--; applyZoom(); } });

    // 11b. LIVE NOW-LINE ── updates every minute
    // Inject keyframes once (inline styles can't use @keyframes from scoped CSS)
    if (!document.getElementById('nowline-style')) {
      const s = document.createElement('style');
      s.id = 'nowline-style';
      s.textContent = '@keyframes nowline-blink{0%,100%{opacity:1}50%{opacity:.25}}';
      document.head.appendChild(s);
    }
    const DAY_START_H = 6, DAY_HOURS = 16; // 06:00 – 22:00
    const TURNO_HOUR_MARKS = [6,8,10,12,14,16,18,20,22];

    function updateNowLine() {
      const now      = new Date();
      const h        = now.getHours();
      const m        = now.getMinutes();
      const timeStr  = String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0');
      const nowDec   = h + m / 60;
      const timeFrac = Math.max(0, Math.min(1, (nowDec - DAY_START_H) / DAY_HOURS));

      // Weekly gantt: find today column and compute left% across all 5 columns
      const dayEls    = document.querySelectorAll('.gantt-days .gantt-day');
      const totalCols = dayEls.length;
      const todayIdx  = Array.from(dayEls).findIndex(d => d.classList.contains('gantt-day--today'));

      if (todayIdx >= 0 && totalCols > 0) {
        const leftPct = (todayIdx + timeFrac) / totalCols * 100;

        document.querySelectorAll('.gantt-timeline').forEach((tl, i) => {
          let nline = tl.querySelector('.today-line');
          if (!nline) {
            nline = document.createElement('div');
            nline.className = 'today-line';
            nline.style.cssText = 'position:absolute;top:0;bottom:0;width:2px;background:#DC2626;z-index:5;pointer-events:none;transition:left .4s ease;animation:nowline-blink 1s ease-in-out infinite';
            tl.appendChild(nline);
          }
          nline.style.left = leftPct + '%';

          // Time label only on first row
          let lbl = nline.querySelector('span');
          if (i === 0) {
            if (!lbl) {
              lbl = document.createElement('span');
              lbl.style.cssText = 'position:absolute;top:4px;left:4px;font-size:.55rem;font-weight:800;color:#DC2626;letter-spacing:.06em;background:rgba(220,38,38,.1);padding:.1rem .3rem;border-radius:3px;white-space:nowrap';
              nline.appendChild(lbl);
            }
            lbl.textContent = timeStr;
          }
        });
      }

      // Turno gantt: highlight current hour cell
      document.querySelectorAll('.turno-hour-cell').forEach((cell, i) => {
        const mark = TURNO_HOUR_MARKS[i];
        const next = TURNO_HOUR_MARKS[i + 1] ?? 23;
        cell.classList.toggle('turno-hour-cell--now', h >= mark && h < next);
      });

      // Turno gantt: live vertical line inside each track (inline styles avoid Astro scope issue)
      const turnoTimeFrac = Math.max(0, Math.min(1, (nowDec - DAY_START_H) / DAY_HOURS));
      const turnoPct = turnoTimeFrac * 100;
      document.querySelectorAll('.turno-track').forEach(track => {
        let nline = track.querySelector('.turno-now-line');
        if (!nline) {
          nline = document.createElement('div');
          nline.className = 'turno-now-line';
          nline.style.cssText = 'position:absolute;top:0;bottom:0;width:2px;background:#DC2626;z-index:4;pointer-events:none;transition:left .4s ease;animation:nowline-blink 1s ease-in-out infinite';
          track.appendChild(nline);
        }
        nline.style.left = turnoPct + '%';
      });
    }

    updateNowLine();
    setInterval(updateNowLine, 60000);

    // 12. EXPAND ── fullscreen toggle
    const expandBtn  = document.getElementById('expandGantt');
    const ganttCard2 = document.querySelector('.gantt-card');
    const expandIconOpen  = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>`;
    const expandIconClose = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="10" y1="14" x2="3" y2="21"/><line x1="21" y1="3" x2="14" y2="10"/></svg>`;
    let ganttExpanded = false;

    expandBtn && expandBtn.addEventListener('click', () => {
      ganttExpanded = !ganttExpanded;
      ganttCard2.classList.toggle('gantt-card--expanded', ganttExpanded);
      expandBtn.innerHTML = ganttExpanded ? expandIconClose : expandIconOpen;
      expandBtn.title = ganttExpanded ? 'Reducir' : 'Ampliar Gantt';
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && ganttExpanded) {
        ganttExpanded = false;
        ganttCard2.classList.remove('gantt-card--expanded');
        expandBtn.innerHTML = expandIconOpen;
        expandBtn.title = 'Ampliar Gantt';
      }
    });
  }

  // Toggle industries panel collapse
  const industriesToggle = document.getElementById('industriesToggle');
  const industriesPanel  = document.getElementById('industriesPanel');
  industriesToggle.addEventListener('click', () => {
    industriesPanel.classList.toggle('collapsed');
    industriesToggle.setAttribute('aria-expanded',
      !industriesPanel.classList.contains('collapsed') ? 'true' : 'false'
    );
  });

  // Logout
  document.getElementById('nav-logout').addEventListener('click', e => {
    e.preventDefault();
    revokeServerSession();
    localStorage.removeItem('pc_token');
    location.reload();
  });

  // ═══ First Build — onboarding shell (localStorage-backed, phase 1) ═══
  (function initOnboarding() {
    const KEY = 'pc_onboarding';
    const STEPS = [
      { id: 'sector',   label: 'Elige tu sector' },
      { id: 'pieces',   label: 'Revisa tus tipos de pieza' },
      { id: 'plan',     label: 'Lanza tu primer plan' },
      { id: 'scenario', label: 'Compara un escenario' },
    ];
    const get  = () => { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { return {}; } };
    const save = (s) => { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {} };
    const doneCount = (s) => { const d = s.steps || {}; return STEPS.filter(x => d[x.id]).length; };
    const labelOf = (id) => (STEPS.find(x => x.id === id) || {}).label || '';

    const welcomeEl   = document.getElementById('ob-welcome');
    const checklistEl = document.getElementById('ob-checklist');
    const reopenEl    = document.getElementById('ob-reopen');
    const authOverlay = document.getElementById('auth-overlay');
    if (!welcomeEl || !checklistEl || !reopenEl) return;

    const loggedIn = () => !!localStorage.getItem('pc_token') && authOverlay && authOverlay.classList.contains('hidden');

    function markStep(id, silent) {
      const s = get();
      if (!s.steps) s.steps = {};
      if (s.steps[id]) return;
      s.steps[id] = true;
      save(s);
      render();
      if (!silent && typeof showToast === 'function') showToast('✓ Hecho: ' + labelOf(id));
      checkComplete();
    }

    function checkComplete() {
      const s = get();
      if (doneCount(s) === STEPS.length && s.status !== 'done') {
        s.status = 'done';
        save(s);
        render();
        if (typeof showToast === 'function') showToast('Tu espacio de trabajo está preparado.', 4000);
      }
    }

    function navTo(id) {
      if (id === 'sector') { const b = document.getElementById('backToSelector'); if (b && !b.classList.contains('hidden')) b.click(); return; }
      if (id === 'pieces') { const m = document.querySelector('.nav-item[data-panel="mrp"]'); if (m) m.click(); }
      if (id === 'plan') {
        const g = document.querySelector('.nav-item[data-panel="gantt"]'); if (g) g.click();
        setTimeout(() => { const t = document.getElementById('plannerToggleBtn'); if (t) t.click(); }, 140);
      }
      if (id === 'scenario') { const e = document.querySelector('.nav-item[data-panel="escenarios"]'); if (e) e.click(); }
    }

    function render() {
      const s = get();
      const d = s.steps || {};
      const n = doneCount(s);
      const complete = n === STEPS.length;
      const pct = Math.round((n / STEPS.length) * 100);

      welcomeEl.classList.toggle('show', !s.welcomed && loggedIn());
      const wb = welcomeEl.querySelector('.ob-w-bar > i');
      if (wb) wb.style.width = pct + '%';
      const wp = welcomeEl.querySelector('.ob-w-progress');
      if (wp) wp.textContent = n === 0
        ? 'Paso 0 de ' + STEPS.length + ' · aún no has configurado nada'
        : 'Paso ' + n + ' de ' + STEPS.length + ' · ' + pct + '%';

      const showCl = loggedIn() && s.welcomed && s.status !== 'hidden' && s.status !== 'dismissedDone';
      checklistEl.classList.toggle('show', showCl);
      checklistEl.classList.toggle('ob-cl-done', complete);
      reopenEl.classList.toggle('show', loggedIn() && s.welcomed && (s.status === 'hidden') && !complete);

      checklistEl.querySelector('.ob-cl-count').textContent = complete ? '¡Listo!' : n + ' / ' + STEPS.length;
      checklistEl.querySelector('.ob-cl-head span:first-child').textContent =
        complete ? 'Espacio de trabajo preparado' : 'Prepara tu espacio de trabajo';

      const firstUndone = STEPS.find(x => !d[x.id]);
      const ul = checklistEl.querySelector('.ob-cl-body');
      ul.innerHTML = STEPS.map(st => {
        const cls = d[st.id] ? 'done' : (firstUndone && firstUndone.id === st.id ? 'now' : '');
        return '<li data-step="' + st.id + '" class="' + cls + '"><span class="ob-box">' + (d[st.id] ? '&#10003;' : '') + '</span><span>' + st.label + '</span></li>';
      }).join('');
      // Astro scopes <style> to elements stamped at build time; JS-built <li> need the
      // scope attribute copied from a static ancestor or the rules silently don't match.
      const scopeAttr = Array.prototype.slice.call(checklistEl.attributes).find(a => a.name.indexOf('data-astro-cid') === 0);
      if (scopeAttr) ul.querySelectorAll('*').forEach(el => el.setAttribute(scopeAttr.name, scopeAttr.value));
      ul.querySelectorAll('li').forEach(li => li.addEventListener('click', () => navTo(li.getAttribute('data-step'))));

      const footBtn = checklistEl.querySelector('.ob-cl-foot button');
      const footTxt = checklistEl.querySelector('.ob-cl-foot span');
      if (complete) { footBtn.textContent = 'Cerrar'; footBtn.dataset.ob = 'closeDone'; footTxt.textContent = STEPS.length + ' pasos completados'; }
      else { footBtn.textContent = 'Ocultar'; footBtn.dataset.ob = 'hide'; footTxt.textContent = 'Se guarda automáticamente'; }
    }

    welcomeEl.querySelector('[data-ob="start"]').addEventListener('click', () => { const s = get(); s.welcomed = true; save(s); render(); });
    welcomeEl.querySelector('[data-ob="explore"]').addEventListener('click', () => { const s = get(); s.welcomed = true; s.status = 'exploring'; save(s); render(); });

    checklistEl.querySelector('.ob-cl-head').addEventListener('click', () => checklistEl.classList.toggle('collapsed'));
    checklistEl.querySelector('.ob-cl-foot button').addEventListener('click', function () {
      const s = get();
      s.status = this.dataset.ob === 'closeDone' ? 'dismissedDone' : 'hidden';
      save(s); render();
    });
    reopenEl.addEventListener('click', () => { const s = get(); s.status = 'exploring'; save(s); render(); });

    // ── completion event wiring ──
    document.querySelectorAll('#industry-selector .industry-card').forEach(c =>
      c.addEventListener('click', () => markStep('sector')));
    document.querySelectorAll('.nav-item[data-panel]').forEach(item =>
      item.addEventListener('click', () => {
        const p = item.dataset.panel;
        if (p === 'mrp') markStep('pieces');
        if (p === 'escenarios') markStep('scenario');
      }));
    const altHost = document.getElementById('planner-alternatives');
    if (altHost && 'MutationObserver' in window) {
      new MutationObserver(() => {
        if (altHost.querySelector('.alt-card')) markStep('plan');
        const sim = altHost.querySelector('.alt-card__sim');
        if (sim && !sim.classList.contains('alt-card__sim--loading') && sim.textContent.trim()) markStep('scenario');
      }).observe(altHost, { childList: true, subtree: true });
    }
    // re-render when auth resolves / the dashboard shows
    if (authOverlay && 'MutationObserver' in window) {
      new MutationObserver(() => {
        if (authOverlay.classList.contains('hidden')) {
          const dv = document.getElementById('dashboard-view');
          if (dv && dv.classList.contains('visible')) markStep('sector', true);
          render();
        }
      }).observe(authOverlay, { attributes: true, attributeFilter: ['class'] });
    }

    render();
  })();

  applySettings();   // theme / density / language / gantt colours from pc_settings
  init();
</script>

<!-- ── ADD ORDER MODAL ── -->
<div class="modal-backdrop" id="orderModal">
  <div class="modal">
    <div class="modal__header">
      <span class="modal__title">Añadir orden al Gantt</span>
      <button class="modal__close" id="modalClose">×</button>
    </div>
    <div class="modal__body">
      <div class="form-row">
        <div class="form-field">
          <label class="form-label">ID de orden</label>
          <input class="form-input" id="f-of" placeholder="OF-2050" />
        </div>
        <div class="form-field">
          <label class="form-label">Descripción</label>
          <input class="form-input" id="f-desc" placeholder="Carcasa B · Serie 300" />
        </div>
      </div>
      <div class="form-field">
        <label class="form-label">Recurso</label>
        <select class="form-select" id="f-recurso">
          <option value="cnc-1">CNC-1 — Fresado</option>
          <option value="cnc-2">CNC-2 — Torneado</option>
          <option value="soldadura">Soldadura (Robot MIG)</option>
          <option value="acabados">Acabados (Pintura + QC)</option>
          <option value="embalaje">Embalaje / Expedición</option>
        </select>
      </div>
      <!-- Semana-specific fields -->
      <div class="modal-view-section" id="modal-semana">
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">Día</label>
            <select class="form-select" id="f-dia">
              <option value="0">Lunes 19</option>
              <option value="1">Martes 20</option>
              <option value="2">Miércoles 21</option>
              <option value="3">Jueves 22</option>
              <option value="4">Viernes 23</option>
            </select>
          </div>
          <div class="form-field">
            <label class="form-label">Duración en celda</label>
            <select class="form-select" id="f-dur">
              <option value="100">Todo el día (100%)</option>
              <option value="75">75%</option>
              <option value="50">Media jornada (50%)</option>
              <option value="25">25%</option>
            </select>
          </div>
        </div>
      </div>
      <!-- Turno-specific fields -->
      <div class="modal-view-section" id="modal-turno" hidden>
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">Hora inicio</label>
            <select class="form-select" id="f-start"></select>
          </div>
          <div class="form-field">
            <label class="form-label">Hora fin</label>
            <select class="form-select" id="f-end"></select>
          </div>
        </div>
      </div>
      <div class="form-field">
        <label class="form-label">Color</label>
        <div class="color-picker" id="colorPicker">
          <div class="color-opt selected" data-color="blue"   style="background:#1B3F8B"></div>
          <div class="color-opt"          data-color="teal"   style="background:#0891B2"></div>
          <div class="color-opt"          data-color="green"  style="background:#16A34A"></div>
          <div class="color-opt"          data-color="purple" style="background:#7C3AED"></div>
          <div class="color-opt"          data-color="amber"  style="background:#D97706"></div>
          <div class="color-opt"          data-color="gray"   style="background:#64748B"></div>
        </div>
      </div>
    </div>
    <div class="modal__footer">
      <button class="btn-ui" id="modalCancel">Cancelar</button>
      <button class="btn-ui btn-ui--primary" id="modalSubmit">Añadir al Gantt</button>
    </div>
  </div>
</div>

</body>
</html>
