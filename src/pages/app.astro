      // ── Users ──
      async function loadAdminUsers() {
        const token = localStorage.getItem('pc_token');
        if (!token) return;
        await loadAdminCompanies();
        try {
          const res = await fetch(`${API_BASE}/admin/users`, { headers: { Authorization: `Bearer ${token}` } });
          const users = await res.json();
          adminUsersList = users;
          renderAdminUsers(users);
        } catch { document.getElementById('usersBody')!.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--red)">Error al cargar usuarios</td></tr>'; }
      }

      function renderAdminUsers(users: any[]) {
        const tbody = document.getElementById('usersBody')!;
        if (!users.length) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--n50)">No hay usuarios todavía</td></tr>'; return; }
        tbody.innerHTML = users.map(u => {
          const companyName = u.company_id ? (adminCompanies.find((c: any) => c.id === u.company_id)?.name || u.company || '—') : (u.company || '—');
          const sectors = u.is_admin ? '<span style="color:var(--amber);font-size:.72rem">Todos</span>'
            : (u.sector ? u.sector.split(',').map((s: string) => s.trim()).join(', ') : '<span style="color:var(--red);font-size:.72rem">Sin asignar</span>');
          return `<tr>
            <td><div style="font-weight:600">${u.name}</div><div style="font-size:.72rem;color:var(--n50)">${u.email}</div></td>
            <td style="font-size:.78rem;color:var(--n30)">${companyName}</td>
            <td style="font-size:.78rem;color:var(--n50)">${sectors}</td>
            <td><span class="admin-badge ${u.is_admin ? 'admin-badge--admin' : ''}" style="${!u.is_admin ? 'background:var(--n90);color:var(--n50)' : ''}">${u.is_admin ? 'Admin' : 'Cliente'}</span></td>
            <td><span class="admin-badge ${u.is_active ? 'admin-badge--active' : 'admin-badge--inactive'}">${u.is_active ? 'Activo' : 'Inactivo'}</span></td>
            <td style="font-size:.72rem;color:var(--n50)">${u.last_login ? new Date(u.last_login).toLocaleDateString('es-ES') : 'Nunca'}</td>
            <td>
              <button class="admin-action-btn" data-edit-user="${u.id}">Editar</button>
              <button class="admin-action-btn" data-toggle-user="${u.id}" data-toggle-active="${u.is_active}">${u.is_active ? 'Revocar' : 'Reactivar'}</button>
              <button class="admin-action-btn del" data-del-user="${u.id}" data-del-user-name="${u.name}">Eliminar</button>
            </td>
          </tr>`;
        }).join('');

        tbody.querySelectorAll('[data-edit-user]').forEach(btn => {
          btn.addEventListener('click', () => openUserModal(parseInt((btn as HTMLElement).dataset.editUser!)));
        });
        tbody.querySelectorAll('[data-toggle-user]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const el = btn as HTMLElement;
            const isActive = el.dataset.toggleActive === 'true';
            const target = adminUsersList.find((x: any) => x.id === parseInt(el.dataset.toggleUser!));
            if (isActive && !confirm(`¿Revocar el acceso de ${target?.name || 'este usuario'}? No podrá iniciar sesión hasta que se reactive.`)) return;
            const token = localStorage.getItem('pc_token');
            const res = await fetch(`${API_BASE}/admin/users/${el.dataset.toggleUser}`, { method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ is_active: !isActive }) });
            if (!res.ok) { const d = await res.json().catch(() => ({})); showToast(`⚠ ${d.detail || 'No se pudo actualizar'}`); return; }
            showToast(isActive ? '✓ Acceso revocado' : '✓ Acceso restaurado');
            loadAdminUsers();
          });
        });
        tbody.querySelectorAll('[data-del-user]').forEach(btn => {
          const el = btn as HTMLElement;
          btn.addEventListener('click', async () => {
            if (!confirm(`¿Eliminar a ${el.dataset.delUserName}?`)) return;
            const token = localStorage.getItem('pc_token');
            await fetch(`${API_BASE}/admin/users/${el.dataset.delUser}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
            loadAdminUsers();
          });
        });
      }

      function openUserModal(id?: number) {
        editingUserId = id || null;
        const u = id ? adminUsersList.find((x: any) => x.id === id) : null;
