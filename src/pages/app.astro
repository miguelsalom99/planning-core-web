        (document.getElementById('pt-name') as HTMLInputElement).value = pt?.name || '';
        (document.getElementById('pt-layup') as HTMLInputElement).value = pt?.layup_type || 'Cuasi-isótropo';
        (document.getElementById('pt-atl-hours') as HTMLInputElement).value = String(pt?.atl_hours ?? 4);
        (document.getElementById('pt-autoclave-hours') as HTMLInputElement).value = String(pt?.autoclave_hours ?? 8);
        (document.getElementById('pt-ndt-hours') as HTMLInputElement).value = String(pt?.ndt_hours ?? 2);
        (document.getElementById('pt-cnc-hours') as HTMLInputElement).value = String(pt?.cnc_hours ?? 2);
        (document.getElementById('pt-workers-atl') as HTMLInputElement).value = String(pt?.workers_atl ?? 1);
        (document.getElementById('pt-workers-bag') as HTMLInputElement).value = String(pt?.workers_bag ?? 2);
        (document.getElementById('pt-workers-autoclave') as HTMLInputElement).value = String(pt?.workers_autoclave ?? 1);
        (document.getElementById('pt-workers-ndt') as HTMLInputElement).value = String(pt?.workers_ndt ?? 1);
        (document.getElementById('pt-workers-cnc') as HTMLInputElement).value = String(pt?.workers_cnc ?? 1);
        document.getElementById('pieceTypeModal')!.classList.add('open');
        document.getElementById('pt-name')?.focus();
      }
      function closePieceTypeModal() { document.getElementById('pieceTypeModal')!.classList.remove('open'); }

      async function savePieceType() {
        const token = localStorage.getItem('pc_token');
        const errEl = document.getElementById('pieceTypeModalErr')!;
        const name = (document.getElementById('pt-name') as HTMLInputElement).value.trim();
        if (!name) { errEl.textContent = 'El nombre es obligatorio'; return; }
        errEl.textContent = '';
        const body = {
          name,
          layup_type: (document.getElementById('pt-layup') as HTMLInputElement).value.trim() || 'Cuasi-isótropo',
          atl_hours: Number((document.getElementById('pt-atl-hours') as HTMLInputElement).value) || 0,
          autoclave_hours: Number((document.getElementById('pt-autoclave-hours') as HTMLInputElement).value) || 0,
          ndt_hours: Number((document.getElementById('pt-ndt-hours') as HTMLInputElement).value) || 0,
          cnc_hours: Number((document.getElementById('pt-cnc-hours') as HTMLInputElement).value) || 0,
          workers_atl: Number((document.getElementById('pt-workers-atl') as HTMLInputElement).value) || 0,
          workers_bag: Number((document.getElementById('pt-workers-bag') as HTMLInputElement).value) || 0,
          workers_autoclave: Number((document.getElementById('pt-workers-autoclave') as HTMLInputElement).value) || 0,
          workers_ndt: Number((document.getElementById('pt-workers-ndt') as HTMLInputElement).value) || 0,
          workers_cnc: Number((document.getElementById('pt-workers-cnc') as HTMLInputElement).value) || 0,
        };
        const url = editingPieceTypeId ? `${API_BASE}/api/piece-types/${editingPieceTypeId}` : `${API_BASE}/api/piece-types`;
        const method = editingPieceTypeId ? 'PATCH' : 'POST';
        const res = await fetch(url, { method, headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (!res.ok) { const d = await res.json(); errEl.textContent = d.detail || 'Error al guardar'; return; }
        closePieceTypeModal();
        loadAdminPieceTypes();
        showToast(editingPieceTypeId ? '✓ Tipo de pieza actualizado' : '✓ Tipo de pieza creado');
      }

      async function deletePieceType(id: number, name: string) {
        if (!confirm(`¿Eliminar "${name}"? Los planes que lo usen dejarán de poder referenciarlo.`)) return;
        const token = localStorage.getItem('pc_token');
        const res = await fetch(`${API_BASE}/api/piece-types/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
        if (!res.ok) { showToast('⚠ No se pudo eliminar'); return; }
        loadAdminPieceTypes();
        showToast('Tipo de pieza eliminado');
      }

      document.getElementById('newPieceTypeBtn')?.addEventListener('click', () => openPieceTypeModal());
      document.getElementById('pieceTypeModalClose')?.addEventListener('click', closePieceTypeModal);
      document.getElementById('pieceTypeModalCancel')?.addEventListener('click', closePieceTypeModal);
      document.getElementById('pieceTypeModalSave')?.addEventListener('click', savePieceType);
      document.getElementById('pieceTypeModal')?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === document.getElementById('pieceTypeModal')) closePieceTypeModal();
      });

      // Load on panel open
      document.querySelector('.nav-item[data-panel="admin"]')?.addEventListener('click', () => {
        loadAdminCompanies();
      });
    }

    // ── Theme toggle ─────────────────────────────────────────────
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    function applyTheme(dark: boolean) {
      if (dark) {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
      }
    }
    themeToggleBtn?.addEventListener('click', () => {
      applyTheme(document.documentElement.getAttribute('data-theme') !== 'dark');
    });

    // ── Topbar: notifications & settings buttons ─────────────────
    function navToPanel(panelId: string) {
      document.querySelectorAll('.nav-item[data-panel]').forEach(n => n.classList.remove('nav-item--active'));
      document.querySelector(`.nav-item[data-panel="${panelId}"]`)?.classList.add('nav-item--active');
      document.querySelectorAll('.dash-panel').forEach(p => (p as HTMLElement).style.display = 'none');
      const target = document.getElementById(`panel-${panelId}`);
      if (target) target.style.display = '';
      closeMobileSidebar();
    }

    // ── Mobile sidebar drawer ──────────────────────────────────────
    const sidebarEl2       = document.getElementById('sidebar');
    const sidebarToggleBtn = document.getElementById('sidebarToggle');
    const sidebarBackdropEl = document.getElementById('sidebarBackdrop');

    function openMobileSidebar() {
      sidebarEl2?.classList.add('mobile-open');
      sidebarBackdropEl?.classList.add('open');
    }
    function closeMobileSidebar() {
      sidebarEl2?.classList.remove('mobile-open');
      sidebarBackdropEl?.classList.remove('open');
    }
    sidebarToggleBtn?.addEventListener('click', () => {
      if (sidebarEl2?.classList.contains('mobile-open')) closeMobileSidebar();
      else openMobileSidebar();
    });
    sidebarBackdropEl?.addEventListener('click', closeMobileSidebar);
    window.addEventListener('resize', () => {
      if (window.innerWidth > 860) closeMobileSidebar();
    });

    // ── Global search ────────────────────────────────────────────
    const searchOverlay   = document.getElementById('searchOverlay');
    const searchInput     = document.getElementById('searchInput') as HTMLInputElement | null;
    const searchResultsEl = document.getElementById('searchResults');

    const searchCache: { planificaciones: any[]; companies: any[]; users: any[]; pieceTypes: any[] } = { planificaciones: [], companies: [], users: [], pieceTypes: [] };
    let searchCacheLoaded = false;
    let searchActiveIndex = -1;
    let currentSearchResults: any[] = [];

    const SEARCH_ICONS: Record<string, string> = {
      orden: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>',
      alerta: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
      disrupcion: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
      plan: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>',
      empresa: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>',
      usuario: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>',
      piezatipo: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
    };

    function escapeHtml(s: string): string {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return s.replace(/[&<>"']/g, c => map[c]);
    }
    function highlightMatch(text: string, q: string): string {
      const idx = text.toLowerCase().indexOf(q.toLowerCase());
      if (idx === -1 || !q) return escapeHtml(text);
      return escapeHtml(text.slice(0, idx)) + '<mark>' + escapeHtml(text.slice(idx, idx + q.length)) + '</mark>' + escapeHtml(text.slice(idx + q.length));
    }

    async function loadSearchCache() {
      searchCacheLoaded = true;
      const token = localStorage.getItem('pc_token');
      try {
        const res = await fetch(`${API_BASE}/planificaciones`, { headers: { Authorization: `Bearer ${token}` } });
        searchCache.planificaciones = res.ok ? await res.json() : [];
      } catch { searchCache.planificaciones = []; }
      if (localStorage.getItem('pc_is_admin') === 'true') {
        try {
          const [compRes, usersRes] = await Promise.all([
            fetch(`${API_BASE}/admin/companies`, { headers: { Authorization: `Bearer ${token}` } }),
            fetch(`${API_BASE}/admin/users`, { headers: { Authorization: `Bearer ${token}` } }),
          ]);
          searchCache.companies = compRes.ok ? await compRes.json() : [];
          searchCache.users = usersRes.ok ? await usersRes.json() : [];
        } catch { searchCache.companies = []; searchCache.users = []; }
        try {
          const ptRes = await fetch(`${API_BASE}/api/piece-types`, { headers: { Authorization: `Bearer ${token}` } });
          searchCache.pieceTypes = ptRes.ok ? await ptRes.json() : [];
        } catch { searchCache.pieceTypes = []; }
      }
    }

    function jumpToRow(panel: string, row: Element) {
      navToPanel(panel);
      closeSearch();
      setTimeout(() => {
        row.scrollIntoView({ block: 'center', behavior: 'smooth' });
        row.classList.add('search-highlight-flash');
        setTimeout(() => row.classList.remove('search-highlight-flash'), 1600);
      }, 100);
    }

    function runSearch(qRaw: string) {
      const q = qRaw.trim();
      searchActiveIndex = -1;
      if (!q) { renderSearchResults([], ''); return; }
      const ql = q.toLowerCase();
      const results: any[] = [];

      document.querySelectorAll('#ordersBody tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        if (!cells.length) return;
        const id = cells[0]?.textContent?.trim() || '';
        const desc = cells[1]?.textContent?.trim() || '';
        const resource = cells[2]?.textContent?.trim() || '';
        if (`${id} ${desc} ${resource}`.toLowerCase().includes(ql)) {
          results.push({ group: 'Órdenes', type: 'orden', title: id, sub: `${desc} · ${resource}`, action: () => jumpToRow('ordenes', row) });
        }
      });

      document.querySelectorAll('#alertList .alert-row').forEach(row => {
        const text = row.querySelector('.alert-desc')?.textContent?.trim() || '';
        if (text.toLowerCase().includes(ql)) {
          results.push({ group: 'Alertas', type: 'alerta', title: text.length > 70 ? text.slice(0, 70) + '…' : text, sub: '', action: () => jumpToRow('alertas', row) });
        }
      });

      document.querySelectorAll('#panel-disrupciones .disrupt-row').forEach(row => {
        const title = row.querySelector('.disrupt-title')?.textContent?.trim() || '';
        const detail = row.querySelector('.disrupt-detail')?.textContent?.trim() || '';
        if (`${title} ${detail}`.toLowerCase().includes(ql)) {
          results.push({ group: 'Disrupciones', type: 'disrupcion', title, sub: detail, action: () => jumpToRow('disrupciones', row) });
        }
      });

      searchCache.planificaciones.forEach((p: any) => {
        if (`${p.nombre} ${p.descripcion || ''}`.toLowerCase().includes(ql)) {
          results.push({
            group: 'Planificaciones guardadas', type: 'plan', title: p.nombre, sub: p.descripcion || '',
            action: () => { navToPanel('historial'); closeSearch(); },
          });
        }
      });

      searchCache.companies.forEach((c: any) => {
        if ((c.name || '').toLowerCase().includes(ql)) {
          results.push({
            group: 'Empresas', type: 'empresa', title: c.name, sub: c.industry || '',
            action: () => { navToPanel('admin'); document.getElementById('adminTabCompanies')?.dispatchEvent(new MouseEvent('click')); closeSearch(); },
          });
        }
      });
      searchCache.users.forEach((u: any) => {
        if (`${u.name} ${u.email}`.toLowerCase().includes(ql)) {
          results.push({
            group: 'Usuarios', type: 'usuario', title: u.name, sub: u.email,
            action: () => { navToPanel('admin'); document.getElementById('adminTabUsers')?.dispatchEvent(new MouseEvent('click')); closeSearch(); },
          });
        }
      });
      searchCache.pieceTypes.forEach((pt: any) => {
        if (`${pt.name} ${pt.layup_type}`.toLowerCase().includes(ql)) {
          results.push({
            group: 'Tipos de pieza', type: 'piezatipo', title: pt.name, sub: pt.layup_type,
            action: () => { navToPanel('admin'); document.getElementById('adminTabPieceTypes')?.dispatchEvent(new MouseEvent('click')); closeSearch(); },
          });
        }
      });

      renderSearchResults(results, q);
    }

    function renderSearchResults(results: any[], q: string) {
      currentSearchResults = results;
      if (!searchResultsEl) return;
      if (!results.length) {
        searchResultsEl.innerHTML = `<div class="search-empty">${q ? 'Sin resultados para “' + escapeHtml(q) + '”.' : 'Escribe para buscar en todo el panel.'}</div>`;
        return;
      }
      const groups: Record<string, any[]> = {};
      results.forEach(r => {
        if (!groups[r.group]) groups[r.group] = [];
        groups[r.group].push(r);
      });
      let html = '';
      let idx = 0;
      Object.entries(groups).forEach(([group, items]) => {
        html += `<div class="search-group-label">${escapeHtml(group)}</div>`;
        items.forEach(r => {
          html += `<div class="search-result-item" data-idx="${idx}">
            <div class="search-result-icon">${SEARCH_ICONS[r.type] || ''}</div>
            <div class="search-result-body">
              <div class="search-result-title">${highlightMatch(r.title, q)}</div>
              ${r.sub ? `<div class="search-result-sub">${escapeHtml(r.sub)}</div>` : ''}
            </div>
          </div>`;
          idx++;
        });
      });
      searchResultsEl.innerHTML = html;
      searchResultsEl.querySelectorAll('.search-result-item').forEach(el => {
        el.addEventListener('click', () => {
          const i = parseInt((el as HTMLElement).dataset.idx || '-1');
          currentSearchResults[i]?.action();
        });
      });
    }

    function updateActiveResult(items: NodeListOf<Element>) {
      items.forEach((it, i) => it.classList.toggle('search-result-item--active', i === searchActiveIndex));
      (items[searchActiveIndex] as HTMLElement)?.scrollIntoView({ block: 'nearest' });
    }

    function openSearch() {
      searchOverlay?.classList.add('open');
      closeMobileSidebar();
      searchInput?.focus();
      if (!searchCacheLoaded) loadSearchCache();
    }
    function closeSearch() {
      searchOverlay?.classList.remove('open');
      if (searchInput) searchInput.value = '';
      renderSearchResults([], '');
    }

    let searchDebounce: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => runSearch(searchInput!.value), 120);
    });
    searchInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      const items = searchResultsEl?.querySelectorAll('.search-result-item');
      if (!items || !items.length) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        searchActiveIndex = Math.min(searchActiveIndex + 1, items.length - 1);
        updateActiveResult(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        searchActiveIndex = Math.max(searchActiveIndex - 1, 0);
        updateActiveResult(items);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const target = searchActiveIndex >= 0 ? currentSearchResults[searchActiveIndex] : currentSearchResults[0];
        target?.action();
      }
    });
    document.getElementById('searchBtn')?.addEventListener('click', openSearch);
    searchOverlay?.addEventListener('click', (e: MouseEvent) => { if (e.target === searchOverlay) closeSearch(); });
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
      else if (e.key === 'Escape' && searchOverlay?.classList.contains('open')) closeSearch();
    });

    // Bell → open Alertas panel
    document.getElementById('notifBtn')?.addEventListener('click', () => {
      if (document.getElementById('dashboard-view')?.style.display === 'none') return;
      navToPanel('alertas');
    });

    // Gear → dropdown
    const settingsBtn      = document.getElementById('settingsBtn');
    const settingsDropdown = document.getElementById('settingsDropdown');

    settingsBtn?.addEventListener('click', e => {
      e.stopPropagation();
      settingsDropdown?.classList.toggle('open');
    });

    document.addEventListener('click', e => {
      if (settingsDropdown && !settingsDropdown.contains(e.target as Node) && e.target !== settingsBtn) {
        settingsDropdown.classList.remove('open');
      }
    });

    settingsDropdown?.querySelectorAll('[data-settings-action]').forEach(item => {
      item.addEventListener('click', () => {
        settingsDropdown.classList.remove('open');
        const action = (item as HTMLElement).dataset.settingsAction;
        if (action === 'mrp') {
          navToPanel('mrp');
          initMrpPanel();
        } else if (action === 'historial') {
          navToPanel('historial');
          loadHistorial();
        } else if (action === 'tiempos') {
          navToPanel('mrp');
          initMrpPanel();
          // Switch to tiempos tab
          setTimeout(() => {
            document.querySelector('.mrp-tab[data-mrptab="tiempos"]')?.dispatchEvent(new MouseEvent('click'));
          }, 50);
        } else if (action === 'logout') {
          localStorage.removeItem('pc_token');
          localStorage.removeItem('pc_email');
          showToast('Sesión cerrada');
          setTimeout(() => { window.location.href = '/'; }, 1000);
        } else if (action === 'seguridad') {
          openSecurityQuestionModal();
        }
      });
    });

    // ── Security question modal ─────────────────────────────────────
    const securityQuestionModal  = document.getElementById('securityQuestionModal');
    const securityQuestionStatus = document.getElementById('securityQuestionStatus');

    async function openSecurityQuestionModal() {
      if (!securityQuestionModal) return;
      if (securityQuestionStatus) securityQuestionStatus.textContent = 'Cargando…';
      (document.getElementById('sq-question') as HTMLInputElement).value = '';
      (document.getElementById('sq-answer') as HTMLInputElement).value = '';
      securityQuestionModal.classList.add('open');
      const token = localStorage.getItem('pc_token');
      try {
        const res = await fetch(`${API_BASE}/auth/security-question`, { headers: { Authorization: `Bearer ${token}` } });
        const data = await res.json();
        if (data.has_security_question) {
          (document.getElementById('sq-question') as HTMLInputElement).value = data.question;
          if (securityQuestionStatus) securityQuestionStatus.textContent = 'Ya tienes una pregunta configurada. Puedes actualizarla (deberás escribir la respuesta de nuevo).';
        } else {
          if (securityQuestionStatus) securityQuestionStatus.textContent = 'Aún no tienes una pregunta de seguridad configurada.';
        }
      } catch {
        if (securityQuestionStatus) securityQuestionStatus.textContent = '';
      }
    }
    function closeSecurityQuestionModal() { securityQuestionModal?.classList.remove('open'); }

    document.getElementById('securityQuestionClose')?.addEventListener('click', closeSecurityQuestionModal);
    document.getElementById('securityQuestionCancel')?.addEventListener('click', closeSecurityQuestionModal);
    securityQuestionModal?.addEventListener('click', (e: MouseEvent) => {
      if (e.target === securityQuestionModal) closeSecurityQuestionModal();
    });
    document.getElementById('securityQuestionSave')?.addEventListener('click', async () => {
      const question = (document.getElementById('sq-question') as HTMLInputElement).value.trim();
      const answer   = (document.getElementById('sq-answer') as HTMLInputElement).value.trim();
      if (!question || !answer) {
        if (securityQuestionStatus) securityQuestionStatus.textContent = 'La pregunta y la respuesta son obligatorias.';
        return;
      }
      const btn = document.getElementById('securityQuestionSave') as HTMLButtonElement;
      btn.disabled = true;
      const token = localStorage.getItem('pc_token');
      try {
        const res = await fetch(`${API_BASE}/auth/security-question`, {
          method: 'PUT',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ question, answer }),
        });
        if (!res.ok) { const d = await res.json(); throw new Error(d.detail || 'Error al guardar'); }
        showToast('✓ Pregunta de seguridad guardada');
        closeSecurityQuestionModal();
      } catch (e: any) {
        if (securityQuestionStatus) securityQuestionStatus.textContent = e.message || 'Error al guardar';
      } finally {
        btn.disabled = false;
      }
    });

    // Sync notif badge with alert count
    function syncNotifBadge() {
      const active = document.querySelectorAll('#alertList .alert-row:not(.alert-row--resolved)').length;
      const badge  = document.getElementById('notifBadge');
      if (badge) badge.style.display = active > 0 ? '' : 'none';
    }
    // Run once and re-run whenever alerts change (observe the list)
    syncNotifBadge();
    const _alertObserver = new MutationObserver(syncNotifBadge);
    const _alertList = document.getElementById('alertList');
    if (_alertList) _alertObserver.observe(_alertList, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });

    // 3. Alert banner — "Ver sugerencia"
    const alertCTA    = document.querySelector('.alert-banner__cta');
    const alertBanner = document.querySelector('.alert-banner');
    if (alertCTA && alertBanner) {
      alertCTA.addEventListener('click', () => {
        alertBanner.style.transition = 'opacity .25s, transform .25s';
        alertBanner.style.opacity = '0';
        alertBanner.style.transform = 'translateY(-6px)';
        setTimeout(() => { alertBanner.style.display = 'none'; }, 260);
        showToast('✓ Sugerencia aplicada · OF-2041 movida al turno tarde');
      });
    }

    // 4. Replanificar IA
    const replanBtn = document.querySelector('.btn-ui--primary');
    if (replanBtn) {
      replanBtn.addEventListener('click', async () => {
        if (replanBtn.disabled) return;
        const original = replanBtn.innerHTML;
        replanBtn.disabled = true;
        replanBtn.innerHTML = `<svg class="spin-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Calculando…`;
        await new Promise(r => setTimeout(r, 2200));
        replanBtn.innerHTML = original;
        replanBtn.disabled = false;
        showToast('✓ Plan optimizado · 3 órdenes reordenadas · CNC-2 pasa al 81%', 4000);
      });
    }

    // 5. Exportar
    const exportBtn = document.querySelector('.header-actions .btn-ui:first-child');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        showToast('Plan exportado · Descarga iniciada');
      });
    }

    // 6. Escenarios
    const scenariosBtn = document.querySelector('.header-actions .btn-ui:nth-child(2)');
    if (scenariosBtn) {
      scenariosBtn.addEventListener('click', () => {
        showToast('Escenarios: función disponible próximamente');
      });
    }

    // 7. FILTRAR — real filter dropdown
    const filterBtn     = document.getElementById('filterBtn');
    const filterDropdown = document.getElementById('filterDropdown');
    const filterBadge   = document.getElementById('filterBadge');
    const filterApply   = document.getElementById('filterApply');
    const filterClear   = document.getElementById('filterClear');
    const ganttSub2     = document.querySelector('.gantt-header__sub');

    // Status chip toggle
    document.querySelectorAll('#filterDropdown [data-status]').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('#filterDropdown [data-status]').forEach(c => c.classList.remove('chip--active'));
        chip.classList.add('chip--active');
      });
    });

    filterBtn && filterBtn.addEventListener('click', e => {
      e.stopPropagation();
      filterDropdown.classList.toggle('open');
    });

    document.addEventListener('click', e => {
      if (filterDropdown && !filterDropdown.contains(e.target) && e.target !== filterBtn) {
        filterDropdown.classList.remove('open');
      }
    });

    function applyFilters() {
      const checkboxes = document.querySelectorAll('#filterDropdown input[type=checkbox]');
      const statusChip = document.querySelector('#filterDropdown [data-status].chip--active');
      const activeStatus = statusChip ? statusChip.dataset.status : 'todos';

      const unchecked = Array.from(checkboxes).filter(cb => !cb.checked).map(cb => cb.dataset.resource);

      // Filter semana rows
      document.querySelectorAll('.gantt-grid .gantt-row').forEach(row => {
        const res = row.dataset.resource;
        if (unchecked.includes(res)) {
          row.classList.add('gantt-row--hidden');
        } else {
          // Apply status filter to blocks inside
          if (activeStatus !== 'todos') {
            const blocks = row.querySelectorAll('.gantt-block');
            let hasMatch = false;
            blocks.forEach(b => {
              const match = activeStatus === 'riesgo'
                ? b.dataset.estado === 'En riesgo'
                : b.dataset.estado === 'En plazo';
              b.style.opacity = match ? '1' : '0.2';
              if (match) hasMatch = true;
            });
            row.classList.toggle('gantt-row--hidden', !hasMatch);
          } else {
            row.querySelectorAll('.gantt-block').forEach(b => b.style.opacity = '1');
            row.classList.remove('gantt-row--hidden');
          }
        }
      });

      // Filter turno rows
      document.querySelectorAll('.turno-row').forEach(row => {
        const res = row.dataset.resource;
        row.style.display = unchecked.includes(res) ? 'none' : '';
      });

      // Update badge + button state
      const totalHidden = unchecked.length + (activeStatus !== 'todos' ? 1 : 0);
      if (totalHidden > 0) {
        filterBadge.textContent = totalHidden;
        filterBadge.style.display = '';
        filterBtn.classList.add('filter-btn--active');
      } else {
        filterBadge.style.display = 'none';
        filterBtn.classList.remove('filter-btn--active');
      }

      // Update subtitle
      const visibleSemana = document.querySelectorAll('.gantt-grid .gantt-row:not(.gantt-row--hidden)').length;
      if (ganttSub2) ganttSub2.textContent = `${visibleSemana} recursos · 12 órdenes activas`;

      filterDropdown.classList.remove('open');
    }

    function clearFilters() {
      document.querySelectorAll('#filterDropdown input[type=checkbox]').forEach(cb => cb.checked = true);
      document.querySelectorAll('#filterDropdown [data-status]').forEach(c => c.classList.remove('chip--active'));
      document.querySelector('#filterDropdown [data-status="todos"]').classList.add('chip--active');
      document.querySelectorAll('.gantt-grid .gantt-row').forEach(r => {
        r.classList.remove('gantt-row--hidden');
        r.querySelectorAll('.gantt-block').forEach(b => b.style.opacity = '1');
      });
      document.querySelectorAll('.turno-row').forEach(r => r.style.display = '');
      filterBadge.style.display = 'none';
      filterBtn.classList.remove('filter-btn--active');
      if (ganttSub2) ganttSub2.textContent = '5 recursos · 12 órdenes activas';
      filterDropdown.classList.remove('open');
    }

    filterApply && filterApply.addEventListener('click', applyFilters);
    filterClear && filterClear.addEventListener('click', clearFilters);

    // 9. Block click — detail popover (editable)
    const blockPopover      = document.getElementById('blockPopover');
    const blockPopoverClose = document.getElementById('blockPopoverClose');
    const bpOfInput    = document.getElementById('bpOfInput');
    const bpRecursoSel = document.getElementById('bpRecursoSel');
    const bpInicioInp  = document.getElementById('bpInicioInp');
    const bpFinInp     = document.getElementById('bpFinInp');
    const bpPctInp     = document.getElementById('bpPctInp');
    const bpPctVal     = document.getElementById('bpPctVal');
    const bpEstadoSel  = document.getElementById('bpEstadoSel');
    const bpDeleteBtn  = document.getElementById('bpDeleteBtn');
    const bpSaveBtn    = document.getElementById('bpSaveBtn');

    // Populate recurso options from gantt rows
    const RECURSOS = Array.from(document.querySelectorAll('.gantt-row[data-resource]'))
      .map(r => r.dataset.resource).filter(Boolean);
    RECURSOS.forEach(r => bpRecursoSel.add(new Option(r, r)));

    // Live progress label
    bpPctInp && bpPctInp.addEventListener('input', () => { bpPctVal.textContent = bpPctInp.value + '%'; });

    let activePopoverBlock = null;

    function showBlockPopover(block, e) {
      const d = block.dataset;
      if (!d.of) return;
      activePopoverBlock = block;

      bpOfInput.value          = d.of || '';
      bpRecursoSel.value       = d.recurso || (RECURSOS[0] ?? '');
      bpInicioInp.value        = d.inicio  || '';
      bpFinInp.value           = d.fin     || '';
      const pctNum             = parseInt(d.pct) || 0;
      bpPctInp.value           = pctNum;
      bpPctVal.textContent     = pctNum + '%';
      bpEstadoSel.value        = d.estado  || 'En plazo';

      const vw = window.innerWidth, vh = window.innerHeight;
      let x = e.clientX + 12, y = e.clientY + 12;
      if (x + 260 > vw) x = e.clientX - 260;
      if (y + 260 > vh) y = e.clientY - 260;
      blockPopover.style.left = x + 'px';
      blockPopover.style.top  = y + 'px';
      blockPopover.classList.add('open');
    }

    function attachBlockClick(block) {
      block.addEventListener('click', e => {
        if (block.classList.contains('dragging')) return;
        e.stopPropagation();
        showBlockPopover(block, e);
      });
    }
    document.querySelectorAll('.gantt-block[data-of], .turno-block[data-of]').forEach(b => attachBlockClick(b));

    blockPopoverClose && blockPopoverClose.addEventListener('click', () => {
      blockPopover.classList.remove('open');
      activePopoverBlock = null;
    });
    document.addEventListener('click', e => {
      if (blockPopover && !blockPopover.contains(e.target)) {
        blockPopover.classList.remove('open');
        activePopoverBlock = null;
      }
    });

    // Save handler — updates all blocks with same OF
    bpSaveBtn && bpSaveBtn.addEventListener('click', () => {
      if (!activePopoverBlock) return;
      const oldOf      = activePopoverBlock.dataset.of;
      const oldRecurso = activePopoverBlock.dataset.recurso;
      const newOf      = bpOfInput.value.trim()   || oldOf;
      const newRecurso = bpRecursoSel.value;
      const newInicio = bpInicioInp.value.trim();
      const newFin    = bpFinInp.value.trim();
      const newPct    = bpPctInp.value + '%';
      const newEstado = bpEstadoSel.value;

      // Color by estado
      const estadoColor = { 'En plazo':'blue', 'En riesgo':'yellow', 'Retrasada':'red', 'Completada':'green' };
      const newColor = estadoColor[newEstado] || 'blue';

      // Update all blocks sharing the same OF
      document.querySelectorAll(`[data-of="${oldOf}"]`).forEach(bl => {
        bl.dataset.of      = newOf;
        bl.dataset.recurso = newRecurso;
        bl.dataset.inicio  = newInicio;
        bl.dataset.fin     = newFin;
        bl.dataset.pct     = newPct;
        bl.dataset.estado  = newEstado;

        // Update label text (keep "OF · desc" pattern)
        const oldText = bl.textContent.trim();
        const desc = oldText.includes('·') ? oldText.split('·').slice(1).join('·').trim() : '';
        const gbText = bl.querySelector('.gb-text');
        if (gbText) gbText.textContent = desc ? `${newOf} · ${desc}` : newOf;
        else if (!bl.querySelector('.gantt-resize')) bl.textContent = desc ? `${newOf} · ${desc}` : newOf;

        // Update estado color class
        ['gb--blue','gb--green','gb--yellow','gb--red','gb--purple','gb--orange'].forEach(c => bl.classList.remove(c));
        bl.classList.add(`gb--${newColor}`);
      });

      // Move block to new resource row if changed
      if (newRecurso !== oldRecurso) {
        // dataset already updated above; if gantt block, move to first cell of new resource
        if (activePopoverBlock.classList.contains('gantt-block')) {
          const newRow = document.querySelector(`.gantt-row[data-resource="${newRecurso}"]`);
          if (newRow) {
            const cells = newRow.querySelector('.gantt-timeline').querySelectorAll('.gantt-cell');
            const currentCell = activePopoverBlock.parentElement;
            const cellIdx = currentCell ? Array.from(currentCell.parentElement?.children || []).indexOf(currentCell) : 0;
            const targetCell = cells[Math.max(0, cellIdx)] || cells[0];
            if (targetCell) targetCell.appendChild(activePopoverBlock);
          }
        }
      }

      showToast(`✓ ${newOf} actualizada`);
      blockPopover.classList.remove('open');
      activePopoverBlock = null;
    });

    // Delete handler — removes all blocks with same OF
    bpDeleteBtn && bpDeleteBtn.addEventListener('click', () => {
      if (!activePopoverBlock) return;
      const ofVal = activePopoverBlock.dataset.of;
      document.querySelectorAll(`[data-of="${ofVal}"]`).forEach(bl => bl.remove());
      showToast(`Orden ${ofVal} eliminada`);
      blockPopover.classList.remove('open');
      activePopoverBlock = null;
    });

    // 10. ADD ORDER MODAL
    const orderModal  = document.getElementById('orderModal');
    const addOrderBtn = document.getElementById('addOrderBtn');
    const modalClose2 = document.getElementById('modalClose');
    const modalCancel = document.getElementById('modalCancel');
    const modalSubmit = document.getElementById('modalSubmit');
    const DIAS = ['Lun 19','Mar 20','Mié 21','Jue 22','Vie 23'];

    // Populate hour selects once
    const startSel = document.getElementById('f-start');
    const endSel   = document.getElementById('f-end');
    for (let h = 6; h <= 22; h++) {
      const t = String(h).padStart(2,'0') + ':00';
      startSel.add(new Option(t, h));
      endSel.add(new Option(t, h));
    }
    startSel.value = 8;
    endSel.value   = 14;

    // Color picker
    let selectedColor = 'blue';
    document.querySelectorAll('.color-opt').forEach(opt => {
      opt.addEventListener('click', () => {
        document.querySelectorAll('.color-opt').forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        selectedColor = opt.dataset.color;
      });
    });

    function openOrderModal() {
      const isTurno = ganttTurno.style.display !== 'none';
      document.getElementById('modal-semana').hidden = isTurno;
      document.getElementById('modal-turno').hidden  = !isTurno;

      // Auto-generate next order ID
      const nums = Array.from(document.querySelectorAll('[data-of]'))
        .map(el => parseInt(el.dataset.of.replace('OF-','')))
        .filter(n => !isNaN(n));
      const nextNum = nums.length ? Math.max(...nums) + 1 : 2050;
      document.getElementById('f-of').value = `OF-${nextNum}`;
      document.getElementById('f-desc').value = '';

      orderModal.classList.add('open');
    }

    function closeOrderModal() { orderModal.classList.remove('open'); }

    addOrderBtn && addOrderBtn.addEventListener('click', openOrderModal);
    modalClose2 && modalClose2.addEventListener('click', closeOrderModal);
    modalCancel && modalCancel.addEventListener('click', closeOrderModal);
    orderModal.addEventListener('click', e => { if (e.target === orderModal) closeOrderModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && orderModal.classList.contains('open')) closeOrderModal(); });

    modalSubmit && modalSubmit.addEventListener('click', () => {
      const of       = document.getElementById('f-of').value.trim()   || `OF-${Date.now()}`;
      const desc     = document.getElementById('f-desc').value.trim();
      const resource = document.getElementById('f-recurso').value;
      const label    = desc ? `${of} · ${desc}` : of;
      const isTurno  = ganttTurno.style.display !== 'none';

      if (isTurno) {
        const startH = parseInt(startSel.value);
        const endH   = parseInt(endSel.value);
        if (endH <= startH) { showToast('⚠ La hora de fin debe ser posterior al inicio'); return; }
        const totalHours = 16;
        const leftPct  = (startH - 6) / totalHours * 100;
        const widthPct = (endH - startH) / totalHours * 100;

        const block = document.createElement('div');
        block.className = `turno-block gb--${selectedColor}`;
        block.style.left  = leftPct + '%';
        block.style.width = (widthPct - 0.5) + '%';
        block.textContent = label;
        block.dataset.of      = of;
        block.dataset.recurso = resource;
        block.dataset.inicio  = `Mié 21 · ${String(startH).padStart(2,'0')}:00`;
        block.dataset.fin     = `Mié 21 · ${String(endH).padStart(2,'0')}:00`;
        block.dataset.pct     = '0%';
        block.dataset.estado  = 'En plazo';

        const track = document.querySelector(`.turno-row[data-resource="${resource}"] .turno-track`);
        if (track) { track.appendChild(block); initTurnoBlock(block); attachBlockClick(block); }

      } else {
        const dayIdx = parseInt(document.getElementById('f-dia').value);
        const dur    = document.getElementById('f-dur').value;

        const block = document.createElement('div');
        block.className = `gantt-block gb--${selectedColor}`;
        block.style.width     = dur + '%';
        block.style.marginTop = '2px';
        block.textContent     = label;
        block.dataset.of      = of;
        block.dataset.recurso = resource;
        block.dataset.inicio  = DIAS[dayIdx] + ' · 06:00';
        block.dataset.fin     = DIAS[dayIdx] + ' · 22:00';
        block.dataset.pct     = '0%';
        block.dataset.estado  = 'En plazo';

        const row = document.querySelector(`.gantt-row[data-resource="${resource}"]`);
        if (row) {
          const cells = row.querySelector('.gantt-timeline').querySelectorAll('.gantt-cell');
          if (cells[dayIdx]) { cells[dayIdx].appendChild(block); initGanttBlock(block); attachBlockClick(block); }
        }
      }

      showToast(`✓ ${of} añadida al Gantt`);
      closeOrderModal();
    });

    // 11. ZOOM ── ±
    const ZOOM_STEPS = [50, 75, 100, 140, 190, 260];
    const BASE_COL_PX = 160; // px per column at 100%
    let zoomIdx = 2; // index for 100%
    const zoomInBtn  = document.getElementById('zoomIn');
    const zoomOutBtn = document.getElementById('zoomOut');
    const zoomLbl    = document.getElementById('zoomLabel');

    function applyZoom() {
      const pct = ZOOM_STEPS[zoomIdx];
      zoomLbl.textContent = pct + '%';
      zoomOutBtn.disabled = zoomIdx === 0;
      zoomInBtn.disabled  = zoomIdx === ZOOM_STEPS.length - 1;

      if (zoomIdx === 2) {
        // Reset to fluid layout
        document.querySelectorAll('.gantt-grid').forEach(g => g.style.gridTemplateColumns = '');
        document.querySelectorAll('.gantt-days, .gantt-timeline').forEach(el => el.style.gridTemplateColumns = '');
        document.querySelectorAll('.turno-track, .turno-empty-track').forEach(el => el.style.minWidth = '');
        document.querySelectorAll('.turno-hour-header').forEach(el => el.style.minWidth = '');
        document.querySelectorAll('#gantt-turno [style*="grid-template-columns"]').forEach(el => el.style.gridTemplateColumns = '');
      } else {
        const colW  = Math.round(BASE_COL_PX * pct / 100);
        const totalW = 5 * colW;
        document.querySelectorAll('.gantt-grid').forEach(g => {
          g.style.gridTemplateColumns = `148px ${totalW}px`;
        });
        document.querySelectorAll('.gantt-days, .gantt-timeline').forEach(el => {
          el.style.gridTemplateColumns = `repeat(5, ${colW}px)`;
        });
        // Turno: make tracks wide enough
        const turnoMinW = Math.round(800 * pct / 100);
        document.querySelectorAll('.turno-track, .turno-empty-track, .turno-hour-header').forEach(el => {
          el.style.minWidth = turnoMinW + 'px';
        });
        // Turno grid header
        document.querySelectorAll('#gantt-turno > div[style*="grid-template-columns"]').forEach(el => {
          el.style.gridTemplateColumns = `148px ${turnoMinW}px`;
        });
      }
    }

    zoomInBtn  && zoomInBtn.addEventListener('click',  () => { if (zoomIdx < ZOOM_STEPS.length - 1) { zoomIdx++; applyZoom(); } });
    zoomOutBtn && zoomOutBtn.addEventListener('click', () => { if (zoomIdx > 0)                     { zoomIdx--; applyZoom(); } });

    // 11b. LIVE NOW-LINE ── updates every minute
    // Inject keyframes once (inline styles can't use @keyframes from scoped CSS)
    if (!document.getElementById('nowline-style')) {
      const s = document.createElement('style');
      s.id = 'nowline-style';
      s.textContent = '@keyframes nowline-blink{0%,100%{opacity:1}50%{opacity:.25}}';
      document.head.appendChild(s);
    }
    const DAY_START_H = 6, DAY_HOURS = 16; // 06:00 – 22:00
    const TURNO_HOUR_MARKS = [6,8,10,12,14,16,18,20,22];

    function updateNowLine() {
      const now      = new Date();
      const h        = now.getHours();
      const m        = now.getMinutes();
      const timeStr  = String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0');
      const nowDec   = h + m / 60;
      const timeFrac = Math.max(0, Math.min(1, (nowDec - DAY_START_H) / DAY_HOURS));

      // Weekly gantt: find today column and compute left% across all 5 columns
      const dayEls    = document.querySelectorAll('.gantt-days .gantt-day');
      const totalCols = dayEls.length;
      const todayIdx  = Array.from(dayEls).findIndex(d => d.classList.contains('gantt-day--today'));

      if (todayIdx >= 0 && totalCols > 0) {
        const leftPct = (todayIdx + timeFrac) / totalCols * 100;

        document.querySelectorAll('.gantt-timeline').forEach((tl, i) => {
          let nline = tl.querySelector('.today-line');
          if (!nline) {
            nline = document.createElement('div');
            nline.className = 'today-line';
            nline.style.cssText = 'position:absolute;top:0;bottom:0;width:2px;background:#DC2626;z-index:5;pointer-events:none;transition:left .4s ease;animation:nowline-blink 1s ease-in-out infinite';
            tl.appendChild(nline);
          }
          nline.style.left = leftPct + '%';

          // Time label only on first row
          let lbl = nline.querySelector('span');
          if (i === 0) {
            if (!lbl) {
              lbl = document.createElement('span');
              lbl.style.cssText = 'position:absolute;top:4px;left:4px;font-size:.55rem;font-weight:800;color:#DC2626;letter-spacing:.06em;background:rgba(220,38,38,.1);padding:.1rem .3rem;border-radius:3px;white-space:nowrap';
              nline.appendChild(lbl);
            }
            lbl.textContent = timeStr;
          }
        });
      }

      // Turno gantt: highlight current hour cell
      document.querySelectorAll('.turno-hour-cell').forEach((cell, i) => {
        const mark = TURNO_HOUR_MARKS[i];
        const next = TURNO_HOUR_MARKS[i + 1] ?? 23;
        cell.classList.toggle('turno-hour-cell--now', h >= mark && h < next);
      });

      // Turno gantt: live vertical line inside each track (inline styles avoid Astro scope issue)
      const turnoTimeFrac = Math.max(0, Math.min(1, (nowDec - DAY_START_H) / DAY_HOURS));
      const turnoPct = turnoTimeFrac * 100;
      document.querySelectorAll('.turno-track').forEach(track => {
        let nline = track.querySelector('.turno-now-line');
        if (!nline) {
          nline = document.createElement('div');
          nline.className = 'turno-now-line';
          nline.style.cssText = 'position:absolute;top:0;bottom:0;width:2px;background:#DC2626;z-index:4;pointer-events:none;transition:left .4s ease;animation:nowline-blink 1s ease-in-out infinite';
          track.appendChild(nline);
        }
        nline.style.left = turnoPct + '%';
      });
    }

    updateNowLine();
    setInterval(updateNowLine, 60000);

    // 12. EXPAND ── fullscreen toggle
    const expandBtn  = document.getElementById('expandGantt');
    const ganttCard2 = document.querySelector('.gantt-card');
    const expandIconOpen  = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>`;
    const expandIconClose = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="10" y1="14" x2="3" y2="21"/><line x1="21" y1="3" x2="14" y2="10"/></svg>`;
    let ganttExpanded = false;

    expandBtn && expandBtn.addEventListener('click', () => {
      ganttExpanded = !ganttExpanded;
      ganttCard2.classList.toggle('gantt-card--expanded', ganttExpanded);
      expandBtn.innerHTML = ganttExpanded ? expandIconClose : expandIconOpen;
      expandBtn.title = ganttExpanded ? 'Reducir' : 'Ampliar Gantt';
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && ganttExpanded) {
        ganttExpanded = false;
        ganttCard2.classList.remove('gantt-card--expanded');
        expandBtn.innerHTML = expandIconOpen;
        expandBtn.title = 'Ampliar Gantt';
      }
    });
  }

  // Toggle industries panel collapse
  const industriesToggle = document.getElementById('industriesToggle');
  const industriesPanel  = document.getElementById('industriesPanel');
  industriesToggle.addEventListener('click', () => {
    industriesPanel.classList.toggle('collapsed');
    industriesToggle.setAttribute('aria-expanded',
      !industriesPanel.classList.contains('collapsed') ? 'true' : 'false'
    );
  });

  // Logout
  document.getElementById('nav-logout').addEventListener('click', e => {
    e.preventDefault();
    localStorage.removeItem('pc_token');
    location.reload();
  });

  init();
</script>

<!-- ── ADD ORDER MODAL ── -->
<div class="modal-backdrop" id="orderModal">
  <div class="modal">
    <div class="modal__header">
      <span class="modal__title">Añadir orden al Gantt</span>
      <button class="modal__close" id="modalClose">×</button>
    </div>
    <div class="modal__body">
      <div class="form-row">
        <div class="form-field">
          <label class="form-label">ID de orden</label>
          <input class="form-input" id="f-of" placeholder="OF-2050" />
        </div>
        <div class="form-field">
          <label class="form-label">Descripción</label>
          <input class="form-input" id="f-desc" placeholder="Carcasa B · Serie 300" />
        </div>
      </div>
      <div class="form-field">
        <label class="form-label">Recurso</label>
        <select class="form-select" id="f-recurso">
          <option value="cnc-1">CNC-1 — Fresado</option>
          <option value="cnc-2">CNC-2 — Torneado</option>
          <option value="soldadura">Soldadura (Robot MIG)</option>
          <option value="acabados">Acabados (Pintura + QC)</option>
          <option value="embalaje">Embalaje / Expedición</option>
        </select>
      </div>
      <!-- Semana-specific fields -->
      <div class="modal-view-section" id="modal-semana">
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">Día</label>
            <select class="form-select" id="f-dia">
              <option value="0">Lunes 19</option>
              <option value="1">Martes 20</option>
              <option value="2">Miércoles 21</option>
              <option value="3">Jueves 22</option>
              <option value="4">Viernes 23</option>
            </select>
          </div>
          <div class="form-field">
            <label class="form-label">Duración en celda</label>
            <select class="form-select" id="f-dur">
              <option value="100">Todo el día (100%)</option>
              <option value="75">75%</option>
              <option value="50">Media jornada (50%)</option>
              <option value="25">25%</option>
            </select>
          </div>
        </div>
      </div>
      <!-- Turno-specific fields -->
      <div class="modal-view-section" id="modal-turno" hidden>
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">Hora inicio</label>
            <select class="form-select" id="f-start"></select>
          </div>
          <div class="form-field">
            <label class="form-label">Hora fin</label>
            <select class="form-select" id="f-end"></select>
          </div>
        </div>
      </div>
      <div class="form-field">
        <label class="form-label">Color</label>
        <div class="color-picker" id="colorPicker">
          <div class="color-opt selected" data-color="blue"   style="background:#1B3F8B"></div>
          <div class="color-opt"          data-color="teal"   style="background:#0891B2"></div>
          <div class="color-opt"          data-color="green"  style="background:#16A34A"></div>
          <div class="color-opt"          data-color="purple" style="background:#7C3AED"></div>
          <div class="color-opt"          data-color="amber"  style="background:#D97706"></div>
          <div class="color-opt"          data-color="gray"   style="background:#64748B"></div>
        </div>
      </div>
    </div>
    <div class="modal__footer">
      <button class="btn-ui" id="modalCancel">Cancelar</button>
      <button class="btn-ui btn-ui--primary" id="modalSubmit">Añadir al Gantt</button>
    </div>
  </div>
</div>

</body>
</html>
