  function applyI18n(root: Document | Element = document) {
    const lang = getSettings().lang;
    const dict = I18N[lang] || {};
    root.querySelectorAll('[data-i18n]').forEach(el => {
      const v = dict[el.getAttribute('data-i18n')!];
      if (v != null) el.textContent = v;
    });
    root.querySelectorAll('[data-i18n-ph]').forEach(el => {
      const v = dict[el.getAttribute('data-i18n-ph')!];
      if (v != null) (el as HTMLInputElement).placeholder = v;
    });
  }

  let _systemThemeMQ: MediaQueryList | null = null;
  function applySettings() {
    const s = getSettings();
    const root = document.documentElement;
    // theme
    const wantDark = s.theme === 'dark' ||
      (s.theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
    root.setAttribute('data-theme', wantDark ? 'dark' : 'light');
    if (s.theme === 'system' && window.matchMedia && !_systemThemeMQ) {
      _systemThemeMQ = window.matchMedia('(prefers-color-scheme: dark)');
      _systemThemeMQ.addEventListener('change', () => { if (getSettings().theme === 'system') applySettings(); });
    }
    // density
    if (s.density === 'compact') root.setAttribute('data-density', 'compact');
    else root.removeAttribute('data-density');
    // gantt colours
    Object.keys(GB_DEFAULTS).forEach(k => {
      const v = s.cellColors[k];
      if (v && v.toLowerCase() !== GB_DEFAULTS[k].toLowerCase()) root.style.setProperty('--gb-' + k, v);
      else root.style.removeProperty('--gb-' + k);
    });
    // language
    root.lang = s.lang;
    applyI18n();
    syncConfigPanel();
  }

  function syncConfigPanel() {
    const s = getSettings();
    const seg = (id: string, val: string) => {
      const box = document.getElementById(id);
      if (!box) return;
      box.querySelectorAll('button').forEach(b =>
        b.classList.toggle('active', (b as HTMLElement).dataset.val === val));
    };
    seg('cfgLang', s.lang);
    seg('cfgTheme', s.theme);
    seg('cfgDensity', s.density);
    const sp = document.getElementById('cfgStartPanel') as HTMLSelectElement | null;
    if (sp) sp.value = s.startPanel;
    document.querySelectorAll('#cfgColors .cfg-color').forEach(row => {
      const input = row.querySelector('input[type="color"]') as HTMLInputElement;
      const hex   = row.querySelector('.cfg-color__hex') as HTMLElement;
      const key   = input.dataset.key!;
      const val   = (s.cellColors[key] || GB_DEFAULTS[key]);
      input.value = val;
      if (hex) hex.textContent = val.toUpperCase();
    });
  }

