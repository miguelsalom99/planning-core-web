      function populateCompanySelect() {
        const sel = document.getElementById('au-company-id')!;
        const cur = (sel as HTMLSelectElement).value;
        sel.innerHTML = '<option value="">— Sin empresa —</option>' +
          adminCompanies.map(c => `<option value="${c.id}">${c.name}${c.industry ? ' · ' + (INDUSTRY_LABELS[c.industry] || c.industry) : ''}</option>`).join('');
