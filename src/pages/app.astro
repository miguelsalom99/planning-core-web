        if (input) input.value = '';
        if (status) status.textContent = '';
        renderCheckpointList(activeCheckpointOrder);
        enhanceOrderRows();
        input?.focus();
      } else if (status) {
        status.textContent = 'No se pudo guardar. ¿Sesión iniciada?';
