    // Adds/refreshes a trailing "Checkpoints" cell + button on every order row,
    // reading the order code from the row's first cell. Safe to call repeatedly —
    // it's the only way listeners survive the innerHTML swaps that history-mode
    // restore and MRP-apply do to #ordersBody.
    function enhanceOrderRows() {
      document.querySelectorAll('#ordersBody tr[data-estado]').forEach(row => {
        const code = row.querySelector('td:first-child')?.textContent?.trim();
        if (!code) return;
        let cell = row.querySelector('.order-checkpoints-cell') as HTMLElement | null;
        if (!cell) {
          cell = document.createElement('td');
          cell.className = 'order-checkpoints-cell';
          row.appendChild(cell);
        }
        const items = allCheckpoints.filter(c => c.order_code === code);
        const done = items.filter(c => c.done).length;
        const btn = document.createElement('button');
        btn.className = 'checkpoints-btn' + (items.length > 0 && done === items.length ? ' checkpoints-btn--done' : '');
        btn.textContent = items.length ? `✓ ${done}/${items.length}` : '+ Checkpoints';
        btn.addEventListener('click', () => {
          const desc = row.querySelector('td:nth-child(2)')?.textContent?.trim() || code;
          openCheckpointsModal(code, desc);
        });
        cell.innerHTML = '';
        cell.appendChild(btn);
        copyAstroScope(cell);
      });
    }

    function renderCheckpointList(orderCode: string) {
      const list = document.getElementById('checkpointList');
      const empty = document.getElementById('checkpointEmpty');
      if (!list) return;
      list.innerHTML = '';
      const items = allCheckpoints.filter(c => c.order_code === orderCode);
      if (empty) empty.style.display = items.length ? 'none' : '';

      items.forEach(c => {
        const item = document.createElement('div');
        item.className = 'checkpoint-item';
        item.innerHTML = `
          <input type="checkbox" class="checkpoint-item__check" ${c.done ? 'checked' : ''} />
          <span class="checkpoint-item__title ${c.done ? 'checkpoint-item__title--done' : ''}"></span>
          <button class="checkpoint-item__del" title="Eliminar">×</button>
        `;
        (item.querySelector('.checkpoint-item__title') as HTMLElement).textContent = c.title;

        item.querySelector('.checkpoint-item__check')?.addEventListener('change', async (e) => {
          const checked = (e.target as HTMLInputElement).checked;
          const updated = await patchCheckpoint(c.id, { done: checked });
          if (updated) {
            allCheckpoints = allCheckpoints.map(x => x.id === c.id ? updated : x);
            renderCheckpointList(orderCode);
            enhanceOrderRows();
          } else {
            (e.target as HTMLInputElement).checked = !checked;
            showToast('⚠ No se pudo actualizar');
          }
        });

        item.querySelector('.checkpoint-item__del')?.addEventListener('click', async () => {
          await deleteCheckpointRemote(c.id);
          allCheckpoints = allCheckpoints.filter(x => x.id !== c.id);
          renderCheckpointList(orderCode);
          enhanceOrderRows();
        });

        copyAstroScope(item);
        list.appendChild(item);
      });
    }

