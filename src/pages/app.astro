          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Recurso afectado</label>
              <select class="form-input" id="disruptResource">
                <option value="">— Ninguno —</option>
                <option value="ATL-01">ATL-01</option>
                <option value="ATL-02">ATL-02</option>
                <option value="AUTOCLAVE">Autoclave</option>
                <option value="NDT">NDT</option>
                <option value="CNC">CNC</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Duración (turnos)</label>
              <input class="form-input" id="disruptDuration" type="number" min="1" max="21" value="1" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Día</label>
              <select class="form-input" id="disruptDay">
                <option value="0">Lunes</option>
                <option value="1">Martes</option>
                <option value="2">Miércoles</option>
                <option value="3">Jueves</option>
                <option value="4">Viernes</option>
                <option value="5">Sábado</option>
