    <!-- ── MAIN ── -->
    <main class="main">

      <!-- Page header -->
      <div class="page-header">
        <div class="page-header__left">
          <h1>Planificación semanal</h1>
          <div class="page-header__meta">
            <span class="page-header__sub">19–23 mayo 2026 · Turno mañana + tarde</span>
