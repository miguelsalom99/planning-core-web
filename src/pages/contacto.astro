---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTORS } from '../data/sectors.js';
---
<BaseLayout
  title="Solicitar demo — Planning Core"
  description="Solicita una demo personalizada de Planning Core para tu sector y planta. Respuesta en 24h."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-label" data-i18n="contacto.hero.label">Contacto</p>
      <h1 class="section-title section-title--light" data-i18n="contacto.hero.title">Hablemos de tu planta</h1>
      <p class="page-hero__sub" data-i18n="contacto.hero.sub">
        Una llamada de 30 min para entender tus restricciones y ver si Planning Core
        encaja. Sin compromiso. Respuesta en menos de 24h.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-inner">
      <!-- FORM -->
      <div class="contact-form-wrap">
        <h2 data-i18n="contacto.form.title">Solicitar demo</h2>
        <p class="form-sub" data-i18n="contacto.form.sub">Cuéntanos tu sector y el reto principal. Te respondemos en menos de 24h.</p>

        <form class="contact-form" id="contactForm">
          <div class="form-row">
            <div class="form-group">
              <label for="nombre" data-i18n="contacto.form.name">Nombre *</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required data-i18n-placeholder="contacto.form.namePH" />
            </div>
            <div class="form-group">
              <label for="empresa" data-i18n="contacto.form.company">Empresa *</label>
              <input type="text" id="empresa" name="empresa" placeholder="Nombre de la empresa" required data-i18n-placeholder="contacto.form.companyPH" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="email" data-i18n="contacto.form.email">Email *</label>
              <input type="email" id="email" name="email" placeholder="tu@empresa.com" required />
            </div>
            <div class="form-group">
              <label for="telefono" data-i18n="contacto.form.phone">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" placeholder="+34 600 000 000" />
            </div>
          </div>

          <div class="form-group">
            <label for="sector" data-i18n="contacto.form.sector">Sector *</label>
            <select id="sector" name="sector" required>
              <option value="" data-i18n-opt="contacto.form.sectorDefault">Selecciona tu sector</option>
              {SECTORS.map(s => (
                <option value={s.slug}>{s.name}</option>
              ))}
              <option value="otro">Otro sector</option>
            </select>
          </div>

          <div class="form-group">
            <label for="cargo" data-i18n="contacto.form.role">Cargo</label>
            <input type="text" id="cargo" name="cargo" placeholder="Director de Producción, Plant Manager..." />
          </div>

          <div class="form-group">
            <label for="reto" data-i18n="contacto.form.challenge">Cuéntanos tu principal reto *</label>
            <textarea id="reto" name="reto" rows="4" placeholder="¿Cuál es el cuello de botella más crítico? ¿Cómo gestionáis ahora la planificación?" required></textarea>
          </div>

          <div class="form-group form-group--check">
            <label class="check-label">
              <input type="checkbox" required />
              <span data-i18n="contacto.form.consent">Acepto que Planning Core use mis datos para contactarme sobre la demo.</span>
            </label>
          </div>

          <button type="submit" class="btn btn--primary btn--full" data-i18n="contacto.form.submit">
            Solicitar demo gratuita →
          </button>
        </form>

        <div class="form-success" id="formSuccess" style="display:none">
          <div class="success-icon">✅</div>
          <h3 data-i18n="contacto.success.title">¡Solicitud recibida!</h3>
          <p data-i18n="contacto.success.sub">Te contactamos en menos de 24h para coordinar la demo.</p>
        </div>
      </div>

      <!-- SIDEBAR -->
      <div class="contact-sidebar">
        <div class="sidebar-block">
          <h3 data-i18n="contacto.sidebar.next">Lo que pasa después</h3>
          <div class="sidebar-steps">
            <div class="sidebar-step">
              <span class="ss-num">1</span>
              <div><strong data-i18n="contacto.sidebar.s1.title">Confirmamos tu solicitud</strong><span data-i18n="contacto.sidebar.s1.desc">Email en menos de 2 horas en horario laboral.</span></div>
            </div>
            <div class="sidebar-step">
              <span class="ss-num">2</span>
              <div><strong data-i18n="contacto.sidebar.s2.title">Llamada de discovery (30 min)</strong><span data-i18n="contacto.sidebar.s2.desc">Entendemos tu sector, recursos y el reto principal.</span></div>
            </div>
            <div class="sidebar-step">
              <span class="ss-num">3</span>
              <div><strong data-i18n="contacto.sidebar.s3.title">Demo personalizada</strong><span data-i18n="contacto.sidebar.s3.desc">Planning Core configurado con tus datos y tus restricciones reales.</span></div>
            </div>
            <div class="sidebar-step">
              <span class="ss-num">4</span>
              <div><strong data-i18n="contacto.sidebar.s4.title">Propuesta de piloto</strong><span data-i18n="contacto.sidebar.s4.desc">Si encaja, diseñamos el piloto de 12 semanas con KPIs acordados.</span></div>
            </div>
          </div>
        </div>

        <div class="sidebar-block sidebar-block--dark">
          <h3 data-i18n="contacto.sidebar.direct">Contacto directo</h3>
          <a href="tel:+34686595405" class="direct-link">
            <span>📞</span>
            +34 686 595 405
          </a>
          <p class="sidebar-note" data-i18n="contacto.sidebar.note">Respondemos en menos de 24h en días laborables.</p>
        </div>

        <div class="sidebar-block">
          <h3 data-i18n="contacto.sidebar.why.title">Por qué empezar con un piloto</h3>
          <ul class="why-list">
            <li data-i18n="contacto.sidebar.why.0">ROI medible con tus propios datos</li>
            <li data-i18n="contacto.sidebar.why.1">Sin permanencia ni contrato largo</li>
            <li data-i18n="contacto.sidebar.why.2">Onboarding guiado por nuestro equipo</li>
            <li data-i18n="contacto.sidebar.why.3">Si no genera valor, no hay contrato</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: linear-gradient(145deg, #060F20, #0B1C3A); padding: 5rem 0 4rem; }
  .page-hero__sub { color: var(--silver); max-width: 580px; line-height: 1.7; margin-top: .75rem; font-size: 1.05rem; }

  .contact-section { padding: 5rem 0; }
  .contact-inner { display: grid; grid-template-columns: 1fr 380px; gap: 4rem; align-items: start; }

  /* FORM */
  .contact-form-wrap {
    background: #fff;
    border: 1px solid var(--n80);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow);
  }
  .contact-form-wrap h2 { font-size: 1.4rem; font-weight: 800; color: var(--navy); margin-bottom: .35rem; }
  .form-sub { font-size: .9rem; color: var(--n30); margin-bottom: 2rem; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-group { margin-bottom: 1.25rem; }
  .form-group label {
    display: block;
    font-size: .8rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: .4rem;
    letter-spacing: .01em;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: .65rem .9rem;
    border: 1.5px solid var(--n80);
    border-radius: var(--radius);
    font-family: var(--font);
    font-size: .9rem;
    color: var(--navy);
    background: #fff;
    transition: border-color .15s;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(30,77,183,.08); }
  .form-group textarea { resize: vertical; }

  .form-group--check .check-label { display: flex; gap: .6rem; align-items: flex-start; cursor: pointer; font-size: .82rem; color: var(--n30); line-height: 1.5; }
  .form-group--check input { width: auto; margin-top: 2px; }

  .btn--full { width: 100%; justify-content: center; padding: .85rem; font-size: 1rem; margin-top: .5rem; }

  .form-success { text-align: center; padding: 2rem 0; }
  .success-icon { font-size: 2.5rem; margin-bottom: 1rem; }
  .form-success h3 { font-size: 1.25rem; font-weight: 800; color: var(--navy); margin-bottom: .5rem; }
  .form-success p { color: var(--n30); }

  /* SIDEBAR */
  .contact-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
  .sidebar-block { background: #fff; border: 1px solid var(--n80); border-radius: var(--radius-lg); padding: 1.5rem; }
  .sidebar-block h3 { font-size: .95rem; font-weight: 700; color: var(--navy); margin-bottom: 1rem; }
  .sidebar-block--dark { background: var(--navy); border-color: var(--navy); }
  .sidebar-block--dark h3 { color: #fff; }

  .sidebar-steps { display: flex; flex-direction: column; gap: .85rem; }
  .sidebar-step { display: flex; gap: .75rem; align-items: flex-start; }
  .ss-num { width: 24px; height: 24px; background: rgba(30,77,183,.1); color: var(--brand); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 700; flex-shrink: 0; margin-top: 1px; }
  .sidebar-step strong { display: block; font-size: .875rem; color: var(--navy); margin-bottom: .1rem; }
  .sidebar-step span { font-size: .8rem; color: var(--n30); line-height: 1.4; }

  .direct-link { display: flex; align-items: center; gap: .6rem; font-size: .9rem; color: var(--silver); font-weight: 500; margin-bottom: .5rem; }
  .direct-link:hover { color: #fff; }
  .sidebar-note { font-size: .78rem; color: rgba(255,255,255,.35); }

  .why-list { list-style: none; padding: 0; }
  .why-list li { font-size: .875rem; color: var(--n30); padding: .4rem 0; padding-left: 1.25rem; position: relative; border-bottom: 1px solid var(--n80); }
  .why-list li:last-child { border-bottom: none; }
  .why-list li::before { content: '✓'; position: absolute; left: 0; color: var(--brand); font-weight: 700; font-size: .75rem; }

  @media (max-width: 900px) {
    .contact-inner { grid-template-columns: 1fr; }
    .contact-sidebar { order: -1; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const success = document.getElementById('formSuccess');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (form) form.style.display = 'none';
    if (success) success.style.display = 'block';
  });
</script>
