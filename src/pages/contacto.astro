---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTORS } from '../data/sectors.js';
---
<BaseLayout
  title="Solicitar demo — Planning Core"
  description="Solicita una demo personalizada de Planning Core para tu sector y tu planta. Respuesta en menos de 24h. Sin compromiso."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-label" data-i18n="contacto.hero.label">Contacto</p>
      <h1 class="section-title section-title--light" data-i18n="contacto.hero.title">Hablemos de tu planta</h1>
      <p class="page-hero__sub" data-i18n="contacto.hero.sub">
        Una llamada de 30 min para entender tus restricciones y ver si Planning Core
        encaja. Sin compromiso. Respuesta en menos de 24h.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-inner">
      <!-- FORM -->
      <div class="contact-form-wrap">
        <h2 class="cf-title" data-i18n="contacto.form.title">Solicitar demo</h2>
        <p class="form-sub" data-i18n="contacto.form.sub">Cuéntanos tu sector y el reto principal. Te respondemos en menos de 24h.</p>

        <form class="contact-form" id="contactForm" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="nombre" data-i18n="contacto.form.name">Nombre *</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required data-i18n-placeholder="contacto.form.namePH" />
            </div>
            <div class="form-group">
              <label for="empresa" data-i18n="contacto.form.company">Empresa *</label>
              <input type="text" id="empresa" name="empresa" placeholder="Nombre de la empresa" required data-i18n-placeholder="contacto.form.companyPH" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="email" data-i18n="contacto.form.email">Email *</label>
              <input type="email" id="email" name="email" placeholder="tu@empresa.com" required />
            </div>
            <div class="form-group">
              <label for="telefono" data-i18n="contacto.form.phone">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" placeholder="+34 600 000 000" />
            </div>
          </div>

          <div class="form-group">
            <label for="sector" data-i18n="contacto.form.sector">Sector *</label>
            <select id="sector" name="sector" required>
              <option value="" data-i18n-opt="contacto.form.sectorDefault">Selecciona tu sector</option>
              {SECTORS.map(s => (
                <option value={s.slug} data-i18n-opt={`sector.${s.slug}.name`}>{s.name}</option>
              ))}
              <option value="otro" data-i18n-opt="contacto.form.sectorOther">Otro sector</option>
            </select>
          </div>

          <div class="form-group">
            <label for="cargo" data-i18n="contacto.form.role">Cargo</label>
            <input type="text" id="cargo" name="cargo" placeholder="Director de Producción, Plant Manager..." />
          </div>

          <div class="form-group">
            <label for="reto" data-i18n="contacto.form.challenge">Cuéntanos tu principal reto *</label>
            <textarea id="reto" name="reto" rows="4" placeholder="¿Cuál es el cuello de botella más crítico? ¿Cómo gestionáis ahora la planificación?" required></textarea>
          </div>

          <div class="form-group form-group--check">
            <label class="check-label">
              <input type="checkbox" id="consent" required />
              <span data-i18n="contacto.form.consent">Acepto que Planning Core use mis datos para contactarme sobre la demo.</span>
            </label>
          </div>

          <p class="form-error" id="formError" hidden></p>

          <button type="submit" class="btn btn--primary btn--full" id="cfSubmit" data-i18n="contacto.form.submit">
            Solicitar demo gratuita →
          </button>
        </form>

        <div class="form-success" id="formSuccess" hidden>
          <div class="success-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 data-i18n="contacto.success.title">¡Solicitud recibida!</h3>
          <p data-i18n="contacto.success.sub">Te contactamos en menos de 24h para coordinar la demo.</p>
        </div>
      </div>

      <!-- SIDEBAR -->
      <div class="contact-sidebar">
        <div class="sidebar-block">
          <h3 data-i18n="contacto.sidebar.next">Lo que pasa después</h3>
          <ol class="sidebar-steps">
            <li class="sidebar-step"><span class="ss-num">1</span><div><strong data-i18n="contacto.sidebar.s1.title">Confirmamos tu solicitud</strong><span data-i18n="contacto.sidebar.s1.desc">Email en menos de 2 horas en horario laboral.</span></div></li>
            <li class="sidebar-step"><span class="ss-num">2</span><div><strong data-i18n="contacto.sidebar.s2.title">Llamada de discovery (30 min)</strong><span data-i18n="contacto.sidebar.s2.desc">Entendemos tu sector, recursos y el reto principal.</span></div></li>
            <li class="sidebar-step"><span class="ss-num">3</span><div><strong data-i18n="contacto.sidebar.s3.title">Demo personalizada</strong><span data-i18n="contacto.sidebar.s3.desc">Planning Core configurado con tus datos y tus restricciones reales.</span></div></li>
            <li class="sidebar-step"><span class="ss-num">4</span><div><strong data-i18n="contacto.sidebar.s4.title">Propuesta de piloto</strong><span data-i18n="contacto.sidebar.s4.desc">Si encaja, diseñamos el piloto de 12 semanas con KPIs acordados.</span></div></li>
          </ol>
        </div>

        <div class="sidebar-block sidebar-block--dark">
          <h3 data-i18n="contacto.sidebar.direct">Contacto directo</h3>
          <a href="tel:+34686595405" class="direct-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/></svg>
            +34 686 595 405
          </a>
          <p class="sidebar-note" data-i18n="contacto.sidebar.note">Respondemos en menos de 24h en días laborables.</p>
        </div>

        <div class="sidebar-block">
          <h3 data-i18n="contacto.sidebar.why.title">Por qué empezar con un piloto</h3>
          <ul class="why-list">
            <li data-i18n="contacto.sidebar.why.0">ROI medible con tus propios datos</li>
            <li data-i18n="contacto.sidebar.why.1">Sin permanencia ni contrato largo</li>
            <li data-i18n="contacto.sidebar.why.2">Onboarding guiado por nuestro equipo</li>
            <li data-i18n="contacto.sidebar.why.3">Si no genera valor, no hay contrato</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section { padding: 4.5rem 0 5.5rem; }
  .contact-inner { display: grid; grid-template-columns: 1fr 360px; gap: 3.5rem; align-items: start; }

  .contact-form-wrap {
    background: #fff;
    border: 1px solid var(--n80);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2.25rem 2.5rem;
    box-shadow: var(--shadow);
  }
  .cf-title { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--navy); margin-bottom: .35rem; letter-spacing: -.02em; }
  .form-sub { font-size: .88rem; color: var(--n30); margin-bottom: 1.75rem; line-height: 1.5; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-group { margin-bottom: 1.1rem; }
  .form-group label {
    display: block;
    font-size: .78rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: .35rem;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: .62rem .85rem;
    border: 1.5px solid var(--n80);
    border-radius: var(--radius);
    font-family: var(--font);
    font-size: .9rem;
    color: var(--navy);
    background: #fff;
    transition: border-color .15s, box-shadow .15s;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(30,77,183,.1); }
  .form-group input:user-invalid { border-color: #DC2626; }
  .form-group textarea { resize: vertical; min-height: 96px; }

  .form-group--check .check-label { display: flex; gap: .55rem; align-items: flex-start; cursor: pointer; font-size: .8rem; color: var(--n30); line-height: 1.5; }
  .form-group--check input { width: auto; margin-top: 2px; accent-color: var(--brand); }

  .form-error { color: #DC2626; font-size: .82rem; margin-bottom: .75rem; }

  .btn--full { width: 100%; justify-content: center; padding: .85rem; font-size: 1rem; margin-top: .4rem; }
  .btn--full[disabled] { opacity: .6; cursor: progress; }

  .form-success { text-align: center; padding: 2.5rem 1rem; }
  .success-mark {
    width: 52px; height: 52px; margin: 0 auto 1.1rem;
    border-radius: 50%; background: rgba(22,163,74,.12); color: var(--ok);
    display: grid; place-items: center;
  }
  .success-mark svg { width: 26px; height: 26px; }
  .form-success h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; color: var(--navy); margin-bottom: .5rem; }
  .form-success p { color: var(--n30); font-size: .92rem; }

  .contact-sidebar { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 5rem; }
  .sidebar-block { background: #fff; border: 1px solid var(--n80); border-radius: var(--radius-lg); padding: 1.4rem 1.5rem; }
  .sidebar-block h3 { font-family: var(--font-display); font-size: .92rem; font-weight: 700; color: var(--navy); margin-bottom: 1rem; letter-spacing: -.01em; }
  .sidebar-block--dark { background: var(--navy); border-color: var(--navy); }
  .sidebar-block--dark h3 { color: #fff; }

  .sidebar-steps { list-style: none; display: flex; flex-direction: column; }
  .sidebar-step { display: flex; gap: .8rem; align-items: flex-start; padding: .7rem 0; border-top: 1px solid var(--n90); }
  .sidebar-step:first-child { border-top: none; padding-top: 0; }
  .ss-num {
    width: 22px; height: 22px; flex-shrink: 0; margin-top: 1px;
    border: 1.5px solid var(--brand); color: var(--brand);
    border-radius: 50%; display: grid; place-items: center;
    font-family: var(--font-display); font-size: .68rem; font-weight: 700;
  }
  .sidebar-step strong { display: block; font-size: .85rem; color: var(--navy); margin-bottom: .12rem; }
  .sidebar-step span { font-size: .8rem; color: var(--n30); line-height: 1.4; }

  .direct-link { display: flex; align-items: center; gap: .55rem; font-size: .92rem; color: var(--silver); font-weight: 600; margin-bottom: .5rem; }
  .direct-link:hover { color: #fff; }
  .sidebar-note { font-size: .76rem; color: rgba(255,255,255,.4); }

  .why-list { list-style: none; }
  .why-list li { font-size: .85rem; color: var(--n30); padding: .5rem 0 .5rem 1.3rem; position: relative; border-top: 1px solid var(--n90); line-height: 1.4; }
  .why-list li:first-child { border-top: none; }
  .why-list li::before { content: '✓'; position: absolute; left: 0; color: var(--ok); font-weight: 700; font-size: .75rem; }

  @media (max-width: 960px) {
    .contact-inner { grid-template-columns: 1fr; }
    .contact-sidebar { position: static; order: -1; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const API = 'https://composite-replanning-api.vercel.app';
  const form    = document.getElementById('contactForm') as HTMLFormElement | null;
  const success = document.getElementById('formSuccess');
  const errEl   = document.getElementById('formError') as HTMLElement | null;
  const submit  = document.getElementById('cfSubmit') as HTMLButtonElement | null;

  const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value.trim() || '';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errEl) errEl.hidden = true;

    if (!form.checkValidity()) { form.reportValidity(); return; }

    const payload = {
      name:    val('nombre'),
      company: val('empresa'),
      email:   val('email'),
      phone:   val('telefono') || null,
      sector:  val('sector') || null,
      role:    val('cargo') || null,
      message: val('reto') || null,
      source_lang: (localStorage.getItem('pc_lang') || 'es'),
      user_agent: navigator.userAgent,
    };

    if (submit) { submit.disabled = true; }
    try {
      const res = await fetch(`${API}/api/leads`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('http ' + res.status);
      form.style.display = 'none';
      if (success) success.hidden = false;
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (_) {
      if (errEl) {
        errEl.textContent = (localStorage.getItem('pc_lang') === 'en')
          ? 'Could not send. Please try again, or write to us directly at +34 686 595 405.'
          : 'No se pudo enviar. Inténtalo de nuevo o escríbenos directamente al +34 686 595 405.';
        errEl.hidden = false;
      }
      if (submit) submit.disabled = false;
    }
  });
</script>
