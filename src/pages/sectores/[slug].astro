---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTORS } from '../../data/sectors.js';
import SectorIcon from '../../components/SectorIcon.astro';

export function getStaticPaths() {
  return SECTORS.map(s => ({ params: { slug: s.slug }, props: { sector: s } }));
}

const { sector: s } = Astro.props;
---
<BaseLayout
  title={`${s.name} — Software de planificación · Planning Core`}
  description={`Planning Core para ${s.name}: ${s.roiHeadline}. Piloto de 12 semanas, ROI medible con tus propios datos.`}
  accent={s.accent}
>
  <!-- HERO -->
  <section class="sd-hero" style={`--acc:${s.accent}`}>
    <div class="container sd-hero__inner">
      <div>
        <div class="sd-hero__icon"><SectorIcon slug={s.slug} size={30} /></div>
        <h1 class="sd-hero__title" data-i18n={`sector.${s.slug}.name`}>{s.name}</h1>
        <p class="sd-hero__tagline" data-i18n={`sector.${s.slug}.tagline`}>{s.tagline}</p>
        <p class="sd-hero__roi" data-i18n={`sector.${s.slug}.roiHeadline`}>{s.roiHeadline}</p>
        <div class="sd-hero__ctas">
          <a href="/contacto" class="btn btn--primary" style={`background:${s.accent};border-color:${s.accent}`} data-i18n="sectorDetail.cta.demo">Solicitar demo →</a>
          <a href="/precios" class="btn btn--outline" data-i18n="sectorDetail.cta.pilot">Ver piloto 12 semanas</a>
        </div>
      </div>
      <div class="sd-meta">
        <div class="sd-meta__row"><span class="sd-meta__k" data-i18n="sectorDetail.meta.marketEs">Mercado ES</span><span class="sd-meta__v" data-i18n={`sector.${s.slug}.marketEs`}>{s.marketEs}</span></div>
        <div class="sd-meta__row"><span class="sd-meta__k" data-i18n="sectorDetail.meta.marketEu">Mercado EU</span><span class="sd-meta__v" data-i18n={`sector.${s.slug}.marketEu`}>{s.marketEu}</span></div>
        <div class="sd-meta__row"><span class="sd-meta__k" data-i18n="sectorDetail.meta.deployment">Implantación</span><span class="sd-meta__v" data-i18n={`sector.${s.slug}.cycle`}>{s.cycle}</span></div>
        <div class="sd-meta__row"><span class="sd-meta__k" data-i18n="sectorDetail.meta.icp">ICP</span><span class="sd-meta__v" data-i18n={`sector.${s.slug}.icp`}>{s.icp}</span></div>
      </div>
    </div>
  </section>

  <!-- PAINS -->
  <section class="sd-pains" style={`--acc:${s.accent}`}>
    <div class="container">
      <p class="section-label" data-i18n="sectorDetail.pains.label">El problema</p>
      <h2 class="section-title">
        <span data-i18n="sectorDetail.pains.titlePrefix">Los dolores de</span>{' '}
        <span data-i18n={`sector.${s.slug}.short`}>{s.short || s.name}</span>
      </h2>
      <div class="sd-pains__grid">
        {s.pains.map(([title, desc], i) => (
          <div class="sd-pain">
            <span class="sd-pain__n">{`0${i + 1}`}</span>
            <h3 data-i18n={`sector.${s.slug}.pain.${i}.title`}>{title}</h3>
            <p data-i18n={`sector.${s.slug}.pain.${i}.desc`}>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DIFFERENTIATORS -->
  <section class="sd-diffs" style={`--acc:${s.accent}`}>
    <div class="container">
      <p class="section-label section-label--light" data-i18n="sectorDetail.diffs.label">Por qué Planning Core</p>
      <h2 class="section-title section-title--light" data-i18n="sectorDetail.diffs.title">La solución que encaja</h2>
      <div class="sd-diffs__list">
        {s.differentiators.map(([title, desc], i) => (
          <div class="sd-diff">
            <span class="sd-diff__n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 data-i18n={`sector.${s.slug}.diff.${i}.title`}>{title}</h3>
              <p data-i18n={`sector.${s.slug}.diff.${i}.desc`}>{desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="sd-bar" data-i18n="sectorDetail.diffs.bar">
        ✓  100% personalizable a vuestras necesidades y requerimientos. Sin código. Sin consultores. En semanas.
      </div>
    </div>
  </section>

  <!-- PILOT TIMELINE -->
  <section class="sd-pilot" style={`--acc:${s.accent}`}>
    <div class="container">
      <p class="section-label" data-i18n="sectorDetail.pilot.label">Piloto 12 semanas</p>
      <h2 class="section-title" data-i18n="sectorDetail.pilot.title">De cero a producción en 3 meses</h2>
      <ol class="sd-pilot__steps">
        {s.pilotSteps.map(([phase, desc], i) => (
          <li class="sd-pstep">
            <span class="sd-pstep__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="sd-pstep__phase" data-i18n={`sector.${s.slug}.pilot.${i}.phase`}>{phase}</span>
            <span class="sd-pstep__desc" data-i18n={`sector.${s.slug}.pilot.${i}.desc`}>{desc}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- KPIs -->
  <section class="sd-kpis" style={`--acc:${s.accent}`}>
    <div class="container">
      <p class="section-label" data-i18n="sectorDetail.kpis.label">KPIs que se miden</p>
      <h2 class="section-title" data-i18n="sectorDetail.kpis.title">Impacto medible desde la semana 1</h2>
      <div class="sd-kpis__grid">
        {s.kpis.map((kpi, i) => (
          <div class="sd-kpi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="8"/><rect x="13" y="6" width="3" height="12"/></svg>
            <span data-i18n={`sector.${s.slug}.kpi.${i}`}>{kpi}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPETITORS -->
  <section class="sd-comp" style={`--acc:${s.accent}`}>
    <div class="container">
      <p class="section-label" data-i18n="sectorDetail.comp.label">Competencia</p>
      <h2 class="section-title" data-i18n="sectorDetail.comp.title">Por qué no las alternativas</h2>
      <div class="sd-comp__table">
        <div class="sd-comp__head">
          <span data-i18n="sectorDetail.comp.headerAlt">Alternativa</span>
          <span data-i18n="sectorDetail.comp.headerWhy">Por qué no</span>
        </div>
        {s.competitors.map(([name, why], i) => (
          <div class="sd-comp__row">
            <span class="sd-comp__name" data-i18n={`sector.${s.slug}.comp.${i}.name`}>{name}</span>
            <span class="sd-comp__why" data-i18n={`sector.${s.slug}.comp.${i}.why`}>{why}</span>
          </div>
        ))}
        <div class="sd-comp__row sd-comp__row--us">
          <span class="sd-comp__name">Planning Core ✓</span>
          <span class="sd-comp__why" data-i18n="sectorDetail.comp.usWhy">Gantt visual · Escenarios con robustez medida · Sin reemplazar ERP · Piloto en 12 sem</span>
        </div>
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="sd-cta" style={`--acc:${s.accent};background:${s.accent}`}>
    <div class="container sd-cta__inner">
      <div>
        <h2 class="sd-cta__title" data-i18n="sectorDetail.bottom.title">¿Listo para empezar el piloto?</h2>
        <p class="sd-cta__sub" data-i18n="sectorDetail.bottom.sub">12 semanas. Sin riesgo. ROI medible.</p>
      </div>
      <a href="/contacto" class="btn sd-cta__btn" data-i18n="sectorDetail.bottom.cta">Solicitar demo gratuita →</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .sd-hero { position: relative; overflow: hidden; background: linear-gradient(160deg, #060F20, #0B1C3A 62%, color-mix(in srgb, var(--acc) 22%, #0B1C3A)); padding: 5rem 0 4.25rem; }
  .sd-hero::before { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 7.6923%); -webkit-mask-image: linear-gradient(90deg, transparent, #000 35%, #000); mask-image: linear-gradient(90deg, transparent, #000 35%, #000); pointer-events: none; }
  .sd-hero__inner { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 3.5rem; align-items: start; }
  .sd-hero__icon { width: 60px; height: 60px; border-radius: 15px; background: color-mix(in srgb, var(--acc) 18%, transparent); border: 1px solid color-mix(in srgb, var(--acc) 35%, transparent); display: flex; align-items: center; justify-content: center; color: #fff; margin-bottom: 1.25rem; }
  .sd-hero__title { font-family: var(--font-display); font-size: clamp(1.9rem, 3.6vw, 2.85rem); font-weight: 800; color: #fff; line-height: 1.08; letter-spacing: -.025em; margin-bottom: .7rem; }
  .sd-hero__tagline { font-size: 1.05rem; color: var(--silver); margin-bottom: .6rem; }
  .sd-hero__roi { font-size: .88rem; color: rgba(255,255,255,.55); margin-bottom: 1.9rem; line-height: 1.6; max-width: 34rem; }
  .sd-hero__ctas { display: flex; gap: .9rem; flex-wrap: wrap; }

  .sd-meta { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: var(--radius-lg); padding: 1.4rem 1.5rem; min-width: 250px; flex-shrink: 0; }
  .sd-meta__row { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem 0; border-top: 1px solid rgba(255,255,255,.07); }
  .sd-meta__row:first-child { border-top: none; padding-top: 0; }
  .sd-meta__k { font-size: .68rem; font-weight: 600; color: rgba(255,255,255,.35); text-transform: uppercase; letter-spacing: .06em; }
  .sd-meta__v { font-size: .8rem; color: rgba(255,255,255,.8); font-weight: 500; text-align: right; }

  /* PAINS */
  .sd-pains { padding: 5.5rem 0; }
  .sd-pains__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; margin-top: 2rem; }
  .sd-pain { border: 1px solid var(--n80); border-radius: var(--radius-lg); padding: 1.5rem; background: #fff; }
  .sd-pain__n { font-family: var(--font-display); font-size: .72rem; font-weight: 700; letter-spacing: .1em; color: var(--acc); }
  .sd-pain h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin: .6rem 0 .5rem; }
  .sd-pain p { font-size: .88rem; color: var(--n30); line-height: 1.65; }

  /* DIFFS */
  .sd-diffs { position: relative; overflow: hidden; background: linear-gradient(180deg, #0B1C3A, #081533); padding: 5.5rem 0; }
  .section-label--light { color: var(--silver); }
  .sd-diffs__list { display: flex; flex-direction: column; gap: .7rem; margin-top: 2rem; }
  .sd-diff { display: grid; grid-template-columns: 3rem 1fr; gap: 1.25rem; align-items: start; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: 1.35rem 1.5rem; }
  .sd-diff__n { font-family: var(--font-display); font-size: 1.05rem; font-weight: 800; color: color-mix(in srgb, var(--acc) 60%, #fff); }
  .sd-diff h3 { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: .3rem; }
  .sd-diff p { font-size: .88rem; color: var(--silver); line-height: 1.6; }
  .sd-bar { margin-top: 1.75rem; background: var(--acc); color: #fff; text-align: center; font-size: .86rem; font-weight: 700; padding: .8rem 1.5rem; border-radius: var(--radius); }

  /* PILOT */
  .sd-pilot { padding: 5.5rem 0; background: #fff; border-top: 1px solid var(--n80); }
  .sd-pilot__steps { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 2rem; border-top: 2px solid var(--navy); }
  .sd-pstep { padding: 1.5rem 1.4rem 0 0; border-right: 1px solid var(--n80); position: relative; display: flex; flex-direction: column; }
  .sd-pstep:last-child { border-right: none; }
  .sd-pstep::before { content: ''; position: absolute; top: -6px; left: 0; width: 10px; height: 10px; border-radius: 50%; background: var(--acc); }
  .sd-pstep__n { font-family: var(--font-display); font-size: .72rem; font-weight: 700; letter-spacing: .1em; color: var(--acc); }
  .sd-pstep__phase { font-size: .92rem; font-weight: 700; color: var(--navy); margin: .55rem 0 .45rem; }
  .sd-pstep__desc { font-size: .82rem; color: var(--n30); line-height: 1.55; }

  /* KPIS */
  .sd-kpis { padding: 5.5rem 0; }
  .sd-kpis__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .9rem; margin-top: 2rem; }
  .sd-kpi { display: flex; align-items: center; gap: .85rem; background: #fff; border: 1px solid var(--n80); border-radius: var(--radius); padding: 1.05rem 1.25rem; font-size: .9rem; color: var(--navy); font-weight: 500; }
  .sd-kpi svg { width: 18px; height: 18px; color: var(--acc); flex-shrink: 0; }

  /* COMPETITORS */
  .sd-comp { padding: 5.5rem 0; background: #fff; border-top: 1px solid var(--n80); }
  .sd-comp__table { margin-top: 2rem; border: 1px solid var(--n80); border-radius: var(--radius-lg); overflow: hidden; }
  .sd-comp__head { display: grid; grid-template-columns: 220px 1fr; gap: 1rem; padding: .7rem 1.5rem; background: var(--ground); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--blue-gray); }
  .sd-comp__row { display: grid; grid-template-columns: 220px 1fr; gap: 1rem; padding: 1rem 1.5rem; border-top: 1px solid var(--n80); align-items: center; }
  .sd-comp__row--us { background: color-mix(in srgb, var(--acc) 6%, transparent); border-top: 2px solid var(--acc); }
  .sd-comp__name { font-size: .9rem; font-weight: 600; color: var(--navy); }
  .sd-comp__row--us .sd-comp__name { color: var(--acc); }
  .sd-comp__why { font-size: .86rem; color: var(--n30); }

  /* BOTTOM CTA */
  .sd-cta { padding: 3.5rem 0; }
  .sd-cta__inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .sd-cta__title { font-family: var(--font-display); color: #fff; font-size: 1.6rem; font-weight: 800; margin-bottom: .4rem; letter-spacing: -.02em; }
  .sd-cta__sub { color: rgba(255,255,255,.8); font-size: 1rem; }
  .sd-cta__btn { background: #fff; color: #0B1C3A; font-weight: 700; }

  @media (max-width: 900px) {
    .sd-hero__inner { grid-template-columns: 1fr; }
    .sd-meta { width: 100%; }
    .sd-pains__grid { grid-template-columns: 1fr; }
    .sd-pilot__steps { grid-template-columns: 1fr 1fr; }
    .sd-pstep { border-right: none; border-bottom: 1px solid var(--n80); padding-bottom: 1.3rem; }
    .sd-kpis__grid { grid-template-columns: 1fr; }
    .sd-comp__head, .sd-comp__row { grid-template-columns: 1fr; gap: .25rem; }
    .sd-comp__head span:first-child { display: none; }
  }
  @media (max-width: 560px) {
    .sd-pilot__steps { grid-template-columns: 1fr; }
  }
</style>
