---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTORS } from '../../data/sectors.js';
import SectorIcon from '../../components/SectorIcon.astro';
---
<BaseLayout
  title="Sectores industriales — Planning Core"
  description="Planning Core preconfigurado para 9 sectores industriales: Composites, Impresión, Fundición, Muebles, MedTech, Ferroviario, Agroalimentario, Naval y Construcción."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-label" data-i18n="sectores.hero.label">Sectores industriales</p>
      <h1 class="section-title section-title--light" data-i18n-html="sectores.hero.title">Diseñado para tu industria,<br/>no para todas a la vez</h1>
      <p class="page-hero__sub" data-i18n="sectores.hero.sub">
        Cada sector industrial tiene restricciones distintas: ventanas de mantenimiento,
        cuello de botella, trazabilidad regulatoria, turnos de 24h. Planning Core viene
        preconfigurado con la lógica de tu sector.
      </p>
    </div>
  </section>

  <section class="sectors-list">
    <div class="container">
      <ol class="sl-grid">
        {SECTORS.map((s, i) => (
          <li>
            <a href={`/sectores/${s.slug}`} class="sl-row" style={`--acc:${s.accent}`}>
              <span class="sl-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="sl-icon"><SectorIcon slug={s.slug} size={20} /></span>
              <span class="sl-main">
                <span class="sl-name" data-i18n={`sector.${s.slug}.name`}>{s.name}</span>
                <span class="sl-tag" data-i18n={`sector.${s.slug}.tagline`}>{s.tagline}</span>
                <span class="sl-roi" data-i18n={`sector.${s.slug}.roiHeadline`}>{s.roiHeadline}</span>
              </span>
              <span class="sl-meta">
                <span class="sl-meta-lbl" data-i18n="sectores.meta.cycle">Ciclo de implantación</span>
                <span class="sl-meta-val" data-i18n={`sector.${s.slug}.cycle`}>{s.cycle}</span>
              </span>
              <span class="sl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .sectors-list { padding: 3.5rem 0 5.5rem; }
  .sl-grid { list-style: none; border-top: 1px solid var(--n80); }
  .sl-row {
    display: grid;
    grid-template-columns: 2.4rem 44px 1fr auto 1.2rem;
    align-items: center; column-gap: 1.5rem;
    padding: 1.5rem .6rem;
    border-bottom: 1px solid var(--n80);
    color: inherit;
    transition: background var(--transition), padding-left var(--transition), box-shadow var(--transition);
  }
  .sl-row:hover { background: #fff; padding-left: 1.1rem; box-shadow: var(--shadow); }
  .sl-num { font-family: var(--font-display); font-size: .78rem; font-weight: 700; letter-spacing: .1em; color: var(--acc); }
  .sl-icon {
    width: 44px; height: 44px; border-radius: 11px;
    background: color-mix(in srgb, var(--acc) 12%, transparent);
    color: var(--acc);
    display: flex; align-items: center; justify-content: center;
  }
  .sl-main { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .sl-name { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--navy); line-height: 1.2; }
  .sl-tag { font-size: .9rem; color: var(--n30); }
  .sl-roi { font-size: .8rem; color: var(--blue-gray); margin-top: .15rem; }
  .sl-meta { text-align: right; flex-shrink: 0; }
  .sl-meta-lbl { display: block; font-size: .62rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--blue-gray); margin-bottom: .2rem; }
  .sl-meta-val { font-size: .85rem; font-weight: 600; color: var(--navy); }
  .sl-arrow { color: var(--acc); font-size: 1.05rem; opacity: 0; transition: opacity var(--transition); }
  .sl-row:hover .sl-arrow { opacity: 1; }

  @media (max-width: 900px) {
    .sl-row {
      grid-template-columns: 44px 1fr;
      grid-template-areas: 'icon main' 'blank meta';
      column-gap: 1rem; row-gap: .6rem;
    }
    .sl-num { display: none; }
    .sl-icon { grid-area: icon; }
    .sl-main { grid-area: main; }
    .sl-meta { grid-area: meta; text-align: left; }
    .sl-arrow { display: none; }
  }
</style>
