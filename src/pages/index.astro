  .tl-body { display: flex; flex-direction: column; gap: .12rem; }
  .tl-body b { font-size: .95rem; color: #fff; font-weight: 700; }
  .tl-body span { font-size: .82rem; color: rgba(255,255,255,.55); }
  .tl-dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,.25); }
  .tl-dot--ok { background: #16A34A; }
  .tl-dot--warn { background: #D97706; }
  .tl-line { width: 1px; height: 18px; margin-left: calc(1.25rem + 64px); background: rgba(255,255,255,.15); }
  .replan__cta { margin-top: 2.4rem; }

  /* ─────────────── SECTORS ─────────────── */
  .sectors { padding: 5.5rem 0; }
  .sectors__sub { margin-bottom: 2.5rem; }
  .sec-list { list-style: none; border-top: 1px solid var(--n80); }
  .sec-row {
    display: grid;
    grid-template-columns: 40px minmax(11rem, 16rem) 1fr auto;
