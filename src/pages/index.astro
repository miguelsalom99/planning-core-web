---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTORS } from '../data/sectors.js';
import SectorIcon from '../components/SectorIcon.astro';
---
<BaseLayout>

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <div class="badge hero__badge">
          <span class="hero__badge-dot"></span>
          <span data-i18n="home.hero.badge">El plan «óptimo» se rompe el martes</span>
        </div>
        <h1 class="hero__title" data-i18n-html="home.hero.title">
          Elige un plan que aguante,<br/>
          <span class="hero__accent">no uno que solo se vea bien.</span>
        </h1>
        <p class="hero__sub" data-i18n-html="home.hero.sub">
          Todo software de planificación te entrega un plan «óptimo»: impecable en
          papel, frágil en planta. Planning Core genera tres, simula cientos de
          imprevistos sobre cada uno y te da su
          <span class="hero__relief">puntuación de robustez</span> — eliges el que
          encaja con tu tolerancia al riesgo, con datos y no a ojo.
        </p>
        <div class="hero__ctas">
          <a href="/contacto" class="btn btn--primary" data-i18n="home.hero.cta1">Quiero verlo con mis datos →</a>
          <a href="#stress" class="btn btn--outline" data-i18n="home.hero.cta2">Ver la robustez en acción</a>
        </div>
        <div class="hero__trust">
          <span data-i18n="home.hero.trust1">Robustez medida, no supuesta</span>
          <span class="hero__trust-sep">·</span>
          <span data-i18n="home.hero.trust2">Sin reemplazar tu ERP</span>
          <span class="hero__trust-sep">·</span>
          <span data-i18n="home.hero.trust3">Operativo en 12 semanas</span>
        </div>
      </div>

      <div class="hero__visual">
        <div class="planner">
          <div class="planner__bar">
            <span class="planner__dot"></span><span class="planner__dot"></span><span class="planner__dot"></span>
            <span class="planner__name" data-i18n="home.demo.frame">Planning Core · Planificación semanal</span>
          </div>
          <div class="planner__scenarios" data-planner>
            <button class="scn" type="button" data-scn="opt"><span data-i18n="home.gantt.opt">Óptimo</span></button>
            <button class="scn scn--on" type="button" data-scn="bal"><span data-i18n="home.gantt.bal">Equilibrado</span></button>
            <button class="scn" type="button" data-scn="con"><span data-i18n="home.gantt.con">Conservador</span></button>
          </div>
          <div class="planner__gantt">
            {[
              { r: 'ATL-01',    c: '#1589EE' },
              { r: 'ATL-02',    c: '#1589EE' },
              { r: 'AUTOCLAVE', c: '#F4740B' },
              { r: 'NDT',       c: '#7B5EA7' },
              { r: 'CNC',       c: '#2E844A' },
            ].map(row => (
              <div class="grow">
                <span class="grow__label">{row.r}</span>
                <span class="grow__track">
                  <span class="grow__bar" data-bar style={`background:${row.c}`}></span>
                </span>
              </div>
            ))}
          </div>
          <div class="planner__kpis">
            <div class="pk">
              <span class="pk__k" data-i18n="home.demo.finish">Fin del plan</span>
              <b class="pk__v" data-pk="finish">Jue · T1</b>
            </div>
            <div class="pk">
              <span class="pk__k" data-i18n="home.demo.buffer">Margen entre ops.</span>
              <b class="pk__v" data-pk="buffer">1 turno</b>
            </div>
            <div class="pk pk--wide">
              <span class="pk__k" data-i18n="home.demo.robust">Robustez Monte Carlo</span>
              <span class="pk__meter"><i data-pk="robBar" style="width:84%"></i></span>
              <b class="pk__v pk__v--ok"><span data-pk="rob">84</span><span>/100</span></b>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PROOF BAR ═══ -->
  <div class="proof">
    <div class="container proof__inner">
      <div class="proof__item"><strong>9</strong><span data-i18n="home.proof.sectors">sectores preconfigurados</span></div>
      <span class="proof__sep"></span>
      <div class="proof__item"><strong data-i18n="home.proof.pilotN">12&nbsp;sem</strong><span data-i18n="home.proof.pilot">del piloto a producción</span></div>
      <span class="proof__sep"></span>
      <div class="proof__item"><strong>3&nbsp;s</strong><span data-i18n="home.proof.scenarios">para replanificar la semana</span></div>
      <span class="proof__sep"></span>
      <div class="proof__item"><strong>300</strong><span data-i18n="home.proof.sims">imprevistos simulados por plan</span></div>
    </div>
  </div>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section class="how">
    <div class="container">
      <p class="section-label" data-i18n="home.how.label">Cómo funciona</p>
      <h2 class="section-title how__title" data-i18n-html="home.how.title">Un Gantt que decide,<br/>no solo que dibuja</h2>
      <p class="section-sub how__sub" data-i18n="home.how.sub">
        Planning Core vive encima de tu ERP. Tú defines los recursos y las
        restricciones; el motor construye el plan y lo mantiene al día.
      </p>

      <ol class="steps">
        <li class="step">
          <span class="step__n">01</span>
          <h3 class="step__t" data-i18n="home.steps.0.title">Define tus recursos</h3>
          <p class="step__d" data-i18n="home.steps.0.desc">Máquinas, operarios, turnos y restricciones de secuencia. Sin código, sin IT — en menos de una semana.</p>
        </li>
        <li class="step">
          <span class="step__n">02</span>
          <h3 class="step__t" data-i18n="home.steps.1.title">El motor planifica y simula</h3>
          <p class="step__d" data-i18n="home.steps.1.desc">Construye el plan óptimo respetando cada restricción y lo somete a cientos de simulaciones Monte Carlo para medir su robustez ante imprevistos.</p>
        </li>
        <li class="step">
          <span class="step__n">03</span>
          <h3 class="step__t" data-i18n="home.steps.2.title">Compara 3 escenarios</h3>
          <p class="step__d" data-i18n="home.steps.2.desc">Óptimo, Equilibrado y Conservador — con su fecha de fin, su margen ante imprevistos y su puntuación de robustez. Eliges con datos, no a ojo.</p>
        </li>
        <li class="step">
          <span class="step__n">04</span>
          <h3 class="step__t" data-i18n="home.steps.3.title">Ejecuta y mide</h3>
          <p class="step__d" data-i18n="home.steps.3.desc">Gantt en tiempo real, alertas de cuello de botella antes de que ocurra y un scorecard de impacto desde el primer día.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ STRESS TEST — centrepiece / the differentiator ═══ -->
  <section class="replan" id="stress">
    <div class="replan__grid" aria-hidden="true"></div>
    <div class="container">
      <p class="section-label section-label--light" data-i18n="home.stress.label">Ponlo a prueba</p>
      <h2 class="section-title section-title--light replan__title" data-i18n-html="home.stress.title">
        El plan que no has puesto a prueba<br/>no es un plan. Es una apuesta.
      </h2>
      <p class="replan__sub" data-i18n="home.stress.sub">
        Lanza un imprevisto y observa cómo responde cada escenario. La puntuación
        de robustez ya predecía cuál iba a aguantar.
      </p>

      <div class="stress" data-stress>
        <div class="stress__controls">
          <span class="stress__ctl-label" data-i18n="home.stress.trigger">Lanza un imprevisto:</span>
          <div class="stress__chips" role="group" aria-label="Imprevistos">
            <button class="stress-chip" type="button" data-disr="autoclave" aria-pressed="false" data-i18n="home.stress.d.autoclave">Avería de autoclave · 2 turnos</button>
            <button class="stress-chip" type="button" data-disr="rush" aria-pressed="false" data-i18n="home.stress.d.rush">Pedido urgente · entrega 48 h</button>
            <button class="stress-chip" type="button" data-disr="sick" aria-pressed="false" data-i18n="home.stress.d.sick">Operario clave de baja · 1 turno</button>
          </div>
          <button class="stress-reset" type="button" data-stress-reset hidden data-i18n="home.stress.reset">Reiniciar</button>
        </div>

        <div class="stress__grid" aria-live="polite">
          {[
            { key: 'opt', rob: 71 },
            { key: 'bal', rob: 84 },
            { key: 'con', rob: 92 },
          ].map(s => (
            <div class="scard" data-scard={s.key}>
              <div class="scard__head">
                <span class="scard__label" data-i18n={`home.gantt.${s.key}`}>{s.key === 'opt' ? 'Óptimo' : s.key === 'bal' ? 'Equilibrado' : 'Conservador'}</span>
                <span class="scard__rob"><span data-i18n="home.stress.rob">Robustez</span> <b>{s.rob}</b></span>
              </div>
              <div class="scard__bar"><i style={`width:${s.rob}%`}></i></div>
              <div class="scard__result" data-scard-result>
                <span class="scard__state" data-st="idle" data-i18n="home.stress.idle">Plan publicado · listo</span>
                <span class="scard__state scard__state--ok" data-st="held" data-i18n="home.stress.held" hidden>Absorbido</span>
                <span class="scard__state scard__state--bad" data-st="broke" data-i18n="home.stress.broke" hidden>Fechas rotas</span>
                <span class="scard__metric" data-sm hidden></span>
                <span class="scard__note" data-sn hidden></span>
              </div>
            </div>
          ))}
        </div>
        <p class="stress__caption" data-i18n="home.stress.caption">Datos de ejemplo. Con tus datos, la robustez se calcula sobre tu planta real.</p>
      </div>

      <a href="/comparativa" class="btn btn--outline replan__cta" data-i18n="home.stress.cta">Ver cómo se compara con lo de siempre →</a>
    </div>
  </section>

  <!-- ═══ SECTORS ═══ -->
  <section class="sectors">
    <div class="container">
      <p class="section-label" data-i18n="home.sectors.label">Sectores</p>
      <h2 class="section-title" data-i18n-html="home.sectors.title">Diseñado para tu industria,<br/>no para todas a la vez</h2>
      <p class="section-sub sectors__sub" data-i18n="home.sectors.sub">
        Cada sector tiene sus propias restricciones. Planning Core llega
        preconfigurado con la lógica de la tuya.
      </p>

      <ul class="sec-list">
        {SECTORS.map(s => (
          <li>
            <a href={`/sectores/${s.slug}`} class="sec-row" style={`--acc:${s.accent}`}>
              <span class="sec-row__icon"><SectorIcon slug={s.slug} /></span>
              <span class="sec-row__name" data-i18n={`sector.${s.slug}.short`}>{s.short}</span>
              <span class="sec-row__tag" data-i18n={`sector.${s.slug}.tagline`}>{s.tagline}</span>
              <span class="sec-row__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ WHY / VALUE ═══ -->
  <section class="value">
    <div class="container value__grid">
      <div class="value__text">
        <p class="section-label" data-i18n="home.value.label">Por qué Planning Core</p>
        <h2 class="section-title" data-i18n-html="home.value.title">No es otro ERP.<br/>Es la capa que faltaba.</h2>
        <p class="section-sub" data-i18n="home.value.sub">
          Tu ERP registra lo que pasó. Planning Core decide qué producir mañana —
          encima de tu sistema actual, sin migraciones ni consultores.
        </p>
        <div class="value__list">
          <div class="vi">
            <span class="vi__k">01</span>
            <div><strong data-i18n="home.value.1.title">Robustez medida, no supuesta</strong><span data-i18n="home.value.1.desc">Cada escenario trae su puntuación Monte Carlo: sabes cuál aguanta antes de elegirlo.</span></div>
          </div>
          <div class="vi">
            <span class="vi__k">02</span>
            <div><strong data-i18n="home.value.0.title">Replanifica en segundos</strong><span data-i18n="home.value.0.desc">Un imprevisto no cuesta una reunión de dos horas. Cuesta tres segundos.</span></div>
          </div>
          <div class="vi">
            <span class="vi__k">03</span>
            <div><strong data-i18n="home.value.2.title">La lógica de tu sector, ya dentro</strong><span data-i18n="home.value.2.desc">Ciclo de autoclave, ventanas de mantenimiento, trazabilidad GxP — preconfigurado.</span></div>
          </div>
          <div class="vi">
            <span class="vi__k">04</span>
            <div><strong data-i18n="home.value.3.title">Sin tocar tu ERP</strong><span data-i18n="home.value.3.desc">Integración vía API en días. Escala de una máquina a cientos de recursos.</span></div>
          </div>
        </div>
      </div>

      <div class="value__compare">
        <div class="cmp cmp--old">
          <div class="cmp__h" data-i18n="home.comp.withoutLabel">Sin Planning Core</div>
          <div class="cmp__row"><span class="cmp__x">✗</span><span data-i18n="home.comp.old.0">Excel por turno, verdad por persona</span></div>
          <div class="cmp__row"><span class="cmp__x">✗</span><span data-i18n="home.comp.old.1">El cuello de botella se detecta tarde</span></div>
          <div class="cmp__row"><span class="cmp__x">✗</span><span data-i18n="home.comp.old.2">Plan hecho el lunes, inútil el martes</span></div>
          <div class="cmp__row"><span class="cmp__x">✗</span><span data-i18n="home.comp.old.3">Dos horas de reunión para replanificar</span></div>
          <div class="cmp__row"><span class="cmp__x">✗</span><span data-i18n="home.comp.old.4">El plan vive en la cabeza del jefe de turno</span></div>
        </div>
        <div class="cmp cmp--new">
          <div class="cmp__h" data-i18n="home.comp.withLabel">Con Planning Core</div>
          <div class="cmp__row"><span class="cmp__ok">✓</span><span data-i18n="home.comp.new.0">Un plan en tiempo real para todo el equipo</span></div>
          <div class="cmp__row"><span class="cmp__ok">✓</span><span data-i18n="home.comp.new.1">Alerta automática antes de que ocurra</span></div>
          <div class="cmp__row"><span class="cmp__ok">✓</span><span data-i18n="home.comp.new.2">El Gantt se actualiza solo</span></div>
          <div class="cmp__row"><span class="cmp__ok">✓</span><span data-i18n="home.comp.new.3">Replanificación en segundos, con robustez medida</span></div>
          <div class="cmp__row"><span class="cmp__ok">✓</span><span data-i18n="home.comp.new.4">Visibilidad para toda la planta</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PILOT CTA ═══ -->
  <section class="pilot">
    <div class="container pilot__inner">
      <div>
        <p class="section-label section-label--light" data-i18n="home.pilot.label">Piloto 12 semanas</p>
        <h2 class="section-title section-title--light" data-i18n-html="home.pilot.title">De Excel a Gantt inteligente<br/>en 12 semanas</h2>
        <p class="pilot__sub" data-i18n="home.pilot.sub">
          Mapeamos tus recursos en la semana 1, validamos el plan en la 8 y
          hacemos go-live con métricas reales antes de la 12. Si no genera valor,
          no hay contrato.
        </p>
      </div>
      <div class="pilot__actions">
        <a href="/precios" class="btn btn--primary" data-i18n="home.pilot.cta1">Ver el piloto →</a>
        <a href="/contacto" class="btn btn--outline" data-i18n="home.pilot.cta2">Hablar con ventas</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  main { background: var(--ground); }
</style>

<style>
  /* ─────────────── HERO ─────────────── */
  .hero {
    position: relative;
    background: linear-gradient(160deg, #060F20 0%, #0B1C3A 60%, #0E2751 100%);
    padding: 5.5rem 0 5rem;
    overflow: hidden;
  }
  .hero__grid {
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.04) 0 1px, transparent 1px 14.28%);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%, #000);
    mask-image: linear-gradient(90deg, transparent, #000 30%, #000);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 3.5rem;
    align-items: center;
  }
  .hero__badge {
    background: rgba(217,119,6,.12);
    color: #fb923c;
    border-color: rgba(217,119,6,.28);
    margin-bottom: 1.5rem;
    text-transform: none;
    letter-spacing: .02em;
    font-weight: 600;
  }
  .hero__badge-dot {
    width: 6px; height: 6px; border-radius: 50%; background: #fb923c;
    box-shadow: 0 0 0 0 rgba(251,146,60,.6);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse { 70%, 100% { box-shadow: 0 0 0 7px rgba(251,146,60,0); } }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 4.4vw, 3.35rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.06;
    letter-spacing: -.03em;
    margin-bottom: 1.4rem;
  }
  .hero__accent {
    color: transparent;
    background: linear-gradient(180deg, #fff 30%, #8BC2C6);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .hero__relief { color: #fff; font-weight: 700; }
  .hero__sub {
    color: rgba(255,255,255,.62);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 30rem;
  }
  .hero__ctas { display: flex; gap: .9rem; flex-wrap: wrap; margin-bottom: 1.6rem; }
  .hero__trust {
    display: flex; gap: .6rem; flex-wrap: wrap; align-items: center;
    font-size: .78rem; color: rgba(255,255,255,.42);
  }
  .hero__trust-sep { opacity: .4; }

  /* Hero planner mock */
  .hero__visual { position: relative; }
  .planner {
    background: #0C1E3F;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 14px;
    box-shadow: 0 24px 70px -20px rgba(0,0,0,.55);
    overflow: hidden;
    width: calc(100% + 5vw);
  }
  .planner__bar {
    display: flex; align-items: center; gap: .4rem;
    padding: .7rem .9rem;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.02);
  }
  .planner__dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.18); }
  .planner__name { margin-left: .5rem; font-size: .7rem; color: rgba(255,255,255,.45); font-weight: 500; }
  .planner__scenarios { display: flex; gap: .4rem; padding: .8rem .9rem .3rem; }
  .scn {
    font: inherit; font-size: .68rem; font-weight: 600;
    padding: .28rem .7rem; border-radius: 999px; cursor: pointer;
    background: rgba(255,255,255,.05); color: rgba(255,255,255,.5);
    border: 1px solid transparent;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }
  .scn:hover { color: rgba(255,255,255,.8); background: rgba(255,255,255,.09); }
  .scn:focus-visible { outline: 2px solid #8BC2C6; outline-offset: 2px; }
  .scn--on, .scn--on:hover { background: rgba(38,81,178,.28); color: #bcd1ff; border-color: rgba(120,160,255,.35); }
  .planner__gantt { padding: .6rem .9rem .3rem; display: flex; flex-direction: column; gap: .34rem; }
  .grow { display: flex; align-items: center; gap: .55rem; }
  .grow__label { width: 62px; flex-shrink: 0; font-size: .62rem; color: rgba(255,255,255,.4); font-variant-numeric: tabular-nums; }
  .grow__track {
    position: relative; flex: 1; height: 16px; border-radius: 3px;
    background: rgba(255,255,255,.04);
    background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 1px, transparent 1px 12.5%);
  }
  .grow__bar { position: absolute; top: 2px; bottom: 2px; border-radius: 2px; opacity: .92; transition: left .4s cubic-bezier(.4,0,.2,1), width .4s cubic-bezier(.4,0,.2,1); }
  .pk__meter i { transition: width .4s cubic-bezier(.4,0,.2,1); }
  .planner__kpis {
    padding: .8rem .9rem 1rem; margin-top: .3rem;
    border-top: 1px solid rgba(255,255,255,.07);
    display: grid; grid-template-columns: 1fr 1fr; gap: .55rem .9rem;
  }
  .pk { display: flex; flex-direction: column; gap: .12rem; }
  .pk--wide { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: .7rem; }
  .pk__k { font-size: .6rem; color: rgba(255,255,255,.4); text-transform: uppercase; letter-spacing: .04em; }
  .pk__v { font-size: .82rem; color: #fff; font-weight: 700; }
  .pk__v--ok { color: #4ade80; }
  .pk__v--ok span { color: rgba(255,255,255,.35); font-weight: 500; font-size: .68rem; }
  .pk--wide .pk__k { grid-column: 1; }
  .pk--wide .pk__v { grid-column: 2; grid-row: 1 / span 2; }
  .pk__meter { grid-column: 1; height: 4px; border-radius: 999px; background: rgba(255,255,255,.1); overflow: hidden; }
  .pk__meter i { display: block; height: 100%; background: #16A34A; border-radius: inherit; }

  /* ─────────────── PROOF ─────────────── */
  .proof { background: var(--navy-dark); border-bottom: 1px solid rgba(255,255,255,.06); }
  .proof__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.6rem 1.5rem; flex-wrap: wrap; }
  .proof__item { display: flex; align-items: baseline; gap: .5rem; }
  .proof__item strong { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: #fff; letter-spacing: -.02em; }
  .proof__item span { font-size: .78rem; color: rgba(255,255,255,.5); }
  .proof__sep { flex: 1; height: 1px; background: rgba(255,255,255,.09); min-width: 12px; }

  /* ─────────────── HOW ─────────────── */
  .how { padding: 5.5rem 0; }
  .how__sub { margin-bottom: 3rem; }
  .steps {
    list-style: none;
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 2px solid var(--navy);
  }
  .step { padding: 1.6rem 1.5rem 0 0; border-right: 1px solid var(--n80); position: relative; }
  .step:last-child { border-right: none; }
  .step::before {
    content: ''; position: absolute; top: -6px; left: 0;
    width: 10px; height: 10px; border-radius: 50%; background: var(--navy);
  }
  .step__n { font-family: var(--font-display); font-size: .78rem; font-weight: 700; letter-spacing: .12em; color: var(--brand); }
  .step__t { font-size: 1.02rem; font-weight: 700; color: var(--navy); margin: .7rem 0 .45rem; }
  .step__d { font-size: .88rem; color: var(--n30); line-height: 1.6; }

  /* ─────────────── REPLAN centrepiece ─────────────── */
  .replan {
    position: relative; overflow: hidden;
    background: linear-gradient(180deg, #0B1C3A, #081533);
    padding: 5.5rem 0;
    scroll-margin-top: 80px;
  }
  .replan__grid {
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 7.6923%);
    pointer-events: none;
  }
  .replan .container { position: relative; }
  .section-label--light { color: var(--silver); }
  .replan__title { max-width: 30ch; }
  .replan__sub { color: rgba(255,255,255,.6); font-size: 1.02rem; line-height: 1.65; max-width: 34rem; margin: .5rem 0 2.6rem; }

  /* Interactive stress-test */
  .stress { margin-top: .5rem; }
  .stress__controls { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem .9rem; margin-bottom: 1.6rem; }
  .stress__ctl-label { font-size: .8rem; color: rgba(255,255,255,.5); font-weight: 600; }
  .stress__chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .stress-chip {
    font: inherit; font-size: .78rem; font-weight: 600;
    padding: .5rem .9rem; border-radius: 999px; cursor: pointer;
    background: rgba(255,255,255,.05); color: rgba(255,255,255,.72);
    border: 1px solid rgba(255,255,255,.12);
    transition: background .15s, border-color .15s, color .15s;
  }
  .stress-chip:hover { background: rgba(255,255,255,.1); color: #fff; }
  .stress-chip[aria-pressed="true"] { background: rgba(217,119,6,.16); border-color: rgba(217,119,6,.45); color: #fdba74; }
  .stress-chip:focus-visible { outline: 2px solid #8BC2C6; outline-offset: 2px; }
  .stress-reset {
    font: inherit; font-size: .76rem; font-weight: 600; cursor: pointer;
    background: none; border: none; color: rgba(255,255,255,.5);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .stress-reset:hover { color: #fff; }

  .stress__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .scard {
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 14px;
    padding: 1.35rem 1.4rem;
    transition: border-color .35s ease, background .35s ease;
  }
  .scard--ok  { border-color: rgba(22,163,74,.45);  background: rgba(22,163,74,.08); }
  .scard--bad { border-color: rgba(220,68,68,.5);   background: rgba(220,68,68,.09); }
  .scard__head { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; margin-bottom: .8rem; }
  .scard__label { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: #fff; }
  .scard__rob { font-size: .64rem; color: rgba(255,255,255,.45); text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .scard__rob b { font-family: var(--font-display); font-size: .95rem; color: #8BC2C6; margin-left: .25rem; }
  .scard__bar { height: 4px; border-radius: 999px; background: rgba(255,255,255,.12); overflow: hidden; margin-bottom: 1rem; }
  .scard__bar i { display: block; height: 100%; background: #8BC2C6; border-radius: inherit; }
  .scard__result { display: flex; flex-direction: column; gap: .3rem; min-height: 4.5rem; }
  .scard__state { font-size: .82rem; font-weight: 700; color: rgba(255,255,255,.6); }
  .scard__state--ok  { color: #4ade80; }
  .scard__state--bad { color: #f87171; }
  .scard__metric { font-size: .8rem; color: rgba(255,255,255,.78); font-variant-numeric: tabular-nums; }
  .scard__note { font-size: .76rem; color: rgba(255,255,255,.45); line-height: 1.4; }
  .stress__caption { font-size: .72rem; color: rgba(255,255,255,.35); margin-top: 1rem; }
  .replan__cta { margin-top: 2.4rem; }

  @media (max-width: 760px) {
    .stress__grid { grid-template-columns: 1fr; }
  }

  /* ─────────────── SECTORS ─────────────── */
  .sectors { padding: 5.5rem 0; }
  .sectors__sub { margin-bottom: 2.5rem; }
  .sec-list { list-style: none; border-top: 1px solid var(--n80); }
  .sec-row {
    display: grid;
    grid-template-columns: 40px minmax(11rem, 16rem) 1fr auto;
    align-items: center; column-gap: 1.4rem; row-gap: .1rem;
    padding: 1rem .5rem;
    border-bottom: 1px solid var(--n80);
    transition: background var(--transition), padding-left var(--transition), box-shadow var(--transition);
  }
  .sec-row:hover { background: #fff; padding-left: 1rem; box-shadow: var(--shadow); }
  .sec-row__icon {
    width: 36px; height: 36px; border-radius: 9px;
    background: color-mix(in srgb, var(--acc) 12%, transparent);
    color: var(--acc);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .sec-row__icon :global(svg) { width: 18px; height: 18px; }
  .sec-row__name { font-family: var(--font-display); font-weight: 700; font-size: .95rem; color: var(--navy); line-height: 1.25; }
  .sec-row__tag { font-size: .875rem; color: var(--n30); }
  .sec-row__arrow { color: var(--acc); opacity: 0; transition: opacity var(--transition); font-size: 1.05rem; }
  .sec-row:hover .sec-row__arrow { opacity: 1; }

  /* ─────────────── VALUE ─────────────── */
  .value { padding: 5.5rem 0; background: #fff; border-top: 1px solid var(--n80); }
  .value__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4.5rem; align-items: start; }
  .value__list { margin-top: 1.75rem; display: flex; flex-direction: column; }
  .vi {
    display: grid; grid-template-columns: 2.5rem 1fr; gap: .9rem;
    padding: 1.1rem 0; border-top: 1px solid var(--n80);
  }
  .vi:first-child { border-top: none; }
  .vi__k { font-family: var(--font-display); font-size: .8rem; font-weight: 700; color: var(--brand); letter-spacing: .06em; }
  .vi strong { display: block; font-size: .98rem; color: var(--navy); margin-bottom: .2rem; }
  .vi span { font-size: .88rem; color: var(--n30); line-height: 1.55; }

  .value__compare {
    display: grid; grid-template-columns: 1fr 1fr;
    border: 1px solid var(--n80); border-radius: var(--radius-lg); overflow: hidden;
    box-shadow: var(--shadow); background: #fff;
    position: sticky; top: 6rem;
  }
  .cmp { padding: 1.5rem 1.4rem; }
  .cmp--old { background: #FBF5F4; border-right: 1px solid var(--n80); }
  .cmp__h { font-family: var(--font-display); font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 1.1rem; }
  .cmp--old .cmp__h { color: #C0392B; }
  .cmp--new .cmp__h { color: var(--ok); }
  .cmp__row { display: flex; gap: .55rem; align-items: flex-start; font-size: .84rem; color: var(--steel); line-height: 1.45; margin-bottom: .8rem; }
  .cmp__row:last-child { margin-bottom: 0; }
  .cmp__x { color: #C0392B; font-weight: 700; flex-shrink: 0; }
  .cmp__ok { color: var(--ok); font-weight: 700; flex-shrink: 0; }

  /* ─────────────── PILOT ─────────────── */
  .pilot { background: linear-gradient(160deg, #060F20, #0B1C3A); padding: 5rem 0; }
  .pilot__inner { display: flex; justify-content: space-between; align-items: center; gap: 3rem; flex-wrap: wrap; }
  .pilot__sub { color: var(--silver); max-width: 34rem; line-height: 1.65; margin-top: .8rem; font-size: 1rem; }
  .pilot__actions { display: flex; flex-direction: column; gap: .9rem; flex-shrink: 0; }

  /* ─────────────── RESPONSIVE ─────────────── */
  @media (max-width: 1080px) {
    .hero__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .planner { width: 100%; max-width: 30rem; }
    .steps { grid-template-columns: repeat(2, 1fr); }
    .step { border-right: none; border-bottom: 1px solid var(--n80); padding-bottom: 1.4rem; }
    .step:nth-child(2n) { border-right: none; }
    .value__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .value__compare { position: static; }
  }
  @media (max-width: 640px) {
    .hero { padding: 4rem 0 3.5rem; }
    .steps { grid-template-columns: 1fr; }
    .sec-row {
      grid-template-columns: 36px 1fr;
      grid-template-areas: 'icon name' 'blank tag';
      column-gap: .9rem; row-gap: .15rem;
    }
    .sec-row__icon { grid-area: icon; }
    .sec-row__name { grid-area: name; }
    .sec-row__tag  { grid-area: tag; }
    .sec-row__arrow { display: none; }
    .value__compare { grid-template-columns: 1fr; }
    .cmp--old { border-right: none; border-bottom: 1px solid var(--n80); }
    .tl-step { grid-template-columns: 1fr; gap: .3rem; }
    .tl-line { display: none; }
    .proof__sep { display: none; }
    .proof__inner { justify-content: flex-start; gap: 1rem 1.75rem; }
  }
</style>

<script>
  // Interactive stress-test — trigger a disruption, show how each scenario responds
  const stress = document.querySelector('[data-stress]');
  if (stress) {
    type Cell = { ok: boolean; otd: number; slip: Record<string, string>; note: Record<string, string> };
    const DISR: Record<string, Record<string, Cell>> = {
      autoclave: {
        opt: { ok: false, otd: 88, slip: { es: '+2 días', en: '+2 days' }, note: { es: 'sin colchón que absorba la parada', en: 'no buffer to absorb the outage' } },
        bal: { ok: true,  otd: 100, slip: { es: 'sin desvío', en: 'on time' }, note: { es: 'el turno de margen la absorbe', en: 'the buffer shift absorbs it' } },
        con: { ok: true,  otd: 100, slip: { es: 'sin desvío', en: 'on time' }, note: { es: 'de sobra', en: 'with room to spare' } },
      },
      rush: {
        opt: { ok: false, otd: 92, slip: { es: '+1 día', en: '+1 day' }, note: { es: 'desplaza 3 órdenes comprometidas', en: 'pushes back 3 committed orders' } },
        bal: { ok: true,  otd: 100, slip: { es: 'sin desvío', en: 'on time' }, note: { es: 'encaja en el margen', en: 'fits into the buffer' } },
        con: { ok: true,  otd: 100, slip: { es: 'sin desvío', en: 'on time' }, note: { es: 'encaja sin tocar el resto', en: 'fits without touching the rest' } },
      },
      sick: {
        opt: { ok: false, otd: 90, slip: { es: '+1 día', en: '+1 day' }, note: { es: 'CNC se queda sin cubrir', en: 'CNC left uncovered' } },
        bal: { ok: true,  otd: 96,  slip: { es: 'sin desvío', en: 'on time' }, note: { es: 'se reasigna dentro del turno', en: 'reassigned within the shift' } },
        con: { ok: true,  otd: 100, slip: { es: 'sin desvío', en: 'on time' }, note: { es: 'holgura de sobra', en: 'plenty of slack' } },
      },
    };
    const OTD = { es: 'OTD', en: 'OTD' } as Record<string, string>;
    const cards = [...stress.querySelectorAll<HTMLElement>('[data-scard]')];
    const chips = [...stress.querySelectorAll<HTMLElement>('[data-disr]')];
    const resetBtn = stress.querySelector<HTMLButtonElement>('[data-stress-reset]');
    let active: string | null = null;

    const render = () => {
      const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
      cards.forEach(card => {
        const key = card.dataset.scard!;
        const idle  = card.querySelector<HTMLElement>('[data-st="idle"]')!;
        const held  = card.querySelector<HTMLElement>('[data-st="held"]')!;
        const broke = card.querySelector<HTMLElement>('[data-st="broke"]')!;
        const sm = card.querySelector<HTMLElement>('[data-sm]')!;
        const sn = card.querySelector<HTMLElement>('[data-sn]')!;
        if (!active) {
          card.classList.remove('scard--ok', 'scard--bad');
          idle.hidden = false; held.hidden = true; broke.hidden = true; sm.hidden = true; sn.hidden = true;
          return;
        }
        const o = DISR[active][key];
        card.classList.toggle('scard--ok', o.ok);
        card.classList.toggle('scard--bad', !o.ok);
        idle.hidden = true;
        held.hidden = !o.ok;
        broke.hidden = o.ok;
        sm.hidden = false; sn.hidden = false;
        sm.textContent = `${OTD[lang]} ${o.otd}% · ${o.slip[lang]}`;
        sn.textContent = o.note[lang];
      });
      chips.forEach(c => c.setAttribute('aria-pressed', String(c.dataset.disr === active)));
      if (resetBtn) resetBtn.hidden = !active;
    };

    chips.forEach(c => c.addEventListener('click', () => { active = c.dataset.disr!; render(); }));
    resetBtn?.addEventListener('click', () => { active = null; render(); });
    new MutationObserver(() => render()).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
    render();
  }

  // Hero planner mock — switch scenario, update gantt + KPIs
  const planner = document.querySelector('[data-planner]');
  if (planner) {
    const SCN = {
      opt: {
        bars: [[6,14],[6,14],[22,15],[39,13],[54,13]],
        finish: { es: 'Mié · T1', en: 'Wed · S1' },
        buffer: { es: '0 turnos', en: '0 shifts' },
        rob: 71,
      },
      bal: {
        bars: [[6,14],[6,14],[24,20],[46,16],[64,16]],
        finish: { es: 'Jue · T1', en: 'Thu · S1' },
        buffer: { es: '1 turno', en: '1 shift' },
        rob: 84,
      },
      con: {
        bars: [[6,14],[6,14],[26,23],[51,18],[71,18]],
        finish: { es: 'Vie · T1', en: 'Fri · S1' },
        buffer: { es: '2 turnos', en: '2 shifts' },
        rob: 92,
      },
    };
    const bars = [...document.querySelectorAll('[data-bar]')];
    const pk = (k: string) => document.querySelector<HTMLElement>(`[data-pk="${k}"]`);
    let current = 'bal';

    const render = (key: string) => {
      const s = SCN[key as keyof typeof SCN];
      if (!s) return;
      current = key;
      const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
      bars.forEach((b, i) => {
        const [l, w] = s.bars[i] || [0, 0];
        b.style.left = l + '%';
        b.style.width = w + '%';
      });
      const f = pk('finish'); if (f) f.textContent = s.finish[lang];
      const bf = pk('buffer'); if (bf) bf.textContent = s.buffer[lang];
      const rb = pk('robBar'); if (rb) rb.style.width = s.rob + '%';
      const r = pk('rob'); if (r) r.textContent = String(s.rob);
      planner.querySelectorAll('.scn').forEach(btn => {
        btn.classList.toggle('scn--on', (btn as HTMLElement).dataset.scn === key);
      });
    };

    planner.querySelectorAll('.scn').forEach(btn => {
      btn.addEventListener('click', () => render((btn as HTMLElement).dataset.scn!));
    });
    // Re-render when <html lang> flips (BaseLayout's applyLang), so KPI strings stay in sync
    new MutationObserver(() => render(current))
      .observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
    render('bal');
  }
</script>
